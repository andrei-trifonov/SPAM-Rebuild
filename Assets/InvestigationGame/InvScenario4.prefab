      Content: "\"\u0421\u043F\u0430\u043C\" - \u0431\u044B\u0441\u0442\u0440\u043E
        \u0440\u0430\u0441\u0442\u0443\u0449\u0430\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F"
      Level: 1
      Type: 0
      Locked: 0
  - Item1: 4
    t1: {fileID: 0}
