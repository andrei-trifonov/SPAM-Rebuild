  m_Script: {fileID: 11500000, guid: 0a9db2d755cd1f84fa0b783e56cc1bcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Thoughts: []
  Results:
  - ID: 13
    Content: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0437\u0430\u0447\u0435\u043C
      \u0438 \u043A\u0442\u043E \u0441\u043E\u0437\u0434\u0430\u0435\u0442 \u044D\u0442\u0443
      \u0437\u0435\u043B\u0435\u043D\u0443\u044E \u0434\u0440\u044F\u043D\u044C -
      \u0444\u0430\u043A\u0442 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u043E\u043D\u0430
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u043D\u0430 \u043C\u043E\u0439 \u043C\u043E\u0437\u0433. \u0418 \u043C\u043D\u0435
      \u044D\u0442\u043E \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F!"
    Var: 8
    Value: 1
    jumpLabel: A1
    isTrueResult: 1
  - ID: 10
    Content: "\u0411\u043B\u0438\u043D, \u0435\u0440\u0443\u043D\u0434\u0430 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C. \u041F\u0440\u0438
      \u0447\u0435\u043C \u0437\u0434\u0435\u0441\u044C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E
      \u0434\u043B\u044F \u044D\u0440\u0435\u043A\u0446\u0438\u0438?"
    Var: 8
    Value: 2
    jumpLabel: A1
    isTrueResult: 0
  Merges:
  - Item1: 1
    t1: {fileID: 0}
    Item2: 2
    t2: {fileID: 0}
    Result:
      ID: 10
      Content: "\u0421\u043F\u0430\u043C - \u044D\u0442\u043E \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E
        \u0434\u043B\u044F \u044D\u0440\u0435\u043A\u0446\u0438\u0438?"
      Level: 2
      Type: 3
      Locked: 0
  - Item1: 2
    t1: {fileID: 0}
