--- !u!114 &2901446293802180339
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8871073353941084874}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a9db2d755cd1f84fa0b783e56cc1bcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Thoughts: []
  Results:
  - ID: 14
    Content: "\u0412\u044B\u0445\u043E\u0434\u0438\u0442, \u041A\u0438\u0440\u0443
      \u043D\u0443\u0436\u0435\u043D \u0421\u043F\u0430\u043C, \u0447\u0442\u043E\u0431\u044B
      \u0442\u043E\u0436\u0435 \u0432\u0438\u0434\u0435\u0442\u044C \u0441\u0432\u044F\u0437\u0438?
      \u041D\u043E \u0437\u0430\u0447\u0435\u043C?"
    Var: 5
    Value: 1
    jumpLabel: 0.2
    isTrueResult: 1
  - ID: 12
    Content: "\u042D\u0442\u043E \u0437\u0432\u0443\u0447\u0438\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u043E,
      \u043D\u043E, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B
      \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u041A\u0438\u0440\u0443 \u0432\u043E\u0439\u0442\u0438
      \u0432 \u0440\u043E\u043B\u044C."
    Var: 5
    Value: 2
    jumpLabel: 0.2
    isTrueResult: 0
  - ID: 10
    Content: "\u041A\u0438\u0440 \u043D\u0438\u0447\u0435\u043C \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \"\u0440\u043E\u043A-\u0437\u0432\u0435\u0437\u0434\"...
      \u041E\u043D \u0442\u043E\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B."
    Var: 5
    Value: 3
    jumpLabel: 0.2
    isTrueResult: 0
  Merges:
  - Item1: 7
    t1: {fileID: 0}
    Item2: 8
    t2: {fileID: 0}
    Result:
      ID: 9
      Content: "\u041A\u0438\u0440 \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u0441\u0435\u0431\u044F
        \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u043C \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442\u043E\u043C?"
      Level: 1
      Type: 3
      Locked: 0
  - Item1: 9
    t1: {fileID: 0}
    Item2: 2
    t2: {fileID: 0}
    Result:
      ID: 10
      Content: "\u041A\u0430\u043A  \u0432\u0441\u0435 \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442\u044B,
        \u041A\u0438\u0440 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
        \"\u0421\u043F\u0430\u043C\", \u0447\u0442\u043E\u0431\u044B \u043A\u0430\u0439\u0444\u0430\u043D\u0443\u0442\u044C"
      Level: 2
      Type: 1
      Locked: 0
  - Item1: 3
    t1: {fileID: 0}
    Item2: 5
    t2: {fileID: 0}
    Result:
      ID: 11
      Content: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u041A\u0438\u0440 \u0443\u0432\u043B\u0435\u043A\u0430\u0435\u0442\u0441\u044F
        \u044F\u043F\u043E\u043D\u0441\u043A\u0438\u043C \u0442\u0435\u0430\u0442\u0440\u043E\u043C"
      Level: 1
      Type: 0
      Locked: 0
  - Item1: 11
    t1: {fileID: 0}
    Item2: 2
    t2: {fileID: 0}
    Result:
      ID: 12
      Content: "\u041C\u043E\u0436\u0435\u0442... \u0421\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440
        \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u041A\u0438\u0440\u0443
        \u0432\u043E\u0439\u0442\u0438 \u0432 \u0440\u043E\u043B\u044C?"
      Level: 2
      Type: 2
      Locked: 0
  - Item1: 4
    t1: {fileID: 0}
    Item2: 6
    t2: {fileID: 0}
    Result:
      ID: 13
      Content: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043A\u043E\u0435-\u043A\u0442\u043E
        \u0443\u0432\u043B\u0435\u043A\u0430\u0435\u0442\u0441\u044F \u043A\u0438\u0431\u0435\u0440\u043F\u0430\u043D\u043A\u043E\u043C"
      Level: 1
      Type: 0
      Locked: 0
  - Item1: 13
    t1: {fileID: 0}
    Item2: 1
    t2: {fileID: 0}
    Result:
      ID: 14
      Content: "\u041A\u0438\u0440 - \u0442\u043E\u0442, \u043A\u0442\u043E \u0432\u043E\u043F\u043B\u043E\u0449\u0430\u0435\u0442
        \u043A\u0438\u0431\u0435\u0440\u043F\u0430\u043D\u043A \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
      Level: 1
      Type: 0
      Locked: 0
  - Item1: 14
    t1: {fileID: 0}
    Item2: 2
    t2: {fileID: 0}
    Result:
      ID: 14
      Content: "\"\u0421\u043F\u0430\u043C\" \u043D\u0443\u0436\u0435\u043D \u0435\u043C\u0443,
        \u0447\u0442\u043E\u0431\u044B \u0441\u0435\u0442\u044C \u0438 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0431\u044B\u043B\u0438 \u043E\u0434\u043D\u0438\u043C \u0446\u0435\u043B\u044B\u043C"
      Level: 2
      Type: 3
      Locked: 0
