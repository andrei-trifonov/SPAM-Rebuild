--- !u!114 &4897153987696012909
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5696816498727526817}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a9db2d755cd1f84fa0b783e56cc1bcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Thoughts: []
  Results:
  - ID: 13
    Content: "\u042D\u0442\u043E \u0431\u0435\u0437\u0443\u043C\u0438\u0435, \u043D\u043E
      \u043A\u0442\u043E-\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u043C\u043E\u0435 \u0438\u043C\u044F \u0432\u043D\u0443\u0442\u0440\u0438
      \u043A\u0430\u0431\u0438\u043D\u043A\u0438. \u042D\u0442\u043E\u0442 \u0442\u0440\u0443\u043F
      \u0432 \u0441\u043B\u0438\u0432\u0435 \u043A\u0430\u043A-\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D
      \u0441\u043E \u043C\u043D\u043E\u0439. \u041D\u043E \u043A\u0430\u043A? \u0418
      \u043F\u0440\u0438 \u0447\u0435\u043C \u0437\u0434\u0435\u0441\u044C \u044F?"
    Var: 5
    Value: 1
    jumpLabel: 0.2
    isTrueResult: 1
  - ID: 15
    Content: "\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043A\u043E\u0435-\u043A\u0442\u043E
      \u043E\u0431\u043A\u043E\u043B\u043E\u043B\u0441\u044F \u043D\u0430\u0440\u043A\u043E\u0442\u043E\u0439
      \u0438 \u0441\u043C\u044B\u043B \u0441\u0435\u0431\u044F \u0432 \u0443\u043D\u0438\u0442\u0430\u0437.
      \u0414\u0435\u043B\u043E \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u043E!
      \u042F \u0441\u0430\u043C\u044B\u0439 \u043F\u0438\u0437\u0434\u0430\u0442\u044B\u0439
      \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432."
    Var: 5
    Value: 2
    jumpLabel: 0.2
    isTrueResult: 0
  - ID: 14
    Content: "\u041A\u043E\u0448\u043C\u0430\u0440! \u0423 \u043D\u0430\u0441 \u0432
      \u0433\u043E\u0440\u043E\u0434\u0435 \u0437\u0430\u0432\u0435\u043B\u0438\u0441\u044C
      \u043A\u0430\u043D\u0438\u0431\u0430\u043B\u044B! \u041A\u0442\u043E-\u0442\u043E
      \u0441\u044A\u0435\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u0438 \u044D\u0442\u0430 \u0440\u0443\u043A\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u043B\u0430\u0441\u044C!"
    Var: 5
    Value: 3
    jumpLabel: 0.2
    isTrueResult: 0
  Merges:
  - Item1: 3
    t1: {fileID: 0}
    Item2: 6
    t2: {fileID: 0}
    Result:
      ID: 11
      Content: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445
        \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043A\u0440\u043E\u0432\u044C...
        \u041E\u0439!"
      Level: 1
      Type: 1
      Locked: 0
  - Item1: 2
    t1: {fileID: 0}
    Item2: 5
    t2: {fileID: 0}
    Result:
      ID: 12
      Content: "\u041A\u0442\u043E-\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0437\u0434\u043E\u0440\u043E\u0432\u043E
        \u043E\u0442\u0442\u044F\u043D\u0443\u043B\u0441\u044F..."
      Level: 1
      Type: 0
      Locked: 0
  - Item1: 7
    t1: {fileID: 0}
    Item2: 1
    t2: {fileID: 0}
    Result:
      ID: 13
      Content: "\u041A\u0430\u043A \u044D\u0442\u043E... \u0412\u043E\u043E\u0431\u0449\u0435
        \u043C\u043E\u0433\u043B\u043E \u0432\u044B\u0439\u0442\u0438 \u0438\u0437...."
      Level: 2
      Type: 1
      Locked: 0
  - Item1: 11
    t1: {fileID: 0}
    Item2: 1
    t2: {fileID: 0}
    Result:
      ID: 14
      Content: "\u041A\u0430\u043A \u044D\u0442\u043E... \u0412\u043E\u043E\u0431\u0449\u0435
        \u043C\u043E\u0433\u043B\u043E \u0432\u044B\u0439\u0442\u0438"
      Level: 2
      Type: 2
      Locked: 0
  - Item1: 12
    t1: {fileID: 0}
    Item2: 1
    t2: {fileID: 0}
    Result:
      ID: 15
      Content: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E
        \u043C\u043E\u0433 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F
        \u0432 \u0441\u043B\u0438\u0432?"
