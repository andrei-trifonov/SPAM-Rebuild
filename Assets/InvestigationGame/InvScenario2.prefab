--- !u!114 &183935702382111698
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5696816498727526817}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a9db2d755cd1f84fa0b783e56cc1bcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Thoughts: []
  Results:
  - ID: 11
    Content: "\u041A\u0442\u043E-\u0442\u043E \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F
      \u0432 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0442\u0443\u0430\u043B\u0435\u0442
      \u0438 \u043E\u0431\u0434\u0440\u043E\u0447\u0438\u043B \u043A\u0430\u0431\u0438\u043D\u043A\u0443!
      \u042F \u0434\u043E\u043B\u0436\u043D\u0430 \u043E\u0442\u043E\u043C\u0441\u0442\u0438\u0442\u044C."
    Var: 5
    Value: 1
    jumpLabel: 0.2
    isTrueResult: 1
  - ID: 12
    Content: "\u0412 \u0448\u043A\u043E\u043B\u0435 \u0442\u043E\u0447\u043D\u043E
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043A\u0443\u043B\u044C\u0442
      \u0442\u0443\u0430\u043B\u0435\u0442\u043D\u044B\u0445 \u0430\u043D\u0433\u0435\u043B\u043E\u0432
      - \u0438\u043D\u0430\u0447\u0435 \u043D\u0438\u043A\u0430\u043A \u043D\u0435
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u0442\u043E, \u0447\u0442\u043E
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0432 \u0436\u0435\u043D\u0441\u043A\u043E\u043C
      \u0442\u0443\u0430\u043B\u0435\u0442\u0435."
    Var: 5
    Value: 2
    jumpLabel: 0.2
    isTrueResult: 0
  - ID: 14
    Content: "\u041A\u043E\u0448\u043C\u0430\u0440! \u0423 \u043D\u0430\u0441 \u0432
      \u0433\u043E\u0440\u043E\u0434\u0435 \u0437\u0430\u0432\u0435\u043B\u0438\u0441\u044C
      \u043A\u0430\u043D\u0438\u0431\u0430\u043B\u044B! \u041A\u0442\u043E-\u0442\u043E
      \u0441\u044A\u0435\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u0438 \u044D\u0442\u0430 \u0440\u0443\u043A\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u043B\u0430\u0441\u044C!"
    Var: 5
    Value: 3
    jumpLabel: 0.2
    isTrueResult: 0
  Merges:
  - Item1: 6
    t1: {fileID: 0}
    Item2: 7
    t2: {fileID: 0}
    Result:
      ID: 8
      Content: "\u041A\u0442\u043E-\u0442\u043E \u043C\u043E\u0433 \u0437\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u0441\u044E\u0434\u0430 \u0447\u0435\u0440\u0435\u0437 \u043E\u043A\u043D\u043E"
      Level: 1
      Type: 3
      Locked: 0
  - Item1: 1
    t1: {fileID: 0}
    Item2: 5
    t2: {fileID: 0}
    Result:
      ID: 9
      Content: "\u0422\u0440\u0430\u043F\u044B \u043F\u0440\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
        \u0432 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0442\u0443\u0430\u043B\u0435\u0442!"
      Level: 1
