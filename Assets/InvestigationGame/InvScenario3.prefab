      propertyPath: scenarioBlock.Array.data[624]
      value: "    mr \"\u041D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u0439\u0447\u0430\u0441
        - \u0432\u043E\u043E\u0431\u0449\u0435. \u0412\u0441\u044F \u0436\u0438\u0437\u043D\u044C
        - \u0432 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0438.\"\r"
