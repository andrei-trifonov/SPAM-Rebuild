    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[783]
      value: "    mr \"\u0425\u043E\u0442\u044F \u0431\u044B, \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0435
        \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u0427\u0442\u043E-\u0442\u043E
        \u0449\u0438\u043F\u043B\u0435\u0442 \u0440\u0443\u043A\u0443... \u0410\u0445
        \u0434\u0430. \u042F \u0436\u0435 \u0435\u0435 \u043F\u043E\u0440\u0435\u0437\u0430\u043B\u0430
        \u0441\u0442\u0435\u043A\u043B\u043E\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u0443\u0442\u0440\u043E\u043C.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[784]
      value: "    mr \"\u042D\u0442\u0438 \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u0438...
