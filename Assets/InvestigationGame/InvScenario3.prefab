      value: "    mr \"\u041D\u0430 \u043A\u0443\u0445\u043D\u0435 \u043C\u0435\u043D\u044F
        \u0443\u0436\u0435 \u0436\u0434\u0435\u0442 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043C\u044B\u0439
