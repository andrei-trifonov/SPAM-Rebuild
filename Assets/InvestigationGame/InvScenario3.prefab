    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[104]
      value: "    mr \"\u0415\u0449\u0435 \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434
        \u043D\u0435 \u0440\u0435\u0448\u0430\u044E\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0433\u043B\u0430\u0437\u0430. \u0421\u0443\u0434\u044F \u043F\u043E \u0441\u0432\u0435\u0442\u0443,
        \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0449\u0435\u043C\u0443
        \u0441\u043A\u0432\u043E\u0437\u044C \u0432\u0435\u043A\u0438, \u0441\u0435\u0439\u0447\u0430\u0441
        \u0441\u0430\u043C\u044B\u0439 \u0440\u0430\u0437\u0433\u0430\u0440 \u0434\u043D\u044F.
        \u042F \u043F\u0440\u043E\u043B\u0435\u0436\u0430\u043B\u0430 \u043D\u0435
        \u043C\u0435\u043D\u044C\u0448\u0435 \u0432\u043E\u0441\u044C\u043C\u0438
        \u0447\u0430\u0441\u043E\u0432.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[105]
      value: "    mr \"\u042F \u0441 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E,
