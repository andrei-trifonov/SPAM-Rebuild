    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[260]
      value: "    mr \"\u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u043D\u0435 \u0442\u0430\u043A
        \u043E\u0434\u0438\u043D\u043E\u043A\u043E? \u041F\u043E\u0447\u0435\u043C\u0443
        \u043C\u0435\u043D\u044F \u044D\u0442\u043E \u0432\u043E\u043B\u043D\u0443\u0435\u0442?
        \u0413\u0434\u0435 \u043C\u043D\u0435 \u043D\u0430\u0439\u0442\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438\u0437\u0431\u0430\u0432\u0438\u043B
        \u0431\u044B \u043C\u0435\u043D\u044F \u043E\u0442 \u044D\u0442\u043E\u0439
        \u0443\u0436\u0430\u0441\u043D\u043E\u0439 \u0442\u043E\u0441\u043A\u0438?
        \u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u043B\u0430\u0431\u0430\u044F,
        \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u0442\u044C
        \u0435\u0439.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[261]
      value: "    mr \"\u041C\u0438\u0448\u0430, \u044F \u0443\u0431\u0438\u0432\u0430\u044E
        \u0442\u0435\u0431\u044F. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
