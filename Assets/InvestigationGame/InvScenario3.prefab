    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[625]
      value: "    mr \"\u0416\u0430\u043B\u044C \u0442\u043E\u043B\u044C\u043A\u043E,
        \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u043E\u0431\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0441\u043C\u0435\u0440\u0442\u044C\u044E, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
        \u0431\u044B \u0442\u044B \u0436\u0434\u0435\u0448\u044C \u043F\u043E\u0435\u0437\u0434,
        \u043D\u043E \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432
        \u0443\u043F\u0430\u0434\u0435\u0448\u044C \u043D\u0430 \u0440\u0435\u043B\u044C\u0441\u044B,
        \u043E\u0431\u0435\u0441\u0441\u0438\u043B\u0435\u0432, \u0443\u0442\u0440\u0430\u0442\u0438\u0432
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0432\u043E\u0439\u0442\u0438
        \u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u0443\u044E \u0434\u0432\u0435\u0440\u044C.\"\r"
      objectReference: {fileID: 0}
