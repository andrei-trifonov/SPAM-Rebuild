      propertyPath: scenarioBlock.Array.data[459]
      value: "    n \"-\u0411\u044B\u043B\u0430 \u0443 \u043D\u0435\u0435 \u043D\u0435
        \u0442\u0430\u043A \u0434\u0430\u0432\u043D\u043E. \u041B\u0435\u0442\u0430\u0435\u0442
        \u0432 \u043E\u0431\u043B\u0430\u043A\u0430\u0445, \u0434\u0430, \u0432\u043F\u0440\u043E\u0447\u0435\u043C,
        \u0442\u0430\u043A \u0436\u0435 \u043A\u0430\u043A \u0438 \u0442\u044B. \u041A\u0430\u0442\u0430\u0435\u0442
        \u043A\u043E\u043B\u0435\u0441\u0430...\"\r"
