    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[865]
      value: "    mr \"\u042F \u0431\u044B\u043B\u0430 \u0447\u0438\u0441\u0442\u044B\u043C
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
        \u0435\u0449\u0435 \u043C\u043E\u0433\u043B\u043E \u0431\u044B \u0447\u0442\u043E-\u0442\u043E
        \u0432\u044B\u0439\u0442\u0438, \u043C\u043E\u0439 \u043C\u043E\u0437\u0433
        \u043D\u0435 \u0431\u044B\u043B \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D
        \u0433\u043B\u0443\u043F\u044B\u043C\u0438 \u043C\u044B\u0441\u043B\u044F\u043C\u0438.\"\r"
