    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[467]
      value: "    mr \"-\u0427\u0442\u043E-\u0436, \u0434\u0443\u043C\u0430\u044E,
        \u043F\u043E\u0440\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C.
        \u0411\u0443\u0434\u0435\u0442 \u043F\u043B\u043E\u0445\u043E, \u0435\u0441\u043B\u0438
        \u043D\u0430\u0441 \u0437\u0430\u043C\u0435\u0442\u044F\u0442 \u0432 \u0442\u0430\u043A\u043E\u043C
        \u0432\u0438\u0434\u0435. \u041A\u0430\u043A\u0430\u044F \u043F\u0430\u0440\u0430
