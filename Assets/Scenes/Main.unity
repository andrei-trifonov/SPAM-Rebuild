      value: "    mr \"\u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u043D\u0430\u0441
        \u043D\u0435 \u043D\u0430\u0448\u043B\u0438. \u041F\u043E\u0434\u0443\u043C\u0430\u043B\u0438,
        \u0447\u0442\u043E \u044D\u0442\u043E \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u043E\u0440\u044B
        \u043F\u043E\u0434\u043E\u0436\u0433\u043B\u0438 \u043C\u0430\u0448\u0438\u043D\u0443
        \u0441\u0435\u043C\u044C\u0438, \u0447\u0442\u043E \u0436\u0438\u043B\u0430
        \u0432 \u0434\u043E\u043C\u0435 \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432.\"\r"
