    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[592]
      value: "    narrator \"\u0411\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E.
        \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043D\u0435 \u0437\u043D\u0430\u044E,
        \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u043D\u0435 \u0435\u0449\u0435
        \u0437\u0434\u0435\u0441\u044C \u0441\u0438\u0434\u0435\u0442\u044C. \u042F
        \u043D\u0430\u0447\u0430\u043B\u0430 \u0448\u0430\u0440\u0438\u0442\u044C
        \u043F\u043E \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u043C \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
        \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430, \u043D\u043E \u0431\u0435\u0437
        \u0442\u043E\u043B\u043A\u0443 - \u0432\u0441\u0435 \u0432\u0435\u0449\u0438
        \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430\u0432\u0435\u0440\u0445\u0443,
        \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[593]
      value: "    narrator \"\u042F \u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430,
        \u043A\u0430\u043A \u0437\u0430\u0431\u044B\u043B\u0430 \u0438\u0445 \u0442\u0430\u043C.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[594]
      value: "    narrator \"\u0421\u0442\u0430\u043B\u043E \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
        \u0435\u0449\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435. \"\r"
