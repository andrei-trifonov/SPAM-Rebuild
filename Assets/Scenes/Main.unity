      propertyPath: scenarioBlock.Array.data[863]
      value: "    mr \"\u0421\u0435\u0439\u0447\u0430\u0441 \u0437\u0434\u0435\u0441\u044C
        \u043E\u0448\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
        \u043F\u0430\u0440\u0430 \u043D\u0430\u0440\u043A\u043E\u043C\u0430\u043D\u043E\u0432,
        \u0438\u0449\u0443\u0449\u0438\u0445 \u043F\u0440\u0438\u043F\u0440\u044F\u0442\u0430\u043D\u043D\u044B\u0435
        \u0434\u043B\u044F \u043D\u0438\u0445 \u0434\u043E\u0437\u044B. \u042F \u0431\u044B
        \u043C\u043D\u043E\u0433\u043E\u0435 \u043E\u0442\u0434\u0430\u043B\u0430,
        \u0447\u0442\u043E\u0431\u044B \u0441\u043D\u043E\u0432\u0430 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
        \u0432 \u0441\u0432\u043E\u0435\u043C \u0431\u0435\u0437\u0437\u0430\u0431\u043E\u0442\u043D\u043E\u043C,
        \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u043C \u0434\u0435\u0442\u0441\u0442\u0432\u0435,
        \u0433\u0434\u0435 \u0432\u0441\u0435 \u0431\u044B\u043B\u043E \u0442\u0430\u043A
        \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E...\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[864]
      value: "    mr \"\u0410 \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0438
