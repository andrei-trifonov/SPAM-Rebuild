    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[595]
      value: "    narrator \"\u0412\u043E\u043B\u043E\u0441\u044B \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
        \u0432\u0441\u0442\u0430\u043B\u0438 \u0434\u044B\u0431\u043E\u043C. \u042F
        \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0434\u043E\u0448\u043B\u0430
        \u043A \u0441\u0442\u0435\u043D\u0435, \u0437\u0430\u0433\u043E\u0440\u043E\u0434\u0438\u0432\u0448\u0435\u0439
