      propertyPath: scenarioBlock.Array.data[856]
      value: "    mr \"\u042F \u0436\u0438\u0432\u0443 \u043D\u0430 \u043A\u0440\u0430\u044E
        \u0433\u043E\u0440\u043E\u0434\u0430. \u041E\u0442\u0441\u044E\u0434\u0430
        \u0434\u043E \u0446\u0435\u043D\u0442\u0440\u0430 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
        \u0434\u0430\u043B\u0435\u043A\u043E \u0438\u0434\u0442\u0438 \u043F\u0435\u0448\u043A\u043E\u043C,
        \u0430 \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u044B \u0443\u0436\u0435
        \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0445\u043E\u0434\u044F\u0442.
        \u0411\u043B\u0438\u0436\u0435 \u0432\u0441\u0435\u0433\u043E \u043D\u0430
        \u0412\u0435\u0441\u0435\u043D\u043D\u044E\u044E \u0438\u0434\u0442\u0438
        \u0447\u0435\u0440\u0435\u0437 \u0446\u0435\u043B\u044B\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B
        \u0440\u0436\u0430\u0432\u044B\u0445 \u043F\u043E\u043A\u043E\u0441\u0438\u0432\u0448\u0438\u0445\u0441\u044F
        \u0433\u0430\u0440\u0430\u0436\u0435\u0439.\"\r"
