      propertyPath: scenarioBlock.Array.data[695]
      value: "    mr \"\u0418\u0437 \u0435\u0433\u043E \u043F\u0440\u043E\u043B\u043E\u043C\u043B\u0435\u043D\u043D\u043E\u0439
