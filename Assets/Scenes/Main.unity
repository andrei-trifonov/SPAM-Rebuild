        \u043F\u0440\u0438\u0447\u0435\u0441\u0430\u043B\u0430 \u0432\u043E\u043B\u043E\u0441\u044B.
        \u041F\u0440\u0430\u0432\u0434\u0430, \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043B\u043E\u043A\u043E\u043D\u044B \u0442\u0430\u043A \u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
        \u0441\u0442\u043E\u044F\u0442\u044C \u0434\u044B\u0431\u043E\u043C, \u0438
        \u0441 \u043D\u0438\u043C\u0438 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F
