    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[603]
      value: "    mr \"\u0427\u0435\u043C \u0431\u044B \u0437\u0430\u043D\u044F\u0442\u044C
        \u0441\u0435\u0431\u044F? \u0412\u043E\u0442 \u0431\u044B \u0441\u0435\u0439\u0447\u0430\u0441
        \u0437\u0430\u0441\u043D\u0443\u0442\u044C, \u0438 \u043F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F,
        \u043A\u043E\u0433\u0434\u0430 \u043C\u0435\u043D\u044F \u0443\u0436\u0435
        \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0439\u0434\u0443\u0442...\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[604]
      value: "    mr \"\u041D\u043E \u043A\u0430\u043A \u0436\u0435 \u043D\u0435\u0443\u0434\u043E\u0431\u043D\u043E
        \u0437\u0434\u0435\u0441\u044C \u0441\u0438\u0434\u0435\u0442\u044C. \u0414\u0430\u0436\u0435
        \u043F\u043E\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u043E\u0434
        \u0433\u043E\u043B\u043E\u0432\u0443 \u043D\u0435\u0447\u0435\u0433\u043E.
        \u0418 \u0435\u0441\u043B\u0438 \u0431\u0443\u0434\u0443 \u0434\u043E\u043B\u0433\u043E
        \u0442\u0430\u043A \u0441\u0438\u0434\u0435\u0442\u044C, \u0442\u043E \u0442\u043E\u0447\u043D\u043E
        \u0437\u0430\u0431\u043E\u043B\u0435\u044E...\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[605]
      value: "    mr \"\u041A\u0442\u043E \u0431\u044B\u043B \u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
        \u043D\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435? \u041F\u043E\u0447\u0435\u043C\u0443
        \u043E\u043D \u043C\u0435\u043D\u044F \u0437\u0430\u043F\u0435\u0440? \u0418
        \u0434\u043B\u044F \u0447\u0435\u0433\u043E?\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[606]
      value: "    mr \"\u041C\u043E\u0436\u0435\u0442, \u043A\u0442\u043E-\u0442\u043E
        \u0438\u0437 \u0433\u0440\u0443\u043F\u043F\u044B? \u041D\u043E \u0437\u0430\u0447\u0435\u043C
        \u0438\u043C \u044D\u0442\u043E, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
        \u043A\u0442\u043E-\u0442\u043E \u043C\u043E\u0433 \u0431\u044B \u0442\u0430\u043A
        \u0438\u0437\u0434\u0435\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430\u0434\u043E
        \u043C\u043D\u043E\u0439, \u043D\u043E \u0442\u043E\u0433\u0434\u0430 \u0431\u044B
        \u043E\u043D\u0438 \u043F\u0440\u0438\u0448\u043B\u0438 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[607]
      value: "    mr \"\u0421\u0442\u043E\u0440\u043E\u0436? \u041E\u043D \u0431\u044B
        \u0443\u0441\u043B\u044B\u0448\u0430\u043B \u043C\u043E\u0439 \u043A\u0440\u0438\u043A
        \u0438 \u043E\u0442\u043A\u0440\u044B\u043B \u0434\u0432\u0435\u0440\u044C.
        \u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u043E\u0447\u043D\u043E \u043D\u0435
        \u043E\u043D. \u041A\u0430\u043A \u0436\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[608]
      value: "    mr \"\u042F \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u043B\u0430
        \u043A\u043E\u043D\u0447\u0438\u043A \u043D\u043E\u0441\u0430. \u041E\u0447\u0435\u043D\u044C
        \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439... \u0418, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u043A\u0440\u0430\u0441\u043D\u044B\u0439.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[609]
      value: "    mr \"\u0425\u043E\u0447\u0435\u0442\u0441\u044F \u0434\u043E\u043C\u043E\u0439,
        \u0432 \u043C\u044F\u0433\u043A\u0443\u044E \u043A\u0440\u043E\u0432\u0430\u0442\u044C,
        \u0432 \u0433\u0440\u044F\u0437\u043D\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443,
        \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u0435\u0440\u0438\u0430\u043B\u044B
        \u0434\u043D\u0438 \u043D\u0430\u043F\u0440\u043E\u043B\u0435\u0442, \u0443\u043C\u0438\u0440\u0430\u0442\u044C
        \u043E\u0442 \u0431\u043E\u043B\u0438 \u0432 \u0443\u0441\u0442\u0430\u043B\u044B\u0445
        \u0433\u043B\u0430\u0437\u0430\u0445, \u043C\u0443\u0447\u0438\u0442\u044C\u0441\u044F
        \u043E\u0442 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
        \u043C\u0438\u0433\u0440\u0435\u043D\u0438.\"\r"
      objectReference: {fileID: 0}
