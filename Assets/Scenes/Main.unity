    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[591]
      value: "    narrator \"{font=Hard.ttf}-\u0412\u044B\u043F\u0443\u0441\u0442\u0438
        \u043C\u0435\u043D\u044F! \u0416\u0438\u0432\u043E \u0432\u044B\u043F\u0443\u0441\u0442\u0438!{/font}\"\r"
