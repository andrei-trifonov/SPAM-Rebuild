        \u0441\u0442\u0430\u0442\u044C \u0443\u043C\u043D\u0435\u0435, \u043F\u0440\u043E\u0441\u0442\u043E
        \u0435\u0441\u043B\u0438 \u044F \u043F\u0440\u043E\u043F\u0443\u0449\u0443
        \u0435\u0449\u0435 \u043D\u0435\u0434\u0435\u043B\u044E, \u043C\u0435\u043D\u044F,
        \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u043E\u0442\u0447\u0438\u0441\u043B\u044F\u0442.\"\r"
