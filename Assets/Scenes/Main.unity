      propertyPath: scenarioBlock.Array.data[590]
      value: "    narrator \"\u0428\u0430\u0433\u0438 \u0443\u0436\u0435 \u0441\u043B\u044B\u0448\u0430\u043B\u0438\u0441\u044C
