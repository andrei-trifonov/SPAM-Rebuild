    - type: 0
      name: 2
      line: "\u041D\u043E \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441,
        \u0441\u043A\u0432\u043E\u0437\u044C \u043E\u0431\u0448\u0438\u0432\u043A\u0443
        \u0434\u0432\u0435\u0440\u0438, \u0432 \u043D\u0435\u0435 \u043F\u0440\u043E\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0441\u043A\u0440\u0435\u0436\u0435\u0442, \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439
        \u0441\u0442\u0443\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0441\u0435
        \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442 \u0438 \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442,
        \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u044D\u0442\u043E \u043D\u0430\u0440\u044F\u0434
        \u043C\u0438\u043B\u0438\u0446\u0438\u0438 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
        \u043F\u0440\u043E\u043F\u0438\u043B\u0438\u0442\u044C \u0434\u0432\u0435\u0440\u044C
        \u0432 \u043C\u043E\u044E \u0443\u044E\u0442\u043D\u0443\u044E \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0443,
        \u0440\u0430\u0441\u043A\u0438\u0434\u0430\u0442\u044C \u043F\u043E \u043A\u043E\u043C\u043D\u0430\u0442\u0435
        \u0432\u0441\u0435 \u043C\u043E\u0438 \u0432\u0435\u0449\u0438, \u0432\u0441\u0435
        \u0441\u043B\u043E\u043C\u0430\u0442\u044C \u0438 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u0442\u044C."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
