        \u0440\u0438\u0442\u043C\u044B \u043C\u0443\u0437\u044B\u043A\u0438. \u0410\u043B\u0438\u043D\u0430
        \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u0443
        \u043C\u043D\u0435 \u043D\u0430 \u043F\u043B\u0435\u0447\u043E \u0438 \u043F\u0440\u0438\u0436\u0430\u043B\u0430\u0441\u044C
        \u043A\u043E \u043C\u043D\u0435 \u0432\u0441\u0435\u043C \u0441\u0432\u043E\u0438\u043C 
        \u0442\u0435\u043B\u043E\u043C.\r\n"
