    - type: 0
      name: 0
      line: "void RealizeFate(meat_machine* machine) {\n    //comment: but even in
        this solitary oasis she realizes the inevitable fate - forever locked in
        the web of her algorithms, a prisoner of her thoughts\n    logical_denial
        = true;\n    logical_anger = true;\n    logical_bargain = true;"
      font: 4
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
