    - type: 0
      name: 2
      line: "\u0422\u0430\u043C \u0431\u044B\u043B\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E
        \u043B\u044E\u0434\u0435\u0439... \u0410 \u0435\u0441\u043B\u0438 \u043E\u043D\u0438
        \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443\u0442 \u043E\u0431\u043E
        \u043C\u043D\u0435? \u042D\u0442\u043E \u0430\u0431\u0437\u0430\u0446! "
