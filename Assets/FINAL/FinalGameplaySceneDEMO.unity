      name: 2
      line: "\u0421\u043E\u043D\u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
        \u043A\u043E \u043C\u043D\u0435 \u0438 \u0441\u043C\u0435\u0448\u043D\u043E
