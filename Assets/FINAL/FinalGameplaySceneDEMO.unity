      line: "\u041C\u044B \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u043B\u0438,
        \u043F\u043E\u043A\u0430 \u0432\u0441\u0435 \u0437\u0430 \u0434\u0432\u0435\u0440\u044C\u044E
        \u0442\u0443\u0430\u043B\u0435\u0442\u0430 \u0437\u0430\u0439\u0434\u0443\u0442
