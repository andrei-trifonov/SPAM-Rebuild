    - type: 0
      name: 2
      line: "\u0414\u0435\u0432\u043E\u0447\u043A\u0430 \u0438\u0437 \u0442\u043E\u043B\u043F\u044B
        \u0443\u043A\u0430\u0437\u0430\u043B\u0430 \u043D\u0430 \u043B\u0443\u0436\u0438\u0446\u0443
        \u0433\u043D\u043E\u044F, \u0440\u0430\u0441\u0442\u0435\u043A\u0448\u0438\u0432\u0448\u0443\u044E\u0441\u044F
        \u043F\u043E \u0441\u0442\u043E\u043B\u0443, \u0441\u0442\u0435\u043A\u0430\u044E\u0449\u0443\u044E
        \u043F\u043E \u043D\u043E\u0436\u043A\u0435 \u0441\u0442\u043E\u043B\u0430
        , \u043A\u0430\u043F\u0430\u044E\u0449\u0443\u044E \u0441 \u043A\u0440\u0430\u0435\u0432
        \u043D\u0430 \u043B\u0438\u043D\u043E\u043B\u0435\u0443\u043C."
