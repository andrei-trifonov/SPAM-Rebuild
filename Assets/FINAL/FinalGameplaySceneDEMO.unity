    - type: 0
      name: 0
      line: "// thoughts are the echo of howling blood;\n- reflected off the walls
        of virtuality().\nvoid ThoughtsEcho(meat_machine* machine) {\n    //comment:
        her thoughts reflect in virtuality\n    if(Msne(2, gcode, h_LOCKALKEY, 0,
        FALSE))\n        display(\"system OK\");\n}"
      font: 4
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
