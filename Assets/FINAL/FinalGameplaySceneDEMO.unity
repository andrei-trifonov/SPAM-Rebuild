    - type: 0
      name: 2
      line: "\u0410\u0445, \u0421\u043E\u043D\u044F, \u043A\u0430\u043A \u044F \u0442\u0435\u0431\u044F
        \u043F\u043E\u043D\u0438\u043C\u0430\u044E. \u042F \u0442\u043E\u0436\u0435
        \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0443 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
