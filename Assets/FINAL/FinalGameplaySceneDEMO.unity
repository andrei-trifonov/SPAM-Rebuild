    - type: 0
      name: 2
      line: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0433\u0434\u0435-\u0442\u043E
        \u0435\u0441\u0442\u044C \u0435\u0449\u0435 \u0432\u044B\u0445\u043E\u0434?
        \u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430 \u043D\u0430\u0432\u0435\u0440\u0445,
        \u0433\u0434\u0435 \u043A\u0440\u0430\u0441\u043E\u0432\u0430\u043B\u0430\u0441\u044C
        \u0434\u044B\u0440\u0430 \u0432 \u043F\u043E\u0442\u043E\u043B\u043A\u0435, 
        \u0441\u044B\u043F\u0430\u043B\u0441\u044F \u043F\u0435\u0441\u043E\u043A
        \u0438 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u043A\u0443\u0441\u043E\u0447\u043A\u0438
        \u043F\u043E\u0431\u0435\u043B\u043A\u0438."
