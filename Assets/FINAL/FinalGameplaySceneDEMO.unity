    - type: 0
      name: 2
      line: "\u0421 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0435\u043A\u0443\u043D\u0434\u043E\u0439
        \u043D\u0430\u0434\u0435\u0436\u0434\u0430, \u0447\u0442\u043E \u043C\u044B
        \u043E\u0442\u044B\u0449\u0435\u043C \u0437\u0434\u0435\u0441\u044C \u0421\u043E\u043D\u044E,
        \u0443\u0433\u0430\u0441\u0430\u043B\u0430. \u041C\u044B \u043E\u0431\u043E\u0433\u043D\u0443\u043B\u0438
        \u043F\u043E \u043A\u0440\u0443\u0433\u0443 \u0431\u0443\u0434\u0443\u0449\u0435\u0435
        \u043A\u043E\u0441\u0442\u0440\u0438\u0449\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
        \u0443\u0436\u0435 \u043F\u043E\u043B\u0438\u0432\u0430\u043B\u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
        \u0441\u043C\u0435\u0441\u044C\u044E. "
