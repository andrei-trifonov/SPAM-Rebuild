    - type: 0
      name: 13
      line: "-\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0443
        \u0442\u0435\u0431\u044F \u0432 \u0433\u043E\u043B\u043E\u0432\u0435. \u0421\u0435\u0439\u0447\u0430\u0441
        \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F
        - \u0442\u043E, \u0447\u0442\u043E \u0442\u044B \u043F\u043E\u043C\u043E\u0433\u043B\u0430
        \u0435\u0439 \u0443\u043F\u0430\u0441\u0442\u044C \u0432 \u043E\u0433\u043E\u043D\u044C."
