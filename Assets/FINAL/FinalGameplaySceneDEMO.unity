    - type: 0
      name: 2
      line: "\u041A\u043E\u043B\u0435\u0441\u043E \u0432\u0440\u0430\u0449\u0430\u043B\u043E\u0441\u044C
        \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E - \u043D\u0443\u0436\u043D\u043E
        \u0431\u044B\u043B\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u0434\u0430\u0442\u044C
        \u043F\u0430\u0440\u0443 \u043C\u043E\u043D\u0435\u0442 \u0431\u0438\u043B\u0435\u0442\u0435\u0440\u0443
        \u0438 \u0437\u0430\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C \u0432
        \u043A\u0430\u0431\u0438\u043D\u043A\u0443. \u041F\u043B\u0430\u0442\u0438\u0442\u044C
        \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C, \u043D\u043E
        \u043A\u043E\u043B\u0435\u0441\u043E \u0435\u0445\u0430\u043B\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
        \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
        \u0443\u0434\u0440\u0430\u0442\u044C \u0432 \u043E\u0431\u043B\u0430\u043A\u0430
        \u043D\u0430 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439 \u043A\u0430\u0431\u0438\u043D\u043A\u0435.\r\n"
