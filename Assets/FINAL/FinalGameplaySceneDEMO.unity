    - type: 0
      name: 5
      line: "-\u041E\u0431\u043E \u0432\u0441\u0435\u043C. \u042D\u0442\u043E \u0434\u0430\u0436\u0435
        \u0433\u0440\u0443\u0441\u0442\u043D\u043E, \u0441 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
        \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u043D\u043E... \u0417\u0430\u0442\u043E,
        \u043C\u043E\u0436\u043D\u043E \u043D\u0438 \u043E \u0447\u0435\u043C \u043D\u0435
        \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0442\u044C. \u0423 \u043B\u044E\u0431\u043E\u0439
        \u0447\u0435\u0440\u0435\u0434\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
        \u0431\u0443\u0434\u0435\u0442 \u043A\u0430\u043A\u043E\u0439-\u043D\u0438\u0431\u0443\u0434\u044C,
        \u043D\u043E \u0444\u0438\u043D\u0430\u043B. \u041C\u043E\u0436\u0435\u0442,
        \u0442\u0435\u0431\u0435 \u043E\u043D \u0438 \u043D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C
        \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u043D\u043E,
        \u043A\u0430\u043A \u0431\u044B \u0442\u043E \u043D\u0438 \u0431\u044B\u043B\u043E,
        \u0432\u0441\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F.\r\n"
