    - type: 0
      name: 2
      line: "\u041A\u0430\u043A\u0443\u044E-\u0442\u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u0443\u044E
        \u0441\u0432\u044F\u0437\u044C \u043C\u0435\u0436\u0434\u0443 \u043C\u043D\u043E\u0439
        \u0438 \u0432\u0441\u0435\u043C\u0438 \u0432\u043E\u043A\u0440\u0443\u0433.
        \u041D\u0435 \u0447\u0442\u043E-\u0442\u043E \u043E\u0431\u044B\u0434\u0435\u043D\u043D\u043E\u0435,
        \u0432\u0440\u043E\u0434\u0435 \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u0438\u0445
        \u0447\u0443\u0432\u0441\u0442\u0432, \u0430 \u0447\u0442\u043E-\u0442\u043E
        \u043C\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435, \u0447\u0442\u043E
        \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C.
        \u0421\u0435\u0439\u0447\u0430\u0441 \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E
        \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0443\u0433\u0430\u0441\u0430\u0435\u0442.\_"
