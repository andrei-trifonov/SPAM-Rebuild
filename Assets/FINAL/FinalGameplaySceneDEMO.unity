    - type: 0
      name: 4
      line: "-\u0423 \u043C\u0435\u043D\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435
        \u0432\u0435\u0449\u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
        \u0434\u043E\u043C\u0430. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044D\u0442\u043E
        \u0431\u044B\u043B \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
