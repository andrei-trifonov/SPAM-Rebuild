    - type: 0
      name: 2
      line: "\u041B\u0443\u0447\u0448\u0435 \u0435\u043C\u0443 \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C,
        \u0447\u0435\u043C \u0443\u0437\u043D\u0430\u0432\u0430\u0442\u044C \u0432\u0441\u0435
        \u0441\u0430\u043C\u043E\u0439. \u041C\u044B \u043C\u043E\u043B\u0447\u0430
        \u0434\u043E\u0448\u043B\u0438 \u0434\u043E \u043C\u043E\u0435\u0433\u043E
        \u0434\u043E\u043C\u0430, \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0443\u043C\u0430\u043B
        \u043E \u0447\u0435\u043C-\u0442\u043E \u0441\u0432\u043E\u0435\u043C. \u0421\u043E\u043D\u044F
        \u0440\u0435\u0448\u0438\u043B\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C
        \u0441\u043D\u0430\u0440\u0443\u0436\u0438, \u043F\u043E\u043A\u0430 \u044F
        \u043D\u0430\u0431\u0438\u0440\u0430\u044E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435
        \u041A\u0438\u0440\u0443.\r\n"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
