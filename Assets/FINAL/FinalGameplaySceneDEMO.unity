    - type: 0
      name: 2
      line: "\u041E\u043D\u0430 \u0432\u043B\u0438\u043B\u0430\u0441\u044C \u0432
        \u0433\u0440\u0443\u043F\u043F\u0443 \u043E\u0442\u043F\u043B\u044F\u0441\u044B\u0432\u0430\u044E\u0449\u0438\u0445
        \u0434\u0435\u0432\u043E\u0447\u0435\u043A \u0432 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0445
        \u043F\u043B\u0430\u0442\u044C\u044F\u0445, \u0431\u043E\u043B\u044C\u0448\u0435
        \u043F\u043E\u0445\u043E\u0436\u0438\u0445 \u043D\u0430 \u0440\u0432\u0430\u043D\u043E\u0435
        \u0442\u0440\u044F\u043F\u044C\u0435, \u0438 \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
        \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E
        \u043E\u0442 \u043D\u0438\u0445 \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0430\u0441\u044C,
        \u0431\u0443\u0434\u0442\u043E \u0431\u044B\u043B\u0430 \u043E\u0434\u043D\u043E\u0439
        \u0438\u0437 \u044D\u0442\u0438\u0445 \u0442\u0430\u043D\u0446\u043E\u0432\u0449\u0438\u0446."
