    - type: 0
      name: 2
      line: "\u041F\u0440\u0430\u0432\u0434\u0430, \u0437\u0430\u0433\u0430\u0440
        \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
        \u0431\u043B\u0435\u0434\u043D\u044B\u0439, \u0435\u0434\u0432\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C\u044B\u0439
        - \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E, \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
        \u0441\u0438\u0434\u0435\u0442\u044C \u043D\u0430 \u043F\u0435\u0441\u043A\u0435
        \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u043A\u0430\u043A
        \u043F\u043B\u0435\u0449\u0435\u0442\u0441\u044F \u0432\u043E\u0434\u0430
        \u0438 \u043A\u0440\u0438\u0447\u0430\u0442 \u0447\u0430\u0439\u043A\u0438. "
