    - type: 0
      name: 2
      line: "\u0411\u0435\u0442\u043E\u043D\u043D\u044B\u0439 \u0433\u0438\u0433\u0430\u043D\u0442,
        \u0441\u043F\u044F\u0449\u0438\u0439 \u0432\u0435\u0447\u043D\u044B\u043C
        \u0441\u043D\u043E\u043C. \u0422\u044B \u043E\u0449\u0443\u0449\u0430\u0435\u0448\u044C
        \u0435\u0433\u043E \u0434\u044B\u0445\u0430\u043D\u0438\u0435, \u043A\u0430\u043A
        \u043F\u0443\u043B\u044C\u0441\u0430\u0446\u0438\u044E \u0437\u0435\u043C\u043B\u0438
        \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438, \u043A\u0430\u043A
        \u0440\u043E\u043A\u043E\u0442 \u043C\u0430\u0448\u0438\u043D, \u043F\u0440\u043E\u043D\u043E\u0441\u044F\u0449\u0438\u0445\u0441\u044F
        \u043F\u043E \u0435\u0433\u043E \u0430\u0440\u0442\u0435\u0440\u0438\u044F\u043C."
