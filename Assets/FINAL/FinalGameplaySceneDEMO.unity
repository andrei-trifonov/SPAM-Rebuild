    - type: 0
      name: 2
      line: "\u042F \u0441\u0445\u043E\u0436\u0443 \u0441 \u0443\u043C\u0430. \u042F
        \u0442\u043E\u0447\u043D\u043E \u0441\u0445\u043E\u0436\u0443 \u0441 \u0443\u043C\u0430.
        \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043D\u0435\u0434\u0435\u043B\u044F
        \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0447\u0435\u0440\u0435\u0434\u0430
        \u0431\u0435\u0437\u0443\u043C\u0438\u044F. \u042F \u043F\u0440\u043E\u0441\u0442\u043E
        \u0445\u043E\u0447\u0443 \u0432\u0441\u0435 \u0437\u0430\u0431\u044B\u0442\u044C.
        \u0417\u0430\u0431\u044B\u0442\u044C \u0437\u0430\u043F\u0430\u0445 \u0433\u043D\u0438\u044E\u0449\u0435\u0433\u043E
        \u0442\u0440\u0443\u043F\u0430, \u044D\u0442\u043E\u0433\u043E \u043C\u0435\u0440\u0437\u043A\u043E\u0433\u043E
        \u043A\u043E\u0442\u0430 \u0438 \u0431\u044B\u0442\u044C \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439.
        \u0421 \u043C\u0435\u043D\u044F \u0445\u0432\u0430\u0442\u0438\u0442.\r\n"
