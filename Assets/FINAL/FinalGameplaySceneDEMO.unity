    - type: 0
      name: 2
      line: "\u042F \u0432\u0437\u044F\u043B\u0430 \u0440\u0436\u0430\u0432\u044B\u0439
        \u043C\u044F\u0441\u043D\u0438\u0446\u043A\u0438\u0439 \u043D\u043E\u0436,
        \u0437\u0430\u043D\u0435\u0441\u043B\u0430 \u0440\u0443\u043A\u0443, \u0438
        \u0441\u043E \u0432\u0441\u0435\u0439 \u0441\u0438\u043B\u044B \u0440\u0443\u0431\u0430\u043D\u0443\u043B\u0430
        \u043F\u043E \u043B\u0435\u0436\u0430\u0449\u0435\u043C\u0443 \u043D\u0430
        \u0441\u0442\u043E\u043B\u0435 \u043F\u0430\u043B\u044C\u0446\u0443. \u041C\u044F\u0441\u043D\u043E\u0439
        \u043A\u0443\u0441\u043E\u0447\u0435\u043A \u0444\u0430\u043B\u0430\u043D\u0433\u0438
        \u043E\u0442\u043B\u0435\u0442\u0435\u043B \u043A\u0443\u0434\u0430-\u0442\u043E
        \u043F\u043E\u0434 \u0441\u0442\u043E\u043B, \u0430 \u0438\u0437 \u043F\u0430\u043B\u044C\u0446\u0430
        \u043D\u0430\u0447\u0430\u043B\u0430 \u0445\u043B\u0435\u0441\u0442\u0430\u0442\u044C
        \u043A\u0440\u043E\u0432\u044C."
