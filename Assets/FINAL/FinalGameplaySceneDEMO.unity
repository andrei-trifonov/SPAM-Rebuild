    - type: 0
      name: 2
      line: "\u041A\u043B\u0438\u043A - \u0438 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442.
        \u0412\u043E\u043A\u0440\u0443\u0433 \u0442\u0435\u043C\u043D\u043E\u0442\u0430,
        \u043A\u0443\u0434\u0430 \u043D\u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438,
        \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u044B \u044F \u043D\u0438
        \u043E\u0437\u0438\u0440\u0430\u043B\u0430\u0441\u044C \u0432\u043E\u043A\u0440\u0443\u0433.\r\n"
