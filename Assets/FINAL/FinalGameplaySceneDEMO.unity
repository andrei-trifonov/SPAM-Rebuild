      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 5
      line: -Your friends stay the way they are. Or rather, the way they wanted you
        to see them.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
