    - type: 0
      name: 2
      line: "\u0421\u043A\u0432\u043E\u0437\u044C \u0441\u043E\u043D\u043D\u0443\u044E
        \u043F\u0435\u043B\u0435\u043D\u0443 \u043F\u043E\u0441\u043B\u044B\u0448\u0430\u043B\u043E\u0441\u044C
        \u0445\u0440\u0438\u043F\u044F\u0449\u0435\u0435 \"\u042D\u0448\u0430\u0444\u043E\u0442\".
        \u0412\u043E\u0442 \u0431\u043B\u0438\u043D, \u0447\u0443\u0442\u044C \u043D\u0435
        \u043F\u0440\u043E\u0435\u0445\u0430\u043B\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443.\n"
