      name: 2
      line: " \u0421\u043F\u0443\u0441\u0442\u044F \u043F\u0430\u0440\u0443 \u043C\u0438\u043D\u0443\u0442
        \u043C\u0443\u0437\u044B\u043A\u0430 \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
        \u0441\u043C\u0435\u043D\u0438\u043B\u0430 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435,
