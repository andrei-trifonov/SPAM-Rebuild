      line: "void \u041A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F\u0421\u0435\u0440\u0434\u0446\u0430(\u043C\u044F\u0441\u043E-\u043C\u0430\u0448\u0438\u043D\u0430*
        \u043C\u0430\u0448\u0438\u043D\u0430) {\n\_\_\_ \u0448\u0430\u0433\u0438++;
        \n\_\_\_ \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C(\u0448\u0430\u0433\u0438%2
        == 0? \"\u0442\u0443\u043A\" : \"\u0442\u0430\u043A\");\n\_\_\_ \u0435\u0441\u043B\u0438
        (!\u043C\u0430\u0448\u0438\u043D\u0430->\u0441\u0435\u0440\u0434\u0446\u0435.\u0448\u0430\u0433()){\n\_\_\_\_\_\_\_
        ~\u043C\u044F\u0441\u043E-\u043C\u0430\u0448\u0438\u043D\u0430();\n\_\_\_
        }\n} "
