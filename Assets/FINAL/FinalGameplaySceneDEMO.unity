    - type: 0
      name: 2
      line: "\u0423 \u043A\u043E\u0433\u043E-\u0442\u043E \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435
        \u043D\u0430\u0448\u043B\u0430\u0441\u044C \u0437\u0430\u0436\u0438\u0433\u0430\u043B\u043A\u0430,
        \u0438 \u044F \u043F\u043E\u043E\u0447\u0435\u0440\u0435\u0434\u0438, \u043F\u044B\u0442\u0430\u044F\u0441\u044C
        \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0441 \u0442\u0443\u0433\u0438\u043C
