    - type: 0
      name: 2
      line: "\u0420\u0430\u0437\u043D\u043E\u0446\u0432\u0435\u0442\u043D\u044B\u0435
        \u0433\u0430\u0440\u0430\u0436\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u043B\u0438\u0441\u044C
        \u0438\u0437 \u043D\u0430\u0432\u0438\u0441\u0448\u0435\u0433\u043E \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0433\u043E
        \u0442\u0443\u043C\u0430\u043D\u0430 \u0441\u043B\u0435\u0432\u0430 \u0438
        \u0441\u043F\u0440\u0430\u0432\u0430, \u0438 \u043D\u0430\u043A\u043E\u043D\u0435\u0446,
        \u043C\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
        \u043F\u0435\u0440\u0435\u0434 \u043E\u0434\u043D\u0438\u043C \u0438\u0437
        \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u043E\u0432."
