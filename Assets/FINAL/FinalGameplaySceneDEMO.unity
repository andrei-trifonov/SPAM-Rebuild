    - type: 0
      name: 2
      line: "\u0422\u0430\u043A\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E,
        \u0431\u0443\u0434\u0442\u043E \u0433\u043E\u0440\u043E\u0434 \u0437\u0430\u0441\u0442\u044B\u043B
        \u0432 \u043E\u0434\u043D\u043E\u043C \u043C\u043E\u043C\u0435\u043D\u0442\u0435,
        \u0438 \u0441\u043C\u0430\u043A\u0443\u0435\u0442 \u0435\u0433\u043E, \u0440\u0430\u0441\u043F\u0440\u043E\u0431\u0443\u0435\u0442
        \u043F\u043E \u043A\u0440\u0443\u043F\u0438\u0446\u0430\u043C \u044D\u0442\u0443
        \u0445\u0442\u043E\u043D\u044C \u0438 \u043F\u0435\u0447\u0430\u043B\u044C
        \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0438 \u043E\u0434\u0438\u043D\u043E\u043A\u043E\u0439
        \u043D\u043E\u0447\u0438.\r"
