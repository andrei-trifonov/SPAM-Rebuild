    - type: 0
      name: 2
      line: "\u042F \u043F\u043E\u0434\u043F\u043E\u043B\u0437\u043B\u0430 \u0438
        \u0443\u0442\u043A\u043D\u0443\u043B\u0430\u0441\u044C \u0432 \u0433\u0440\u0443\u0434\u044C
        \u043F\u043E\u043A\u0440\u0430\u0441\u043D\u0435\u0432\u0448\u0435\u0439
        \u0421\u043E\u043D\u0435 \u0438 \u0433\u0440\u043E\u043C\u043A\u043E \u0437\u0430\u0440\u044B\u0434\u0430\u043B\u0430,
        \u0442\u043E \u0438 \u0434\u0435\u043B\u043E \u0432\u0441\u0445\u043B\u0438\u043F\u044B\u0432\u0430\u044F. "
