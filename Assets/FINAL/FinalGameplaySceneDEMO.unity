    - type: 0
      name: 2
      line: "\u042F \u0441\u0442\u043E\u044E \u0438 \u0441\u043C\u043E\u0442\u0440\u044E,
        \u043A\u0430\u043A \u043D\u0430 \u043C\u0435\u0442\u0430\u044E\u0449\u0435\u043C\u0441\u044F
        \u0432 \u043E\u0433\u043D\u0435 \u0441\u0438\u043B\u0443\u044D\u0442\u0435
        \u043F\u043B\u0430\u0432\u0438\u0442\u0441\u044F \u043E\u0434\u0435\u0436\u0434\u0430,
        \u043F\u0440\u0438\u043B\u0438\u043F\u0430\u044F \u043A \u0442\u0430\u043A\u043E\u0439
        \u0436\u0435 \u0440\u0430\u0441\u043F\u043B\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0439
        \u043A\u043E\u0436\u0435, \u043A\u0430\u043A \u0421\u043E\u043D\u044F \u043F\u0430\u0434\u0430\u0435\u0442,
        \u0438 \u0441\u043D\u043E\u0432\u0430 \u0432\u0441\u0442\u0430\u0435\u0442,
        \u0430 \u0435\u0435 \u0442\u0435\u043B\u043E \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u0435\u0442
        \u0432\u0441\u0435 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u0440\u043D\u044B\u0439,
        \u0447\u0443\u043C\u0430\u0437\u044B\u0439 \u0446\u0432\u0435\u0442, \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F\u0441\u044C
        \u0432 \u043E\u0431\u0443\u0433\u043B\u0435\u043D\u043D\u044B\u0439 \u0442\u0440\u0443\u043F.\n"
