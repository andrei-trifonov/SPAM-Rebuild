    - type: 0
      name: 2
      line: "\u041E\u043D \u043D\u0435 \u0436\u0435\u043B\u0430\u0435\u0442 \u0442\u0435\u0431\u0435
        \u0437\u043B\u0430, \u0445\u043E\u0442\u044F \u043C\u043E\u0436\u0435\u0442
        \u0438 \u0443\u0431\u0438\u0442\u044C, \u0435\u0441\u043B\u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F.
        \u0413\u043E\u0440\u043E\u0434 - \u044D\u0442\u043E \u0433\u0440\u043E\u043C\u0430\u0434\u043D\u044B\u0439,
        \u043C\u043E\u0433\u0443\u0447\u0438\u0439 \u0437\u0432\u0435\u0440\u044C,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043B\u044E\u0431\u0438\u0442
        \u0442\u0435\u0431\u044F, \u0441\u0432\u043E\u0435\u0433\u043E \u043D\u0435\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E\u0433\u043E,
        \u0443\u0435\u0431\u0438\u0449\u043D\u043E\u0433\u043E \u0434\u0435\u0442\u0435\u043D\u044B\u0448\u0430."
