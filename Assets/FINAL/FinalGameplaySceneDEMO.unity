    - type: 0
      name: 2
      line: "\u041F\u0440\u0438\u0432\u044B\u0447\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0436\u043A\u0430
        \u0434\u043E \u0448\u043A\u043E\u043B\u044B. \u0418\u043D\u043E\u0433\u0434\u0430
        \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E
        \u044F \u0436\u0438\u0432\u0443 \u0432 \u043A\u0430\u043A\u043E\u043C-\u0442\u043E
        \u0442\u0443\u043D\u043D\u0435\u043B\u0435. \u041E\u0434\u0438\u043D \u043A\u043E\u043D\u0435\u0446
        \u0435\u0433\u043E \u0432 \u043A\u043B\u0430\u0441\u0441\u0435, \u0434\u0440\u0443\u0433\u043E\u0439
        - \u0434\u043E\u043C\u0430. \u0415\u0449\u0435 \u043E\u0434\u0438\u043D -
        \u0432 \u043F\u0430\u0440\u043A\u0435, \u0434\u0440\u0443\u0433\u043E\u0439
        - \u0432 \u043A\u043B\u0443\u0431\u0435,  \u0438 \u0435\u0449\u0435, \u0435\u0449\u0435,
        \u0435\u0449\u0435... "
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
