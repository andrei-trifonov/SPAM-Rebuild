    - type: 0
      name: 2
      line: "\u0413\u043B\u0430\u0437\u0430 \u0436\u0430\u0434\u043D\u043E \u0438\u0441\u043A\u0430\u043B\u0438
        \u0441\u043F\u043E\u0441\u043E\u0431 \u0443\u0431\u0435\u0436\u0430\u0442\u044C,
        \u0438, \u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u044F \u0443\u0432\u0438\u0434\u0435\u043B\u0430
        \u043E\u043A\u043D\u043E \u0431\u0435\u0437 \u0440\u0435\u0448\u0435\u0442\u043A\u0438.
        \u041D\u0435 \u0434\u043E\u0436\u0438\u0434\u0430\u044F\u0441\u044C \u0440\u0435\u0430\u043A\u0446\u0438\u0438
