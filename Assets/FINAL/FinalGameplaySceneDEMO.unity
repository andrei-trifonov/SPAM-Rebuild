  m_EditorClassIdentifier: 
  Labels:
  - name: "\u0414\u0435\u043D\u044C3 \u041D\u0430\u0447\u0430\u043B\u043E 1"
    lines:
    - type: 16
      name: 0
      line: Cover3
      font: 0
      inv: 0
