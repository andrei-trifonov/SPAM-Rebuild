    - type: 0
      name: 2
      line: "\u041C\u043D\u0435 \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E
        \u0441\u0442\u0430\u043B\u043E \u0435\u0433\u043E \u0436\u0430\u043B\u043A\u043E.
        \u0423 \u0410\u043B\u0438\u043D\u044B \u0432\u043E\u0442 \u0442\u043E\u0436\u0435
        \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0442 \u043D\u0438\u043A\u043E\u0433\u043E,
        \u043A\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u043E  \u043D\u0430\u0437\u0432\u0430\u0442\u044C
        \"\u0434\u0440\u0443\u0433\u043E\u043C\". \u0411\u043E\u044E\u0441\u044C
        \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C, \u0434\u043E
        \u0447\u0435\u0433\u043E \u0433\u0440\u0443\u0441\u0442\u043D\u043E \u0435\u0439
        \u0436\u0438\u0432\u0451\u0442\u0441\u044F - \u044F \u043F\u043E\u0447\u0442\u0438
        \u043D\u0435 \u0432\u0438\u0436\u0443 \u0435\u0435 \u043D\u0430 \u0443\u043B\u0438\u0446\u0435,
        \u0430 \u0434\u043E\u043C\u0430 \u0443 \u0410\u043B\u0438 \u043D\u0430\u0432\u0440\u044F\u0434
        \u043B\u0438 \u043D\u0430\u0439\u0434\u0443\u0442\u0441\u044F \u043A\u0430\u043A\u0438\u0435-\u0442\u043E
        \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044F\r\n"
