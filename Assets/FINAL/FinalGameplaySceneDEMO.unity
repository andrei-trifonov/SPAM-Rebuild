    - type: 0
      name: 2
      line: "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A
        \u0438\u043B\u0438 \u043F\u043B\u043E\u0445\u043E\u0439? \u041F\u043E\u0441\u0442\u0443\u043F\u0430\u043B\u0430
        \u043B\u0438 \u044F \u0432\u0441\u0435 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
        \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
