      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: -I'm just glad I can still see you.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
