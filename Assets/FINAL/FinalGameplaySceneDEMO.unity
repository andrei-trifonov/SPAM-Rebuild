    - type: 0
      name: 2
      line: "\u042F \u043F\u0440\u043E\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0430\u0441\u044C
        \u043A \u0442\u0443\u0430\u043B\u0435\u0442\u0443 \u0438 \u0437\u0430\u043F\u0435\u0440\u043B\u0430\u0441\u044C
        \u0432 \u0437\u0430\u0431\u043B\u0435\u0432\u0430\u043D\u043D\u043E\u0439
        \u043A\u0430\u0431\u0438\u043D\u043A\u0435. \u0420\u0443\u043A\u0438 \u0441\u0440\u0430\u0437\u0443
        \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C \u0437\u0430\u0436\u0430\u0442\u044C
        \u043D\u043E\u0441, \u0447\u0442\u043E\u0431\u044B \u0435\u0434\u043A\u0438\u0439
        \u043A\u0438\u0441\u043B\u043E\u0442\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445
        \u043D\u0435 \u0440\u0430\u0437\u044A\u0435\u043B \u043B\u0435\u0433\u043A\u0438\u0435."
