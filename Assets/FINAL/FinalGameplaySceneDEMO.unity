    - type: 0
      name: 2
      line: "\u042F \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u0441\u0435\u043B\u0430
        \u0440\u044F\u0434\u043E\u043C \u0441 \u0410\u043B\u0438\u043D\u043E\u0439.
        \u041E\u043D\u0430 \u0441\u043B\u0435\u0433\u043A\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430
        \u0433\u043E\u043B\u043E\u0432\u0443 \u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
