  - name: "\u0414\u0435\u043D\u044C3 \u041F\u0441\u0438\u0445\u0435\u044F"
    lines:
    - type: 0
      name: 2
      line: "\u0411\u043B\u0438\u0436\u0435 \u043A \u0443\u0442\u0440\u0443 \u043C\u043D\u0435
        \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438 \u0437\u0430\u043A\u0430\u0437\u0430\u043D\u043D\u0443\u044E
        \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0447\u043A\u0435 \"\u041F\u0441\u0438\u0445\u0435\u044E\"
        -  \u0441\u0444\u0435\u0440\u0443 \u0434\u043B\u044F \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445
        \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0439 \u0432 \u0441\u0435\u0442\u044C.
        \u041D\u0430 \u043D\u0435\u0435 \u0431\u044B\u043B\u0438 \u0441\u043F\u0443\u0449\u0435\u043D\u044B
        \u0432\u0441\u0435 \u0443\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u044B\u0435
        \u0440\u0430\u043D\u0435\u0435 \u0443 \u043C\u0430\u043C\u044B \u0434\u0435\u043D\u044C\u0433\u0438."
