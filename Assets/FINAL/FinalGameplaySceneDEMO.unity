    - type: 0
      name: 2
      line: "\u0412\u0435\u0440\u043D\u0435\u0435 \u0442\u043E, \u0447\u0442\u043E
        \u043E\u0442 \u043D\u0435\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
        - \u0441\u043A\u0432\u043E\u0437\u044C \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0438\u0439
        \u0440\u0430\u0437\u043B\u043E\u043C \u0432 \u0434\u043E\u043C\u0435 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u043B\u0430\u0441\u044C
        \u0433\u0440\u0443\u0434\u0430 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E 
        \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0433\u043E \u0443\u0440\u043E\u0434\u043B\u0438\u0432\u043E\u0433\u043E
        \u043F\u0443\u043B\u044C\u0441\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E
        \u043C\u044F\u0441\u0430. \u042F \u043F\u0440\u043E\u0442\u0435\u0440\u043B\u0430
        \u0433\u043B\u0430\u0437\u0430 \u043A\u0443\u043B\u0430\u043A\u0430\u043C\u0438.
        \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C,
        \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442 - \u0441\u043E\u0441\u0443\u0434\u044B
        \u0438 \u044F\u0437\u0432\u044B, \u0441\u043F\u043B\u0435\u0442\u0435\u043D\u0438\u044F
        \u0438 \u043C\u044B\u0448\u0446\u044B \u043F\u043E\u043F\u043B\u044B\u043B\u0438
        \u0432 \u0433\u043B\u0430\u0437\u0430\u0445, \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0432
        \u0432\u0441\u0435 \u0432\u043E\u043A\u0440\u0443\u0433."
