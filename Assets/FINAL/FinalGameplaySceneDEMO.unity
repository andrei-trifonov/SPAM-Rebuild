    - type: 0
      name: 2
      line: "\u041C\u043E\u0435 \u0442\u0435\u043B\u043E \u0431\u0443\u0434\u0442\u043E
        \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0432 \u0441\u043C\u0438\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
        \u0440\u0443\u0431\u0430\u0448\u043A\u0443. \u042F \u043D\u0435 \u0441\u0440\u0430\u0437\u0443
        \u043E\u0441\u043E\u0437\u043D\u0430\u043B\u0430 \u0433\u0434\u0435 \u044F,
        \u0438 \u0447\u0442\u043E \u0442\u0443\u0442 \u0434\u0435\u043B\u0430\u044E.\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F
        \u044F \u0437\u0430\u0441\u043D\u0443\u043B\u0430 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C."
