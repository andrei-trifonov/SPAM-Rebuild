    - type: 0
      name: 2
      line: "\u042F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C,
        \u043F\u043E \u0438\u043D\u0435\u0440\u0446\u0438\u0438 \u043F\u0440\u043E\u0431\u0435\u0436\u0430\u0432
        \u0434\u0430\u043B\u044C\u0448\u0435,\_ \u0447\u0443\u0442\u044C \u0431\u044B\u043B\u043E
        \u043D\u0435 \u0441\u043F\u043E\u0442\u043A\u043D\u0443\u0432\u0448\u0438\u0441\u044C
        \u043E \u0431\u043E\u0440\u0434\u044E\u0440. \u041E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430\u0441\u044C.
        \u0421\u043E\u043D\u0438 \u043D\u0438\u0433\u0434\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E.\n"
