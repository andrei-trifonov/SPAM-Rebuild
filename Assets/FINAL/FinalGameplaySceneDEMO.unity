      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: I looked out the window. Nothing is happening, not even a light in the
        windows. Very strange.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
