    - type: 11
      name: 0
      line: 
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: "\u0414\u0435\u043D\u044C3 \u041D\u0430\u0447\u0430\u043B\u043E
        2"
      music: 0
      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
