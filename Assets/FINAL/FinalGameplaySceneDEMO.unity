    - type: 8
      name: 2
      line: "\u042F \u0437\u0430\u0436\u043C\u0443\u0440\u0438\u043B\u0430\u0441\u044C,
        \u0430 \u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430
        \u0433\u043B\u0430\u0437\u0430, \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
        \u0432 \u043E\u0431\u044A\u044F\u0442\u0438\u044F\u0445 \u041A\u0438\u0440\u0430.
        \n\n\u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0435\u0435
        \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043A\u0430\u043A\u0438\u043C-\u0442\u043E
        \u0441\u043D\u043E\u043C. \u0422\u0435\u043F\u043B\u043E \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u043E\u0441\u044C
        \u043F\u043E \u043A\u043E\u0436\u0435, \u0430 \u0432\u0441\u043B\u0435\u0434
        \u0437\u0430 \u043D\u0438\u043C \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u043B\u0438\u0441\u044C
        \u0432\u043E\u043B\u043D\u044B \u0445\u043E\u043B\u043E\u0434\u0430, \u0432\u044B\u0437\u044B\u0432\u0430\u044F
        \u043C\u0443\u0440\u0430\u0448\u043A\u0438 \u0438 \u043C\u0435\u043B\u043A\u0443\u044E
        \u0434\u0440\u043E\u0436\u044C.\n\n\u042F \u0437\u0430\u0441\u043C\u0443\u0449\u0430\u043B\u0430\u0441\u044C,
        \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E,
        \u0447\u0442\u043E \u0435\u0434\u0432\u0430 \u043B\u0438 \u043E\u0449\u0443\u0449\u0430\u043B\u0430
        \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u044F.
        \u041C\u043D\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u043E \u044D\u0442\u043E
        \u0447\u0443\u0432\u0441\u0442\u0432\u043E, \u043A\u043E\u0433\u0434\u0430
        \u043E\u0431\u043D\u0438\u043C\u0430\u0435\u0448\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
        \u0432\u043E \u0441\u043D\u0435.\n\n\u0411\u0443\u0434\u0442\u043E \u043D\u0430
        \u043C\u0435\u043D\u044F \u043D\u0430\u043A\u0438\u043D\u0443\u043B\u0438
        \u0442\u0435\u043F\u043B\u044B\u0439 \u0445\u0430\u043B\u0430\u0442,  \u0438
        \u043E\u043D \u0435\u0434\u0432\u0430 \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
        \u043A\u043E\u0436\u0438, \u0438\u043B\u0438 \u0432\u0435\u0442\u0435\u0440
        \u043B\u0430\u0441\u043A\u0430\u0435\u0442 \u0435\u0434\u0432\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C\u044B\u0435
        \u0432\u043E\u043B\u043E\u0441\u044B \u043D\u0430 \u0442\u0435\u043B\u0435. "
