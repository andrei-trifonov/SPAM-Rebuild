      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: Sonya was swinging back and forth on a swing, cluelessly blowing bubbles
        into a box of grape juice.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
