    - type: 0
      name: 2
      line: "\u041E\u043D \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
        \u0431\u0435\u0437\u0447\u0443\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C,
        \u043D\u043E \u0442\u044B \u043E\u0449\u0443\u0449\u0430\u0435\u0448\u044C
        \u044D\u0442\u043E \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u044E\u0449\u0435\u0435
        \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E\u0435 \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u0435
        \u0431\u0435\u0442\u043E\u043D\u0430 \u043A \u0442\u0432\u043E\u0435\u0439
        \u0441\u043F\u0438\u043D\u0435, \u0435\u0441\u043B\u0438 \u0432 \u0442\u0432\u043E\u0435\u0439
        \u0436\u0438\u0437\u043D\u0438 \u0432\u0441\u0435 \u043F\u043E\u0448\u043B\u043E
        \u043D\u0435 \u0442\u0430\u043A. "
