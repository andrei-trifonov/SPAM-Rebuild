      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: "-But how\u2026 Sonya has her own personality! She has her own self\u2026
        A simulation can't have its own personality!"
