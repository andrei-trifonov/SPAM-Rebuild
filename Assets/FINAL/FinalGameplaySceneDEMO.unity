    - type: 0
      name: 2
      line: "\u042F \u043A\u0438\u0432\u043D\u0443\u043B\u0430. \u041C\u044B \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C
        \u0432\u043D\u0438\u0437, \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u044C
        \u0443 \u0431\u0430\u0448\u043D\u0438. \u041F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438
        \u0445\u043B\u044E\u043F\u0430\u043B\u0430 \u0440\u0430\u0441\u0448\u0430\u0442\u0430\u043D\u043D\u0430\u044F
        \u043F\u043B\u0438\u0442\u043A\u0430, \u0431\u0443\u0434\u0442\u043E \u0431\u044B
        \u043C\u044B \u0445\u043E\u0434\u0438\u043B\u0438 \u043F\u043E \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u043C
        \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u0435\u0439
        \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438."
