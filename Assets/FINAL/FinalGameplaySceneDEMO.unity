      name: 1
      line: "-\u0422\u044B \u043F\u0440\u0430\u0432\u0430. \u041C\u043D\u0435...
        \u0421\u043B\u043E\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0440\u044F\u0434\u043E\u043C
        \u0441 \u043B\u044E\u0434\u044C\u043C\u0438. \u0410 \u043A\u043E\u0433\u0434\u0430
        \u0438\u0445 \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E... \u042F
        \u0441\u043E\u0432\u0441\u0435\u043C-\u0441\u043E\u0432\u0441\u0435\u043C
        \u0442\u0435\u0440\u044F\u044E\u0441\u044C. \u041C\u044B\u0441\u043B\u0438
        \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u043A\u0430\u043A
        \u0442\u043E\u0447\u043A\u0438 \u0438 \u0442\u0438\u0440\u0435, \u0438 \u043C\u043D\u0435
