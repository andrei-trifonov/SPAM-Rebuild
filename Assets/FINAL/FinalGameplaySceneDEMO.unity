    - type: 0
      name: 2
      line: "\u0415\u0441\u043B\u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u0441\u0432\u043E\u0439 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
        \u0433\u043E\u043B\u043E\u0441 \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u0442\u044C,
        \u0433\u043E\u043B\u043E\u0432\u0443 \u0441\u0440\u0430\u0437\u0443 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442
        \u0448\u0443\u043C \u043F\u0440\u043E\u0432\u043E\u0434\u043E\u0432 \u0438
        \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u043E\u0432,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435 \u0442\u0430\u043A
        \u0443\u0436 \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u0442\u0443\u0434\u0430
        \u0432\u044B\u0433\u043D\u0430\u0442\u044C. "
