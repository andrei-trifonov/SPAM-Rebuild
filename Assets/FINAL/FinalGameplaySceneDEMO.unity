      name: 2
      line: "\u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F,
        \u0447\u0442\u043E \u043E\u043D \u043D\u0435 \u0432\u044B\u043B\u0430\u0437\u0438\u0442
        \u0434\u043D\u044F\u043C\u0438 \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E
        \u0446\u0435\u0440\u043A\u043E\u0432\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u0432\u0430\u043B\u0430
        - \u043E\u0434\u0435\u0436\u0434\u0430 \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u0430
        \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u0441\u0432\u0435\u0447, \u0441\u044B\u0440\u043E\u0441\u0442\u044C\u044E
        \u0438 \u043F\u043E\u0442\u043E\u043C. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u044D\u0442\u043E \u0437\u0430\u043F\u0430\u0445 \u0441\u0432\u044F\u0442\u043E\u0441\u0442\u0438."
