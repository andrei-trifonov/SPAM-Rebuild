      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 1, y: -1, z: -3}
    - type: 0
      name: 2
      line: -From school? For the whole day? You're kidding!
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 4
      line: -Oh, not at all! I already gathered all the girls; we're just waiting
        for you.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: My arms and legs felt numb, and my neck felt disconnected-falling asleep
        at the desk is quite an experience.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
