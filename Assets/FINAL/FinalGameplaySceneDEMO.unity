    - type: 0
      name: 2
      line: "\u0415\u0435 \u0442\u0435\u043B\u043E \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
        \u0442\u0430\u043A\u0438\u043C... \u0414\u0438\u043A\u0438\u043C... \u0412
        \u043D\u0435\u043C \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430\u0441\u044C
        \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u044F\u044F
        \u0437\u0430\u0431\u044B\u0442\u0430\u044F \u0433\u0440\u0430\u0446\u0438\u044F.
        \u0415\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
        \u0442\u0430\u043A\u0438\u043C\u0438 \u043B\u0435\u0433\u043A\u0438\u043C\u0438
        \u0438 \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u043C\u0438. \u0410\u043B\u0438\u043D\u0430
        \u043F\u0440\u0438\u0441\u0435\u043B\u0430 \u043D\u0430 \u043A\u043E\u0440\u0442\u043E\u0447\u043A\u0438,
        \u043E\u043F\u0438\u0440\u0430\u044F\u0441\u044C \u0440\u0443\u043A\u0430\u043C\u0438
        \u043D\u0430 \u0441\u0442\u0432\u043E\u043B \u0434\u0435\u0440\u0435\u0432\u0430
        \u0432 \u043F\u043E\u0437\u0435 \u043A\u043E\u0448\u043A\u0438. "
