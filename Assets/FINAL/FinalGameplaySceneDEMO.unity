    - type: 0
      name: 2
      line: "-\u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0440\u0435\u0434!
        \u0414\u043B\u044F \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E
        \u0445\u0443\u0436\u0435 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
        \u0441 \u0421\u043E\u043D\u0435\u0439... \u041E\u043D\u0430-\u043C\u043E\u044F
        \u043B\u0443\u0447\u0448\u0430\u044F \u043F\u043E\u0434\u0440\u0443\u0433\u0430.
        \u0411\u044B\u043B\u0430 \u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442! "
