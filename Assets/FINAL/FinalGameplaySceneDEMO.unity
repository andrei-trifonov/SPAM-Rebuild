    - type: 0
      name: 2
      line: "\u041C\u044B \u0432\u0437\u044F\u043B\u0438\u0441\u044C \u0437\u0430
        \u0440\u0443\u043A\u0438 \u0438 \u043F\u043E\u0442\u043E\u043F\u0430\u043B\u0438
        \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E
        \u043F\u0430\u0440\u043A\u0430. \u0420\u0435\u0448\u0438\u043B\u0438 \u0434\u043E\u0439\u0442\u0438
        \u043F\u0435\u0448\u043A\u043E\u043C - \u0442\u0430\u043C \u0432\u0441\u0435\u0433\u043E
