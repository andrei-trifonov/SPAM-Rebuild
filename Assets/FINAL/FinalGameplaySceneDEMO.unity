    - type: 0
      name: 2
      line: "\u0422\u0430\u043A \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
        \u0433\u0443\u043B\u044F\u0442\u044C \u0437\u0434\u0435\u0441\u044C. \u0412
        \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C
        \u0441\u0435\u0431\u044F \u0447\u0430\u0441\u0442\u044C\u044E \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
        \u0438 \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430."
