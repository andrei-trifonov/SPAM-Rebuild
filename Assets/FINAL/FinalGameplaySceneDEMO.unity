    - type: 0
      name: 0
      line: "    logical_depression = true;\n    logical_acceptance = true;\n   
        if (denial && anger && bargain && depression)\n        std::cat << \"Error:
        Unable to accept the inevitable!\" << std::endl;\n    machine->realize();"
