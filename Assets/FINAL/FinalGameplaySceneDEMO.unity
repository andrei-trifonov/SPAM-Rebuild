    - type: 0
      name: 2
      line: "\u0412 \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0440\u0430\u0437
        \u0421\u043E\u043D\u0435 \u0434\u0430\u043B\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
        \u0441\u0435\u0434\u0430\u0442\u0438\u0432\u043D\u044B\u0445 \u0438 \u043E\u0431\u0435\u0437\u0431\u043E\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u0445,
        \u0447\u0442\u043E \u043E\u043D\u0430 \u0435\u0434\u0432\u0430 \u043B\u0438
        \u043C\u043E\u0433\u043B\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
        \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u043C\u0435\u043D\u044F."
