      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 8
      name: 2
      line: The closer you get to your brain realizing the depth of the feeling,
        the more you see the falsity around - the floor and walls of cardboard, people
        a formless, distorted mass, and all words just random sounds, more like bird
        chirping.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
