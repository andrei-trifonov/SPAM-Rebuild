    - type: 0
      name: 2
      line: "\u041F\u0440\u044F\u043D\u044B\u0439 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
        \u0432\u043E\u0437\u0434\u0443\u0445 \u0435\u0449\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
        \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u0435\u0442 \u043C\u043E\u0437\u0433...
        \u0427\u0442\u043E \u0441\u043E \u043C\u043D\u043E\u0439 \u0431\u0443\u0434\u0435\u0442?
        \u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043D\u0438 \u043C\u0430\u043B\u0435\u0439\u0448\u0435\u0439
        \u043D\u0430\u0434\u0435\u0436\u0434\u044B \u043D\u0430 \u0447\u0442\u043E-\u0442\u043E
        \u0445\u043E\u0440\u043E\u0448\u0435\u0435.\r\n"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
