    - type: 0
      name: 2
      line: "\u0413\u0434\u0435-\u0442\u043E \u043D\u0430 \u0444\u043E\u043D\u0435
        \u043A\u0430\u043A \u0431\u044B \u0438\u0437 \u043F\u0443\u0441\u0442\u043E\u0442\u044B
        \u0437\u0430\u0437\u0432\u0443\u0447\u0430\u043B\u0438 \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u044B."
