    - type: 0
      name: 2
      line: "\u0418 \u0447\u0442\u043E \u0441\u0430\u043C\u043E\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0435
        - \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0436\u0435\u043B\u0430\u043D\u0438\u044F
        \u0438 \u0441\u0438\u043B \u044D\u0442\u043E\u043C\u0443 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F.
        \u041A\u0430\u043A\u0430\u044F \u0436\u0435 \u0435\u0440\u0443\u043D\u0434\u0430."
