    - type: 0
      name: 2
      line: After making a circle around the square, the investigator approached
        me.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
