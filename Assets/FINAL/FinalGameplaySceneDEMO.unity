    - type: 0
      name: 2
      line: "-\u0414\u0430. \u042F \u0437\u0434\u0435\u0441\u044C \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C.
        \u0418 \u043D\u0438\u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u043D\u0435 \u0443\u0435\u0437\u0436\u0430\u043B\u0430."
