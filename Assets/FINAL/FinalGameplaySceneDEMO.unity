      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 1
      line: -If someone's laughing, I'm sure they're laughing at me. If they're whispering
        about something... It's definitely about me!
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
