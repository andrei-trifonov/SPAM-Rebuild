    - type: 0
      name: 2
      line: "\u042F \u043F\u0435\u0440\u0435\u0432\u0435\u043B\u0430 \u0432\u0437\u0433\u043B\u044F\u0434
        \u043D\u0430 \u0440\u0430\u0437\u043C\u043E\u0442\u0430\u043D\u043D\u0443\u044E
        \u043A\u0438\u0441\u0442\u044C - \u0443 \u0410\u043B\u0438 \u043D\u0430 \u0440\u0443\u043A\u0435
        \u043D\u0435 \u0431\u044B\u043B\u043E \u0434\u0432\u0443\u0445 \u043F\u0430\u043B\u044C\u0446\u0435\u0432.
        \u0412\u043C\u0435\u0441\u0442\u043E \u043D\u0438\u0445 - \u0443\u0440\u043E\u0434\u043B\u0438\u0432\u044B\u0435
        \u0441\u0432\u0435\u0436\u0438\u0435 \u0448\u0440\u0430\u043C\u044B. \u0420\u0443\u043A\u0430
        \u0431\u044B\u043B\u0430 \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0435\u0440\u0435\u0436\u0430\u0442\u0430
        \u0431\u0438\u043D\u0442\u043E\u043C, \u0438 \u043E\u0442 \u043D\u0435\u0433\u043E
        \u043F\u043E \u0432\u0441\u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
        \u043A\u043E\u0436\u0438 \u0442\u044F\u043D\u0443\u043B\u0441\u044F \u043E\u0442\u0442\u0438\u0441\u043A
        \u0432\u044F\u0437\u0438 \u0442\u043A\u0430\u043D\u0438 \u0438 \u0441\u043A\u043B\u0430\u0434\u043E\u043A. 
        \u0418\u0437\u043C\u0443\u0447\u0435\u043D\u043D\u0430\u044F \u0440\u0443\u043A\u0430
        \u0442\u0440\u044F\u0441\u043B\u0430\u0441\u044C \u0438 \u0434\u0440\u043E\u0436\u0430\u043B\u0430
        \u043E\u0442 \u0431\u043E\u043B\u0438. "
