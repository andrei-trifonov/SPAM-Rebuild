    - type: 0
      name: 2
      line: "\u041E\u043D\u0430 \u0437\u0434\u0435\u0441\u044C \u0443\u0436\u0435
        \u043C\u0435\u0441\u044F\u0446. \u041F\u043E\u0447\u0442\u0438 \u0441\u0440\u0430\u0437\u0443
        \u0421\u043E\u043D\u0435 \u043E\u0442\u0440\u0435\u0437\u0430\u043B\u0438
        \u043E\u0431\u0443\u0433\u043B\u0435\u043D\u043D\u044B\u0435 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438.
        \u0422\u043E\u0433\u0434\u0430 \u044F \u0432\u043F\u0435\u0440\u0432\u044B\u0435
        \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430  \u044D\u0442\u043E \u043C\u0435\u0440\u0437\u043A\u043E\u0435
        \u0441\u043B\u043E\u0432\u043E \"\u041A\u0443\u043B\u044C\u0442\u044F\". "
