    - type: 0
      name: 2
      line: "\u0418 \u0432\u0441\u0435 \u0436\u0435, \u044F \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430
        \u0441\u0435\u0431\u044F. \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
        \u043C\u043E\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u0433\u043E\u043B\u043E\u0441 \u0435\u0449\u0435 \u0437\u0432\u0443\u0447\u0438\u0442
        \u0432 \u043C\u043E\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u0435, \u0445\u043E\u0442\u044F
        \u0438 \u0437\u0430\u0433\u043B\u0443\u0448\u0430\u0435\u043C\u044B\u0439
        \u0448\u0443\u043C\u043E\u043C. "
