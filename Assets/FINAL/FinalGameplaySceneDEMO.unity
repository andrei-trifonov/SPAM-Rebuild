    - type: 0
      name: 2
      line: "\u0410\u043B\u0438\u043D\u0430 \u0432\u0446\u0435\u043F\u0438\u043B\u0430\u0441\u044C
        \u0432 \u0441\u0442\u0432\u043E\u043B \u0434\u0435\u0440\u0435\u0432\u0430
