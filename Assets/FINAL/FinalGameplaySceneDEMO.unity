    - type: 0
      name: 2
      line: "\u0410\u043B\u044F \u043D\u0430\u0431\u0440\u0430\u043B\u0430 \u0432\u043E\u0437\u0434\u0443\u0445\u0430
        \u0432 \u0433\u0440\u0443\u0434\u044C \u0438 \u043D\u0430\u0447\u0430\u043B\u0430
        \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043D\u0430\u0434\u0443\u0432\u0430\u0442\u044C
        \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u043F\u0443\u0437\u044B\u0440\u044C.
        \u041F\u0443\u0437\u044B\u0440\u044C \u0434\u0440\u043E\u0436\u0430\u043B
        \u0438 \u0438\u0437\u0432\u0438\u0432\u0430\u043B\u0441\u044F, \u0438 \u043D\u0430\u043A\u043E\u043D\u0435\u0446,
        \u043A\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u043B \u0441\u043E\u0432\u0441\u0435\u043C
        \u0431\u043E\u043B\u044C\u0448\u0438\u043C, \u043E\u0442\u043E\u0440\u0432\u0430\u043B\u0441\u044F
        \u043E\u0442 \u043A\u043E\u043B\u0435\u0447\u043A\u0430 \u0438 \u043F\u043E\u043B\u0435\u0442\u0435\u043B
        \u0432 \u043D\u0435\u0431\u043E, \u0438\u0437\u0432\u0438\u0432\u0430\u044F\u0441\u044C
        \u0438 \u043A\u0440\u0443\u0436\u0430\u0441\u044C \u043E\u0442 \u043D\u0430\u0431\u0435\u0433\u0430\u044E\u0449\u0438\u0445
        \u043F\u043E\u0442\u043E\u043A\u043E\u0432 \u0432\u0435\u0442\u0440\u0430."
