    - type: 0
      name: 4
      line: "-\u041D\u0443 \u0434\u0430\u0432\u0430\u0439, \u0431\u0443\u0434\u0435\u0442
        \u0432\u0435\u0441\u0435\u043B\u043E, \u044F \u043E\u0431\u0435\u0449\u0430\u044E!
        \u042F \u0441\u0442\u043E \u0440\u0430\u0437 \u0442\u0430\u043A \u0434\u0435\u043B\u0430\u043B\u0430.
