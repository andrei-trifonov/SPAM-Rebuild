      line: "\u0421\u043E\u043D\u044F \u0440\u0430\u0441\u043A\u0430\u0447\u0438\u0432\u0430\u043B\u0430\u0441\u044C
        \u0432\u0437\u0430\u0434-\u0432\u043F\u0435\u0440\u0451\u0434 \u043D\u0430
        \u043A\u0430\u0447\u0435\u043B\u044F\u0445, \u043D\u0435\u0434\u043E\u0443\u043C\u0435\u043D\u043D\u043E
        \u043F\u0443\u0441\u043A\u0430\u044F \u043F\u0443\u0437\u044B\u0440\u0438
        \u0432 \u043F\u0430\u0447\u043A\u0443 \u0432\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u043D\u043E\u0433\u043E
        \u0441\u043E\u043A\u0430."
