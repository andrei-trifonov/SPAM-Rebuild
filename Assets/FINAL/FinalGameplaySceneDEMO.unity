      line: "\u041E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430 \u044F \u0437\u0430\u043A\u0440\u044B\u043B\u0430
        \u0433\u043B\u0430\u0437\u0430. \u041C\u0435\u0442\u0430\u043B\u043B \u0437\u0432\u043E\u043D\u043A\u043E
        \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F \u043F\u043E
        \u0431\u0435\u0442\u043E\u043D\u043D\u043E\u043C\u0443 \u043F\u043E\u043B\u0443,
        \u0432\u0441\u043B\u0435\u0434 \u0437\u0430 \u043C\u043D\u043E\u0439 \u0441\u044B\u043F\u044F\u0442\u0441\u044F
        \u043A\u0430\u043C\u043D\u0438 \u0438 \u0437\u0435\u043C\u043B\u044F. \n\u041D\u0435
        \u0440\u0435\u0448\u0430\u044F\u0441\u044C \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F,
        \u044F \u0448\u0430\u0440\u044E \u0432\u043E\u043A\u0440\u0443\u0433 \u0440\u0443\u043A\u0430\u043C\u0438
        - \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u043E\u0431\u043B\u043E\u043C\u043A\u0438
        \u0438 \u043F\u044B\u043B\u044C. "
