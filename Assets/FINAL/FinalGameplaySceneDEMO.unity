    - type: 0
      name: 2
      line: "\u0418\u043D\u044A\u0435\u043A\u0442\u043E\u0440, \u043D\u043E\u0432\u044B\u0439.
        \u041F\u0440\u0438\u0432\u044B\u0447\u043D\u0430\u044F \u043D\u0430\u0434\u043F\u0438\u0441\u044C
        \"SPAM\", \u043D\u043E \u0446\u0432\u0435\u0442 \u0441\u043E\u0432\u0441\u0435\u043C
        \u0434\u0440\u0443\u0433\u043E\u0439. \u0418 \u0446\u0438\u0444\u0440\u0430
        2. \u0412\u0441\u0435 \u0438\u043D\u044A\u0435\u043A\u0442\u043E\u0440\u044B
