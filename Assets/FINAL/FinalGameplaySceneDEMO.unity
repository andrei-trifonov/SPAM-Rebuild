      name: 2
      line: "\u0410\u043B\u0438\u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C
        \u0443 \u0431\u043E\u043B\u044C\u0448\u0443\u0449\u0435\u0433\u043E \u0432\u0435\u0442\u0432\u0438\u0441\u0442\u043E\u0433\u043E
        \u0434\u0435\u0440\u0435\u0432\u0430. \u041A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
