    - type: 0
      name: 2
      line: "\u0415\u0433\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E
        \u0433\u043E\u0442\u043E\u0432\u043E \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u044C\u0441\u044F
        \u043E\u0442 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0439
        \u0431\u043E\u043B\u0438. \u0415\u0449\u0435 \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C
        \u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0434\u0451\u0442
        \u0447\u0442\u043E-\u0442\u043E\_ \u0443\u0436\u0430\u0441\u043D\u043E\u0435.
        \u0421\u0442\u0443\u043A \u0432\u044B\u0431\u0438\u0432\u0430\u0435\u0442
        \u0441\u0431\u0438\u0432\u0447\u0438\u0432\u044B\u0439 \u0440\u0438\u0442\u043C,
        \u043A \u043D\u0435\u043C\u0443 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0430\u044E\u0442\u0441\u044F
        \u0440\u0435\u0437\u043A\u0438\u0435 \u0437\u0432\u0443\u043A\u0438 \u0441\u0438\u043D\u0442\u0435\u0437\u0430\u0442\u043E\u0440\u0430...\_"
