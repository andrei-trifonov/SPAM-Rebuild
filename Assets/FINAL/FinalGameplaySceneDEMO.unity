        \u041C\u0438\u0440\u0430...\", \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044F
        \u0440\u043E\u0442 \u0432\u043E\u0440\u043E\u0442\u043D\u0438\u043A\u043E\u043C
        \u0431\u043B\u0443\u0437\u043A\u0438.\r\n"
