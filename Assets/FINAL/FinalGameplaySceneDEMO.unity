    - type: 0
      name: 2
      line: "-\u0421\u043E\u043D\u044F, \u044F \u0442\u0430\u043A \u0440\u0430\u0434\u0430
        \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C! \u041C\u044B...
        \u041C\u044B \u0432\u043C\u0435\u0441\u0442\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u043C
        \u0440\u0430\u0441\u0441\u0432\u0435\u0442, \u043A\u0430\u043A \u0438 \u0445\u043E\u0442\u0435\u043B\u0438!
        \u042F \u0442\u0430\u043A \u0440\u0430\u0434\u0430! \u042F \u043B\u044E\u0431\u043B\u044E
        \u0442\u0435\u0431\u044F, \u0421\u043E\u043D\u044F!\n"
