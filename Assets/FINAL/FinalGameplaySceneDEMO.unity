    - type: 0
      name: 2
      line: "\"\u0421\u043E\u043D\u0438\u0447\u0443 <3\". \u041D\u0435\u0442 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0439.
        \u042D\u0442\u043E \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043E\u0442
        \u043D\u0435\u0435. \u041F\u043E\u0447\u0435\u0440\u043A \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E
        \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0438 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u044B\u0439.
        \u042F \u043F\u0435\u0440\u0435\u0432\u043E\u0436\u0443 \u0432\u0437\u0433\u043B\u044F\u0434
        \u043D\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
        \u043A\u043E\u0440\u043E\u0431\u043A\u0438, \u0438 \u0443 \u043C\u0435\u043D\u044F
        \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442 \u0441\u0435\u0440\u0434\u0446\u0435.
        \u042D\u0442\u043E \u0436\u0435...\_\_"
