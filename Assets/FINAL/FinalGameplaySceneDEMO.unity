    - type: 0
      name: 2
      line: "\u042F \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043D\u044F\u043B\u0430
        \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
        - \u043E\u0434\u043D\u043E\u043A\u043B\u0430\u0441\u0441\u043D\u0438\u043A\u0438
        \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0432\u043E\u043A\u0440\u0443\u0433
        \u043E\u0434\u043D\u043E\u0439 \u043F\u0430\u0440\u0442\u044B \u0438 \u0447\u0442\u043E-\u0442\u043E
        \u0432\u043E\u0437\u043C\u0443\u0449\u0435\u043D\u043D\u043E \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B\u0438."
