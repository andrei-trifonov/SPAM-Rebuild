    - type: 0
      name: 2
      line: "\u041A \u043F\u044F\u0442\u0438 \u0443\u0442\u0440\u0430 \u0432\u0441\u0435
        \u044D\u0442\u043E \u0441\u0442\u0430\u043B\u043E \u0441\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F
        \u0432 \u0435\u0434\u0438\u043D\u044B\u0439 \u0448\u0443\u043C, \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439 
        \u0445\u0430\u043E\u0441 \u0438\u0437 \u0431\u0443\u043A\u0432 \u0438 \u0446\u0438\u0444\u0440.
        \u0418 \u044D\u0442\u043E\u0442 \u0431\u0435\u0441\u043F\u0440\u043E\u0441\u0432\u0435\u0442\u043D\u044B\u0439
        \u0445\u0430\u043E\u0441 \u0434\u0430\u0432\u0438\u043B \u043D\u0430 \u043C\u0435\u043D\u044F
        \u0432\u0441\u0435 \u0441\u0438\u043B\u044C\u043D\u0435\u0435. "
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
