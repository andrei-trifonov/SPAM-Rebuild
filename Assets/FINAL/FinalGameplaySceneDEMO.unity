    - type: 0
      name: 2
      line: "\u0412 \u0433\u043E\u043B\u043E\u0432\u0435 \u043C\u0435\u0440\u0446\u0430\u043B\u0438
        \u044F\u0440\u043A\u0438\u0435 \u0432\u0441\u043F\u044B\u0448\u043A\u0438,
        \u043D\u0435\u0440\u0430\u0437\u0431\u043E\u0440\u0447\u0438\u0432\u044B\u0435
        \u0441\u043B\u043E\u0432\u0430 \u0438 \u043A\u0443\u0441\u043E\u0447\u043A\u0438
        \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439,
        \u0438 \u0432\u0441\u0435 \u044D\u0442\u043E \u043A\u0430\u043A-\u0442\u043E
        \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B\u043E\u0441\u044C
        \u0432\u043E\u0435\u0434\u0438\u043D\u043E. "
