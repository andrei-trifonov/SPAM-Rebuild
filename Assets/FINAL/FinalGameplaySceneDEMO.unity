    - type: 0
      name: 2
      line: "\u0421\u043F\u0440\u044B\u0433\u043D\u0443\u0432 \u0432\u043D\u0438\u0437,
        \u044F \u0432\u0437\u044F\u043B\u0430\u0441\u044C \u0437\u0430 \u0448\u0438\u0432\u043E\u0440\u043E\u0442
        \u0435\u0433\u043E \u043A\u0443\u0440\u0442\u043A\u0438. \u0413\u043B\u0430\u0437\u0430
        \u043D\u0430\u0447\u0430\u043B\u0438 \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0442\u044C,
        \u0438 \u044F \u0443\u0432\u0438\u0434\u0435\u043B\u0430 \u043C\u0435\u0440\u0446\u0430\u044E\u0449\u0438\u0435
        \u043A\u043E\u043D\u0441\u043E\u043B\u0438 \u0438 \u043E\u0433\u043E\u043D\u044C\u043A\u0438
        \u0432 \u0431\u0435\u0442\u043E\u043D\u043D\u043E\u043C \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435.
        \u041D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
        \u043F\u043E\u0434\u0432\u0430\u043B."
