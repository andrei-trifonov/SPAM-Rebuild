      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 5
      line: -What do you mean by 'real'? To you, Sonya won't change. She'll stay
        as you remember her.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
