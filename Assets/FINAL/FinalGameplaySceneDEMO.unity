    - type: 0
      name: 2
      line: "\u042F \u0435\u0434\u0432\u0430 \u0443\u0441\u0442\u043E\u044F\u043B\u0430
        \u043E\u0442 \u0442\u0430\u043A\u043E\u0439 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438
        \u0438 \u043A\u043E\u0435-\u043A\u0430\u043A \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u043B\u0430
        \u0435\u0433\u043E \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u0442\u043A\u0443.
        \u041C\u0435\u043D\u044F \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u0435\u0442
        \u041A\u0438\u0440\u0430. \u041D\u0435 \u0437\u043D\u0430\u044E, \u043F\u043E\u0447\u0435\u043C\u0443...\n\u0415\u0449\u0435
        \u0440\u0430\u0437 \u043F\u0440\u043E\u0431\u0435\u0433\u0430\u044F \u043C\u0438\u043C\u043E
        \u043C\u0435\u043D\u044F, \u041A\u0438\u0440\u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
        \u043F\u043E\u0434\u043D\u043E\u0436\u043A\u0443. "
