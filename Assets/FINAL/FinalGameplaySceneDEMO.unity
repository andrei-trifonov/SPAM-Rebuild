    - type: 0
      name: 2
      line: "\u0417\u0430\u043F\u043D\u0443\u0432\u0448\u0438\u0441\u044C, \u043E\u043D\u0430
        \u043F\u0440\u043E\u043B\u0435\u0442\u0435\u043B\u0430 \u043F\u0430\u0440\u0443
        \u043C\u0435\u0442\u0440\u043E\u0432 \u0438 \u0443\u043F\u0430\u043B\u0430
        \u043D\u0430 \u0433\u0440\u044F\u0437\u043D\u0443\u044E \u0437\u0435\u043C\u043B\u044E.
