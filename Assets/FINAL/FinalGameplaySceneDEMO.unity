    - type: 0
      name: 2
      line: "\u041A\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
        \u0432 \u043A\u043B\u0430\u0441\u0441\u0435 \u043F\u043E\u0441\u043B\u0435
        \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u043C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u044B,
