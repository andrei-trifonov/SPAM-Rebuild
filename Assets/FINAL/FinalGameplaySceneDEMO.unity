    - type: 0
      name: 2
      line: "\u0414\u0430 \u043A\u0430\u043A \u043E\u043D\u0430 \u043F\u0440\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
        \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0432\u043D\u0443\u0442\u0440\u044C
        \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B? \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u0441\u0442\u043E\u0438\u0442 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C
