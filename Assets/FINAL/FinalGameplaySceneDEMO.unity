    - type: 0
      name: 5
      line: "-\u0410, \u0442\u044B \u043F\u0440\u043E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0443...
        \u042D\u0442\u043E \u043F\u043E\u0440\u0442\u0430\u0442\u0438\u0432\u043D\u0430\u044F
        \"\u041C\u043E\u0431\u0438\u043B\u0430\". \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C
        \u0434\u0432\u0430 \u043C\u0435\u0433\u0430\u0431\u0430\u0439\u0442\u0430
        \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438,
        \u0434\u0432\u0435 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u044B\u0435
        \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
        \u0435\u0434\u0438\u043D\u0438\u0446\u044B.\r\n"
