    - type: 0
      name: 2
      line: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0443 \u0437\u0430\u0431\u043E\u0440\u0430
        \u043C\u0435\u043D\u044F \u0436\u0434\u0451\u0442 \u0410\u043B\u0438\u043D\u0430.
        \u0421\u0442\u043E\u0438\u0442 \u0438 \u043F\u0435\u0440\u0435\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F
        \u0441 \u043D\u043E\u0433\u0438 \u043D\u0430 \u043D\u043E\u0433\u0443. \u041F\u0440\u0435\u043B\u0435\u0441\u0442\u044C.
        \u041D\u0443 \u0432\u043E\u0442 \u0436\u0435 \u043E\u043D\u0430 - \u0431\u0435\u043B\u0430\u044F
