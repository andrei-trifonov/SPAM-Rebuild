      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 8
      name: 2
      line: "\u041A \u043C\u043E\u043C\u0435\u043D\u0442\u0443, \u043A\u0430\u043A
        \u044F \u043F\u0440\u0438\u0448\u043B\u0430 \u0434\u043E\u043C\u043E\u0439,
        \u0440\u0443\u043A\u0438 \u0443\u0436\u0435 \u0431\u044B\u043B\u0438 \u0433\u043E\u0442\u043E\u0432\u044B
        \u043E\u0442\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F \u043E\u0442
        \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438. \u0421 \u043D\u0435\u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435\u043C
        \u044F \u043F\u043E\u0434\u0431\u0435\u0436\u0430\u043B\u0430 \u043A \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044E
        \u0438 \u0432\u043E\u0442\u043A\u043D\u0443\u043B\u0430 \u0432\u0441\u0435
        \u043D\u0443\u0436\u043D\u044B\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u0430,
        \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445
        \u043F\u043E\u0440\u0442\u043E\u0432 \u0443 \u043C\u0430\u0448\u0438\u043D\u044B
        \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.\r\n"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
