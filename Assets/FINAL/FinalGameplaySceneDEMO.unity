    - type: 0
      name: 2
      line: "\u0421\u043A\u0432\u043E\u0437\u044C \u0437\u0430\u043C\u044B\u043B\u0435\u043D\u044B\u0435
        \u0449\u0435\u043B\u0438 \u0432 \u0437\u0430\u0441\u043F\u0430\u043D\u043D\u044B\u0445
        \u0433\u043B\u0430\u0437\u0430\u0445 \u044F \u0432\u0438\u0436\u0443 \u0447\u0435\u0439-\u0442\u043E
        \u0437\u0432\u0435\u0440\u0438\u043D\u044B\u0439 \u043E\u0441\u043A\u0430\u043B...
        \u0410... \u041D\u0435\u0442... \u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
        \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F \u0440\u043E\u0436\u0430
        \u0421\u043E\u043D\u0438."
