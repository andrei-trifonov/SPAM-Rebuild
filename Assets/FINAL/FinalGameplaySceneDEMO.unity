    - type: 0
      name: 2
      line: "\u041A\u0430\u0436\u0434\u0430\u044F \u0441\u0442\u0443\u043F\u0435\u043D\u044C\u043A\u0430
        \u0434\u0430\u0435\u0442\u0441\u044F \u0441 \u0442\u0440\u0443\u0434\u043E\u043C,
        \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C \u0432 \u043D\u043E\u0433\u0430\u0445
        \u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435
        \u0434\u0430\u044E\u0442 \u043E \u0441\u0435\u0431\u0435 \u0437\u043D\u0430\u0442\u044C.
        \u0412\u043E\u0442, \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u043B\u0435\u0441\u0442\u043D\u0438\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u043B\u0451\u0442.
        \u042F \u043F\u043E\u0434\u044B\u043C\u0430\u044E \u0432\u0437\u0433\u043B\u044F\u0434,
        \u0438 \u043F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0432\u043D\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u0440\u0430\u0437\u043C\u0435\u0440\u0430 \u043A\u043E\u0440\u043E\u0431\u043A\u0430."
