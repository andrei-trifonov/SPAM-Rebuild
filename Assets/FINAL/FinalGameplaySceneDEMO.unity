    - type: 0
      name: 2
      line: "\u0412\u043B\u0430\u0436\u043D\u044B\u0439 \u0430\u0441\u0444\u0430\u043B\u044C\u0442
        \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438 \u043D\u0430\u0447\u0430\u043B
        \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F
        \u043A\u0440\u0430\u0441\u043D\u044B\u043C \u0438 \u0441\u0438\u043D\u0438\u043C.
        \u0422\u043E \u043A\u0440\u0430\u0441\u043D\u044B\u043C, \u0442\u043E \u0441\u0438\u043D\u0438\u043C.
        \u0421\u043D\u043E\u0432\u0430 \u043A\u0440\u0430\u0441\u043D\u044B\u043C,
        \u0438 \u0441\u043D\u043E\u0432\u0430 \u0441\u0438\u043D\u0438\u043C. \u042F
        \u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u0443.
        \u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0430\u044F \u043C\u0430\u0448\u0438\u043D\u0430.
        \u0418 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439,
        \u0441\u0438\u0434\u044F\u0449\u0438\u0439 \u043D\u0430 \u043A\u0430\u043F\u043E\u0442\u0435. "
