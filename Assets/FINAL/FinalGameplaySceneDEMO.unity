    - type: 0
      name: 2
      line: "\u042D\u0442\u043E \u043B\u0443\u0447\u0448\u0435\u0435, \u0447\u0442\u043E
        \u044F \u043A\u043E\u0433\u0434\u0430-\u043B\u0438\u0431\u043E \u0435\u043B\u0430
        \u0432 \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438! \n\u0421\u043E\u043D\u044F
        \u0434\u043E\u043B\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u0430\u0441\u044C,
        \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0437\u0430\u0440\u0436\u0430\u0442\u044C
        \u0441  \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u044F \u043D\u0430\u0431\u0438\u0432\u0430\u044E
