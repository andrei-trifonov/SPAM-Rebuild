    - type: 0
      name: 2
      line: "\u0421\u043E\u0431\u0440\u0430\u0432\u0448\u0438\u0441\u044C \u0441
        \u0441\u0438\u043B\u0430\u043C\u0438, \u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u0432\u043D\u0438\u0437, \u043D\u0430 \u0433\u043E\u0440\u043E\u0434, \u0431\u0443\u0434\u0442\u043E
        \u043D\u044B\u0440\u043D\u0443\u0432 \u043B\u0438\u0446\u043E\u043C \u0432
        \u043F\u0440\u043E\u0440\u0443\u0431\u044C. \u0417\u0435\u043C\u043B\u044F
        - \u0441\u0448\u0438\u0442\u044B\u0435 \u043A\u043B\u043E\u0447\u044C\u044F
        \u043B\u043E\u0441\u043A\u0443\u0442\u043D\u043E\u0433\u043E \u043E\u0434\u0435\u044F\u043B\u0430.
        \u041E\u0440\u043D\u0430\u043C\u0435\u043D\u0442 \u0438\u0437 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0445\u0441\u044F
        \u043E\u043A\u043E\u043D \u0438 \u0444\u043E\u043D\u0430\u0440\u0435\u0439... "
