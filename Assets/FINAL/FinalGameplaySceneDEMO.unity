    - type: 0
      name: 2
      line: "\u0421\u043D\u043E\u0432\u0430 \u0437\u0432\u0443\u043A \u0443\u0434\u0430\u0440\u043E\u0432
        \u0432 \u0434\u0432\u0435\u0440\u044C. \u041D\u0430 \u044D\u0442\u043E\u0442
        \u0440\u0430\u0437 \u0433\u0440\u043E\u043C\u0447\u0435. \u0427\u0442\u043E
        \u0435\u043C\u0443 \u043E\u0442 \u043C\u0435\u043D\u044F \u043D\u0443\u0436\u043D\u043E...
        \u0411\u0435\u0437\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0439
        \u043C\u0430\u043D\u044C\u044F\u0447\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434
        \u0431\u044B\u043B \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D
        \u043D\u0435 \u043D\u0430 \u0434\u0432\u0435\u0440\u044C, \u0430 \u0441\u043A\u0432\u043E\u0437\u044C
        \u043D\u0435\u0435, \u0431\u0443\u0434\u0442\u043E \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0435\u043B
        \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043C\u0435\u043D\u044F.  \u041D\u0435\u0443\u0436\u0435\u043B\u0438
        \u043E\u043D \u043F\u0440\u0438\u0448\u0435\u043B \u0438\u0437-\u0437\u0430
        \u0442\u043E\u0433\u043E \u0442\u0440\u0443\u043F\u0430 \u0432 \u0442\u0443\u0430\u043B\u0435\u0442\u0435?
        \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u044D\u0442\u043E...\n"
