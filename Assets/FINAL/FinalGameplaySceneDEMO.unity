    - type: 0
      name: 2
      line: "\u0411\u0435\u0436\u0430\u0442\u044C, \u0431\u0435\u0436\u0430\u0442\u044C,
        \u0431\u0435\u0436\u0430\u0442\u044C \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
        \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0435\u0431\u0430\u043D\u0443\u0442\u043E\u0433\u043E
