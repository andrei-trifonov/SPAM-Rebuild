      name: 2
      line: "-\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C, \u043C\u043E\u0436\u0435\u043C
        \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u043D\u0430 \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044C
        \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C... \u041F\u043E\u0442\u043E\u043C.  
        \u0414\u0443\u043C\u0430\u044E, \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
        \u043E\u0434\u043D\u043E\u043A\u043B\u0430\u0441\u0441\u043D\u0438\u043A\u043E\u0432
        \u043A\u0430\u043A \u0440\u0430\u0437 \u0443\u0431\u0435\u0436\u0430\u043B\u0438
        \u0442\u0443\u0434\u0430... \u0414\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C,
        \u0442\u0430\u043C \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u0435\u0441\u0435\u043B\u043E.\r"
