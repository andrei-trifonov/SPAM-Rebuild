    - type: 0
      name: 2
      line: "\u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E
        \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435.
        \u0412\u043C\u0435\u0441\u0442\u043E \u0437\u0430\u043D\u0443\u0434\u043D\u044B\u0445
        \u0443\u0440\u043E\u043A\u043E\u0432 \u044F \u0441 \u0410\u043B\u0438\u043D\u043E\u0439
        \u0438\u0434\u0443 \u043D\u0430 \u0440\u0435\u0447\u043A\u0443. \u041A\u0443\u043F\u0430\u0442\u044C\u0441\u044F,
        \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0432\u0430\u0442\u043E,
        \u043D\u043E \u044F \u0438 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C
        - \u043A\u0430\u043A \u043F\u043E \u043C\u043D\u0435, \u043B\u0443\u0447\u0448\u0435
        \u0432\u0441\u0435\u0433\u043E - \u0437\u0430\u0433\u043E\u0440\u0430\u0442\u044C
        \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
