    - type: 0
      name: 2
      line: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0437\u0432\u043E\u043D\u043E\u043A
        \u0432\u044B\u0431\u0438\u043B \u043C\u0435\u043B\u043E\u0434\u0438\u044E,
        \u0441\u043E\u043E\u0431\u0449\u0430\u044E\u0449\u0443\u044E \u043E\u0431
        \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0438 \u0443\u0440\u043E\u043A\u0430,
        \u0438 \u043A\u043B\u0430\u0441\u0441 \u043C\u0438\u0433\u043E\u043C \u043E\u043F\u0443\u0441\u0442\u0435\u043B."
