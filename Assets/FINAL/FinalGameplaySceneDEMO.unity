    - type: 0
      name: 0
      line: "\n// Here, in this digital void, they find moments of peace, where their
        thoughts quietly echo off invisible walls.\nvoid MeatMachine* machine) {\n   
        // comment: here, in this digital void, she finds moments of peace - where
        her thoughts softly echo off invisible walls\n    machine->system_restart();\n}"
      font: 4
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
