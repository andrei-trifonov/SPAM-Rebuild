    - type: 0
      name: 2
      line: "\u041F\u043E\u0432\u0438\u0441\u043B\u0430 \u043D\u0435\u043B\u043E\u0432\u043A\u0430\u044F
        \u0442\u0438\u0448\u0438\u043D\u0430. \u041A\u0438\u0440 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F
        \u0441 \u043C\u044B\u0441\u043B\u044F\u043C\u0438, \u0433\u043B\u044F\u0434\u044F
        \u0441\u0435\u0431\u0435 \u043F\u043E\u0434 \u043D\u043E\u0433\u0438 \u0438
        \u0448\u043E\u0440\u043A\u0430\u044F \u043F\u043E\u0434\u043E\u0448\u0432\u043E\u0439
        \u043E \u0437\u0430\u0441\u0442\u044B\u0432\u0448\u0438\u0439 \u0433\u0443\u0434\u0440\u043E\u043D,
