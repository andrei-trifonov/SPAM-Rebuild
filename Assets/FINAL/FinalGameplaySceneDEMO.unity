    - type: 0
      name: 2
      line: "\u041C\u0438\u0440 \u0432\u043E\u043A\u0440\u0443\u0433 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F
        \u043D\u0430 \u043A\u0443\u0441\u043E\u0447\u043A\u0438 \u0438 \u0440\u0430\u0441\u0442\u0430\u044F\u043B
        \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445. \u041C\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
        \u0432 \u0442\u0435\u0441\u043D\u043E\u043C  \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435,
        \u0441 \u043F\u043E\u0442\u043E\u043B\u043E\u043A\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
        \u0441\u0432\u0438\u0441\u0430\u043B\u0438 \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u043D\u044B\u0435
