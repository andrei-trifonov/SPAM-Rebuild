    - type: 0
      name: 2
      line: "\u041D\u0430 \u0410\u043B\u0438\u043D\u0443 \u0441\u0432\u0430\u043B\u0438\u043B\u0438
        \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
        \u0437\u0430\u043F\u0443\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
        \u043A\u043D\u0438\u0436\u043A\u0438 \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C,
        \u043F\u0440\u043E\u0442\u0438\u0440\u0430\u0442\u044C \u043F\u044B\u043B\u044C,
        \u043F\u043E\u043B\u0438\u0432\u0430\u0442\u044C \u0446\u0432\u0435\u0442\u044B,
        \u0438 \u0437\u0430\u043C\u0435\u043D\u044F\u0442\u044C \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u0447\u043D\u0443\u044E
        \u0442\u0435\u0442\u043A\u0443, \u043A\u043E\u0433\u0434\u0430 \u0435\u0435
        \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
