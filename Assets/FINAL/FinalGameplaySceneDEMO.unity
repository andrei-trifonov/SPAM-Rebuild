    - type: 0
      name: 2
      line: "\u0415\u0435 \u043D\u043E\u0433\u0438 \u043C\u043E\u0449\u043D\u043E
        \u0432\u043F\u0435\u0447\u0430\u0442\u044B\u0432\u0430\u043B\u0438\u0441\u044C
        \u0432 \u0437\u0435\u043C\u043B\u044E, \u043F\u043E\u0434\u044B\u043C\u0430\u044F
        \u043F\u044B\u043B\u044C. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
        \u043D\u0430 \u0432\u0441\u044E \u043A\u0430\u0437\u0430\u0432\u0448\u0443\u044E\u0441\u044F
        \u0445\u0440\u0443\u043F\u043A\u043E\u0441\u0442\u044C \u044D\u0442\u0438\u0445
        \u0433\u043B\u0430\u0434\u043A\u0438\u0445 \u0434\u043B\u0438\u043D\u043D\u044B\u0445
        \u043D\u043E\u0433, \u0431\u044B\u043B\u043E \u0441\u043B\u043E\u0436\u043D\u043E
        \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C \u043E\u0431\u044A\u0435\u043C\u043D\u044B\u0435
        \u043C\u044B\u0448\u0446\u044B. "
