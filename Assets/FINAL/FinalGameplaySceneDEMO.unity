      name: 2
      line: "\u041E\u0431\u044B\u0447\u043D\u043E \u0444\u043E\u043D \u0432\u043E\u043A\u0440\u0443\u0433
        \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0437\u0432\u0443\u043A\u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
        \u0448\u0430\u0433\u043E\u0432, \u043A\u0430\u043F\u0435\u043B\u044C \u0438
        \u043D\u0435\u0436\u043D\u043E\u0433\u043E \u0432\u0435\u0442\u0440\u0430
