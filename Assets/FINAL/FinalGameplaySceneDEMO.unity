    - type: 8
      name: 2
      line: "\u041C\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0438\u0441\u044C
        \u0432 \u0435\u0433\u043E \u043C\u0430\u0448\u0438\u043D\u0443. \u041A\u0430\u043A
        \u043E\u0431\u044B\u0447\u043D\u043E \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
        \u0441\u0438\u043B\u044C\u043D\u043E \u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430
        \u0434\u0432\u0435\u0440\u044C\u044E, \u0437\u0430 \u0447\u0442\u043E \u0431\u044B\u043B\u0430
        \u043E\u0442\u0447\u0438\u0442\u0430\u043D\u0430.\n\n\u0415\u0445\u0430\u0442\u044C
        \u0432 \u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u044C \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E.
        \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E,
        \u0447\u0442\u043E \u044F \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0440\u0430\u0437 \u043D\u0430\u0432\u0435\u0449\u0430\u043B\u0430 \u0421\u043E\u043D\u044E,
        \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043A \u044D\u0442\u043E\u043C\u0443
        \u043F\u0440\u0438\u0432\u044B\u043A\u043D\u0443\u0442\u044C. \u042F \u0432\u0435\u0434\u044C
        \u0441\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C?\n\n\u0418 \u043F\u0443\u0441\u0442\u044C
        \u043C\u043D\u0435 \u0442\u044F\u0436\u0435\u043B\u043E \u0435\u0435 \u0432\u0438\u0434\u0435\u0442\u044C
        \u0442\u0430\u043A\u043E\u0439... \u042F \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E
        \u0433\u043E\u0442\u043E\u0432\u0430 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
        \u0432\u0441\u0435, \u0447\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E
        \u043C\u043E\u0436\u043D\u043E, \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u044B
        \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0435 \u0441\u043D\u043E\u0432\u0430,
        \u0445\u043E\u0442\u044C \u0447\u0435\u0440\u0435\u0437 \u043E\u043A\u043E\u0448\u043A\u043E.
        \u0421\u043E\u043D\u044F..."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
