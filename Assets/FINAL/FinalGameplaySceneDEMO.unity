    - type: 0
      name: 2
      line: "\u041C\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0448\u0438\u043F\u0443\u0447\u0438\u0435
        \u0431\u0430\u043D\u043A\u0438. \u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437
        \u043F\u043E\u0432\u0435\u0437\u043B\u043E, \u0438 \u0436\u0438\u0436\u0430
        \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0432\u0441\u043F\u0435\u043D\u0438\u043B\u0430\u0441\u044C.
        \"\u041A\u043E\u0444\u0435\u0438\u043D +\u0422\u0430\u0443\u0440\u0438\u043D.
        \u0421\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C,
        \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u043E \u043A \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u044E
        \u0441 18 \u043B\u0435\u0442. \". \u0414\u0430, \u0434\u0430... \u042F \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0442\u0435\u0431\u044F \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u044E,
        \u0431\u0430\u043D\u043E\u0447\u043A\u0430. "
