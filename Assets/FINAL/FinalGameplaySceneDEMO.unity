    - type: 0
      name: 13
      line: "-\u041D\u0430\u0448\u0435 \u0434\u0435\u043B\u043E - \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C
        \u0438\u043B\u0438 \u043E\u043F\u0440\u043E\u0432\u0435\u0440\u0433\u043D\u0443\u0442\u044C.
        \u0417\u0430\u0442\u0435\u043C \u0438 \u0441\u043D\u0438\u043C\u0430\u0435\u043C
        \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442."
