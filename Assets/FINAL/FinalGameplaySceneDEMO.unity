      name: 2
      line: "\u0411\u043B\u0438\u043D, \u043D\u0443 \u0438 \u0442\u044F\u0436\u0435\u043B\u0430\u044F
        \u0436\u0435 \u0445\u0440\u0435\u043D\u043E\u0442\u0435\u043D\u044C!\r\n\u042F
        \u0437\u0430\u0447\u0435\u043C-\u0442\u043E \u043F\u043E\u0441\u0442\u0443\u0447\u0430\u043B\u0430
        \u043F\u043E \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439
        \u0441\u0444\u0435\u0440\u0435 \u0438 \u043F\u043E\u0434\u043D\u0435\u0441\u043B\u0430
        \u043A \u0443\u0445\u0443. \u0412\u043D\u0443\u0442\u0440\u0438 \u0441\u043B\u044B\u0448\u0430\u043B\u0441\u044F
        \u0433\u0443\u043B.  \u0418 \u044D\u0442\u0430 \u0448\u0442\u0443\u043A\u0430
        \u043D\u0443\u0436\u043D\u0430 \u0434\u043B\u044F \u0432\u044B\u0445\u043E\u0434\u0430
        \u0432 \u0441\u0435\u0442\u044C? \u0418 \u043A\u0430\u043A \u0436\u0435 \u044F
        \u0431\u0443\u0434\u0443 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
        \u043D\u0430 \u043C\u043E\u043D\u0438\u0442\u043E\u0440? \u041D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
        \u043A\u0430\u043A \u044D\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435
        \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
      time: 0
      value: 0
