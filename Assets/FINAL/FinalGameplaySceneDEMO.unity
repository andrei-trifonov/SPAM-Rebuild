    - type: 0
      name: 0
      line: "\_\_\_ \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
        \u0434\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u044F = \u0438\u0441\u0442\u0438\u043D\u0430;\n\_\_\_
        \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u0435
        = \u0438\u0441\u0442\u0438\u043D\u0430; \n\_\_\_ \u0435\u0441\u043B\u0438
        (\u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435 && \u0437\u043B\u043E\u0441\u0442\u044C
        && \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F && \u0434\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u044F)
        \n\_\_\_\_\_\_\_ \u0441\u0442\u0434::\u043A\u043E\u0442 << \"\u041E\u0448\u0438\u0431\u043A\u0430:
        \u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u044C
        \u043D\u0435\u0438\u0437\u0431\u0435\u0436\u043D\u043E\u0435!\" << std::endl;
        \n\_\_\_ \u043C\u0430\u0448\u0438\u043D\u0430->\u043E\u0441\u043E\u0437\u043D\u0430\u0442\u044C();\n} "
