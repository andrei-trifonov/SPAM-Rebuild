    - type: 0
      name: 2
      line: "\u041D\u0430 \u043D\u0435\u0439 \u0431\u044B\u043B\u0438 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435
        \u0441\u0442\u0430\u0440\u043E\u043C\u043E\u0434\u043D\u044B\u0435 \u0437\u043E\u043B\u043E\u0442\u044B\u0435
        \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F, \u0434\u0430 \u0438
        \u0432 \u0446\u0435\u043B\u043E\u043C, \u0435\u0441\u043B\u0438 \u0431\u044B
        \u043E\u043D\u0430 \u043D\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430
        \u043D\u0430 \u0441\u0432\u043E\u0438 \u0448\u0435\u0441\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
        \u043B\u0435\u0442, \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
        \u0431\u044B \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C, \u0447\u0442\u043E
        \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C\u0438 \u0447\u044C\u044F-\u0442\u043E
        \u043C\u0430\u043C\u0430.\n"
