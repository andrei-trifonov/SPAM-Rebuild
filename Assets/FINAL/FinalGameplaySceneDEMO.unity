    - type: 0
      name: 0
      line: "void HeartBeat(meat_machine* machine) {\n    steps++;\n    display(steps
        % 2 == 0 ? \"thump\" : \"tick\");\n    if (!machine->heart.step()){\n       
        ~meat_machine();\n    }\n}"
      font: 4
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
