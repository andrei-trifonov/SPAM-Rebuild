    - type: 0
      name: 2
      line: "\u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
        \u0441\u0442\u0443\u043A\u0430 \u043D\u0435\u0440\u0432\u043D\u043E \u0437\u0430\u0434\u0432\u0438\u0433\u0430\u043B\u0430\u0441\u044C
        \u0440\u0443\u0447\u043A\u0430 \u0434\u0432\u0435\u0440\u0438 - \u0432\u0432\u0435\u0440\u0445
        \u0438 \u0432\u043D\u0438\u0437, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0431\u0443\u0434\u0442\u043E \u043E\u043D\u0430 \u0441\u0435\u0439\u0447\u0430\u0441
        \u0432\u044B\u043F\u0440\u044B\u0433\u043D\u0435\u0442 \u0432\u043C\u0435\u0441\u0442\u0435
        \u0441 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u043E\u043C \u0437\u0430\u043C\u043A\u0430.
