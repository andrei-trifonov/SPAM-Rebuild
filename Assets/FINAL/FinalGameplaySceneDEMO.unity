    - type: 0
      name: 5
      line: "-\u0422\u043E\u0433\u0434\u0430 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C,
        \u043E\u0442\u043A\u0443\u0434\u0430 \u044D\u0442\u0438 \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0438.\r"
