    - type: 0
      name: 2
      line: "\u041C\u0435\u043D\u044F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
        \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u043E. \u041C\u044B\u0441\u043B\u0438
        \u043F\u0443\u0442\u0430\u044E\u0442\u0441\u044F, \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
        \u0438 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F
        \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u043E\u0434\u043D\u043E
        \u0446\u0435\u043B\u043E\u0435. \u041A\u043E\u0433\u0434\u0430 \u0421\u043E\u043D\u044F
        \u0432\u043A\u043E\u043B\u043E\u043B\u0430 \u043C\u043D\u0435 \u044D\u0442\u0443
        \u0434\u0440\u044F\u043D\u044C, \u044F \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
        \u0447\u0442\u043E-\u0442\u043E... \u0421\u0442\u0440\u0430\u043D\u043D\u043E\u0435."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
