      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 4
      line: -I shouldn't...
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
