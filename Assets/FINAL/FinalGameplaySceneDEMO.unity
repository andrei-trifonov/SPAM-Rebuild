    - type: 0
      name: 2
      line: "\u041B\u0435\u0434\u044F\u043D\u044B\u0435 \u0431\u0440\u044B\u0437\u0433\u0438
        \u0441\u0440\u0430\u0437\u0443 \u043F\u0440\u0438\u0432\u0435\u043B\u0438
        \u043C\u0435\u043D\u044F \u0432 \u0447\u0443\u0432\u0441\u0442\u0432\u0430.
        \u0412 \u0433\u043E\u043B\u043E\u0432\u0435 \u0448\u0443\u043C\u0435\u043B\u043E,
        \u0430 \u043A \u0433\u043E\u0440\u043B\u0443 \u043F\u043E\u0434\u043A\u0430\u0442\u044B\u0432\u0430\u043B
        \u0442\u043E\u0448\u043D\u043E\u0442\u0432\u043E\u0440\u043D\u044B\u0439
        \u043A\u043E\u043C."
