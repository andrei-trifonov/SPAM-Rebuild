    - type: 0
      name: 2
      line: "\u041C\u043E\u044F \u0433\u043E\u043B\u043E\u0432\u0430 - \u043A\u043E\u043C\u043D\u0430\u0442\u0430
        \u0441 \u043F\u043E\u043B\u043E\u0447\u043A\u0430\u043C\u0438, \u043F\u043E\u043B\u043D\u0430\u044F
        \u0440\u0430\u0437\u043D\u044B\u0445 \u043A\u043D\u0438\u0433, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u044F \u043F\u0438\u0448\u0443 \u0441\u0432\u043E\u0438 \u043C\u044B\u0441\u043B\u0438.
        \u0412\u0441\u0435 \u0432 \u043D\u0438\u0445 \u0441\u0432\u044F\u0437\u0430\u043D\u043E
        \u0432 \u0435\u0434\u0438\u043D\u043E\u0435 \u0446\u0435\u043B\u043E\u0435,
        \u0438 \u0443 \u0432\u0441\u0435\u0433\u043E \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0438
        \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u0438 \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435. "
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
