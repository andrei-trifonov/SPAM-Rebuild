      line: "\u0418 \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439
        \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0442\u0441\u044F \u0432
        \u0441\u0435\u0442\u044C, \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
        \u0435\u0435 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C \u0431\u0443\u0434\u0435\u0442
        \u043F\u043E\u0445\u043E\u0436\u0430 \u043D\u0430 \u0442\u0443, \"\u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u0443\u044E\"
        \u0421\u043E\u043D\u044E. "
