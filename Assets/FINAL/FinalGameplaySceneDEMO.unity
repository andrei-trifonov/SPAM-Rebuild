    - type: 0
      name: 2
      line: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041C\u043D\u0435 \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E\_
        \u0432\u043E\u0442 \u0442\u0430\u043A \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C
        \u0433\u043E\u043B\u043E\u0441. \u042D\u0442\u043E \u041C\u0438\u0440\u0430.
        \u041C\u0438\u0440\u0430 \u041A\u0430\u043B\u0438\u043D\u0438\u043D\u0430.
        \u0412\u044B... \u0417\u043D\u0430\u0435\u0442\u0435 \u043E\u0431\u043E \u043C\u043D\u0435?
        \u042D\u0442\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u0435\u0441\u043B\u0438
        \u0437\u043D\u0430\u0435\u0442\u0435.\_"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
