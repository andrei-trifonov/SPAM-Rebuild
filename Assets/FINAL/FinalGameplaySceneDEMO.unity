    - type: 0
      name: 2
      line: "\u042F \u043E\u0433\u043B\u044F\u0434\u0435\u043B\u0430 \u0441\u0432\u043E\u0439
        \u0434\u0432\u043E\u0440. \u041E\u043D \u0443\u0436\u0435 \u0441\u043F\u0430\u043B.
        \u0412\u0438\u0434\u0438\u043C\u043E, \u0441\u0435\u0439\u0447\u0430\u0441
        \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \"\u043D\u043E\u0447\u044C\".
        \u042F \u0434\u0430\u0432\u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430
        \u0441\u0447\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438... \u0418
        \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u044D\u0442\u043E,
        \u043C\u0438\u0440 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
        \u0436\u0438\u0442\u044C, \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435
        \u0437\u0430\u043C\u0435\u0447\u0430\u044F \u043C\u0435\u043D\u044F. \u041F\u043B\u043E\u0445\u043E
        \u043B\u0438 \u044D\u0442\u043E? \u0418 \u0434\u043E\u043B\u0436\u0435\u043D
        \u043B\u0438 \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u044C
        \u043C\u0435\u043D\u044F? \u041A\u0442\u043E \u044F \u0442\u0430\u043A\u0430\u044F,
        \u0447\u0442\u043E\u0431\u044B \u0441\u043E \u043C\u043D\u043E\u0439 \u0441\u0447\u0438\u0442\u0430\u043B\u0438\u0441\u044C?
        \u042F \u0436\u0438\u0432\u0443 \u0441\u0435\u0431\u0435 \u0438 \u0436\u0438\u0432\u0443,
        \u0433\u0434\u0435-\u0442\u043E \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E...\n"
