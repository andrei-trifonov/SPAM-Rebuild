    - type: 0
      name: 2
      line: "\u0418\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u043A \u043D\u0430\u043C
        \u0432\u044B\u0448\u0435\u043B \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
        \u0441\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u043A
