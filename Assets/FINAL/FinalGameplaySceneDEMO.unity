    - type: 0
      name: 2
      line: "\u0421\u043E\u043D\u044F \u0442\u0430\u043A \u043F\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E,
        \u0431\u0443\u0434\u0442\u043E \u0432 \u043D\u0435\u0439 \u043D\u0435 \u0431\u044B\u043B\u043E
        \u043D\u0438 \u0435\u0434\u0438\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u0438,
        \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430 \u0440\u0438\u0442\u043C\u0443,
        \u0442\u043E \u0438 \u0434\u0435\u043B\u043E \u0440\u0430\u0437\u0432\u043E\u0434\u044F
        \u0440\u0443\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u0441\u043D\u043E\u0432\u0430
        \u0432\u044B\u043F\u0438\u0441\u0430\u0442\u044C \u0438\u043C\u0438 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E
        \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u0443.\_"
