    - type: 0
      name: 2
      line: "\u041A\u0438\u0440 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435
        \u043F\u0440\u0438\u0448\u0435\u043B \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C.
        \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043E\u043D \u0437\u0430\u0431\u043E\u043B\u0435\u043B.
        \u041F\u0435\u0440\u0435\u0435\u0437\u0434 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
        \u043E\u0441\u043B\u0430\u0431\u0438\u043B \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C,
        \u0438 \u0432\u043E\u0442 - \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
