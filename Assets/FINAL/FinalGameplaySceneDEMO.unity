        \u0440\u0443\u043A\u0443. \u0421\u0442\u0430\u0440\u0430\u044F\u0441\u044C
        \u043D\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u0438\u0442\u044C \u0435\u0439
        \u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u0438, \u044F \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C
        \u043D\u0430\u0432\u0435\u0440\u0445, \u0438 \u0432\u043E\u0442 \u043C\u044B
        \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u043D\u0438\u0436\u043D\u0435\u0439
