    - type: 0
      name: 2
      line: "\u0423 \u0442\u0451\u0442\u0438 \u043F\u043E\u0434 \u0437\u043E\u043D\u0442\u0438\u043A\u043E\u043C
        \u043C\u044B \u0432\u0437\u044F\u043B\u0438 \u0432\u043A\u0443\u0441\u043D\u044F\u0448\u0435\u043A
        - \u043B\u044E\u0447\u043E\u043A \u043E\u0442\u043A\u0440\u044B\u043B\u0441\u044F,
        \u0438 \u0438\u0437 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u043E\u0432\u0430\u043B\u0438\u043B
        \u043F\u0430\u0440, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
        \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
        \u0441\u043E\u0441\u0438\u0441\u043A\u0430 \u0434\u043B\u044F \u0445\u043E\u0442-\u0434\u043E\u0433\u0430,
