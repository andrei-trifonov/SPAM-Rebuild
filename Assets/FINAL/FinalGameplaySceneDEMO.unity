    - type: 0
      name: 2
      line: "\u041C\u043E\u0439 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
        \u0433\u043E\u043B\u043E\u0441 \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
        \u043F\u0440\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u0441\u043A\u0432\u043E\u0437\u044C
        \u0448\u0443\u043C \u0438 \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E,
        \u043D\u043E \u0442\u0443\u043F\u043E\u0435 \u0436\u0435\u043B\u0430\u043D\u0438\u0435
        \u0431\u044B\u0442\u044C \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u043D\u043E\u0439
        \u044D\u043A\u0440\u0430\u043D\u043E\u043C \u0432\u0437\u044F\u043B\u043E
        \u0432\u0435\u0440\u0445. \u0418 \u0432 \u044D\u0442\u043E\u043C \u043C\u043E\u043C\u0435\u043D\u0442\u0435
        \u044F \u0443\u0437\u043D\u0430\u043B\u0430 \u0441\u0435\u0431\u044F."
