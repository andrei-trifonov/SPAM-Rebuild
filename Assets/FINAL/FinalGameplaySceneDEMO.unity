  - name: break 0.2.8.2
    lines:
    - type: 0
      name: 2
      line: "-\u041D\u0443-\u043D\u0443, \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u044C.
        \u0412\u0441\u0435 \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E.
        \u0418 \u044D\u0442\u0430 \u0431\u043E\u043B\u044C \u0440\u0430\u043D\u043E
        \u0438\u043B\u0438 \u043F\u043E\u0437\u0434\u043D\u043E \u043F\u0440\u043E\u0439\u0434\u0451\u0442.\r\n"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
