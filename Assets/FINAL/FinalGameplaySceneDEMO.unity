  - name: A1.1
    lines:
    - type: 0
      name: 2
      line: "\u042F \u0440\u0435\u0448\u0438\u043B\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044C.
        \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u043E\u0431 \u044D\u0442\u043E\u043C
        \u0435\u0449\u0435 \u043F\u043E\u0436\u0430\u043B\u0435\u044E...\n\u041A\u043E\u043B\u0435\u0431\u0430\u044F\u0441\u044C,
        \u044F \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0430 \u0449\u0435\u043A\u043E\u043B\u0434\u0443
        \u0432\u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u041D\u0435 \u0434\u043E\u0436\u0438\u0434\u0430\u044F\u0441\u044C
        \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F, \u0422\u043E\u043B\u0438\u043A
        \u0434\u0435\u0440\u043D\u0443\u043B \u0440\u0443\u0447\u043A\u0443 \u0434\u0432\u0435\u0440\u0438
        \u0438 \u0432\u043E\u0448\u0435\u043B \u0432\u043D\u0443\u0442\u0440\u044C
        \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B.\r\n"
