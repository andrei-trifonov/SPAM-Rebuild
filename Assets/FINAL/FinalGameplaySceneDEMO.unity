    - type: 0
      name: 2
      line: "\u041F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u043C\u043D\u0435
        \u043E\u0447\u0435\u043D\u044C \u0437\u043D\u0430\u043A\u043E\u043C\u043E
        \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E... \u0413\u0434\u0435 \u044F
        \u043C\u043E\u0433\u043B\u0430 \u0435\u0433\u043E \u0432\u0438\u0434\u0435\u0442\u044C
        \u0440\u0430\u043D\u044C\u0448\u0435? \u0417\u0432\u0443\u043A\u0438 \u0440\u0435\u043B\u0435
        \u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
        \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u0432 \u043E\u0442\u043E\u0432\u0441\u044E\u0434\u0443
        \u0448\u0435\u043F\u0447\u0443\u0442 \u043C\u043D\u0435 \u043E \u0447\u0435\u043C-\u0442\u043E,
        \u043D\u043E \u044F \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E. "
