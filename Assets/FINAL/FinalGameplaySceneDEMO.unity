    - type: 0
      name: 2
      line: "\u041D\u0430 \u043D\u043E\u0441\u043E\u0447\u043A\u0430\u0445 \u044F
        \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C \u043A
        \u0432\u0445\u043E\u0434\u043D\u043E\u0439 \u0434\u0432\u0435\u0440\u0438.
        \u0421\u043D\u043E\u0432\u0430 \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
        \u0441\u0442\u0443\u043A. \u0412 \u0433\u043B\u0430\u0437\u043A\u0435 \u044F
        \u0441\u0440\u0430\u0437\u0443 \u0443\u0432\u0438\u0434\u0435\u043B\u0430
        \u0444\u0443\u0440\u0430\u0436\u043A\u0443, \u043D\u0435\u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
        \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u0443\u044E \u043D\u0430 \u0443\u0440\u043E\u0434\u043B\u0438\u0432\u043E\u0435
        \u043B\u0438\u0446\u043E. \u042D\u0442\u043E \u0422\u043E\u043B\u0438\u043A...\r\n"
