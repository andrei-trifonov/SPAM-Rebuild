    - type: 8
      name: 2
      line: "\u0421 \u0442\u043E\u0433\u043E \u0434\u043D\u044F \u044F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F
        \u0431\u0443\u0434\u0442\u043E \u043D\u0430 \u043F\u0440\u0438\u0432\u044F\u0437\u0438.
        \u0412\u0435\u0447\u043D\u043E \u0438\u0434\u0443\u0449\u0438\u0435 \u0437\u0430
        \u043C\u043D\u043E\u0439 \u043C\u0438\u043B\u0438\u0446\u0438\u043E\u043D\u0435\u0440\u044B,
        \u0432\u0435\u0437\u0434\u0435 \u0441\u043B\u0435\u0434\u044F\u0449\u0438\u0435
        \u043A\u0430\u043C\u0435\u0440\u044B... \u0418 \u043C\u044B\u0441\u043B\u0438
        \u043E \u0421\u043E\u043D\u0435. \n\n\u042F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u043D\u0430\u0432\u0435\u0449\u0430\u044E \u0435\u0435,  \u043D\u0435 \u043C\u043E\u0433\u0443
        \u043E\u0442\u043E\u0439\u0442\u0438 \u0438 \u0448\u0430\u0433\u0443. \u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u0434\u0443\u043C\u0430\u044E \u043E \u0442\u043E\u043C, \u0447\u0442\u043E...
        \u042D\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u043B\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0442\u0438.
        \u0427\u0442\u043E \u044D\u0442\u043E \u0432\u0441\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
        \u0441\u043E\u043D \u0438 \u0432\u043F\u0440\u0430\u0432\u0434\u0443 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
        \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u044F.\n\n\u0410 \u0421\u043E\u043D\u044F
        \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0441\u0438\u0434\u0438\u0442
        \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u0435\u0439\u0447\u0430\u0441
        \u043D\u0430 \u043A\u0430\u0447\u0435\u043B\u044F\u0445 \u0432\u043E \u0434\u0432\u043E\u0440\u0435
        \u0438 \u0436\u0434\u0435\u0442 \u043C\u0435\u043D\u044F."
