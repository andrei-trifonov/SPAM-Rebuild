    - type: 0
      name: 2
      line: "\u0412\u043E\u043A\u0440\u0443\u0433 \u043E\u043A\u0430\u043C\u0435\u043D\u0435\u0432\u0448\u0435\u0433\u043E
        \u0441\u0442\u0432\u043E\u043B\u0430, \u043F\u043E\u043A\u0440\u044B\u0432\u0448\u0435\u0433\u043E\u0441\u044F
        \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0435\u0439\u0441\u044F
        \u043A\u043E\u0440\u043E\u0439 \u0438 \u043C\u0445\u043E\u043C \u043C\u043E\u0436\u043D\u043E
        \u0432\u043E\u0434\u0438\u0442\u044C \u0445\u043E\u0440\u043E\u0432\u043E\u0434\u044B
        \u043F\u043E \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430\u043C
        - \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043D \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439."
