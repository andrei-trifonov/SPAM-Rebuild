    - type: 0
      name: 2
      line: "\u041D\u0435 \u0441\u0442\u043E\u0438\u043B\u043E \u043C\u043D\u0435,
        \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0431\u0435\u0436\u0430\u0442\u044C...
        \u041C\u043E\u0436\u0435\u0442, \u0442\u0430\u043A \u043D\u0430 \u043C\u0435\u043D\u044F
        \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
        \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F. \u0418 \u0433\u043E\u0440\u043B\u043E
        \u0431\u043E\u043B\u0438\u0442... \u042F \u0441\u043F\u043B\u044E\u043D\u0443\u043B\u0430
        \u043D\u0430 \u0430\u0441\u0444\u0430\u043B\u044C\u0442, \u043F\u044B\u0442\u0430\u044F\u0441\u044C
        \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u043E\u0442
        \u0432\u043A\u0443\u0441\u0430 \u043A\u0440\u043E\u0432\u0438."
