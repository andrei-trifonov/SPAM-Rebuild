    - type: 0
      name: 2
      line: "\u0410\u043B\u0438\u043D\u0430 \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0430\u0441\u044C
        \u0432 \u043B\u0430\u0434\u043E\u0448\u043A\u0443. \u0418 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
        \u043D\u0430 \u043B\u0430\u0432\u043A\u0443 - \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C
        \u0437\u0430 \u0442\u0435\u043C, \u043A\u0430\u043A \u043A\u043B\u0430\u0441\u0441
        \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0444\u0438\u0437-\u0440\u043E\u0439.
        \u041D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u043E\u043D\u0430
        \u0441\u043A\u0443\u0447\u0430\u0435\u0442...  \u0415\u0439 \u0438 \u043F\u0440\u0430\u0432\u0434\u0430
        \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u043B\u043E \u0431\u044B
        \u0432\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u0442\u044C\u0441\u044F."
