    - type: 0
      name: 0
      line: "// my_material.silicon heart beats. #SET BITS = CONSENT sirens->city,
        where \nfor each(pixel, blood){ - each drop of blood, each byte - a soul's
        scream == exception.logging() }"
      font: 4
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
