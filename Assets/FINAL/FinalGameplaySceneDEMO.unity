    - type: 0
      name: 2
      line: "\u041A\u0438\u0440 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B
        \u0440\u0443\u043A\u0443, \u0438 \u044F \u0432\u0437\u044F\u043B\u0430 \u0435\u0435
        \u0432 \u0441\u0432\u043E\u044E. \n\u041A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u044F \u043F\u043E\u043A\u0440\u0430\u0441\u043D\u0435\u043B\u0430..."
