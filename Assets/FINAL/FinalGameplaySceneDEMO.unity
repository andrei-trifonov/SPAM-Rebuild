  - name: 0.2.6
    lines:
    - type: 0
      name: 2
      line: "\u042F \u043F\u043E\u043F\u043B\u0435\u043B\u0430\u0441\u044C \u0432\u0441\u043B\u0435\u0434
        \u041A\u0438\u0440\u0443. \u0412 \u0442\u0430\u043A\u0442 \u0435\u0433\u043E
        \u0448\u0430\u0433\u0443 \u0431\u043E\u043B\u0442\u0430\u043B\u0438\u0441\u044C
        \u0438\u0437 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
        \u043F\u0440\u043E\u0432\u043E\u0434\u0430, \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0449\u0438\u0435
        \u0440\u0430\u0437\u043D\u044B\u0435 \u043C\u043E\u0434\u0443\u043B\u0438
        \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E\u0439
        \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439 \u0448\u0442\u0443\u043A\u043E\u0432\u0438\u043D\u044B.\r"
