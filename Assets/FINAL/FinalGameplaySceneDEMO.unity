    - type: 0
      name: 2
      line: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043C\u044B \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B\u0438, \u043E\u0431\u043D\u044F\u0432\u0448\u0438\u0441\u044C
        \u0432 \u0442\u0438\u0448\u0438\u043D\u0435 - \u043C\u0443\u0437\u044B\u043A\u0430
        \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C.
        \u0412\u0440\u0435\u043C\u044F \u0431\u0443\u0434\u0442\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u043E
        \u0447\u0442\u043E-\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u044C
        \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u043E \u043D\u0430\u0441
