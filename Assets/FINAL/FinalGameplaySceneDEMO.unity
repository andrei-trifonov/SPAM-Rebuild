    - type: 0
      name: 2
      line: "\u0422\u0435\u043C\u043D\u044B\u0439 \u0437\u0430\u0442\u0445\u043B\u044B\u0439
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440 \u043D\u0430\u0431\u0438\u0442\u044B\u0439
        \u043F\u0440\u043E\u0432\u043E\u0434\u0430\u043C\u0438 \u0438 \u0440\u0436\u0430\u0432\u044B\u043C\u0438
        \u0442\u0440\u0443\u0431\u0430\u043C\u0438. \u042F \u043F\u043E\u0447\u0442\u0438
        \u0443\u0432\u0435\u0440\u0435\u043D\u0430 , \u0447\u0442\u043E \u043D\u0430\u0434\u043E
        \u043C\u043D\u043E\u0439 \u043B\u0435\u0436\u0438\u0442 \u0442\u043E\u043B\u0449\u0430
        \u0437\u0435\u043C\u043B\u0438. "
