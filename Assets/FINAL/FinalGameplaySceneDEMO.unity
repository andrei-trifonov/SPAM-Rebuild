    - type: 0
      name: 2
      line: "\u0422\u0440\u0435\u0441\u043A \u0432 \u0433\u043E\u043B\u043E\u0432\u0435.
        \u0411\u043E\u043B\u044C. \u0411\u0443\u0434\u0438\u043B\u044C\u043D\u0438\u043A.
        \u0417\u0430 \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E
        \u0436\u0438\u0432\u0443, \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430
        \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C \u043F\u043E \u0431\u0443\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0443.
        \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0447\u0442\u043E, \u0442\u043E\u043B\u044C\u043A\u043E
