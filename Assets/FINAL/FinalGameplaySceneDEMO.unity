    - type: 0
      name: 2
      line: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u044D\u0442\u043E
        \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430,
        \u0438\u043B\u0438 \u043E\u043D\u0430 \u043D\u0430\u0434\u043E\u0435\u0441\u0442
        \u0432\u0441\u0435\u043C \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u0443
        \u0434\u043D\u0435\u0439...\n\u041E\u043D\u0430 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430
        \u043D\u0430\u0441 \u0441 \u0421\u043E\u043D\u0435\u0439 \u0438 \u043F\u0440\u043E\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0430\u0441\u044C
        \u043A \u043D\u0430\u0448\u0435\u0439 \u043F\u0430\u0440\u0442\u0435."
