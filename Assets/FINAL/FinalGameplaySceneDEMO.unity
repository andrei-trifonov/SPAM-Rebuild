      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: '-Sonya, I''m so happy to see you! We... We''re watching the sunrise
        together, like we wanted! I''m so happy! I love you, Sonya!

'
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
