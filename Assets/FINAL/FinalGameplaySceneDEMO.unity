    - type: 0
      name: 4
      line: "-\u041C\u0438\u0440\u0430, \u0442\u044B \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435?
        \u0412\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u043E? \u041C\u0438\u0440\u0430?
        \u0422\u044B \u043C\u0435\u043D\u044F \u0438\u0437\u0432\u0438\u043D\u0438,\_
        \u044F \u043D\u0435 \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E \u0442\u0430\u043A
        \u0431\u0443\u0434\u0435\u0442, \u043F\u0440\u0430\u0432\u0434\u0430, \u043D\u0435
        \u0437\u043D\u0430\u043B\u0430. \u041C\u043D\u0435 \u0427\u0438\u043A \u0441\u043A\u0430\u0437\u0430\u043B,
        \u0447\u0442\u043E \u043E\u0442 \u0434\u0432\u0443\u0445 \u0433\u0440\u0430\u043C\u043C
        \u043D\u0438\u0447\u0435\u0433\u043E \u0431\u044B\u0442\u044C \u043D\u0435
        \u0434\u043E\u043B\u0436\u043D\u043E, \u0430 \u043E\u043D\u043E \u0432\u043E\u0442
        \u0442\u0430\u043A, \u0442\u044B \u043D\u0435 \u0443\u0448\u0438\u0431\u043B\u0430\u0441\u044C?"
