    - type: 0
      name: 2
      line: "\u0411\u043B\u0438\u043D, \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0435 \u0431\u044B\u043B\u0430
        \u043D\u0430 \u043A\u043E\u043D\u0446\u0435\u0440\u0442\u0435... \u041D\u0443,
        \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u044F \u0441\u0442\u044B\u0434\u043D\u044B\u0445
        \u0432\u044B\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0439 \u0432
        \u0448\u043A\u043E\u043B\u0435."
