      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 0
      line: "void FindTruth(meat_machine* machine) {\n    // : deciphering the labyrinth
        of pixels and code, she tries to find the lost truth in the abyss of programming\n   
        local_array >> 1;\n    data_pointer /= 8;\n    Find(data_date);\n}"
      font: 4
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
