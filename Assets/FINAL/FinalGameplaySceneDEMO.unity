      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 4
      line: -With burns like these... you don't survive... To me... it's a curse.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
