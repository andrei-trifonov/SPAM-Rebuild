        \u043A\u0430\u043A-\u0442\u043E \u0436\u0443\u0442\u043A\u043E \u0435\u0433\u043E
        \u0437\u0434\u0435\u0441\u044C \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C.
