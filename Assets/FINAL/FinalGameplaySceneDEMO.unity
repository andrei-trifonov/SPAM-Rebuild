    - type: 0
      name: 2
      line: "\u0414\u0435\u0434 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
        \u0432\u0441\u0435 \u0435\u0449\u0435 \u0441\u0442\u043E\u0438\u0442 \u0441\u043D\u0430\u0440\u0443\u0436\u0438
        \u0438 \u0436\u0434\u0435\u0442 \u043C\u0435\u043D\u044F. \u041D\u0435 \u0445\u043E\u0447\u0443
        \u043D\u0438\u043A\u0443\u0434\u0430 \u0441 \u043D\u0438\u043C. \u041F\u043B\u0435\u0432\u0430\u0442\u044C,
