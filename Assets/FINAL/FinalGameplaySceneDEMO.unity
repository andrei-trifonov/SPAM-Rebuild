    - type: 0
      name: 2
      line: "\u042F \u0432\u0437\u044F\u043B\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
        \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442 \u043E\u0431\u0435\u0438\u043C\u0438
        \u0440\u0443\u043A\u0430\u043C\u0438. \u041E\u043D \u0442\u044F\u0436\u0435\u043B\u0435\u0435,
        \u0447\u0435\u043C \u043C\u043E\u0433 \u0431\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F...\n\u042F
