    - type: 8
      name: 2
      line: "\u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C
        \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E, \u043A\u043E\u0433\u0434\u0430
        \u0438\u0434\u0435\u0448\u044C \u043F\u043E \u0442\u0438\u0445\u0438\u043C
        \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
        \u0435\u0449\u0435 \u0433\u043E\u0440\u0438\u0442 \u0441\u0432\u0435\u0442,
        \u0441\u043E\u0432\u0441\u0435\u043C \u043E\u0434\u043D\u0430.\n\n\u042D\u0445\u043E\u043C
        \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F \u043E\u0442
        \u0442\u043E\u0448\u043D\u043E\u0442\u043D\u043E-\u0433\u043E\u043B\u0443\u0431\u044B\u0445
        \u0441\u0442\u0435\u043D \u0448\u0430\u0433\u0438, \u0438 \u0434\u0430\u0436\u0435
        \u043D\u0435 \u0432\u0435\u0440\u0438\u0442\u0441\u044F, \u0447\u0442\u043E
        \u0437\u0434\u0435\u0441\u044C \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E
        \u0431\u0435\u0433\u0430\u043B\u0438 \u0442\u043E\u043B\u043F\u044B \u0448\u043A\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u0432.  
        \n\n\u0412 \u043F\u043E\u043B\u043D\u043E\u0439 \u0442\u0438\u0448\u0438\u043D\u0435
        \u043C\u044B \u043F\u0440\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0438
        \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u0430,
        \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0435\u0433\u043E \u043D\u0435
        \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C."
