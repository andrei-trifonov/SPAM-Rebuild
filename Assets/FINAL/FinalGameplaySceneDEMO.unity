    - type: 0
      name: 2
      line: " \u041A\u0442\u043E-\u0442\u043E \u0443\u0431\u0435\u0436\u0430\u043B
        \u0437\u0430 \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u043E\u043C, \u043A\u0442\u043E-\u0442\u043E
        - \u043A\u0443\u0440\u0438\u0442\u044C \u043D\u0430 \u0437\u0430\u0434\u043D\u0438\u0439
        \u0434\u0432\u043E\u0440. \u042F \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0438\u043B\u0430
        \u0441\u0432\u043E\u0438\u043C \u0433\u043B\u0430\u0437\u0430\u043C - \u043D\u0430
        \u043C\u0435\u0441\u0442\u0435, \u0433\u0434\u0435 \u0441\u0438\u0434\u0435\u043B
        \u041A\u0438\u0440 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0438\u043D\u044A\u0435\u043A\u0442\u043E\u0440
        \"\u0421\u043F\u0430\u043C\". "
