    - type: 0
      name: 2
      line: "\u042F \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u043B\u0430 \u043D\u0430
        \u0421\u043E\u043D\u044E. \u041E\u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u043D\u0430 \u043D\u0430\u0441 \u0441 \u041A\u0438\u0440\u043E\u043C. \u041A\u0430\u043A
        \u0442\u043E\u043B\u044C\u043A\u043E \u044F \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0430
        \u043D\u0430 \u043D\u0435\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435,
        \u043E\u043D\u0430 \u043F\u043E\u043A\u0440\u0430\u0441\u043D\u0435\u043B\u0430
        \u0438 \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C.\r\n"
