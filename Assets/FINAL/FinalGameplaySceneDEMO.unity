    - type: 0
      name: 2
      line: "\u0428\u043A\u043E\u043B\u044C\u043D\u0438\u043A\u0438 \u0441\u0440\u0430\u0437\u0443
        \u0436\u0435 \u043E\u0431\u0441\u0442\u0443\u043F\u0438\u043B\u0438 \u0435\u0435
        \u0438 \u043D\u0430\u0447\u0430\u043B\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F
        \u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C
        \u043E\u0431\u043E \u0432\u0441\u0435\u043C. \u041A\u0438\u0440\u0430, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0442\u0435\u043F\u0435\u0440\u044C \u0430\u043B\u044C\u0444\u0430-\u0441\u0430\u043C\u043A\u0430,
        \u0438\u043B\u0438 \u0442\u0438\u043F\u0430 \u0442\u043E\u0433\u043E. "
