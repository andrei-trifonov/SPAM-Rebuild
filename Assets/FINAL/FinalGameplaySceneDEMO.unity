    - type: 0
      name: 2
      line: "\u0418 \u0447\u0443\u0432\u0441\u0442\u0432\u043E, \u0447\u0442\u043E
        \u0435\u0441\u043B\u0438 \u0442\u044B \u0441\u0434\u0432\u0438\u043D\u0435\u0448\u044C\u0441\u044F
        \u043D\u0430 \u0448\u0430\u0433 \u043E\u0442 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0439
        \u0442\u0435\u0431\u0435 \u0442\u0440\u043E\u043F\u0438\u043D\u043A\u0438
        - \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435\u0448\u044C
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C.
        \u0411\u043B\u0438\u043D, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
        \u044F \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435
        \u043C\u043E\u0433\u0443 \u0441\u0432\u0435\u0440\u043D\u0443\u0442\u044C
        \u043A\u0443\u0434\u0430-\u0442\u043E \u043D\u0435 \u0442\u0443\u0434\u0430,
        \u0438\u043B\u0438 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
        \u043D\u0430 \u043C\u0438\u043D\u0443\u0442\u0443."
