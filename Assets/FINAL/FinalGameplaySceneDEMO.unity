    - type: 0
      name: 2
      line: "\u0417\u0434\u0435\u0441\u044C, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u043E\u0447\u0435\u043D\u044C \u0434\u0430\u0432\u043D\u043E \u043D\u0438\u043A\u043E\u0433\u043E
        \u043D\u0435 \u0431\u044B\u043B\u043E - \u043C\u0435\u0441\u0442\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
        \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u044B\u043C.
        \u042D\u0442\u043E\u0442 \u0437\u0430\u043F\u0430\u0445... "
