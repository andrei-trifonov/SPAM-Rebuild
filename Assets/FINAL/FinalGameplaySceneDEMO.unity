    - type: 0
      name: 2
      line: "\u042F \u0441\u0442\u0430\u0440\u0430\u043B\u0430\u0441\u044C \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F,
        \u0438 \u043D\u0435 \u043F\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u0438\u0434\u0443,
        \u0447\u0442\u043E \u043C\u0435\u043D\u044F \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
        \u0443\u0436\u0430\u0441 \u043E\u0442 \u043E\u0434\u043D\u043E\u0433\u043E
        \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430
        \u043D\u0430 \u043D\u0435\u0435. \u041A\u0430\u043A \u0431\u044B \u044F \u043D\u0435
        \u0434\u0435\u0440\u0436\u0430\u043B\u0430\u0441\u044C, \u0434\u0440\u043E\u0436\u044C
        \u0432 \u0433\u043E\u043B\u043E\u0441\u0435, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u0432\u044B\u0434\u0430\u0451\u0442 \u043C\u0435\u043D\u044F \u0441 \u0433\u043E\u043B\u043E\u0432\u043E\u0439."
