    - type: 0
      name: 2
      line: "-\u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
        \u0442\u0435\u0431\u0435... \u041D\u043E... \n\u0422\u044B \u0434\u043B\u044F
        \u043C\u0435\u043D\u044F - \u0432\u0441\u044F \u0436\u0438\u0437\u043D\u044C.
        \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u0440\u043E\u0448\u0443
        \u0442\u0435\u0431\u044F. \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
        \u043E\u0441\u0442\u0430\u0432\u043B\u044E. \u041C\u044B \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
        \u0431\u0443\u0434\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435, \u0442\u044B
        \u0438 \u044F."
