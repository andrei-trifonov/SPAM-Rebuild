    - type: 0
      name: 2
      line: "\u041F\u043E\u043A\u0430 \u043C\u044B \u0448\u0430\u0433\u0430\u043B\u0438
        \u043F\u043E \u0442\u0440\u043E\u043F\u0438\u043D\u043A\u0435, \u0421\u043E\u043D\u044F
        \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430
        \u043C\u043D\u0435 \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u043E \u043C\u043E\u0434\u043D\u044B\u0435
        \u0436\u0443\u0440\u043D\u0430\u043B\u044B \u0438 \u043B\u044E\u0431\u0438\u043C\u044B\u0439
        \u0441\u0435\u0440\u0438\u0430\u043B \u043D\u0430 \u0442\u044D-\u0432\u044D,
        \u043D\u043E \u044F \u043F\u043E\u0447\u0442\u0438 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0430. \u0413\u043E\u043B\u043E\u0432\u0430
        \u0431\u044B\u043B\u0430 \u0437\u0430\u0431\u0438\u0442\u0430 \u044D\u043F\u0438\u0437\u043E\u0434\u0430\u043C\u0438
        \u044D\u0442\u043E\u0433\u043E \u0434\u043D\u044F, \u0438 \u043E\u043D\u0438
        \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C
        \u0435\u0435 \u043F\u043E\u043A\u0438\u0434\u0430\u0442\u044C. "
