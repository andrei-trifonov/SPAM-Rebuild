    - type: 0
      name: 2
      line: "\u0417\u0430\u0448\u0435\u043B\u0435\u0441\u0442\u0435\u043B\u0438 \u043A\u0443\u0441\u0442\u044B,
        \u0438 \u0438\u0437 \u043D\u0438\u0445 \u043D\u0430 \u043C\u0435\u043D\u044F
        \u0432\u044B\u043F\u0440\u044B\u0433\u043D\u0443\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
        \r\n\u042F \u0443\u0441\u043F\u0435\u043B\u0430 \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C,
        \u0447\u0442\u043E \u0443 \u043D\u0435\u0433\u043E \u0432 \u0440\u0443\u043A\u0430\u0445 
        \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u0430\u044F
        \u0432\u0435\u0442\u043A\u0430.\r"
