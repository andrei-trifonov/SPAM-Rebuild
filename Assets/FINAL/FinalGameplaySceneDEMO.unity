      line: "-\u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0435\u0441\u0442\u043D\u043E.
        \u041C\u043E\u0436\u0435\u0442, \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u043E
        \u0432\u043E\u0441\u043F\u0438\u0442\u0430\u043D\u0438\u0435 \u0432 \u0434\u0443\u0445\u0435
        \u0441\u0442\u0430\u0440\u043E\u0439 \u0448\u043A\u043E\u043B\u044B. \u0427\u0442\u043E-\u0442\u043E
