      name: 2
      line: "\u0417\u0430\u043D\u0435\u043C\u0435\u0432\u0448\u0435\u0435 \u0442\u0435\u043B\u043E
        \u0441 \u0442\u0440\u0443\u0434\u043E\u043C \u0441\u043F\u0443\u0441\u043A\u0430\u043B\u043E\u0441\u044C
        \u043F\u043E \u0432\u0435\u0442\u043A\u0430\u043C \u0432\u043D\u0438\u0437.
        \u0421\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F \u0431\u044B\u043B\u043E
        \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435,
        \u0447\u0435\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F."
