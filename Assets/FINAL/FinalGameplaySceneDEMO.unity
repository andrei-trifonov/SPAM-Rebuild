    - type: 0
      name: 2
      line: "\u0418 \u0447\u0442\u043E \u043C\u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C?
        \u0421\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u0430\u043A \u0435\u0441\u0442\u044C,
        \u0447\u0442\u043E\u0431\u044B \u0435\u0439 \u0441\u0442\u0430\u043B\u043E
        \u0435\u0449\u0451 \u0442\u044F\u0436\u0435\u043B\u0435\u0435?\r\n\u041D\u0435
        \u0443\u043C\u0435\u044E \u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
        \u043B\u044E\u0434\u0435\u0439, \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E
        \u044D\u0442\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u044C.\r\n"
