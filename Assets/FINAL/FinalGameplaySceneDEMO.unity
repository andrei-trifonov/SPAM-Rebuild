      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 4
      line: -When I call a doctor for hours... And when I can't stand it anymore,
        I... I have to pee on myself. It's... It's so awful.
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
