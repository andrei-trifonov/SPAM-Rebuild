      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 1, y: 0, z: 0}
    - type: 0
      name: 2
      line: -That's nonsense! Nothing could be worse for me than what happened to
