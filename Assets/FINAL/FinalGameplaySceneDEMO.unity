    - type: 0
      name: 2
      line: "\u0421\u043E\u043D\u044F \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0430\u0441\u044C,
        \u0438 \u043F\u0440\u0438\u0441\u0435\u043B\u0430 \u0440\u044F\u0434\u043E\u043C.
        \u041A\u0430\u0431\u0438\u043D\u043A\u0430 \u043C\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043E\u043F\u0443\u0441\u043A\u0430\u043B\u0430\u0441\u044C
        \u0432\u043D\u0438\u0437.\r\n"
