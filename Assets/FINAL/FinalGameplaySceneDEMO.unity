    - type: 8
      name: 2
      line: "\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B
        \u043C\u0435\u043D\u044F \u0434\u043E \u043A\u0440\u044B\u043B\u044C\u0446\u0430.
        \u041D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0439
        \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0439... \u041E\u043D \u043D\u0435
        \u0445\u043E\u0447\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u044F \u043E\u0442
        \u043D\u0435\u0433\u043E \u0441\u0431\u0435\u0436\u0430\u043B\u0430. \n\n\u0416\u0443\u0442\u043A\u0438\u0439,
        \u043F\u0440\u043E\u0431\u0438\u0440\u0430\u044E\u0449\u0438\u0439 \u0434\u043E
        \u0433\u043B\u0443\u0431\u0438\u043D\u044B \u0434\u0443\u0448\u0438 \u0441\u0442\u0435\u0440\u0438\u043B\u044C\u043D\u044B\u0439
        \u0432\u043E\u0437\u0434\u0443\u0445 \u0441\u043E \u0432\u043A\u0443\u0441\u043E\u043C
        \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432 \u0438 \u0441\u043F\u0438\u0440\u0442\u0430.
        \u041E\u043D \u043C\u0435\u043D\u044F \u0434\u0443\u0448\u0438\u0442 \u0438
        \u0432\u044B\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
        \u043D\u0430\u0438\u0437\u043D\u0430\u043D\u043A\u0443. \n\n\u041F\u0443\u0442\u044C
        \u0434\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u044F \u0431\u044B
        \u043C\u043E\u0433\u043B\u0430 \u043F\u0440\u043E\u0439\u0442\u0438 \u0441
        \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438.
        \u041C\u0435\u043D\u044F \u043F\u0443\u0441\u043A\u0430\u044E\u0442 \u043A
        \u0421\u043E\u043D\u0435. \u0412 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435
        \u0441\u043B\u0430\u0434\u043A\u0438\u0439 \u043C\u044B\u043B\u044C\u043D\u044B\u0439
        \u0437\u0430\u043F\u0430\u0445.\n\n\u0427\u0442\u043E-\u0442\u043E \u0440\u0435\u0437\u043A\u043E
        \u0431\u044C\u0435\u0442 \u0432 \u043D\u043E\u0441, \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u043E\u0435
        \u0438 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435,
        \u043D\u0435\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0435.
        \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B\u0430
        \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u0441 \u043D\u0435\u0434\u0435\u043B\u044C\u043D\u044B\u043C
        \u0442\u0440\u0443\u043F\u043E\u043C, \u043D\u043E \u044D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435,
        \u0447\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u043D\u0430
        \u0443\u043C, \u043A\u043E\u0433\u0434\u0430 \u044F \u0432\u0434\u044B\u0445\u0430\u044E.\n\n\u0427\u0443\u0442\u044C
        \u043F\u043E\u0433\u043E\u0434\u044F, \u0441 \u043F\u0440\u043E\u0431\u0438\u0440\u0430\u044E\u0449\u0438\u043C
        \u0441\u0435\u0440\u0434\u0446\u0435 \u0445\u043E\u043B\u043E\u0434\u043E\u043C
        \u0438 \u0434\u0440\u043E\u0436\u044C\u044E \u044F \u0442\u043E\u043B\u043A\u0430\u044E
        \u0434\u0432\u0435\u0440\u044C."
