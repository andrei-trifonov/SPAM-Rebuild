    - type: 0
      name: 2
      line: "\u041F\u0440\u0438\u0432\u044B\u0447\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430,
        \u0434\u0430\u0436\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0436
        \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0430\u044F. \u0414\u0443\u043C\u0430\u044E,
        \u044F \u043C\u043E\u0433\u043B\u0430 \u0431\u044B \u0434\u043E\u0439\u0442\u0438
        \u0434\u043E \u0448\u043A\u043E\u043B\u044B \u0441 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438
        \u0433\u043B\u0430\u0437\u0430\u043C\u0438, \u043F\u043E\u0442\u043E\u043C\u0443
        \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u043B\u0430 \u044D\u0442\u043E
        \u0443\u0436\u0435 \u0442\u044B\u0441\u044F\u0447\u0438 \u0440\u0430\u0437."
