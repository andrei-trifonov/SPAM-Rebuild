    - type: 0
      name: 2
      line: "-\u0414\u0430 \u0432\u0440\u0435\u0442\u0435 \u0432\u044B \u0432\u0441\u0435.
        \u0412\u0441\u0435 \u0443\u0436\u0435 \u0441\u0430\u043C\u0438 \u0440\u0435\u0448\u0438\u043B\u0438
        \u0438 \u0434\u043B\u044F \u0433\u0430\u043B\u043E\u0447\u043A\u0438... \u0412\u0441\u0435
        \u044D\u0442\u043E. \u0421\u043F\u0440\u043E\u0441\u0438\u0442\u0435 \u0443
        \u0421\u043E\u043D\u0438, \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432...\n"
