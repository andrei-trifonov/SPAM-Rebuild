  - name: 0.2.7
    lines:
    - type: 0
      name: 2
      line: "\u041C\u043D\u0435 \u0436\u0430\u043B\u043A\u043E \u0410\u043B\u0438\u043D\u0443,
        \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0438\u0434\u0438\u0442
        \u043E\u0434\u043D\u0430... \u0418 \u043C\u043D\u0435 \u0432\u0441\u0435
        \u0435\u0449\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
        \u0447\u0442\u043E \u0437\u0430 \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439
        \u043F\u0440\u0438\u0448\u0435\u043B \u043A \u043D\u0430\u043C \u0432 \u043A\u043B\u0430\u0441\u0441...
        \u041D\u043E \u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0430\u0436\u0443\u0441\u044C
        \u0441 \u0421\u043E\u043D\u0435\u0439. \u0414\u0443\u043C\u0430\u044E, \u043E\u043D\u0430
        \u043E\u0431\u0438\u0434\u0435\u0442\u0441\u044F, \u0435\u0441\u043B\u0438
        \u044F \u0435\u0435 \u043F\u0440\u043E\u043C\u0435\u043D\u044F\u044E \u043D\u0430
        \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C. \u041F\u0443\u0441\u043A\u0430\u0439
        \u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043E\u0434\u0438\u043D
        \u0443\u0440\u043E\u043A."
