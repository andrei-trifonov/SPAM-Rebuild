  - "    ms \"\u0417\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u043C\u0435\u043D\u044F
    \u043E\u0442\u0441\u044E\u0434\u0430, \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C.
