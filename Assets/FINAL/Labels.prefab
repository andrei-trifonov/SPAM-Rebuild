  m_Name: 
  m_EditorClassIdentifier: 
  labelName: contin2
  scenarioBlock:
  - "    $ save_name = \"\u0417\u0430\u0432\u0442\u0440\u0430 \u0431\u0443\u0434\u0435\u0448\u044C
    \u0443\u0431\u0438\u0432\u0430\u0442\u044C \u043C\u0435\u043D\u044F\"\r"
  - "    $ quick_menu = False\r"
  - "    scene g4\r"
  - "    show g4_back at newlabel\r"
  - "    stop music fadeout 5.0\r"
  - "    $ renpy.pause(5.0, hard = True)\r"
  - "    $ quick_menu = True\r"
  - "    play music \"audio/Space.mp3\"\r"
  - "    if perf < 1:\r"
  - "         $ perf1 += 1\r"
  - "         jump UNITY_Day2\r"
  - "    stop music fadeout 3.0\r"
  - "    scene Scene with dissolve\r"
  - "    $ renpy.pause(3.0, hard = True)\r"
  - "    k \"*\u043A\u0445\u043C*\"\r"
  - "    k \"\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440!
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0430\u043C \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u0441\u044F
    \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0435
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435...\"\r"
  - "    k \"\u0418, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u043E\u043C\u0438\u043C\u043E
    \u044D\u0442\u043E\u0433\u043E \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u0442
    \u0438 \u0441\u0430\u043C \u043C\u0430\u044D\u0441\u0442\u0440\u043E, \u043F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C... \u041E\u0445,
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0433\u043E
    \u0433\u043E\u0441\u0442\u044F \u043D\u0435\u0442 \u0438\u043C\u0435\u043D\u0438...\"\r"
  - "    play music \"audio/Depression.mp3\"\r"
  - "    k \"\u041D\u043E, \u0432 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
    \u044D\u0442\u043E \u0440\u0435\u043F\u0435\u0442\u0438\u0446\u0438\u044F. *\u043A\u0445\u0435*\"\r"
  - "    show d_p at normal(0.2)\r"
  - "    show d_d at normal (0.5)\r"
  - "    show d_s at normal (0.8)\r"
  - "    mr \"\u041D\u0430 \u0441\u0446\u0435\u043D\u0443 \u0432\u044B\u0445\u043E\u0434\u044F\u0442
    \u0442\u0440\u0438 \u043A\u0443\u043A\u043B\u044B.\"\r"
  - "    doc \"-\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C. \u041F\u043E\u043A\u0430\u0436\u0438\u0442\u0435,
    \u0433\u0434\u0435 \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
    \u0431\u043E\u043B\u044C.\"\r"
  - "    pat \"-\u0412\u043E\u0442 \u0437\u0434\u0435\u0441\u044C.\"\r"
  - "    mr \"\u041F\u0430\u0446\u0438\u0435\u043D\u0442 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043D\u0430 \u043F\u0435\u0440\u0435\u0431\u0438\u043D\u0442\u043E\u0432\u0430\u043D\u043D\u0443\u044E
    \u0440\u0443\u043A\u0443.\"\r"
  - "    pat \"-\u041C\u043E\u0435\u0439 \u0440\u0443\u043A\u0435 \u043E\u0447\u0435\u043D\u044C
    \u0431\u043E\u043B\u044C\u043D\u043E.\"\r"
  - "    mr \"\u0414\u043E\u043A\u0442\u043E\u0440 \u043E\u0442\u0432\u0438\u043D\u0447\u0438\u0432\u0430\u0435\u0442
    \u0440\u0443\u043A\u0443, \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u043E\u043D\u0430
    \u0431\u043E\u043B\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B.\"\r"
  - "    doc \"-\u0425\u043C. \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
    \u044D\u0442\u0430 \u0440\u0443\u043A\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u0437\u0430\u043C\u0435\u043D\u044B.\"\r"
  - "    mr \"\u0414\u043E\u043A\u0442\u043E\u0440 \u0448\u0432\u044B\u0440\u044F\u0435\u0442
    \u043F\u0435\u0440\u0435\u0431\u0438\u043D\u0442\u043E\u0432\u0430\u043D\u043D\u0443\u044E
    \u0440\u0443\u043A\u0443 \u0437\u0430 \u0441\u043F\u0438\u043D\u0443, \u0437\u0430\u043C\u0435\u043D\u044F\u044F
    \u0435\u0435 \u043D\u043E\u0432\u043E\u0439.\"\r"
  - "    hide d_p\r"
  - "    show d_sm at normal (0.2)\r"
  - "    doc \"-\u0413\u0434\u0435 \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
    \u0431\u043E\u043B\u044C?\"\r"
  - "    pat \"-\u041D\u0438\u0433\u0434\u0435.\"\r"
  - "    doc \"-\u0412 \u0442\u0430\u043A\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
    \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u043F\u0443\u0442\u0438.\"\r"
  - "    pat \"-\u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F.\"\r"
  - "    mr \"\u041A\u0443\u043A\u043B\u0430 \u0443\u0445\u043E\u0434\u0438\u0442.\"\r"
  - "    hide d_sm with dissolve\r"
  - "    doc \"-\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C. \u041F\u043E\u043A\u0430\u0436\u0438\u0442\u0435,
    \u0433\u0434\u0435 \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
    \u0431\u043E\u043B\u044C.\"\r"
  - "    pat2 \"-\u042F \u043D\u0435 \u0437\u043D\u0430\u044E.\"\r"
  - "    doc \"-\u041F\u043E\u043A\u0430\u0436\u0438\u0442\u0435, \u0433\u0434\u0435
    \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u0431\u043E\u043B\u044C.\"\r"
  - "    mr \"\u041F\u0430\u0446\u0438\u0435\u043D\u0442 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0440\u0443\u043A\u043E\u0439 \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443.\"\r"
  - "    pat2 \"-\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043C\u043E\u044F
    \u0431\u043E\u043B\u044C - \u0432 \u0433\u043E\u043B\u043E\u0432\u0435.\"\r"
  - "    mr \"\u0414\u043E\u043A\u0442\u043E\u0440 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
    \u0433\u043E\u043B\u043E\u0432\u0443 \u043A\u0443\u043A\u043B\u044B.\"\r"
  - "    doc \"-\u041D\u043E \u0441 \u0432\u0430\u0448\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
    \u0432\u0441\u0435 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435.\"\r"
  - "    pat2 \"-\u0422\u043E\u0433\u0434\u0430, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
    \u0443 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u0438\u0442 \u0441\u0435\u0440\u0434\u0446\u0435.\"\r"
  - "    mr \"\u041F\u0430\u043B\u0435\u0446 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430
    \u0442\u044B\u0447\u0435\u0442 \u0432 \u0435\u0433\u043E \u0433\u0440\u0443\u0434\u044C.\"\r"
  - "    scene cg92 with dissolve\r"
  - "    mr \"\u0414\u043E\u043A\u0442\u043E\u0440 \u0440\u0430\u0441\u043F\u0430\u0440\u044B\u0432\u0430\u0435\u0442
    \u0442\u0435\u043B\u043E \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u0438
    \u0434\u043E\u0441\u0442\u0430\u0435\u0442 \u0441\u0435\u0440\u0434\u0446\u0435.\"\r"
  - "    stop music fadeout 2.0\r"
  - "    doc \"-\u0412\u0430\u0448\u0435 \u0441\u0435\u0440\u0434\u0446\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u0443\u0435\u0442
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0445\u043E\u0440\u043E\u0448\u043E.\"\r"
