  scenarioBlock:
  - "    menu:\r"
  - "        \"\u0415\u0449\u0435 \u043E\u0434\u0438\u043D \u043F\u043E\u0440\u0435\u0437.\":\r"
  - "            n \"\u042F \u0432\u044B\u0431\u0440\u0430\u043B\u0430 \u043C\u0435\u0441\u0442\u043E
    \u0447\u0443\u0442\u044C \u043F\u043E\u0432\u044B\u0448\u0435 \u043B\u043E\u043A\u0442\u044F.\"\r"
  - "            n \"\u041D\u043E\u0436 \u0437\u0430\u0442\u0443\u043F\u0438\u043B\u0441\u044F
    \u043E\u0442 \u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435,
    \u0442\u0430\u043A \u0447\u0442\u043E \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u0440\u0430\u0437\u0430 \u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043B\u0430
    \u043A\u043E\u0436\u0443.\"\r"
  - "            n \"\u0415\u0449\u0435 \u0440\u0430\u0437, \u0438 \u0435\u0449\u0435...
    \u043A\u043E\u0436\u0430 \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u043E \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0438\u043B\u0430\u0441\u044C,
    \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0432 \u043D\u0430\u0440\u0443\u0436\u0443
    \u0430\u043B\u044B\u0439 \u0440\u0443\u0447\u0435\u0435\u043A \u043A\u0440\u043E\u0432\u0438.\"\r"
  - "            scene cg193 with dissolve\r"
  - "            n \"\u0414\u043E \u0447\u0435\u0433\u043E \u0436\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0435
    \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435...\"\r"
  - "            n \"\u0412\u043E\u0442 \u0438 \u0432\u0441\u0435. \u042F \u0441\u043B\u043E\u0436\u0438\u043B\u0430
    \u0437\u0430\u043F\u0430\u0447\u043A\u0430\u043D\u044B\u0439 \u043D\u043E\u0436\u0438\u043A
    \u0432 \u043A\u0430\u0440\u043C\u0430\u043D.\"\r"
  - "        \"\u041D\u0435 \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437.\":\r"
  - "            n \"\u041D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F, \u043D\u043E\u0436\u0438\u043A.
    \u0414\u0435\u043B\u043E \u0435\u0449\u0435 \u043D\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u043E.
    \u041D\u0443\u0436\u043D\u043E \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0442\u044C\u0441\u044F
    \u043D\u0430 \u043F\u043E\u0438\u0441\u043A\u0435 \u0438\u0441\u0442\u0438\u043D\u044B.\"\r"
  - "            n \"\u0412\u0434\u0440\u0443\u0433, \u044F \u0441\u043D\u043E\u0432\u0430
    \u0432\u0441\u0435 \u0443\u043F\u0443\u0449\u0443 \u0438 \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C
    \u0431\u0435\u0437 \u0434\u0435\u043B \u0433\u043D\u0438\u0442\u044C \u0432 \u0441\u0432\u043E\u0435\u0439
    \u0431\u0435\u0442\u043E\u043D\u043D\u043E\u0439 \u043A\u043E\u0440\u043E\u0431\u043A\u0435.
    \u041D\u0443 \u0443\u0436 \u043D\u0435\u0442!\"\r"
  - "            n \"\u0415\u0449\u0435 \u043E\u0434\u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044F,
    \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u0430\u044F \u0441\u043A\u0443\u043A\u043E\u0439
    \u0438 \u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u044F\u043C\u0438, \u0438
    \u044F \u0442\u043E\u0447\u043D\u043E \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0441 \u0441\u043E\u0431\u043E\u0439 \u0441\u0434\u0435\u043B\u0430\u044E.\"\r"
  - "    scene Roof with dissolve\r"
  - "    show n_s at normal (0.5)\r"
  - "    n \"\u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
    \u0432\u043D\u0438\u0437. \u0414\u0432\u043E\u0435 \u043B\u044E\u0434\u0435\u0439
    \u0432 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u044B\u0445 \u043F\u0438\u0434\u0436\u0430\u0447\u043A\u0430\u0445
    \u0432\u044B\u0448\u043B\u0438 \u0438\u0437 \u0434\u043E\u043C\u0430.\"\r"
  - "    n \"\u0414\u0432\u0435\u0440\u044C \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u043B\u0430\u0441\u044C
    \u0434\u043E \u043A\u043E\u043D\u0446\u0430 - \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
    \u041C\u0438\u0448\u0430 \u0443\u0436\u0435 \u0432\u0441\u0442\u0430\u043B \u0437\u0430
    \u043D\u0435\u0439 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0437\u0430
    \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u0430\u043C\u0438
    \u0441\u043A\u0432\u043E\u0437\u044C \u0449\u0435\u043B\u043A\u0443.\"\r"
  - "    n \"\u041A\u043E\u0441\u0442\u044E\u043C\u044B \u0441\u043E\u0432\u0441\u0435\u043C
    \u043D\u043E\u0432\u044B\u0435... \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u044F \u043C\u043E\u0433\u0443 \u0441\u0443\u0434\u0438\u0442\u044C, \u0441\u0438\u0434\u044F
    \u0437\u0434\u0435\u0441\u044C, \u043D\u0430 \u043A\u0440\u044B\u0448\u0435.
    \u0414\u043E\u0440\u043E\u0433\u0438\u0435 \u0432\u0435\u0434\u044C \u043A\u043E\u0441\u0442\u044E\u043C\u044B.\"\r"
  - "    n \"\u0411\u043E\u044E\u0441\u044C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C,
    \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u043D\u0435\u0433 \u043D\u0443\u0436\u043D\u043E
    \u0431\u044B\u043B\u043E \u043E\u0442\u0434\u0430\u0442\u044C \u0437\u0430 \u0442\u0430\u043A\u0443\u044E
    \u0440\u043E\u0441\u043A\u043E\u0448\u044C.\"\r"
  - "    n \"\u042D\u0442\u0438 \u043B\u044E\u0434\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043F\u043E\u0445\u043E\u0436\u0438 \u043D\u0430 \u043A\u0430\u043A\u0438\u0445-\u0442\u043E
    \u0431\u0438\u0437\u043D\u0435\u0441\u043C\u0435\u043D\u043E\u0432 \u0438\u043B\u0438
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u043E\u0432.\"\r"
  - "    n \"\u041D\u043E \u044F \u043D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E
    \u0431\u0443\u0434\u044C \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u043E\u0439,
    \u043E\u043D\u0438 \u0431\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u044C
