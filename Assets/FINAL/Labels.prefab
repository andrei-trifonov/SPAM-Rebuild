  - "    narrator \"\u0423 \u043C\u0435\u043D\u044F \u0432\u0434\u0440\u0443\u0433
    \u043A\u0443\u0434\u0430-\u0442\u043E \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u043E\u0441\u044C
    \u0441\u0435\u0440\u0434\u0446\u0435, \u0438 \u0437\u0430\u0434\u0440\u043E\u0436\u0430\u043B\u0438
    \u043D\u043E\u0433\u0438. \u0411\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
    \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043F\u0440\u0438\u0448\u043B\u043E
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435.\"\r"
  - "    play sound \"audio/message.mp3\"\r"
  - "    k_chat \" {font=Message.otf} \u041D\u043E \u0435\u0439 \u043D\u0435 \u043E
    \u0447\u0435\u043C \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u0442\u044C\u0441\u044F.
    \u041B\u044E\u0434\u0438 \u0435\u0439 \u043D\u0435 \u043D\u0430\u0432\u0440\u0435\u0434\u044F\u0442.
    {/font}\"\r"
  - "    narrator \"\u041A\u0438\u0440, \u0442\u0432\u043E\u044E \u043C\u0430\u0442\u044C!\"\r"
  - "    narrator \"\u041E\u043D \u0447\u0442\u043E-\u0442\u043E \u044F\u0432\u043D\u043E
    \u0437\u043D\u0430\u0435\u0442. \u0410 \u043C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E
    \u043E\u043D \u0438 \u0443\u0431\u0438\u043B \u0442\u043E\u0433\u043E \u043F\u0440\u0435\u043F\u043E\u0434\u0430?
    \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043D\u0443\u0436\u043D\u043E
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0422\u043E\u043B\u0435
    \u043E\u0431 \u044D\u0442\u043E\u043C. \u0418\u043B\u0438 \u043F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F
    \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0441\u0430\u043C\u043E\u0439?\"\r"
  - "    narrator \"\u0427\u0435\u0440\u0442! \u041A\u0430\u0436\u0434\u044B\u0439
    \u0434\u0435\u043D\u044C \u0441\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
    \u0447\u0442\u043E-\u0442\u043E \u043D\u0435\u0438\u043C\u043E\u0432\u0435\u0440\u043D\u043E
    \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0435!\"\r"
  - "    window hide\r"
