    \u043C\u0438\u043B\u0438\u0446\u0438\u0438, \u043D\u0435 \u0434\u0443\u043C\u0430\u044E,
    \u0447\u0442\u043E \u0434\u0435\u043B\u043E \u0441\u0434\u0432\u0438\u043D\u0435\u0442\u0441\u044F
    \u0441 \u043C\u0435\u0441\u0442\u0430.\"\r"
  - "            ms \"\u041D\u043E \u0435\u0441\u043B\u0438 \u044F \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443
    \u0432 \u0438\u0445 \u043B\u043E\u0433\u043E\u0432\u043E, \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u043E\u0434\u043F\u043E\u0440\u0447\u0443 \u0438\u043C \u043F\u043B\u0430\u043D\u044B.\"\r"
  - "            ms \"\u0420\u0435\u0448\u0435\u043D\u043E. \u041A \u0437\u0430\u0432\u043E\u0434\u0443
    '\u0420\u0430\u0434\u0443\u0433\u0430' \u0442\u0440\u0438 \u043F\u0443\u0442\u0438
    - \u0447\u0435\u0440\u0435\u0437 \u0433\u043B\u0430\u0432\u043D\u044B\u0435 \u043F\u043E\u043A\u043E\u0441\u0438\u0432\u0448\u0438\u0435\u0441\u044F
    \u0432\u043E\u0440\u043E\u0442\u0430, \u043F\u043E \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439
    \u0434\u043E\u0440\u043E\u0433\u0435 \u043A \u0430\u043D\u0433\u0430\u0440\u0443,
    \u043D\u043E \u0435\u0449\u0435 \u043C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u043C\u0430\u0445\u043D\u0443\u0442\u044C
    \u0437\u0430\u0431\u043E\u0440 \u0441 \u0431\u043B\u0438\u0437\u0436\u0430\u0439\u0448\u0438\u0445
    \u0433\u0430\u0440\u0430\u0436\u0435\u0439.\"\r"
  - "            ms \"\u0414\u0443\u0440\u043E\u0441\u0442\u044C \u043A\u0430\u043A\u0430\u044F-\u0442\u043E.
    \u041A\u0430\u043A\u0438\u0435 \u0440\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
    \u0432 \u043D\u0430\u0448\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435? \u0417\u0432\u0443\u0447\u0438\u0442
    \u0434\u0430\u0436\u0435 \u0441\u043C\u0435\u0448\u043D\u043E. \u0411\u043E\u043B\u044C\u0448\u0435
    \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
    \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0440\u0430\u0437\u044B\u0433\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
