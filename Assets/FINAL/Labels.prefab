  scenarioBlock:
  - "    stop music fadeout 2.0\r"
  - "    $ mpf += 1\r"
  - "    scene Scene with dissolve\r"
  - "    show ms_n_y at normal (0.5)\r"
  - "    show d_s at zoomer (0.01)\r"
  - "    show d_sm at zoomer (0.9)\r"
  - "    un \"-\u041D\u0443-\u043A\u0430, \u0447\u0442\u043E \u043D\u0430\u0448\u0435\u043C\u0443
    \u041C\u0438\u0448\u0435 \u043F\u0440\u0438\u0441\u043B\u0430\u043B\u0430 \u043C\u0430\u043C\u0430\u0448\u0430...
    \u041E\u0433\u043E, \u044D\u0442\u043E \u0447\u0442\u043E? \u0421\u0438\u0433\u0430\u0440\u0435\u0442\u044B...
    \u0414\u0430 \u0446\u0435\u043B\u0435\u0445\u043E\u043D\u044C\u043A\u0438\u0435!\"\r"
  - "    play music \"audio/Paranoia.mp3\"\r"
  - "    un \"\u0414\u0430\u0448\u044C \u043F\u043E\u0433\u043E\u043D\u044F\u0442\u044C,
    \u0430, \u041C\u0438\u0448\u0430? \u041A\u043E\u043D\u0435\u0447\u043D\u043E
    \u0434\u0430\u0448\u044C. \u0414\u0430 \u0442\u0443\u0442 \u0438 \u0442\u0435\u043F\u043B\u044B\u0435
    \u0432\u0435\u0449\u0438... \u041C\u043D\u043E\u0433\u043E \u043D\u0430 \u0442\u0435\u0431\u044F
    \u043E\u0434\u043D\u043E\u0433\u043E \u0431\u0443\u0434\u0435\u0442.\"\r"
  - "    ms \"-\u041C\u043E\u0436\u0435\u0448\u044C \u0445\u043E\u0442\u044C \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u0441\u0438\u0433\u0430\u0440\u0435\u0442\u0430\u043C\u0438, \u043D\u043E \u043E\u0434\u0435\u0436\u0434\u0443
    \u044F \u043D\u0435 \u043E\u0442\u0434\u0430\u043C.\"\r"
  - "    un \"-\u0422\u044B \u0447\u0435\u0433\u043E, \u043E\u043F\u0443\u0445, \u0443\u0440\u043E\u0434?
    \u041E\u0445\u043E\u0442\u0430 \u0441\u0430\u043F\u043E\u0433\u0438 \u044F\u0437\u044B\u043A\u043E\u043C
    \u0447\u0438\u0441\u0442\u0438\u0442\u044C? \u0412\u0441\u0435 \u0440\u0430\u0432\u043D\u043E
    \u0432 \u0438\u0442\u043E\u0433\u0435 \u043E\u0442\u0434\u0430\u0448\u044C \u0432\u0441\u0435.
    \u041A \u0447\u0435\u043C\u0443 \u0443\u043F\u0438\u0440\u0430\u0442\u044C\u0441\u044F?
    \u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
    \u0440\u0430\u0437\u0430 \u043D\u0435 \u043F\u043E\u043D\u044F\u043B?\"\r"
  - "    ms \"-\u0422\u044B \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u043B? \u042F
    \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0432\u044B \u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435.\"\r"
  - "    un \"-\u041D\u0435\u0442, \u0442\u044B \u043D\u0435 \u043F\u043E\u043D\u044F\u043B.
    \u041E\u0442\u0434\u0430\u0432\u0430\u0439, \u0436\u0438\u0432\u043E, \u0438\u043D\u0430\u0447\u0435
    \u0434\u043E\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0442\u044C \u0431\u0443\u0434\u0435\u0448\u044C
    \u0441 \u0440\u0430\u0441\u043A\u0432\u0430\u0448\u0435\u043D\u043D\u043E\u0439
    \u043C\u043E\u0440\u0434\u043E\u0439.\"\r"
  - "    scene cg225a with dissolve\r"
  - "    ms \"-\u041F\u043E \u043E\u0434\u043D\u043E\u043C\u0443, \u0441\u0443\u043A\u0438!\"\r"
  - "    un \"-\u041B\u0435\u0445\u0430, \u0434\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0443\u0447\u0438\u043C
    \u043F\u0440\u0438\u0434\u0443\u0440\u043A\u0430. \u0411\u0435\u0439\u0442\u0435
    \u0435\u0433\u043E \u043F\u043E\u043A\u0430 \u043D\u0435 \u0437\u0430\u043F\u043B\u0430\u0447\u0435\u0442,
    \u0438\u043B\u0438 \u043D\u0435 \u0441\u0434\u043E\u0445\u043D\u0435\u0442.\"\r"
  - "    un \"-\u0410-\u0430\u0439, \u0441\u0443\u043A\u0430-\u0430!\"\r"
  - "    un \"-\u041F\u0430\u0446\u0430\u043D\u044B, \u043E\u043D \u043D\u0430\u0448\u0435\u043C\u0443
    \u0433\u043E\u043B\u043E\u0432\u0443 \u043F\u0440\u043E\u043B\u043E\u043C\u0438\u043B!\"\r"
  - "    un \"-\u0411\u0435\u0439 \u0435\u0433\u043E, \u0431\u0435\u0439!\"\r"
  - "    un \"-\u0427\u0435\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C?!\"\r"
  - "    ms \"-\u0421\u0432\u043E\u043B\u043E\u0447\u044C!\"\r"
  - "    scene cg225b at hpunch\r"
  - "    un \"-\u0410 \u044D\u0442\u043E \u0432\u0438\u0434\u0435\u043B?\"\r"
  - "    un \"-\u0427\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442?
    \u0412 \u0441\u0430\u043D\u0447\u0430\u0441\u0442\u044C \u0435\u0433\u043E, \u0436\u0438\u0432\u043E!\"\r"
  - "    un \"\u0421 \u0432\u0430\u043C\u0438 \u044F \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0441\u044C
    \u043F\u043E\u0437\u0436\u0435. \u0411\u0435\u0433\u043E\u043C, \u0431\u0435\u0433\u043E\u043C!\"\r"
  - "    stop music fadeout 2.0\r"
  - "    jump middle2_act3\r"
