    \u043A '\u041F\u044B\u043B\u044C\u0446\u0435'.\"\r"
  - "    mr \"\u042F \u043D\u0435 \u0434\u043E\u043A\u0442\u043E\u0440... \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
    \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0441\u0438\u043B\u044C\u043D\u043E.\"\r"
  - "    mr \"\u0417\u0430 \u0432\u0441\u0435 \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0435
    \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C...\"\r"
  - "    mr \"\u0418 \u044F \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0430 \u0443\u0436\u0435
    \u043A\u0443\u0447\u0443 \u0434\u0435\u043D\u0435\u0433. \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u043D\u0435 \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E...\"\r"
  - "    mr \"\u0412\u0441\u0435 \u0434\u043E\u0431\u0440\u043E \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u043E
    \u0432 \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439
    \u043F\u0430\u043A\u0435\u0442\u0438\u043A \u0434\u043B\u0438\u043D\u043E\u0439
    \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0430\u043D\u0442\u0438\u043C\u0435\u0442\u0440\u043E\u0432,
    \u0441 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u043E\u0439 \u0437\u0430\u0441\u0442\u0435\u0436\u043A\u043E\u0439.\"\r"
  - "    mr \"\u041D\u0430 \u043D\u0435\u043C \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
    \u0447\u0442\u043E-\u0442\u043E \u043D\u0430 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u043C
    \u0444\u043E\u043D\u0435. \u0420\u0438\u0441\u0443\u043D\u043E\u043A \u043B\u0438\u0441\u0438\u0447\u043A\u0438.
    \u041A\u0440\u0430\u0441\u0438\u0432\u043E.\"\r"
  - "    mr \"\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u0431\u044B \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0430\u0441\u044C,
    \u0435\u0441\u043B\u0438 \u0431\u044B \u0432\u043D\u0443\u0442\u0440\u0438 \u0431\u044B\u043B\u0430
