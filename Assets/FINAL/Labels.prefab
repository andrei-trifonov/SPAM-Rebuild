    \u043F\u043E\u0434 \u043F\u043E\u043A\u0440\u043E\u0432\u043E\u043C \u0442\u0430\u0439\u043D\u044B.
    \u041D\u0435 \u0442\u043E, \u0447\u0442\u043E\u0431\u044B \u043C\u043D\u0435
    \u0441\u0438\u043B\u044C\u043D\u043E \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
    \u0440\u0430\u0441\u043F\u0443\u0442\u0430\u0442\u044C \u044D\u0442\u043E\u0442
    \u043A\u043B\u0443\u0431\u043E\u043A.\"\r"
  - "            n \"\u041F\u0440\u043E\u0441\u0442\u043E \u044D\u0442\u043E \u043A\u0430\u043A-\u0442\u043E
    \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u041A\u0440\u043E\u043C\u0435
