    \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0448\u0430\u0433\u0443, \u0432
    \u043A\u0430\u0436\u0434\u043E\u043C \u0434\u043E\u043B\u0431\u0430\u043D\u043E\u043C
    \u0443\u0433\u043B\u0443 \u0432\u0441\u0435 \u0437\u043D\u0430\u044E\u0442 \u044D\u0442\u043E
    \u0441\u043B\u043E\u0432\u043E.\"\r"
  - "    mr \"\u041C\u0430\u043B\u043E\u043B\u0435\u0442\u043E\u043A \u043F\u043E\u0434\u0441\u0430\u0436\u0438\u0432\u0430\u044E\u0442,
    \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0438\u0445 \u0432\u0434\u044B\u0445\u0430\u0442\u044C
    \u044D\u0442\u0438 \u0437\u0435\u043B\u0435\u043D\u044B\u0435 \u043F\u044B\u043B\u0438\u043D\u043A\u0438.\"\r"
  - "    mr \"\u041D\u0435 \u0437\u043D\u0430\u044E, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
