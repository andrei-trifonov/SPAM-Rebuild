    \u0433\u043E\u0440\u043E\u0434\u0430\u0445.\"\r"
  - "    mr \"\u0414\u0430 \u0438 \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E.
    \u0412 \u043D\u0430\u0448\u0435\u043C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C
