  m_EditorClassIdentifier: 
  labelName: sonya_jump
  scenarioBlock:
  - "    $end_puzp = 0\r"
  - "    $ quick_menu = True\r"
  - "    scene black with dissolve\r"
  - "    stop music fadeout 3.0\r"
  - "    un \"-\u0410\u0430\u0430\u0430!!!\"\r"
  - "    s \"\u041A\u0440\u0438\u043A \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u043B
    \u043C\u0435\u043D\u044F, \u0432\u043F\u043B\u0435\u0442\u044F\u0441\u044C \u0432
    \u0441\u044E\u0436\u0435\u0442 \u0441\u043D\u0430 \u0438 \u0441\u0431\u0438\u0432
    \u043C\u0435\u043D\u044F \u0441 \u0442\u043E\u043B\u043A\u0443.\"\r"
  - "    scene cg158 with dissolve\r"
  - "    play music \"audio/Piece.mp3\"\r"
  - "    s \"\u0412 \u0433\u043B\u0430\u0437\u0430\u0445 \u0432\u0441\u0435 \u0435\u0449\u0435
    \u043F\u043B\u044F\u0441\u0430\u043B\u0438 \u0442\u0435\u043D\u0438, \u043D\u043E
    \u044F \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C
    \u043A \u043E\u043A\u043D\u0443, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
    \u0432\u044B\u0441\u0443\u043D\u0443\u0432 \u0433\u043E\u043B\u043E\u0432\u0443.\"\r"
  - "    s \"\u0414\u0432\u043E\u0435 \u0442\u0438\u043F\u043E\u0432 \u0437\u0430\u0445\u043B\u043E\u043F\u044B\u0432\u0430\u043B\u0438
    \u0434\u0432\u0435\u0440\u0446\u044B \u0442\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F. \u041E\u0434\u0438\u043D
    \u0438\u0437 \u043D\u0438\u0445 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u043D\u0435\u0442
    \u043B\u0438 \u0441\u043B\u0435\u0436\u043A\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C
    \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F \u043D\u0430 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E.\"\r"
