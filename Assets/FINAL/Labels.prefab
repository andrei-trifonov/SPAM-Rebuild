  - "    mr \"\u0412\u0441\u0435-\u0442\u0430\u043A\u0438 \u043E\u043D\u0430 \u043C\u043E\u044F
    \u043B\u0443\u0447\u0448\u0430\u044F \u043F\u043E\u0434\u0440\u0443\u0433\u0430.\"\r"
  - "    mr \"\u041D\u0435\u043B\u044C\u0437\u044F \u043F\u0440\u043E\u0441\u0442\u043E
    \u0442\u0430\u043A \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0435\u0435
    \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0435.\"\r"
  - "    mr \"\u042F-\u0442\u043E \u0437\u043D\u0430\u044E, \u043A\u0430\u043A\u043E\u0432\u043E
    \u0442\u0430\u043C. \u041E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0435\u0434\u0430, \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u0430\u044F
    \u0441\u043A\u0443\u043A\u0430, \u043F\u0440\u0438\u0434\u0443\u0440\u043A\u0438
    \u0441\u043E\u0441\u0435\u0434\u0438.\"\r"
  - "    mr \"\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430 \u043D\u0435 \u0442\u0430\u043A
    \u0443\u0436 \u0434\u0430\u043B\u0435\u043A\u043E \u043E\u0442 \u043C\u0435\u043D\u044F.
    \u041C\u043E\u0436\u0435\u0442 \u0443\u0441\u043F\u0435\u044E \u0435\u0449\u0435
    \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F?\"\r"
  - "    mr \"\u0411\u0440\u043E\u0441\u0438\u0432 \u0442\u0430\u0440\u0435\u043B\u043A\u0443
    \u0432 \u043C\u043E\u0439\u043A\u0443, \u044F \u0432\u044B\u0448\u043B\u0430
    \u043D\u0430 \u0443\u043B\u0438\u0446\u0443.\"\r"
  - "    mr \"\u041F\u043E \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u043A\u0443\u043F\u0438\u0442\u044C
    \u043F\u0430\u043A\u0435\u0442 \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u043E\u0432?\"\r"
  - "    scene cg75 with dissolve\r"
  - "    mr \"\u041E\u0431\u0448\u0430\u0440\u043F\u0430\u043D\u043D\u044B\u0435
    \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432\u043E\u0433\u043E \u0432\u044B\u0441\u0442\u0440\u043E\u0438\u043B\u0438\u0441\u044C
