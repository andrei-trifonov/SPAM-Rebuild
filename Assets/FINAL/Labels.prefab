  - "    mr \"-\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u044E.\"\r"
  - "    mr \"\u042F \u0441\u043B\u043E\u0436\u0438\u043B\u0430 \u0440\u0443\u043A\u0438
