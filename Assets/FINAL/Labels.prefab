  - "    show n_s at zoomer (0.7)\r"
  - "    n \"\u0412\u0440\u0435\u043C\u044F, \u043A\u043E\u0433\u0434\u0430 \u0443
    \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u0430 \u0441\u043B\u0430\u0431\u0430\u044F,
    \u043D\u043E \u044F\u0432\u043D\u0430\u044F \u043D\u0430\u0434\u0435\u0436\u0434\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u043E\u0449\u0443\u0449\u0430\u043B\u0430
    \u0441\u0435\u0440\u0434\u0446\u0435\u043C.\"\r"
  - "    n \"\u042F \u0442\u043E\u0447\u043D\u043E \u043C\u043E\u0433\u043B\u0430
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0432\u0441\u0435 \u043A \u043B\u0443\u0447\u0448\u0435\u043C\u0443.\"\r"
  - "    show a_n at zoomer (0.1)\r"
  - "    stop music fadeout 3.0\r"
  - "    a \"\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0445\u043E\u0447\u0443
    \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F. \u0422\u0443\u0434\u0430,
