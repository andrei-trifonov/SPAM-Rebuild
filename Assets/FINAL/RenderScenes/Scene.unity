    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[699]
      value: "    mr \"\u0413\u043B\u0430\u0437\u0430 \u0435\u0433\u043E \u0431\u044B\u043B\u0438
        \u043D\u0435 \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0435,
        \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u043E\u0431\u044B\u0447\u043D\u043E
        \u043E \u0442\u0440\u0443\u043F\u0430\u0445, \u0430 \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
        \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u0438\u0437 \u043F\u043B\u043E\u0442\u043D\u043E\u0433\u043E
        \u0436\u0435\u043B\u0435, \u0431\u0443\u0434\u0442\u043E \u0435\u0441\u043B\u0438
