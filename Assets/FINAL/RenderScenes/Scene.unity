    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[776]
      value: "    mr \"\u041D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0430.
        \u0421\u043F\u0438\u0442, \u0437\u043D\u0430\u0447\u0438\u0442, \u0431\u0435\u0437
        \u0437\u0430\u0434\u043D\u0438\u0445 \u043D\u043E\u0433. \u041E\u043F\u044F\u0442\u044C
        \u043F\u0440\u0438\u0448\u043B\u0430 \u0434\u043E\u043C\u043E\u0439 \u0443\u0441\u0442\u0430\u0432\u0448\u0435\u0439.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[777]
      value: "    mr \"\u0423 \u043C\u0435\u043D\u044F, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u0443\u0434\u0430.
        \u041E\u0442\u043A\u0440\u044B\u0442\u043E\u0435 \u043E\u043A\u043D\u043E
        \u0434\u0430\u043B\u043E \u043E \u0441\u0435\u0431\u0435 \u0437\u043D\u0430\u0442\u044C.
        \u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0431\u043E\u043B\u0438\u0442
        \u0433\u043E\u043B\u043E\u0432\u0430... \u041D\u043E, \u0435\u0441\u043B\u0438
        \u0431\u044B\u0442\u044C \u0447\u0435\u0441\u0442\u043D\u043E\u0439, \u043E\u043D\u0430
        \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u043E\u043B\u0438\u0442.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[778]
      value: "    mr \"\u041D\u0443\u0436\u043D\u043E \u0441\u0445\u043E\u0434\u0438\u0442\u044C
        \u0432 \u0434\u0443\u0448, \u043F\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F.\"\r"
