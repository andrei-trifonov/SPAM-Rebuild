    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[104]
      value: "    mr \"\u0415\u0449\u0435 \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0443\u043D\u0434
        \u043D\u0435 \u0440\u0435\u0448\u0430\u044E\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
