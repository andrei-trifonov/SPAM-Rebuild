    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[255]
      value: "    mr \"\u041F\u0440\u043E\u0441\u0442\u0438 \u043C\u0435\u043D\u044F,
        \u041C\u0438\u0448\u0430, \u0442\u044B... \u0421\u043E\u0432\u0441\u0435\u043C
        \u043D\u0435\u0432\u0438\u043D\u043E\u0432\u0430\u0442. \u041C\u043D\u0435
        \u0436\u0430\u043B\u044C, \u0447\u0442\u043E \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
        \u0442\u0435\u0431\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C.
        \u041B\u0443\u0447\u0448\u0435 \u0431\u044B... \u041B\u0443\u0447\u0448\u0435
        \u0431\u044B \u0442\u044B \u043F\u043E\u0441\u043A\u043E\u0440\u0435\u0435
        \u043D\u0430\u0448\u0435\u043B \u043D\u043E\u0432\u0443\u044E \u0434\u0435\u0432\u0443\u0448\u043A\u0443.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[256]
      value: "    mr \"\u0410 \u043C\u043E\u0436\u0435\u0442, \u0442\u044B \u043C\u043D\u0435
        \u0437\u0430\u0447\u0435\u043C-\u0442\u043E \u0432\u0440\u0435\u0448\u044C,
        \u0438 \u043D\u0430\u0448\u0435\u043B \u043A\u043E\u0433\u043E-\u0442\u043E?
        \u042F \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B
        \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u0442\u0430\u043A. \u041F\u043E\u0442\u043E\u043C\u0443
        \u0447\u0442\u043E \u044F \u0442\u0435\u0431\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
        \u043D\u0438\u0447\u0435\u0433\u043E - \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0441\u043C\u043E\u0433\u0443 \u0434\u0430\u0442\u044C.\"\r"
      objectReference: {fileID: 0}
