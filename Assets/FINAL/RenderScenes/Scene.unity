      propertyPath: scenarioBlock.Array.data[48]
      value: "    narrator \"\u042F \u0431\u0435\u0440\u0443 \u0442\u0435\u043B\u0435\u0444\u043E\u043D,
        \u0441\u043C\u043E\u0442\u0440\u044E, \u0447\u0442\u043E \u043D\u043E\u0432\u043E\u0433\u043E...
