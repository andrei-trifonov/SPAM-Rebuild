        \u0432 \u0437\u0430\u043C\u043A\u0435 \u0438 \u0437\u0430\u043F\u0435\u0440
        \u0434\u0432\u0435\u0440\u044C.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[587]
      value: "    narrator \"\u042F \u043F\u043E\u0434\u0431\u0435\u0436\u0430\u043B\u0430
        \u043A \u043D\u0435\u0439 \u0438 \u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043E
        \u0437\u043B\u043E\u0441\u0442\u044C\u044E \u0434\u0435\u0440\u0433\u0430\u0442\u044C
        \u0440\u0443\u0447\u043A\u0443, \u043D\u043E \u043E\u043D\u0430 \u043D\u0435
        \u043F\u0440\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B\u0430\u0441\u044C.
        \u0412\u043E\u0442 \u0447\u0435\u0440\u0442, \u0435\u0449\u0435 \u0438 \u043F\u043E\u0434\u0448\u0443\u0442\u0438\u0442\u044C
        \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439 \u043A\u0442\u043E-\u0442\u043E
        \u0437\u0430\u0445\u043E\u0442\u0435\u043B.\"\r"
