    - type: 0
      name: 1
      line: "\u0421\u043E\u043D\u044F \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0430
        \u043C\u043E\u044E \u043B\u0430\u0434\u043E\u043D\u044C."
