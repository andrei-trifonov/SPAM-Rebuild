  Labels:
  - name: "\u0433\u043B\u0430\u0432\u04301"
    lines:
    - type: 0
      name: 3
      line: "\u0413\u0434\u0435 \u0432\u0441\u0435? \u041C\u044B \u0436\u0435  \u0432\u0440\u043E\u0434\u0435
        \u043A\u0430\u043A \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u043B\u0438..."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 1
      pose: 1
      additionalPose: 
      music: 0
      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 3
      line: "-\u041D\u0435 \u0437\u043D\u0430\u044E. \u0410 \u0443 \u0442\u0435\u0431\u044F
        \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0440\u0443\u043A\u0438?"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
