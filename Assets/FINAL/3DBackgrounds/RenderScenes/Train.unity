    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[819]
      value: "    narrator \"\u041E\u0439, \u043A\u0430\u043A\u0438\u0435 \u0433\u043B\u0443\u043F\u043E\u0441\u0442\u0438!
        \u042F \u0441\u043C\u0443\u0442\u0438\u043B\u0430\u0441\u044C \u043E\u0442
