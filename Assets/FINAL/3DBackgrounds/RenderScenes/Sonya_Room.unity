    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[51]
      value: "    narrator \"\u0416\u0430\u043B\u044C \u043E\u043D \u043D\u0435 \u0437\u043D\u0430\u0435\u0442,
        \u0447\u0442\u043E \u043C\u0435\u043D\u044F \u043E\u0442 \u043D\u0435\u0433\u043E
        \u0443\u0436\u0435 \u0442\u043E\u0448\u043D\u0438\u0442, \u0447\u0442\u043E
        \u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443
        \u0435\u0433\u043E \u0432\u0438\u0434\u0435\u0442\u044C. \u0425\u043E\u0442\u044F,
        \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0431\u044B \u0438 \u0437\u043D\u0430\u043B,
        \u043D\u0438\u0447\u0435\u0433\u043E \u0431\u044B \u043D\u0435 \u043F\u043E\u043C\u0435\u043D\u044F\u043B\u043E\u0441\u044C,
        \u0432\u0435\u0434\u044C \u043E\u043D \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A,
        \u043A\u043E\u0433\u0434\u0430 \u0447\u0442\u043E-\u0442\u043E \u0438\u0434\u0435\u0442
        \u043D\u0435 \u043F\u043E \u0435\u0433\u043E \u043F\u043B\u0430\u043D\u0443.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[52]
      value: "    narrator \"\u041E\u043D \u0431\u044B \u0434\u043E\u0431\u0438\u043B\u0441\u044F
        \u0441\u0432\u043E\u0435\u0433\u043E - \u0442\u043E \u0435\u0441\u0442\u044C
        \u043C\u043E\u0435\u0433\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F,
        \u043B\u044E\u0431\u044B\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C.
        \u0415\u0441\u043B\u0438 \u0431\u044B \u043C\u044B \u0440\u0430\u0441\u0441\u0442\u0430\u043B\u0438\u0441\u044C,
        \u043E\u043D \u0431\u044B \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
