    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[801]
      value: "    mr \"\u041A\u0430\u043A\u043E\u0435 \u0432\u0441\u0435-\u0442\u0430\u043A\u0438
        \u0443\u0441\u0442\u0430\u0432\u0448\u0435\u0435 \u0443 \u043C\u0435\u043D\u044F
        \u043B\u0438\u0446\u043E. \u0418 \u044D\u0442\u0438 \u0441\u0438\u043D\u044F\u043A\u0438...
        \u041C\u043D\u0435 \u0431\u044B \u0441\u043F\u0430\u0442\u044C \u043F\u043E\u043B\u0443\u0447\u0448\u0435...
        \u0438\u043B\u0438 \u043F\u043E\u0434\u043E\u043B\u044C\u0448\u0435. \u0425\u043E\u0440\u043E\u0448\u043E,
        \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C
        \u043A\u043E\u0444\u0435, \u0430 \u0442\u043E \u044F \u0431\u044B \u0442\u043E\u0447\u043D\u043E
        \u043D\u0435 \u0443\u0434\u0435\u0440\u0436\u0430\u043B\u0430\u0441\u044C
        \u043E\u0442 \u043F\u0430\u0440\u0443 \u0447\u0430\u0448\u0435\u043A \u044D\u0442\u043E\u0433\u043E
        \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
        \u043D\u0430\u043F\u0438\u0442\u043A\u0430.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[802]
      value: "    mr \"\u041A\u0441\u0442\u0430\u0442\u0438... \u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F,
        \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0434\u0430\u0436\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0441\u044A\u0435\u043B\u0430. \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
        \u0437\u0430\u0432\u0442\u0440\u0430 \u043C\u043D\u0435 \u0443\u0434\u0430\u0441\u0442\u0441\u044F
        \u0443\u0442\u043E\u043B\u0438\u0442\u044C \u0433\u043E\u043B\u043E\u0434
        \u0437\u0430 \u0446\u0435\u043B\u044B\u0445 \u0434\u0432\u0430 \u0434\u043D\u044F.\"\r"
      objectReference: {fileID: 0}
