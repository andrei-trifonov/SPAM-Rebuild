    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[252]
      value: "    mr \"\u042F \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B\u0430
        \u0438 \u0443\u0436\u0430\u0441\u043D\u0443\u043B\u0430\u0441\u044C. \u041C\u043D\u0435
        \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u0435
        \u0440\u0430\u0432\u043D\u043E? \u041D\u0435\u0442, \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
        \u0431\u044B\u0442\u044C. \u041A\u0430\u043A\u0430\u044F \u0436\u0435 \u044F
        \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F.
        \u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u043D\u0435 \u043F\u043B\u0435\u0432\u0430\u0442\u044C
        \u043D\u0430 \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438, \u043C\u043E\u0436\u043D\u043E
        \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0440\u043E\u0434\u043D\u043E\u0433\u043E
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430?\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[253]
      value: "    ms \"-\u042F \u043E\u0447\u0435\u043D\u044C \u0443\u0441\u0442\u0430\u043B
