      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[57]
      value: "    narrator \"\u042F \u0431\u044B \u0438 \u043C\u0443\u0441\u043E\u0440\u043D\u044B\u0439
        \u043C\u0435\u0448\u043E\u043A \u0432\u044B\u043A\u0438\u043D\u0443\u043B\u0430
        \u0438\u0437 \u043E\u043A\u043D\u0430, \u043D\u043E \u0431\u043E\u044E\u0441\u044C,
