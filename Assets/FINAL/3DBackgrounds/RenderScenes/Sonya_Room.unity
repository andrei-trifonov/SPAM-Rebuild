  - name: "\u0433\u043B\u0430\u0432\u04301"
    lines:
    - type: 0
      name: 3
      line: "\u0413\u0434\u0435 \u0432\u0441\u0435? \u041C\u044B \u0436\u0435  \u0432\u0440\u043E\u0434\u0435
        \u043A\u0430\u043A \u043E\u043F\u0430\u0437\u0434\u044B\u0432\u0430\u043B\u0438..."
