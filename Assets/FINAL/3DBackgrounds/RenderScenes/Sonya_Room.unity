        \u0422\u0430\u043A\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439,
        \u043D\u043E... \u0432 \u043D\u0435\u043C \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
