        \u0438\u0437 \u043C\u043E\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u044B,
        \u0431\u0443\u0434\u0442\u043E \u0438\u0445 \u0442\u0430\u043C \u043D\u0438\u043A\u043E\u0433\u0434\u0430
