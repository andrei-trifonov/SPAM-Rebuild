      value: "    mr \"\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0448\u0430\u043C\u043F\u0443\u043D\u044C
        \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F... \u0415\u0449\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0434\u043D\u0435\u0439 \u043D\u0430\u0437\u0430\u0434. \u0427\u0442\u043E
        \u0436, \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043E\u0431\u043E\u0439\u0442\u0438\u0441\u044C
        \u0431\u0435\u0437 \u043D\u0435\u0433\u043E - \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C
        \u043D\u0430 \u0443\u043B\u0438\u0446\u0443 \u0436\u0443\u0442\u043A\u043E
        \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[781]
      value: "    mr \"\u041A\u0430\u043F... \u043A\u0430\u043F... \u0432\u043E\u0434\u0430
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0440\u0436\u0430\u0432\u0430\u044F,
        \u043D\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E.
        \u0411\u044B\u0432\u0430\u043B\u043E \u0445\u0443\u0436\u0435.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[782]
      value: "    mr \"\u0413\u043E\u0440\u044F\u0447\u043E. \u041F\u0440\u0438\u044F\u0442\u043D\u043E.
        \u041F\u0430\u0440 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
        \u043C\u0435\u043D\u044F \u0432 \u0442\u0435\u043F\u043B\u044B\u0435 \u043E\u0431\u044A\u044F\u0442\u0438\u044F.
        \u0418 \u044F... \u043D\u0435 \u0445\u043E\u0447\u0443 \u0438\u0445 \u043F\u043E\u043A\u0438\u0434\u0430\u0442\u044C.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[783]
      value: "    mr \"\u0425\u043E\u0442\u044F \u0431\u044B, \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0435
        \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u0427\u0442\u043E-\u0442\u043E
        \u0449\u0438\u043F\u043B\u0435\u0442 \u0440\u0443\u043A\u0443... \u0410\u0445
        \u0434\u0430. \u042F \u0436\u0435 \u0435\u0435 \u043F\u043E\u0440\u0435\u0437\u0430\u043B\u0430
        \u0441\u0442\u0435\u043A\u043B\u043E\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u0443\u0442\u0440\u043E\u043C.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[784]
      value: "    mr \"\u042D\u0442\u0438 \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u0438...
        \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u0439\u043C\u0435\u0448\u044C,
        \u0433\u0434\u0435 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
        \u0430 \u0433\u0434\u0435 - \u043D\u0435\u0442. \u041E\u0442 \u043D\u0438\u0445
        \u043B\u0435\u0433\u043A\u043E \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F,
        \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C... \u041D\u0443\u0436\u043D\u043E
        \u043F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0436\u0438\u0442\u044C
        \u043A\u0430\u043A \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A...\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[785]
      value: "    mr \"\u042F \u0447\u0430\u0441\u0442\u043E \u043D\u0435\u043D\u0430\u0432\u0438\u0436\u0443
        \u0441\u0435\u0431\u044F \u0437\u0430 \u0432\u0441\u0435, \u0447\u0442\u043E
        \u0434\u0435\u043B\u0430\u044E, \u043D\u043E \u0431\u043E\u044E\u0441\u044C,
        \u043C\u043D\u0435 \u043D\u0435 \u0443\u0431\u0435\u0436\u0430\u0442\u044C
        \u043E\u0442 \u0442\u043E\u0439 \u041C\u0438\u0440\u044B \u041A\u0430\u043B\u0438\u043D\u0438\u043D\u043E\u0439,
        \u0447\u0442\u043E \u0432\u0435\u0447\u043D\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442
        \u0432 \u0434\u0443\u0440\u043D\u044B\u0435 \u0438\u0441\u0442\u043E\u0440\u0438\u0438,
        \u0447\u0442\u043E \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u0435\u0442
        \u043D\u0430\u0440\u043A\u043E\u0442\u0438\u043A\u0438 \u043F\u043E\u0447\u0442\u0438
        \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E, \u0447\u0442\u043E
        \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0430\u0441\u044C \u0432 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
        \u043C\u044B\u0441\u043B\u044F\u0445.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[786]
      value: "    mr \"\u0418 \u044F \u0432\u0441\u0435 \u0447\u0430\u0449\u0435
        \u0434\u0443\u043C\u0430\u044E \u043E\u0431 \u044D\u0442\u043E\u043C, \u0432\u0435\u0434\u044C
        \u043C\u043D\u0435 \u0432\u0441\u0435 \u0445\u0443\u0436\u0435 \u0438 \u0445\u0443\u0436\u0435...\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[787]
      value: "    mr \"\u0411\u043E\u044E\u0441\u044C, \u0447\u0442\u043E \u0443
        \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439
        \u043E\u0442\u0434\u0443\u0448\u0438\u043D\u044B \u0432 \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0441\u0442\u0438,
        \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430
        \u0437\u0430 \u0432\u0441\u044E \u043C\u043E\u044E \u0436\u0438\u0437\u043D\u044C,
        \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0431\u044B \u044F \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430
        \u0441\u0435\u0431\u044F \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u043D\u043E\u0439.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[788]
      value: "    mr \"\u041D\u0443, \u0438\u043B\u0438 \u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u043E
        \u043C\u0430\u043B\u043E.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[789]
      value: "    mr \"\u041A\u0430\u043A \u0436\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u0435\u043D
        \u0434\u0443\u0448 \u043F\u043E\u0441\u043B\u0435 \u0442\u044F\u0436\u0435\u043B\u043E\u0433\u043E
        \u0434\u043D\u044F!\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[790]
      value: "    mr \"\u042F \u0441\u0435\u043B\u0430 \u043D\u0430 \u043F\u043E\u043B
        \u043A\u0430\u0431\u0438\u043D\u043A\u0438 \u0438 \u0437\u0430\u043A\u0440\u044B\u043B\u0430
        \u0433\u043B\u0430\u0437\u0430, \u0440\u0430\u0441\u043F\u043B\u044B\u043B\u0430\u0441\u044C,
        \u043A\u0430\u043A \u043A\u0443\u0431\u0438\u043A \u043B\u044C\u0434\u0430
        \u0432 \u043A\u0438\u043F\u044F\u0449\u0435\u0439 \u0432\u043E\u0434\u0435.
        \u041D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F
        \u043E\u0442 \u0432\u0441\u0435\u0433\u043E... \u041F\u043B\u0435\u0432\u0430\u0442\u044C,
        \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
        \u0442\u0430\u043C, \u0437\u0430 \u043F\u043E\u0440\u043E\u0433\u043E\u043C.
        \u0422\u0430\u043A \u043B\u0435\u0433\u043A\u043E, \u043A\u043E\u0433\u0434\u0430
        \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0432\u043E\u043B\u043D\u0443\u0435\u0442...\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[791]
