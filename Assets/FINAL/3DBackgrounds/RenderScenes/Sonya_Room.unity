      propertyPath: scenarioBlock.Array.data[254]
      value: "    mr \"-\u041C\u043E\u0436\u0435\u0442, \u0443\u0436\u0435 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0448\u044C?\"\r"
