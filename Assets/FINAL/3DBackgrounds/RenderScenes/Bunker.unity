        \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430 \u0440\u0430\u0437\u043D\u0438\u0446\u044B,
        \u0435\u0441\u043B\u0438 \u0431\u044B \u0441\u0435\u0439\u0447\u0430\u0441
        \u0435\u0433\u043E \u0432\u044B\u043F\u0438\u043B\u0430 \u0432 \u043A\u0430\u043A\u043E\u043C-\u043D\u0438\u0431\u0443\u0434\u044C
