    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[118]
      value: "    mo \"-\u0412\u043E\u0442 \u0442\u0430\u043A \u0435\u043C\u0443
        \u0432 \u043B\u0438\u0446\u043E \u0438 \u0441\u043A\u0430\u0436\u0435\u0448\u044C.
        \u041C\u043D\u0435 \u0442\u0430\u043A\u043E\u0435 \u0441\u043B\u044B\u0448\u0430\u0442\u044C
        \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E.
        \u041D\u0435\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u0430\u044F,
        \u043D\u0438\u0447\u0435\u0433\u043E, \u0447\u0442\u043E \u044F \u0434\u043B\u044F
        \u0442\u0435\u0431\u044F \u0434\u0435\u043B\u0430\u044E \u043D\u0435 \u0446\u0435\u043D\u0438\u0448\u044C.
        \u041B\u0430\u0434\u043D\u043E \u0431\u044B \u0442\u043E\u043B\u044C\u043A\u043E
        \u0441\u043E \u043C\u043D\u043E\u0439 \u0442\u0430\u043A, \u043D\u043E \u043D\u0435\u0442
        \u0436\u0435.\"\r"
