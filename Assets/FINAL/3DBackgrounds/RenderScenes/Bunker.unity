      propertyPath: scenarioBlock.Array.data[111]
      value: "    mo \"-\u0421\u043D\u043E\u0432\u0430 \u0432 \u043C\u043E\u0435\u0439
        \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0430
