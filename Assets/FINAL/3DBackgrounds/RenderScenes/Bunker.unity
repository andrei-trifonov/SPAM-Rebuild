    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[114]
      value: "    mr \"\u041C\u0430\u043C\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u043D\u0430 \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0438\u0437\u0440\u0435\u0437\u0430\u043D\u043D\u0443\u044E
        \u0441\u0442\u0435\u043A\u043B\u043E\u043C \u0440\u0443\u043A\u0443, \u0438
        \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u0432\u0448\u0438\u0441\u044C,
        \u043E\u0442\u0432\u0435\u043B\u0430 \u0432\u0437\u0433\u043B\u044F\u0434.\"\r"
