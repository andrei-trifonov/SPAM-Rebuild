      propertyPath: scenarioBlock.Array.data[117]
      value: "    mr \"-\u0421\u043D\u043E\u0432\u0430 \u044D\u0442\u043E\u0442 \u043F\u0435\u0434\u043E\u0444\u0438\u043B...\"\r"
