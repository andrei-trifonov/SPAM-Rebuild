    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[103]
      value: "    mr \"\u0421\u0442\u0443\u0447\u0438\u0442 \u043F\u043E \u0432\u0438\u0441\u043A\u0430\u043C,
        \u0438 \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u043C\u043E\u044F \u0433\u043E\u043B\u043E\u0432\u0430
