      propertyPath: scenarioBlock.Array.data[623]
      value: "    mr \"\u041A\u0430\u043A \u043C\u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0442\u044C
        \u0440\u0430\u0441\u0441\u0432\u0435\u0442 \u0441\u0432\u043E\u0435\u0433\u043E
        \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0430? \u041A\u043E\u0433\u0434\u0430
        \u0432\u0441\u0435, \u0447\u0442\u043E \u044F \u043C\u043E\u0433\u0443 \u0434\u0435\u043B\u0430\u0442\u044C
        - \u043B\u0438\u0448\u044C \u0436\u0434\u0430\u0442\u044C?\"\r"
