      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 3
      line: "-\u041D\u0435 \u0437\u043D\u0430\u044E. \u0410 \u0443 \u0442\u0435\u0431\u044F
        \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0440\u0443\u043A\u0438?"
