      propertyPath: scenarioBlock.Array.data[615]
      value: "    mr \"\u041C\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0435\u0442
