    - type: 0
      name: 1
      line: "-\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C
        \u043E\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0437\u0432\u0443\u043A\u0430.
        \u0411\u0443\u0434\u0442\u043E \u043D\u0430 \u0443\u043B\u0438\u0446\u0435
        \u0437\u0430\u0437\u0432\u0443\u0447\u0430\u043B\u0430 \u0441\u0438\u0440\u0435\u043D\u0430...
