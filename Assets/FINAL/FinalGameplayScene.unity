    - type: 0
      name: 2
      line: "\u042F \u0432\u044B\u0433\u043B\u044F\u043D\u0443\u043B\u0430 \u0432
        \u043E\u043A\u043D\u043E. \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
