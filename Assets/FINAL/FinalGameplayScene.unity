    - type: 8
      name: 2
      line: "\u041C\u0438\u0440 \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434\u043E
        \u043C\u043D\u043E\u0439 \u0440\u0430\u0441\u043F\u0430\u043B\u0441\u044F
        \u043D\u0430 \u043F\u0438\u043A\u0441\u0435\u043B\u0438, \u0431\u0443\u0434\u0442\u043E
        \u0431\u044B \u043C\u0430\u0442\u0435\u0440\u0438\u044F \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C
        \u043D\u0430 \u043A\u043B\u043E\u0447\u043A\u0438, \u0430 \u0438\u0437 \u043A\u043B\u043E\u0447\u043A\u043E\u0432
        \u0441\u043E\u0431\u0440\u0430\u043B\u0441\u044F \u0446\u0435\u043B\u044B\u0439
        \u0443\u0440\u0430\u0433\u0430\u043D \u0438\u0437 \u0447\u0430\u0441\u0442\u0438\u0446,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u0440\u0435\u0437\u0430\u043B\u0438\u0441\u044C
        \u0432 \u043C\u043E\u0435 \u0442\u0435\u043B\u043E, \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0432
        \u0432\u043D\u0443\u0442\u0440\u044C \u0438 \u043E\u0431\u043B\u0435\u043F\u0438\u0432
        \u043F\u043E\u0432\u0441\u044E\u0434\u0443."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
