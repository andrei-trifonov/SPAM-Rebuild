    - type: 0
      name: 5
      line: "-\u0418 \u0442\u0435 \u0432\u044B\u0431\u043E\u0440\u044B, \u0447\u0442\u043E
        \u0442\u044B \u0434\u0435\u043B\u0430\u0435\u0448\u044C... \u0422\u044B \u0434\u0435\u043B\u0430\u0435\u0448\u044C
        \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u043D\u043E? \u0422\u044B \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u0448\u044C
