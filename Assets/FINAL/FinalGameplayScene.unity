      line: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F
        \"\u041F\u0441\u0438\u0445\u0435\u0438\". \u0412 \u043C\u043E\u0435\u043C
        \u0441\u043B\u0443\u0447\u0430\u0435 - \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
