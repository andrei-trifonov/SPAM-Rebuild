    - type: 0
      name: 0
      line: "\u041C\u0435\u043D\u044F \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
        \u0432\u043E\u043E\u0431\u0449\u0435 \u0436\u0435\u043B\u0435\u043C\u044B\u0445\u043E\u043C
        \u043A\u043E\u0440\u043C\u0438\u043B\u0438. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
