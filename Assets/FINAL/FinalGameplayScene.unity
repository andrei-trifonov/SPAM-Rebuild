      name: 2
      line: "\u041A\u043E\u0442 \u0432 \u043F\u0430\u043D\u0438\u043A\u0435 \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F
        \u0446\u0435\u043F\u043B\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
