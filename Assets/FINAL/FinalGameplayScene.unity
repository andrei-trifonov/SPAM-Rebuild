    - type: 0
      name: 4
      line: "-\u0410\u0439! \u042F \u0442\u0435\u0431\u044F \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430.
        \u0423 \u043D\u0430\u0441 \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439,
        \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0435\u0431\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C?\r\n\u042F
        \u0432\u043E\u043E\u0431\u0449\u0435 \u043E\u0444\u0438\u0433\u0435\u043B\u0430,
        \u0432 \u043D\u0430\u0448\u0435\u0439 \u0433\u043B\u0443\u0448\u0438 \u0438
        \u043A\u0442\u043E-\u0442\u043E \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F,
        \u0434\u0430 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0442\u0430\u043A\u043E\u0433\u043E
        \u043D\u0435 \u0431\u044B\u043B\u043E! \u0422\u043E\u043B\u044C\u043A\u043E
        \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u043A\u043B\u0430\u0441\u0441\u043E\u0432
        \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u043B\u0438...\r\n"
