    - type: 0
      name: 2
      line: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0443\u0441\u0438\u043B\u0438\u0435,
        \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F
        \u043F\u043E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435 \u043D\u0430\u0432\u0435\u0440\u0445,
        \u0438 \u044F \u0441\u043C\u043E\u0433\u0443 \u043D\u0430\u043A\u043E\u043D\u0435\u0446
        \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0438 \u0432\u0441\u0435
        \u043E\u0441\u043C\u044B\u0441\u043B\u0438\u0442\u044C. \u0422\u044F\u0436\u0435\u043B\u0430\u044F
        \u0436\u0435\u043B\u0435\u0437\u043D\u0430\u044F \u0434\u0432\u0435\u0440\u044C
        \u0441 \u0433\u0443\u043B\u043E\u043C \u0437\u0430\u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430\u0441\u044C,
        \u0438 \u0432\u043E\u0442 \u044F \u043F\u043E\u0434\u044B\u043C\u0430\u044E\u0441\u044C
        \u043D\u0430 \u0441\u0432\u043E\u0439 \u044D\u0442\u0430\u0436. "
