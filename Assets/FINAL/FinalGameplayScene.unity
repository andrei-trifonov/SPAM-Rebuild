      propertyPath: scenarioBlock.Array.data[703]
      value: "    ohr \"\u0421\u0442\u043E\u0440\u043E\u0436 \u043D\u0435\u0434\u043E\u0432\u0435\u0440\u0447\u0438\u0432\u043E
