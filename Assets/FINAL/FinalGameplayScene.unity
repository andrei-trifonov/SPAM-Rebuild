      propertyPath: scenarioBlock.Array.data[278]
      value: "    mr \"\u0417\u0430\u0432\u0442\u0440\u0430 \u0431\u0443\u0434\u0435\u0442
        \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u0437\u0430 \u043C\u0435\u0441\u044F\u0446,
        \u043A\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u0439\u0434\u0443 \u0443\u0447\u0438\u0442\u044C\u0441\u044F.
        \u0420\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u044F \u0434\u0430\u0436\u0435
        \u043D\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        - \u0432\u043E\u0437\u044C\u043C\u0443 \u0441 \u0441\u043E\u0431\u043E\u0439
        \u043A\u0443\u0447\u0443 \u043F\u0443\u0441\u0442\u044B\u0445 \u0442\u0435\u0442\u0440\u0430\u0434\u0435\u0439.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[279]
      value: "    mr \"\u041D\u0435 \u0442\u043E \u0447\u0442\u043E\u0431\u044B \u043C\u043D\u0435
        \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0437\u0430\u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
        \u0441\u0442\u0430\u0442\u044C \u0443\u043C\u043D\u0435\u0435, \u043F\u0440\u043E\u0441\u0442\u043E
        \u0435\u0441\u043B\u0438 \u044F \u043F\u0440\u043E\u043F\u0443\u0449\u0443
        \u0435\u0449\u0435 \u043D\u0435\u0434\u0435\u043B\u044E, \u043C\u0435\u043D\u044F,
        \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u043E\u0442\u0447\u0438\u0441\u043B\u044F\u0442.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[280]
      value: "    mr \"\u0415\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E,
        \u044F \u0441\u0430\u043C\u0430 \u0434\u043E \u043A\u043E\u043D\u0446\u0430
        \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0437\u0430\u0447\u0435\u043C
        \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E
        \u0442\u0443\u0434\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u044C,
        \u043D\u043E \u0435\u0441\u043B\u0438 \u043C\u0435\u043D\u044F \u0432\u044B\u0433\u043E\u043D\u044F\u0442
        - \u043C\u0430\u043C\u0430 \u0431\u0443\u0434\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u043E
        \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0442\u044C.\"\r"
      objectReference: {fileID: 0}
