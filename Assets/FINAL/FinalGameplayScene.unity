      line: "-\u041C\u043E\u0438 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438...
        \u042F \u0438\u0445 \u0440\u0435\u0434\u043A\u043E \u0432\u0438\u0436\u0443.
        \u041C\u044B \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043E\u0431\u0449\u0430\u0435\u043C\u0441\u044F,
        \u0437\u0430\u0442\u043E... \u0423 \u043C\u0435\u043D\u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u043D\u0435\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438.
        \u041C\u043E\u0436\u0435\u0442, \u043E\u043D\u0438 \u0442\u0430\u043A \u0445\u043E\u0442\u044F\u0442
        \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u0441\u0432\u043E\u044E \u043B\u044E\u0431\u043E\u0432\u044C? \u042F \u043D\u0435
        \u0437\u043D\u0430\u044E... \u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u043D\u0435
        \u0432\u0430\u0436\u043D\u043E. \u0427\u0442\u043E \u043D\u0430\u0441\u0447\u0451\u0442
        \u0442\u0435\u0431\u044F?"
