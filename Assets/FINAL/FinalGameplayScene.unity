  - name: "\u041A\u043E\u043D\u0435\u04461 \u0421\u0435\u043A\u0440\u0435\u0442"
    lines:
    - type: 0
      name: 2
      line: "\u0423\u0436\u0430\u0441\u043D\u0430\u044F \u0431\u043E\u043B\u044C
        \u043E\u0442\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
        \u0411\u043E\u0436\u0435, \u0431\u0443\u0434\u0442\u043E \u044F \u043E\u0449\u0443\u0449\u0430\u044E
        \u043A\u0430\u0436\u0434\u044B\u0439 \u043E\u0442\u0434\u0435\u043B \u0441\u0432\u043E\u0435\u0433\u043E
        \u043C\u043E\u0437\u0433\u0430... \u041C\u043E\u044F \u0433\u043E\u043B\u043E\u0432\u0430
        \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u043E\u0441\u0442\u044B\u0432\u0430\u0435\u0442.
        \u0427\u0442\u043E-\u0442\u043E \u0441\u043B\u0435\u043F\u0438\u0442 \u0433\u043B\u0430\u0437\u0430...
        \u0422\u0430\u043A\u043E\u0435 \u044F\u0440\u043A\u043E\u0435...\n"
