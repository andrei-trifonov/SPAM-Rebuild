    - type: 0
      name: 2
      line: "\u042F \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u043A\u0430\u043A
        \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u043B\u044C\u0448\u0435 \u0437\u0430\u0434\u0432\u0438\u043D\u0443\u0442\u044C
        \u043C\u044B\u0441\u043B\u044C \u043E \u0442\u043E\u043C, \u0447\u0442\u043E
        \u044F \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0430 \u0432 \u044D\u0442\u043E\u043C
        \u0438\u043B\u043B\u044E\u0437\u043E\u0440\u043D\u043E\u043C \u043C\u0438\u0440\u0435,
        \u0438 \u0447\u0442\u043E \u0432\u044B\u0445\u043E\u0434\u0430 \u043D\u0435\u0442,
        \u043D\u043E... \u0421\u0435\u0440\u0434\u0446\u0435 \u0431\u044C\u0435\u0442\u0441\u044F
        \u0432 \u043A\u0430\u043A\u043E\u043C-\u0442\u043E \u043F\u044C\u044F\u043D\u043E\u043C
        \u0443\u0433\u0430\u0440\u0435, \u0430 \u043C\u043E\u0437\u0433 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
        \u0432 \u0433\u0443\u0441\u0442\u043E\u0439 \u043A\u0438\u0441\u0435\u043B\u044C.
        \n"
