    - type: 0
      name: 2
      line: "\u0412 \u0441\u0432\u0435\u0442\u0435 \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0430
        \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043A\u0443\u0434\u0430
        \u043F\u0440\u043E\u0449\u0435. \u0414\u0430\u0436\u0435 \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
        \u043D\u0430 \u0432\u0441\u0435 \u044D\u0442\u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0435
        \u0442\u0435\u043D\u0438, \u0447\u0442\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
        \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432, \u0441\u0442\u043E\u0438\u0442
        \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u0443\u0447\u0443 \u043F\u0440\u043E\u0431\u0435\u0436\u0430\u0442\u044C
        \u043F\u043E \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u043C."
