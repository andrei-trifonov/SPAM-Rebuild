    - type: 0
      name: 6
      line: "-\u0422\u044B \u0438 \u0441\u0430\u043C\u0430 \u0434\u043E\u0433\u0430\u0434\u044B\u0432\u0430\u0435\u0448\u044C\u0441\u044F,
        \u043A\u0430\u043A \u0443\u0441\u0442\u0440\u043E\u0435\u043D \u043C\u0438\u0440. 
        \u0412\u0441\u0435 \u043C\u044B - \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B
        \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0433\u043E \u043C\u043E\u0437\u0430\u0438\u0447\u043D\u043E\u0433\u043E
        \u043F\u0430\u0437\u043B\u0430, \u043A\u0443\u0441\u043E\u0447\u043A\u0438
        \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438, \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0435
        \u0432 \u0431\u0435\u0437\u0434\u043E\u043D\u043D\u0443\u044E \u043F\u0443\u0447\u0438\u043D\u0443,
        \u0435\u043F\u0442\u0430 \u0431\u043B\u044F."
