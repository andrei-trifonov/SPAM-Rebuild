    - type: 0
      name: 2
      line: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441 \u043F\u0435\u0440\u0435\u0431\u043E\u0440\u043E\u043B
        \u0441\u0442\u0440\u0430\u0445 \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C,
        \u0438 \u044F \u0434\u043E\u0441\u0442\u0430\u043B\u0430 \u0438\u043D\u044A\u0435\u043A\u0442\u043E\u0440.
        \u041C\u043E\u0436\u0435\u0442, \u043E\u0442 \u044D\u0442\u043E\u0433\u043E
        \u043C\u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u043B\u0435\u0433\u0447\u0435?
        \u042F \u0441 \u0440\u0430\u0437\u043C\u0430\u0445\u0443 \u0432\u0441\u0430\u0434\u0438\u043B\u0430
        \u0438\u0433\u043B\u0443 \u0432 \u043D\u043E\u0433\u0443.\r\n"
