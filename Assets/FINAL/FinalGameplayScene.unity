    - type: 0
      name: 2
      line: "\u0422\u043E\u043D\u043D\u0435\u043B\u044C \u043C\u0435\u0436\u0434\u0443
        \u0431\u0443\u0445\u0438\u043C\u0438 \u0432\u043E\u043D\u044E\u0447\u0438\u043C\u0438
        \u0442\u0435\u043B\u0430\u043C\u0438 \u0442\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0441\u044F,
        \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u043D\u0430\u043C \u043F\u0440\u043E\u0442\u0438\u0441\u043D\u0443\u0442\u044C\u0441\u044F
        \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u043A\u0440\u0443\u0433\u0443,
        \u0442\u043E \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u043C\u044B\u043A\u0430\u043B\u0441\u044F,
        \u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C
        \u0441\u043E \u0432\u0441\u0435\u0439 \u0441\u0438\u043B\u044B \u043E\u0442\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u0442\u044C
        \u0442\u0443\u0448\u0443, \u0447\u0442\u043E\u0431\u044B \u0442\u0430 \u0445\u043E\u0442\u044C
        \u0447\u0443\u0442\u043E\u0447\u043A\u0443 \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C,
        \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0432 \u043D\u0430\u0448
        \u0442\u0438\u043F\u0430 \u043F\u0430\u0440\u0430\u0432\u043E\u0437\u0438\u043A."
