    - type: 0
      name: 4
      line: "-\u041C\u0438\u0440\u0430... \u0422\u044B \u0441\u043D\u043E\u0432\u0430...
        \u041F\u0440\u0438\u0448\u043B\u0430... \u042F \u0442\u0430\u043A... \u042F
        \u0442\u0430\u043A... \u0420\u0430\u0434\u0430 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C.
        \u0417\u0434\u0435\u0441\u044C \u0442\u0430\u043A... \u0423\u0436\u0430\u0441\u043D\u043E.
        \u042F \u0442\u0430\u043A \u0441\u043E\u0441\u043A\u0443\u0447\u0438\u043B\u0430\u0441\u044C!"
