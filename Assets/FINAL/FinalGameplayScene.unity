    - type: 0
      name: 2
      line: "\u041E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u0430 \u043C\u043D\u0435
        \u0441\u0442\u0430\u043B\u043E \u0441\u0442\u044B\u0434\u043D\u043E. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
        \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u0435\u0445\u043D\u0438\u043A\u0430
        \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043E\u0447\u0435\u043D\u044C
        \u0431\u044B\u0441\u0442\u0440\u043E, \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u0432\u043E\u0434
        \u043E\u0442\u0441\u0442\u0430\u0432\u0430\u0442\u044C \u043E\u0442 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430.
        \r\n"
