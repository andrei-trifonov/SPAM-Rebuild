    - type: 0
      name: 2
      line: "\u041A\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u0442\u0430\u0439\u043D...
        \u041D\u0443 \u0438 \u043B\u0430\u0434\u043D\u043E, \u0445\u0440\u0430\u043D\u0438
        \u0441\u0432\u043E\u0438 \u0441\u0435\u043A\u0440\u0435\u0442\u044B. \r\n\u041C\u044B
        \u0448\u0430\u0433\u0430\u043B\u0438 \u043F\u043E \u0443\u0437\u043E\u0440\u0447\u0430\u0442\u043E\u043C\u0443
        \u043A\u043E\u0432\u0440\u0443 \u0438\u0437 \u0442\u0435\u043D\u0435\u0439
        , \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C \u043D\u0435 \u0441\u043F\u043E\u0442\u043A\u043D\u0443\u0442\u044C\u0441\u044F
        \u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
        \u0438\u043B\u0438 \u0432\u0435\u0442\u043A\u0443.\r"
