    - type: 0
      name: 2
      line: "\u041C\u043E\u0436\u0435\u0442 \u043E\u043D \u043F\u0440\u0438\u0448\u0435\u043B
        \u0438\u0437-\u0437\u0430 \u0442\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F
        \u0432 \"\u041B\u0438\u0441\u044C\u0435\u0439 \u041F\u0435\u0442\u043B\u0435\"?
        \u041E\u043D \u0442\u043E\u0447\u043D\u043E \u0437\u0430\u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442
        \u043C\u0435\u043D\u044F... \u042F \u0432 \u043F\u043E\u043B\u043D\u043E\u0439
        \u0436\u043E\u043F\u0435. \u041C\u043E\u0436\u0435\u0442, \u043C\u043D\u0435
        \u043A\u0443\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u0431\u0435\u0436\u0430\u0442\u044C,
        \u043C\u043E\u0436\u0435\u0442... \u042F \u043D\u0435 \u0437\u043D\u0430\u044E,
        \u0447\u0442\u043E \u043C\u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C!
        \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043D\u0430 \u0441\u0432\u0435\u0436\u0438\u0439
        \u0432\u043E\u0437\u0434\u0443\u0445.\r\n"
