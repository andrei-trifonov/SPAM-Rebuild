    - type: 0
      name: 2
      line: "\u0411\u044B\u043B\u043E \u0441\u043B\u043E\u0436\u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C,
        \u043F\u043E\u0447\u0435\u043C\u0443 \u044F \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0430.
        \u0411\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E, \u043A\u0442\u043E
        \u0432\u044B\u0448\u0435 \u043C\u0435\u043D\u044F \u0432\u044B\u0431\u0440\u0430\u043B
        \u044D\u0442\u043E\u0442 \u0442\u0443\u043F\u043E\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442
        \u043E\u0442\u0432\u0435\u0442\u0430 \u0438\u0437 \u0434\u0432\u0443\u0445
        \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445. "
