    - type: 0
      name: 2
      line: "\u0422\u043E\u043B\u044C\u043A\u043E \u0432\u0442\u043E\u0440\u043D\u0438\u043A,
        \u0430 \u044F \u0443\u0436\u0435 \u043D\u0435 \u0432\u044B\u043D\u043E\u0448\u0443
        \u0448\u043A\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0437\u0432\u043E\u043D\u043A\u0430.
        \n\u042F \u043F\u043E\u043C\u0430\u043D\u0438\u043B\u0430 \u041A\u0438\u0440\u0443
        \u0437\u0430 \u0441\u043E\u0431\u043E\u0439, \u0442\u0430 \u0431\u044B\u0441\u0442\u0440\u043E
        \u0443\u0431\u0440\u0430\u043B\u0430 \u0432\u0435\u0449\u0438 \u0432 \u043F\u0430\u0440\u0442\u0443
        \u0438 \u0432 \u043C\u0438\u0433 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
        \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u043C\u043D\u043E\u0439 \u0438
        \u0421\u043E\u043D\u0435\u0439."
