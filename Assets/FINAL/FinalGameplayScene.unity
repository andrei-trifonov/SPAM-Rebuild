    - type: 0
      name: 2
      line: "\u0421\u043E\u043D\u044F \u0434\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
        \u0432\u0441\u0435\u043C \u0442\u0435\u043B\u043E\u043C, \u0437\u0430\u0434\u0440\u043E\u0436\u0430\u043B\u0438
        \u0442\u0440\u043E\u0441\u0441\u044B, \u0430 \u0435\u0435 \u0442\u044F\u0436\u0435\u043B\u043E\u0435,
        \u0431\u0443\u043B\u044C\u043A\u0430\u044E\u0449\u0435\u0435 \u0434\u044B\u0445\u0430\u043D\u0438\u0435
        \u0443\u0447\u0430\u0441\u0442\u0438\u043B\u043E\u0441\u044C."
