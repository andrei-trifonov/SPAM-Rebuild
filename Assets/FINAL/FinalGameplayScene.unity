    - type: 0
      name: 0
      line: "\n// \u0417\u0434\u0435\u0441\u044C, \u0432 \u044D\u0442\u043E\u0439
        \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439 \u043F\u0443\u0441\u0442\u043E\u0442\u0435,
        \u043E\u043D\u0438 \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u043C\u043E\u043C\u0435\u043D\u0442\u044B
        \u043F\u043E\u043A\u043E\u044F, \u0433\u0434\u0435 \u0438\u0445 \u043C\u044B\u0441\u043B\u0438
        \u0442\u0438\u0445\u043E \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F
        \u043E\u0442 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0445 \u0441\u0442\u0435\u043D.\nvoid
        \u041C\u044F\u0441\u043E\u041C\u0430\u0448\u0438\u043D\u0430* \u043C\u0430\u0448\u0438\u043D\u0430)
        {\n\_\_\_ // \u043A\u043E\u043C\u043C\u0435\u043D\u0442: \u0437\u0434\u0435\u0441\u044C,
        \u0432 \u044D\u0442\u043E\u0439 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439
        \u043F\u0443\u0441\u0442\u043E\u0442\u0435, \u043E\u043D\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442
        \u043C\u043E\u043C\u0435\u043D\u0442\u044B \u043F\u043E\u043A\u043E\u044F
        - \u0433\u0434\u0435 \u0435\u0451 \u043C\u044B\u0441\u043B\u0438 \u0442\u0438\u0445\u043E
        \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F \u043E\u0442
        \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0445 \u0441\u0442\u0435\u043D\n\_\_\_
        \u043C\u0430\u0448\u0438\u043D\u0430->\u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u043A_\u0441\u0438\u0441\u0442\u0435\u043C\u044B();
        \n} "
