      name: 2
      line: "\u041C\u044B \u0448\u043B\u0438 \u043C\u043E\u043B\u0447\u0430, \u0410\u043B\u0438\u043D\u0430
        \u043D\u0435 \u043F\u0440\u043E\u0440\u043E\u043D\u0438\u043B\u0430 \u043D\u0438
        \u0441\u043B\u043E\u0432\u0430. \u041D\u043E\u0447\u043D\u044B\u0435 \u043F\u0442\u0438\u0446\u044B
        \u0449\u0435\u0431\u0435\u0442\u0430\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E,
