    - type: 0
      name: 2
      line: "\u0421\u0443\u043C\u043A\u0443 \u043D\u0430 \u043F\u043B\u0435\u0447\u043E
        - \u0438 \u0432\u043F\u0435\u0440\u0435\u0434. \u0415\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E,
        \u044F \u0443\u0436\u0435 \u0441\u0445\u043E\u0436\u0443 \u0441 \u0443\u043C\u0430
        \u043E\u0442 \u044D\u0442\u043E\u0439 \u0432\u0435\u0447\u043D\u043E\u0439
        \u0442\u0435\u043C\u043D\u043E\u0442\u044B, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
        \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u043F\u043E\u043B\u044F\u0440\u043D\u0430\u044F
        \u043D\u043E\u0447\u044C \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
        \u043F\u0430\u0440\u0443 \u0441\u0443\u0442\u043E\u043A \u043D\u0430\u0437\u0430\u0434. "
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
