    - type: 0
      name: 2
      line: "\u0423\u0441\u043B\u044B\u0448\u0430\u043B\u0430, \u0447\u0442\u043E
        \u0435\u0439 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u0434\u043E\u043B\u0433\u043E,
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432,
        \u0438 \u0442\u043E, \u0447\u0442\u043E \u043E\u043D\u0430 \u0434\u043E \u0441\u0438\u0445
        \u043F\u043E\u0440 \u0434\u044B\u0448\u0438\u0442  - \u044D\u0442\u043E \u043A\u0430\u043A\u043E\u0435-\u0442\u043E 
        \u0447\u0443\u0434\u043E. \u042F \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E
        \u043E\u043D\u0430 \u0432\u044B\u0436\u0438\u0432\u0435\u0442. \u0418 \u0434\u0430\u0436\u0435
        \u043D\u0435 \u0434\u0443\u043C\u0430\u043B\u0430 \u043F\u0440\u043E\u0449\u0430\u0442\u044C\u0441\u044F
        \u0441 \u043D\u0435\u0439."
