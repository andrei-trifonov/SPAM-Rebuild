  - name: "0.2.7.2 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435"
    lines:
    - type: 0
      name: 4
      line: "-\u042D\u0442\u043E \u0443\u0436\u0430\u0441\u043D\u043E... \u042D\u0442\u043E\u0433\u043E
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043D\u0430\u0432\u0435\u0440\u044F\u043D\u043A\u0430
        \u043A\u0442\u043E-\u0442\u043E \u0443\u0431\u0438\u043B, \u0440\u0430\u0441\u0447\u043B\u0435\u043D\u0438\u043B
        \u0438 \u0440\u0430\u0441\u043F\u0438\u0445\u0430\u043B \u043F\u043E \u0442\u0443\u0430\u043B\u0435\u0442\u0430\u043C!
        \u042F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u043D\u0435 \u043F\u043E\u0439\u0434\u0443 \u0432 \u043A\u043B\u0443\u0431!\r\n"
