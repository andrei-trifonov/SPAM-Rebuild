    - type: 0
      name: 2
      line: "\u041A\u0438\u0440\u0430 \u043F\u0443\u043B\u0435\u0439 \u043D\u043E\u0441\u0438\u043B\u0430\u0441\u044C
        \u043F\u043E \u0432\u0441\u0435\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435, 
        \u043E\u0442\u0431\u0438\u0432\u0430\u044F \u043C\u044F\u0447 \u043D\u0430
        \u0434\u0440\u0443\u0433\u0443\u044E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443,
        \u0432\u0441\u043A\u0440\u0438\u043A\u0438\u0432\u0430\u044F \u043F\u0440\u0438
        \u0443\u0434\u0430\u0440\u0430\u0445 \u0438 \u0433\u0440\u043E\u043C\u043A\u043E
        \u0434\u044B\u0448\u0430."
