    - type: 0
      name: 2
      line: " \u042F \u0437\u0430\u0448\u043B\u0430, \u0438\u0437\u0432\u0438\u043D\u0438\u0432\u0448\u0438\u0441\u044C
        \u043F\u0435\u0440\u0435\u0434 \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u043C
        \u0437\u0430 \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435. \u0412
        \u043A\u043B\u0430\u0441\u0441\u0435 \u043C\u0435\u043D\u044F \u0443\u0436\u0435
        \u0436\u0434\u0430\u043B\u0438 \u041A\u0438\u0440, \u0421\u043E\u043D\u044F
        \u0438 \u0410\u043B\u0438\u043D\u0430. \u0420\u044F\u0434\u043E\u043C \u0441
        \u043D\u0438\u043C\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435
        \u043C\u0435\u0441\u0442\u0430. \u041E\u043D\u043E \u0438 \u043F\u043E\u043D\u044F\u0442\u043D\u043E,
        \u043F\u043E\u0447\u0435\u043C\u0443.\r\n"
