    - type: 0
      name: 2
      line: "\u042D\u0442\u043E \u0432\u0441\u0435, \u0447\u0442\u043E \u043D\u0430\u043C
        \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0441\u0434\u0435\u043B\u0430\u0442\u044C.
        \u041C\u044B \u043F\u043E\u0448\u043B\u0438 \u0434\u0430\u043B\u044C\u0448\u0435
        \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443. \u041A\u0440\u0430\u0448\u0435\u043D\u044B\u0435
        \u0431\u0435\u0442\u043E\u043D\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u044B
        \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u043C\u0435\u0442\u0440\u043E\u043C
        \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u0432\u0441\u0435
        \u0431\u043E\u043B\u0435\u0435 \u0443\u0440\u043E\u0434\u043B\u0438\u0432\u044B\u043C\u0438."
