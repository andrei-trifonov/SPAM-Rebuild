    - type: 0
      name: 2
      line: "\u0421\u043E\u043D\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u0433\u0440\u043E\u043C\u043A\u043E
        \u0441\u043E\u043F\u0435\u0442\u044C, \u0431\u043E\u0440\u044F\u0441\u044C
        \u0441\u043E \u0441\u043B\u0435\u0437\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C \u0441\u043A\u0430\u0442\u0438\u0442\u044C\u0441\u044F
