    - type: 0
      name: 2
      line: "\u042F \u0437\u043D\u0430\u044E \u0442\u043E\u0447\u043D\u043E - \u0441
        \u043D\u0435\u0439 \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A,
        \u043D\u043E \u0447\u0442\u043E? \u041D\u0435 \u043C\u043E\u0433\u0443 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C
        \u0441\u0430\u043C\u043E\u0439 \u0441\u0435\u0431\u0435... \u041D\u0435 \u043C\u043E\u0433\u0443
        \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C \u0441\u043B\u043E\u0432\u0430\u043C\u0438.
        \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0441\u0442\u043E\u0438\u0442
        \u0443\u0437\u043D\u0430\u0442\u044C \u0435\u0435 \u043F\u043E\u043B\u0443\u0447\u0448\u0435
        - \u043C\u043E\u0436\u0435\u0442, \u0438 \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E
