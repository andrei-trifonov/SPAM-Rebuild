        \u0437\u0430\u043F\u043B\u0430\u043A\u0430\u043D\u043D\u044B\u0435 \u0433\u043B\u0430\u0437\u0430
        \u044F \u0434\u0432\u0438\u0433\u0430\u043B\u0430\u0441\u044C \u0441\u043A\u0432\u043E\u0437\u044C
        \u043F\u0440\u043E\u0445\u043E\u0434 \u043D\u0430 \u044D\u0442\u0430\u0436\u0435,
        \u0447\u0442\u043E\u0431\u044B \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
        \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u0435\u0435 \u0432\u044B\u0439\u0442\u0438
        \u0432\u043E\u0437\u043B\u0435 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0445
        \u0434\u0432\u0435\u0440\u0435\u0439 \u0432 \u043A\u043E\u043B\u043B\u0435\u0434\u0436.\"\r"
