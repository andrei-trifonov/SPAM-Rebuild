    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[704]
      value: "    ohr \"-\u042F \u0432\u044B\u0437\u043E\u0432\u0443 \u043C\u0438\u043B\u0438\u0446\u0438\u044E.
        \u0410 \u0442\u044B \u0438\u0434\u0438 \u043F\u043E\u043A\u0430 \u0447\u0442\u043E
        \u0434\u043E\u043C\u043E\u0439. \u042F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
        \u043C\u043E\u0433 \u0431\u044B \u043E \u0442\u0435\u0431\u0435 \u043D\u0435
        \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
        \u0438\u043C, \u043D\u043E \u0442\u043E\u0433\u0434\u0430 \u044F \u0431\u0443\u0434\u0443
        \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u044B\u043C.\"\r"
      objectReference: {fileID: 0}
