    - type: 0
      name: 2
      line: "\u041A\u0430\u0431\u0438\u043D\u0435\u0442 \u0442\u0440\u0443\u0434\u0430
        - \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u0436\u0435,
        \u0442\u0430\u043C \u0436\u0435, \u0433\u0434\u0435 \u0438 \u043A\u0430\u0431\u0438\u043D\u0435\u0442
        \u043C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u044B. \u041C\u044B \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u043B\u0438
        \u0434\u0432\u0435\u0440\u044C - \u043E\u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430,
        \u0437\u043D\u0430\u0447\u0438\u0442 \u0443\u0447\u0438\u0442\u0435\u043B\u044C
        \u0433\u0434\u0435-\u0442\u043E \u0437\u0434\u0435\u0441\u044C. \u0412 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435
        \u0435\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E - \u0437\u043D\u0430\u0447\u0438\u0442,
        \u0437\u0430\u043F\u0435\u0440\u0441\u044F \u0432 \u043F\u043E\u0434\u0441\u043E\u0431\u043A\u0435. "
