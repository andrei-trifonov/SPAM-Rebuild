    - type: 0
      name: 2
      line: "\u0427\u0435\u043B\u044E\u0441\u0442\u044C \u0441\u0430\u043C\u0430
        \u0441\u043E\u0431\u043E\u0439 \u0441\u0436\u0430\u043B\u0430\u0441\u044C
        \u0442\u0430\u043A, \u0447\u0442\u043E \u043D\u0430\u0447\u0430\u043B\u0438
        \u0431\u043E\u043B\u0435\u0442\u044C \u0441\u043A\u0440\u0438\u043F\u044F\u0449\u0438\u0435
        \u0437\u0443\u0431\u044B. \u0415\u0441\u043B\u0438 \u0431\u044B \u0443 \u043C\u0435\u043D\u044F
        \u0431\u044B\u043B\u043E \u0445\u043E\u0442\u044F \u0431\u044B \u043D\u0430
        \u0447\u0443\u0442\u043E\u0447\u043A\u0443 \u043C\u0435\u043D\u044C\u0448\u0435
        \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F, \u044F \u0431\u044B \u0441\u0435\u0439\u0447\u0430\u0441
        \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u043B\u0430 \u0434\u0432\u0435\u0440\u044C,
        \u0438 \u0432\u043B\u0435\u043F\u0438\u043B\u0430 \u0431\u044B \u0422\u043E\u043B\u0435
        \u043F\u043E\u0449\u0451\u0447\u0438\u043D\u0443."
