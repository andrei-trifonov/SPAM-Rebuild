        \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
        \u041C\u043E\u0439 \u0433\u043E\u043B\u043E\u0441 \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E
