    - type: 0
      name: 2
      line: "\u0411\u0430\u0448\u043D\u044F, \u043A\u0430\u043A \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
        \u043E\u0442\u0441\u044E\u0434\u0430, \u0434\u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0430
        \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u0443\u043F\u043E\u043B\u0430
        \u043D\u0435\u0431\u0430, \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F
        \u043A\u0430\u043A \u044F \u0431\u044B\u043B\u0430 \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
        \u0434\u043D\u0435. \u041D\u0443\u0436\u043D\u043E \u0441\u043F\u0435\u0448\u0438\u0442\u044C,
        \u043F\u043E\u043A\u0430 \u041A\u0438\u0440 \u043C\u0435\u043D\u044F \u043D\u0435
        \u0434\u043E\u0433\u043D\u0430\u043B."
