        \u0422\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0430 \u0442\u0430\u043A,
        \u0431\u0443\u0434\u0442\u043E \u0442\u0435\u0431\u044F \u0447\u0442\u043E-\u0442\u043E
        \u043D\u0430\u043F\u0443\u0433\u0430\u043B\u043E, \u044F \u043F\u043E\u0448\u043B\u0430
        \u0437\u0430 \u0442\u043E\u0431\u043E\u0439, \u043D\u043E... \u0422\u044B
