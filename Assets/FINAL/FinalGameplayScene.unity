    - type: 0
      name: 2
      line: "-\u0411\u0443\u0434\u0442\u043E \u044F \u043B\u043E\u0432\u043B\u044E
        \u0431\u0430\u0448\u043A\u043E\u0439 \u0441\u0438\u0433\u043D\u0430\u043B
        \u0440\u0430\u0434\u0438\u043E, \u0438 \u044D\u0444\u0438\u0440 \u0442\u0440\u0430\u043D\u0441\u043B\u0438\u0440\u0443\u0435\u0442\u0441\u044F
        \u043C\u043D\u0435 \u043F\u0440\u044F\u043C\u043E \u0432 \u043C\u043E\u0437\u0433!\n\u0421\u043E\u043D\u044F,
        \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C, \u043E\u0447\u0435\u043D\u044C
        \u0441\u0442\u0440\u0430\u0448\u043D\u043E! \u0421\u043B\u0438\u0448\u043A\u043E\u043C
        \u043C\u043D\u043E\u0433\u043E \u0432\u0441\u0435\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442...\n\u0412\u0441\u0435
        \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C \u0432\u0447\u0435\u0440\u0430,
        \u043A\u043E\u0433\u0434\u0430 \u044F \u0443\u0432\u0438\u0434\u0435\u043B\u0430
        \u0442\u0440\u0443\u043F \u0432 \u0442\u0443\u0430\u043B\u0435\u0442\u0435,
        \u0438 \u043F\u043E\u0442\u043E\u043C \u0442\u044B \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0430
        \u043C\u043D\u0435 \u0442\u043E\u0442 \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C..."
