    - type: 0
      name: 2
      line: "\u0411\u044B\u043B\u043E \u0440\u0435\u0448\u0435\u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u0431\u0430\u0440\u0434\u0430\u043A \u043A\u0430\u043A \u0435\u0441\u0442\u044C.
        \n\u042F \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u043B\u0430 \u0432 \u0441\u0442\u043E\u0440\u043E\u0436\u043A\u0443
        \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0442\u0430\u043C
        \u043A\u043B\u044E\u0447 \u043E\u0442 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430.
        \u0412\u043E\u0442 \u0438 \u0432\u0441\u0435."
