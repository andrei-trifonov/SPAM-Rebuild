        \u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E, \u043A\u0430\u043A
        \u0435\u0433\u043E \u0437\u043E\u0432\u0443\u0442... \u0418 \u0441\u044E\u0434\u0430
        \u0441\u043F\u0440\u044B\u0433\u043D\u0443\u043B\u0430 \u0441 \u043D\u0438\u043C
        \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u043C\u0443,
        \u0447\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
        \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u0442\u0430\u043A\u043E\u0433\u043E
