    - type: 0
      name: 0
      line: "\u0422\u0430\u043C \u0431\u044B\u043B \u043D\u0435\u0435\u0431\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0447\u0435\u0440\u0442\u0451\u0436 \u0441 \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C\u0438
        \u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C\u0438.
        \u0415\u0441\u0442\u044C \u043B\u0438 \u0441\u043C\u044B\u0441\u043B \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C
        \u0434\u0432\u0443\u0445\u043F\u0430\u043B\u044C\u0446\u0435\u0432\u044B\u0439,
        \u0438\u043B\u0438 \u043B\u0443\u0447\u0448\u0435 \u043F\u043E\u0434\u043A\u043E\u043F\u0438\u0442\u044C
        \u043D\u0430 \u0442\u0440\u0435\u0445- \u0438\u043B\u0438 \u0447\u0435\u0442\u044B\u0440\u0435\u0445\u043F\u0430\u043B\u044C\u0446\u0435\u0432\u044B\u0439?"
