    - type: 0
      name: 7
      line: "-\u041D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F?
        \u0422\u0430\u043A \u043E\u043D \u043D\u0430 \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435!
        \u041D\u0435, \u0437\u0434\u0435\u0441\u044C \u043D\u0443\u0436\u043D\u043E
        \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443.
        \u041D\u043E\u0447\u044C \u043A\u0430\u043A-\u043D\u0438\u043A\u0430\u043A,
        \u043C\u044B \u0442\u0430\u043A \u0432\u0441\u0435\u0445 \u0440\u0430\u0441\u043F\u0443\u0433\u0430\u0435\u043C.
        \u0417\u043D\u0430\u0435\u0448\u044C \u0447\u0442\u043E, \u0438\u0434\u0438
        \u0434\u043E\u043C\u043E\u0439... \u0422\u044B, \u043D\u0430\u0434\u0435\u044E\u0441\u044C,
        \u043D\u0438\u043A\u043E\u0433\u043E \u0441 \u0441\u043E\u0431\u043E\u0439
        \u043D\u0435 \u043F\u0440\u0438\u0432\u0435\u043B\u0430?"
