    - type: 0
      name: 2
      line: "\u0413\u0434\u0435-\u0442\u043E \u043D\u0430 \u0437\u0430\u0442\u044B\u043B\u043A\u0435
        \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0442\u0440\u0435\u0449\u0430\u0442\u044C
        \u0434\u0440\u043E\u0441\u0441\u0435\u043B\u044F. \u0412\u0441\u0451-\u0442\u0430\u043A\u0438,
        \u0441\u0444\u0435\u0440\u0430 \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0430\u0441\u044C?  
        \u042D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0433\u0443\u043B \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442
        \u0443\u0448\u0438. \u0413\u0443\u043B \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442
        \u0432\u0441\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
        \u0432\u043D\u0443\u0442\u0440\u0438 \u0447\u0435\u0440\u0435\u043F\u0430
        \u0438 \u0432\u044B\u0442\u0435\u0441\u043D\u044F\u0435\u0442 \u0432\u0441\u0435
        \u043C\u044B\u0441\u043B\u0438. \r\n"
