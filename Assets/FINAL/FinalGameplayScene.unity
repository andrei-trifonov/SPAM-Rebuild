    - type: 0
      name: 2
      line: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E,\u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0438\u0437 \u043A\u043E\u0442\u044F\u0442 \u043D\u0430\u0447\u0430\u043B\u0438
        \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F - \u0442\u0430\u043D\u0446\u0443\u044E\u0449\u0438\u0435
        \u043A\u043E\u0442\u044F\u0442\u0430, \u043F\u0440\u044B\u0433\u0430\u044E\u0449\u0438\u0435,
        \u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u0442\u044F\u0442\u0430,
        \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
