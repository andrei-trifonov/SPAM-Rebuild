    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[689]
      value: "    ohr \"-\u0414\u0430 \u043A\u043E\u043C\u0443 \u044D\u0442\u043E\u0442
        \u043A\u043B\u044E\u0447 \u043D\u0443\u0436\u0435\u043D. \u0425\u043E\u0440\u043E\u0448\u043E,
        \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0432\u0441\u0435\u0433\u0434\u0430
        \u0441 \u0441\u043E\u0431\u043E\u0439 \u0435\u0441\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0435.\"\r"
