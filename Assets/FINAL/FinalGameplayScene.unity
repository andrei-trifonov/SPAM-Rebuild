    - type: 0
      name: 2
      line: "\u042F \u043F\u0440\u043E\u0442\u0438\u0441\u043D\u0443\u043B\u0430\u0441\u044C
        \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u0442\u0435\u043D\u0443 \u0438\u0437
        \u0442\u0443\u0448 - \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u0441\u0438\u0434\u0435\u043B\u0430
        \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u0430\u044F \u0410\u043B\u044F.
        \u0415\u0435 \u0432\u0437\u0433\u043B\u044F\u0434 \u0431\u0435\u0433\u0430\u043B
        \u043F\u043E \u043B\u0438\u0446\u0430\u043C \u043E\u0431\u0441\u0442\u0443\u043F\u0438\u0432\u0448\u0438\u0445
        \u0435\u0435 \u043B\u044E\u0434\u0435\u0439, \u0438 \u0432 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
        \u043C\u043E\u043C\u0435\u043D\u0442 \u043E\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
        \u043D\u0430 \u043C\u043D\u0435. \u0415\u0435 \u043F\u043E\u043C\u043E\u043A\u0440\u0435\u0432\u0448\u0438\u0435
        \u0433\u043B\u0430\u0437\u0430 \u043C\u043E\u043B\u0438\u043B\u0438 \u043E
        \u043F\u043E\u043C\u043E\u0449\u0438. \n"
