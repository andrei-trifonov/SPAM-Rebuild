    - type: 0
      name: 2
      line: "\u041C\u044B \u043F\u0440\u043E\u0432\u0435\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435
        \u043F\u043E\u0447\u0442\u0438 \u0447\u0442\u043E \u0447\u0430\u0441.\r\n\u042F
        \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u0443
        \u043D\u0430 \u043F\u043B\u0435\u0447\u043E \u0410\u043B\u0435 \u0438 \u0432\u0434\u043E\u0445\u043D\u0443\u043B\u0430
        \u0437\u0430\u043F\u0430\u0445 \u0435\u0435 \u0447\u0443\u0434\u0435\u0441\u043D\u044B\u0445
        \u0432\u043E\u043B\u043E\u0441. \u041A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
        \u0431\u044B \u043F\u0430\u0445\u043D\u0435\u0442 \u043A\u0430\u043A\u0438\u043C-\u0442\u043E
        \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C 
        \u0437\u0435\u043B\u044C\u0435\u043C \u0441 \u043C\u0451\u0434\u043E\u043C, 
        \u043F\u043E\u043B\u044B\u043D\u044C\u044E, \u043C\u044F\u0442\u043E\u0439
        \u0438 \u0441\u043E\u043D-\u0442\u0440\u0430\u0432\u043E\u0439.\r\n"
