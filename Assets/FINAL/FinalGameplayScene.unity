    - type: 0
      name: 2
      line: "\u042F \u0432\u0437\u0434\u0440\u043E\u0433\u043D\u0443\u043B\u0430
        \u043E\u0442 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0433\u043E
        \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u044F. \u0410\u043B\u0438\u043D\u0430,
        \u0441\u0438\u0434\u0435\u0432\u0448\u0430\u044F \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445
        \u043A\u043E \u043C\u043D\u0435 \u043B\u0438\u0446\u043E\u043C, \u043E\u0431\u043E\u0440\u0432\u0430\u043B\u0430
        \u0444\u0440\u0430\u0437\u0443 \u043D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
        \u0438 \u043F\u043E\u043A\u0440\u0430\u0441\u043D\u0435\u043B\u0430.\r\n"
