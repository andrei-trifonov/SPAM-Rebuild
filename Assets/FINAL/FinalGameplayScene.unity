    - type: 0
      name: 2
      line: "\u041E\u043D\u0430 \u0432\u0437\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C
        \u043F\u043B\u0430\u0447\u0435\u043C, \u043D\u0430\u0447\u0430\u043B\u0430
        \u0440\u044B\u0434\u0430\u0442\u044C \u0438 \u043E \u0447\u0435\u043C-\u0442\u043E 
        \u043D\u0435\u0432\u043D\u044F\u0442\u043D\u043E \u043A\u0440\u0438\u0447\u0430\u0442\u044C
        \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0440\u043E\u043C\u043A\u043E,
