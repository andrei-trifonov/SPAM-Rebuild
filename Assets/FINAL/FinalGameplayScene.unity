    - type: 0
      name: 2
      line: "\u041F\u0443\u0440\u0440-\u043F\u0443\u0440 \u0437\u0430\u043D\u044F\u043B\u0441\u044F
        \u0440\u0430\u0441\u0447\u0435\u043A\u0440\u044B\u0436\u0435\u0432\u0430\u043D\u0438\u0435\u043C
        \u0441\u043E\u0441\u0438\u0441\u043E\u043A \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
        \u043A\u043E\u0433\u0442\u0435\u0439. \u041D\u0430 \u043C\u043D\u0435 - \u0432\u0430\u0440\u043A\u0430
        \u043C\u0430\u043A\u0430\u0440\u043E\u043D. \u0425\u043E\u0440\u043E\u0448\u043E,
        \u0447\u0442\u043E \u0432 \u0448\u043A\u0430\u0444\u0447\u0438\u043A\u0435
        \u043D\u0430 \u043A\u0443\u0445\u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C
        \u043F\u043E\u043B \u043F\u0430\u0447\u043A\u0438."
