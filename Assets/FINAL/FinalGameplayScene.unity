    - type: 0
      name: 2
      line: "\u041A\u0442\u043E-\u0442\u043E \u043F\u043E\u0434\u0430\u043B \u043C\u044F\u0447,
        \u0438 \u0438\u0433\u0440\u0430 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C.
        \u0418\u0437 \u0434\u0435\u0432\u043E\u0447\u0435\u043A \u043D\u0438\u043A\u0442\u043E,
        \u043A\u0440\u043E\u043C\u0435 \u043D\u0435\u0435 \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u043B\u0441\u044F
        \u0441\u043E \u0441\u0432\u043E\u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0430,
        \u043B\u0435\u043D\u0438\u0432\u043E \u043E\u0442\u0431\u0438\u0432\u0430\u044F
        \u043C\u044F\u0447, \u043E\u0442\u0447\u0435\u0433\u043E \u043E\u043D \u0447\u0430\u0441\u0442\u043E
        \u043F\u0430\u0434\u0430\u043B \u043D\u0430 \u043D\u0430\u0448\u0435\u0439
        \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 \u043F\u043E\u043B\u044F,
        \u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u0442\u0435\u0440\u044F\u043B\u0430
        \u043E\u0447\u043A\u0438. "
