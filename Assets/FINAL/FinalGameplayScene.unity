        \u0447\u0442\u043E-\u0442\u043E \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0435,
        \u043D\u043E \u0432 \u0433\u043E\u043B\u043E\u0432\u0443 \u043D\u0435 \u043B\u0435\u0437\u0443\u0442
        \u043C\u044B\u0441\u043B\u0438. \u0411\u043B\u0438\u043D, \u0435\u0441\u043B\u0438
        \u0431\u044B \u043D\u0435 \u0421\u043E\u043D\u044F, \u044F \u0431\u044B \u043D\u0438
        \u0437\u0430 \u0447\u0442\u043E \u043D\u0435 \u0437\u0430\u043D\u044F\u043B\u0430\u0441\u044C
        \u0442\u0430\u043A\u043E\u0439 \u0435\u0440\u0443\u043D\u0434\u043E\u0439.\r\n"
