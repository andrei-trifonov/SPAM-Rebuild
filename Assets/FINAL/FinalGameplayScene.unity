    - type: 0
      name: 2
      line: "\u0412 \u0437\u0434\u0430\u043D\u0438\u0438 \u0448\u043A\u043E\u043B\u044B
        \u0441\u043E\u0432\u0441\u0435\u043C \u0442\u0438\u0445\u043E. \u042F \u0431\u044B\u0441\u0442\u0440\u043E
        \u043D\u0430\u0448\u043B\u0430 \u043D\u0443\u0436\u043D\u044B\u0439 \u043A\u0430\u0431\u0438\u043D\u0435\u0442.
        \u0418\u0437-\u0437\u0430 \u0441\u0442\u0435\u043D\u043A\u0438 \u043F\u043E\u0441\u043B\u044B\u0448\u0430\u043B\u0441\u044F
        \u0433\u043E\u043B\u043E\u0441 \u0443\u0447\u0438\u0442\u0435\u043B\u044F.\r\n"
