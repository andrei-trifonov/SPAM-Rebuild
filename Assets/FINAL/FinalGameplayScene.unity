    - type: 0
      name: 2
      line: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u0447\u0442\u043E \u0432\u043E\u043A\u0440\u0443\u0433
        \u043D\u0430\u0441 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0438
        \u0448\u0443\u0440\u0448\u0430\u0442 \u043A\u043E\u043B\u0435\u0441\u0430\u043C\u0438
        \u0438 \u0432\u0441\u0435 \u0441\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u0432 \u043E\u0434\u0438\u043D \u0441\u043F\u043B\u043E\u0448\u043D\u043E\u0439
        \u0438 \u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u044B\u0439 \u0448\u0443\u043C.
        \u0412\u0441\u0451-\u0442\u0430\u043A\u0438 \u043C\u044B \u0432 \u0441\u0430\u043C\u043E\u043C
        \u0446\u0435\u043D\u0442\u0440\u0435 \u0433\u043E\u0440\u043E\u0434\u0430."
