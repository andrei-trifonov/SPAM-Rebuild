    - type: 0
      name: 2
      line: "\u042F \u0437\u0430\u0433\u043B\u043E\u0442\u043D\u0443\u043B\u0430
        \u043A\u0438\u0441\u043B\u043E-\u0441\u043B\u0430\u0434\u043A\u0438\u0439
        \"\u0420\u0435\u0439\u0437\". \u0425\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u0432\u043A\u0443\u0441 \u0444\u0440\u0443\u043A\u0442\u043E\u0432 \u0438
        \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044F. \u041F\u0440\u043E\u0441\u0442\u043E
        \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E!"
