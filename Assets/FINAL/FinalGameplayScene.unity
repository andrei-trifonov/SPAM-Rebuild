    - type: 0
      name: 2
      line: "\u0414\u0432\u0435\u0440\u044C \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u043B\u0430\u0441\u044C,
        \u0438 \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u043B\u0430
        \u041A\u0438\u0440\u0430 - \u043F\u0430\u0445\u043D\u0443\u0449\u0430\u044F
        \u0444\u0440\u0443\u043A\u0442\u043E\u0432\u044B\u043C\u0438 \u0434\u0443\u0445\u0430\u043C\u0438
        \u0438 \u0432 \u043C\u0430\u043A\u0438\u044F\u0436\u0435 - \u0431\u0443\u0434\u0442\u043E
        \u0431\u044B \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u0443\u0440\u043E\u043A\u0435
        \u043D\u0438\u0447\u0435\u0433\u043E \u0438 \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C. "
