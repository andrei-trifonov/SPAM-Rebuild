    - type: 0
      name: 2
      line: "\u041F\u043E\u0439\u043C\u0430\u0432 \u043E\u0434\u043D\u0443 \u043D\u0430
        \u043B\u0435\u0442\u0443, \u0441\u043C\u043E\u0433\u043B\u0430 \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C
        \u0435\u0435 \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445. \u041D\u0430
        \u043D\u0435\u0439 \u0431\u044B\u043B\u0438 \u043D\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u044B
        \u0441\u043B\u043E\u0432\u0430, \u0441\u0442\u0440\u0430\u043D\u043D\u043E
        \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0449\u0438\u0435\u0441\u044F
