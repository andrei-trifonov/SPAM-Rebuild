    - type: 0
      name: 2
      line: "\u041D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0433\u0443\u043B
        \u0432 \u0443\u0448\u0430\u0445 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B
        \u043C\u0435\u043D\u044F \u0442\u0443\u0442 \u0436\u0435  \u0432\u0441\u043A\u043E\u0447\u0438\u0442\u044C
        \u0441 \u043A\u0440\u043E\u0432\u0430\u0442\u0438. \u0427\u0442\u043E? \u0421\u0438\u0440\u0435\u043D\u0430? "
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
