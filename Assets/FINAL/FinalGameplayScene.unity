    - type: 0
      name: 2
      line: "\u042F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u043D\u0430 \u0441\u0432\u043E\u0435 \u0442\u0435\u043B\u043E. \u041E\u0442
        \u043D\u0435\u0433\u043E \u0438\u0441\u0445\u043E\u0434\u0438\u043B\u0438
        \u0441\u043B\u0430\u0431\u044B\u0435 \u043D\u0438\u0442\u0438 \u0432 \u0440\u0430\u0437\u043D\u044B\u0435
        \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0438 \u0434\u0430\u0436\u0435
        \u0432\u0432\u0435\u0440\u0445, \u043A \u043D\u0435\u0431\u0443, \u0438 \u043A\u0443\u0434\u0430-\u0442\u043E
        \u0432\u043D\u0438\u0437, \u0432\u0433\u043B\u0443\u0431\u044C \u0437\u0435\u043C\u043B\u0438.
        \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u044D\u0442\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u043E?
        \u041C\u043D\u0435 \u044D\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0438\u0442\u0441\u044F,
        \u0438 \u0432\u0441\u0435 \u044D\u0442\u0438 \u0441\u0432\u044F\u0437\u0438
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0442 \u043D\u0430
        \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435...\r\n"
