    - type: 0
      name: 2
      line: "\u0421\u0432\u0435\u0442 \u0432\u0435\u043B \u043A \u0434\u0432\u0435\u0440\u0438.
        \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E
        \u0437\u0430 \u043D\u0435\u0439... \u042F \u043F\u0440\u0438\u0436\u0430\u043B\u0430\u0441\u044C
