    - type: 0
      name: 2
      line: "\u0420\u0430\u0441\u043A\u0430\u0442\u0438\u0441\u0442\u043E\u0435 \u044D\u0445\u043E
        \u043C\u043E\u0436\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u044C
        \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E - \u044D\u0442\u043E\u0442
        \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442 \u0442\u044F\u043D\u0435\u0442\u0441\u044F
        \u043D\u0430 \u0441\u043E\u0442\u043D\u0438 \u043C\u0435\u0442\u0440\u043E\u0432
        \u0432 \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. "
