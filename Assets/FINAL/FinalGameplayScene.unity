    - type: 0
      name: 2
      line: "\u0414\u0430\u0436\u0435 \u043D\u0435 \u043F\u043E\u043C\u043D\u044E
        \u0432 \u043A\u0430\u043A\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
        \u044D\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
        - \u044D\u043F\u0438\u0437\u043E\u0434, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
        \u044F \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0430\u0441\u044C
