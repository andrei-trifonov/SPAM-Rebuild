    - type: 0
      name: 2
      line: "\u0412\u0445\u043E\u0434 \u0432 \u0442\u0443\u0430\u043B\u0435\u0442
        \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u0438\u043B\u0430
        \u0421\u043E\u043D\u044F. \u042F \u0441\u0431\u0438\u043B\u0430 \u0435\u0435
        \u0441 \u043D\u043E\u0433 \u0438 \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0430
        \u043A \u0432\u044B\u0445\u043E\u0434\u0443 \u0438\u0437 \u043A\u043B\u0443\u0431\u0430.
        \u041D\u0430 \u0443\u043B\u0438\u0446\u0435 \u0442\u0435\u043C\u043D\u043E
        - \u043D\u0443\u0436\u043D\u043E \u0443\u0436\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u043D\u0443\u0442\u044C.
        \u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0432\u043E\u0437\u0434\u0443\u0445
        \u0441 \u0440\u0430\u0437\u043C\u0430\u0445\u0443 \u0443\u0434\u0430\u0440\u0438\u043B
        \u043F\u043B\u043E\u0442\u043D\u043E\u0439 \u0441\u0432\u0435\u0436\u0435\u0441\u0442\u044C\u044E
        \u0432 \u043B\u0438\u0446\u043E.\_\n"
