    - type: 0
      name: 2
      line: "\u041C\u044B \u043B\u0435\u0433\u043A\u043E \u043F\u043E\u0434\u043D\u044F\u043B\u0438\u0441\u044C
        \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0432\u044B\u0441\u043E\u0442\u0443,
        \u0432\u0441\u0435 \u0432\u043D\u0443\u0442\u0440\u0438 \u043C\u0435\u043D\u044F
        \u0441\u0436\u0430\u043B\u043E\u0441\u044C \u0438 \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u043E\u0441\u044C
        \u043A\u0443\u0434\u0430-\u0442\u043E \u0432 \u043F\u044F\u0442\u043A\u0438.
        \u042F \u0437\u0430\u0436\u043C\u0443\u0440\u0438\u043B\u0430\u0441\u044C
        - \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0430\u0441 \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C
        \u0434\u044B\u043C\u043D\u044B\u043C\u0438 \u043A\u043B\u043E\u0447\u044C\u044F\u043C\u0438
        \u043E\u0431\u043B\u0430\u043A\u0430."
