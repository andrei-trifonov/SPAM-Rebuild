    - type: 0
      name: 2
      line: "\u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u043F\u0440\u0443\u0442\u043E\u043A
        \u0441\u043B\u0435\u0433\u043A\u0430 \u043D\u0430\u043F\u0440\u044F\u0433\u0441\u044F
        \u0438 \u0441\u043E\u0433\u043D\u0443\u043B\u0441\u044F \u0432 \u0434\u0443\u0433\u0443,
        \u043F\u043E\u0434\u043F\u0440\u0443\u0436\u0438\u043D\u0438\u0432\u0430\u044F
        \u043C\u0435\u043D\u044F \u0432\u0432\u0435\u0440\u0445-\u0432\u043D\u0438\u0437,
        \u043D\u0430\u0440\u0443\u0448\u0430\u044F \u043C\u043E\u0435 \u0438 \u0442\u0430\u043A
        \u0448\u0430\u0442\u043A\u043E\u0435 \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0435."
