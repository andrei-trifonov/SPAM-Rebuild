    - type: 0
      name: 2
      line: "\u0410\u043B\u044F \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B\u0430
        \u0431\u0430\u043D\u043E\u0447\u043A\u0443 \u043C\u043D\u0435. \u041D\u0435
        \u0442\u043E, \u0447\u0442\u043E\u0431\u044B \u044F \u0443\u0432\u0435\u0440\u0435\u043D\u0430
        \u0432 \u0441\u0432\u043E\u0438\u0445 \u0441\u0438\u043B\u0430\u0445... \u042F
        \u0432\u044B\u0434\u0443\u043B\u0430 \u043F\u0430\u0440\u0443 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
