    - type: 0
      name: 2
      line: "\u0427\u0435\u0433\u043E??? \u0422\u0430\u043A\u0438\u0435 \u0431\u044B\u0432\u0430\u044E\u0442?
        \u0418 \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D\u0438 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u044B
