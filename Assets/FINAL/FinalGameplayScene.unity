      line: "void \u041D\u0430\u0439\u0442\u0438\u0418\u0441\u0442\u0438\u043D\u0443(\u043C\u044F\u0441\u043E-\u043C\u0430\u0448\u0438\u043D\u0430*
        \u043C\u0430\u0448\u0438\u043D\u0430) {\n\_\_\_ // : \u0440\u0430\u0437\u0433\u0430\u0434\u044B\u0432\u0430\u044F
        \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442 \u043F\u0438\u043A\u0441\u0435\u043B\u0435\u0439
        \u0438 \u043A\u043E\u0434\u0430, \u043E\u043D\u0430 \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F
        \u043D\u0430\u0439\u0442\u0438 \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u0443\u044E
        \u0438\u0441\u0442\u0438\u043D\u0443 \u0432 \u0431\u0435\u0437\u0434\u043D\u0430\u0445
        \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u043E\u0433\u043E
        \u043A\u043E\u0434\u0430\n\_\_\_ \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0439_\u043C\u0430\u0441\u0441\u0438\u0432
        >> 1;\n\_\_\_ \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C_\u0434\u0430\u043D\u043D
        /= 8;\n\_\_\_ \u041D\u0430\u0439\u0442\u0438(\u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C_\u0434\u0430\u0442\u0430);\n} "
