  - name: hug 0.2.8.2
    lines:
    - type: 0
      name: 2
      line: "\u042F \u0434\u043E\u043B\u0436\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
        \u0441 \u043D\u0435\u0439 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438...
        \u041A\u0440\u043E\u043C\u0435 \u043C\u0435\u043D\u044F \u0443 \u0410\u043B\u0438\u043D\u044B
        \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0442 \u0434\u0440\u0443\u0437\u0435\u0439,
        \u0438 \u0435\u0439 \u043D\u0435\u043A\u043E\u043C\u0443 \u0432\u044B\u0441\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F."
