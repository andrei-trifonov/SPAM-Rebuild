      line: "-\u0410 \u044F \u0443\u0436\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430,
        \u0447\u0442\u043E \u0438\u0437 \u043D\u0430\u0448\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430
        \u0434\u043E\u0440\u043E\u0433\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0432 \u043E\u0434\u043D\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
