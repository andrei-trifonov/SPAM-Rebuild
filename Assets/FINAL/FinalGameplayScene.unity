    - type: 0
      name: 2
      line: "\u042F \u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u0441 \u043F\u043E\u043B\u0430
        \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u0441\u0444\u0435\u0440\u0443.\r\n\u0420\u0443\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442,
        \u0438 \u044D\u0442\u0430 \u0434\u0440\u043E\u0436\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044F
        \u0434\u0430\u043B\u044C\u0448\u0435\u2026 \u0421 \u0442\u0440\u0443\u0434\u043E\u043C
        \u044F \u0437\u0430\u0441\u043E\u0432\u044B\u0432\u0430\u044E \u0433\u043E\u043B\u043E\u0432\u0443
        \u0432\u043D\u0443\u0442\u0440\u044C \u0448\u0430\u0440\u0430. \u0413\u043E\u043B\u043E\u0432\u0430
        \u0441\u0442\u0430\u043B\u0430 \u0442\u044F\u0436\u0435\u043B\u0435\u0435
        \u0440\u0430\u0437\u0430 \u0432 \u0434\u0432\u0430, \u0438 \u044F \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430
        \u0435\u0435 \u043D\u0430 \u0441\u0442\u043E\u043B.\r\n"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
