  - name: "\u0424\u0438\u043D\u0433\u0435\u0440\u0431\u043E\u043A\u0441"
    lines:
    - type: 0
      name: 0
      line: "\u0422\u0443\u0442 \u043A\u0442\u043E-\u0442\u043E \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B
        \u0432\u044B\u0434\u0435\u0440\u0436\u043A\u0438 \u0438\u0437 \u0447\u044C\u0435\u0439-\u0442\u043E
        \u043D\u0430\u0443\u0447\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B
        \u043F\u043E \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
        \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0430\u043C \u0424\u0438\u043D\u0433\u0435\u0440\u0431\u043E\u043A\u0441\u043E\u0432..."
