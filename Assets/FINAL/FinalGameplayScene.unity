    - type: 0
      name: 2
      line: "\u041A \u0447\u0435\u043C\u0443 \u0432\u043E\u043E\u0431\u0449\u0435
        \u043F\u0440\u0438\u0432\u043E\u0434\u044F\u0442 \u043C\u043E\u0438 \u0432\u044B\u0431\u043E\u0440\u044B...
        \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0435\u0441\u043B\u0438
        \u0431\u044B \u044F \u043D\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u043B\u0430
        \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0438\u0447\u0435\u0433\u043E
        - \u0432\u0441\u0435 \u0431\u044B\u043B\u043E \u0431\u044B \u0433\u043E\u0440\u0430\u0437\u0434\u043E
        \u043B\u0443\u0447\u0448\u0435?"
