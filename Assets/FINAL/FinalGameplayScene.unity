    - type: 0
      name: 2
      line: "\u041F\u0430\u0440\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
        \u043F\u043E\u0447\u0442\u0438 \u043F\u0443\u0441\u0442\u044B\u043C. \u041B\u044E\u0434\u0438,
        \u043A\u0430\u043A \u043C\u043E\u0442\u044B\u043B\u044C\u043A\u0438, \u0441\u043F\u043E\u043B\u0437\u043B\u0438\u0441\u044C
        \u043D\u0430 \u0441\u0432\u0435\u0442 \u0444\u043E\u043D\u0430\u0440\u0435\u0439
        \u0443 \u0430\u0442\u0442\u0440\u0430\u043A\u0446\u0438\u043E\u043D\u043E\u0432.
        \u041F\u0440\u0438\u0433\u043B\u0443\u0448\u0435\u043D\u043D\u044B\u0439
        \u0441\u0432\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u043B
        \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430,
        \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0432\u0441\u044E
        \u043F\u0435\u0447\u0430\u043B\u044C - \u043F\u043E\u0434\u0441\u043E\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
        \u0447\u0442\u043E \u044D\u0442\u0430 \u0442\u0435\u043C\u043D\u043E\u0442\u0430
        \u0435\u0449\u0435 \u043D\u0430\u0434\u043E\u043B\u0433\u043E."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
