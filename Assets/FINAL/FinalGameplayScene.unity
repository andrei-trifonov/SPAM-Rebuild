    - type: 0
      name: 2
      line: "\u041D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C.
        \u0422\u0430\u043A\u043E\u0433\u043E \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u043E\u0433\u043E
        \u0446\u0432\u0435\u0442\u0430 \u0431\u044B\u0442\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442...
        \u041D\u043E \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B...
        \u042F \u043D\u0435 \u0432\u0438\u0436\u0443 \u043E\u0442\u0440\u043E\u0441\u0448\u0438\u0445
        \u043A\u043E\u0440\u043D\u0435\u0439... \u0418 \u043F\u0440\u0430\u0432\u0434\u0430,
        \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E \u044F
        \u0437\u043D\u0430\u044E \u0410\u043B\u0438\u043D\u0443, \u0435\u0435 \u0432\u043E\u043B\u043E\u0441\u044B
        \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043C\u0435\u043D\u044F\u043B\u0438
        \u0446\u0432\u0435\u0442."
