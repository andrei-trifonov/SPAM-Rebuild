    - type: 0
      name: 2
      line: "\u0418\u0437 \u0433\u043B\u0443\u0431\u0438\u043D\u044B \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430
        \u0434\u043E\u043D\u0435\u0441\u0441\u044F \u0441\u043B\u0430\u0431\u044B\u0439
        \u0441\u0432\u0435\u0442. \u041E\u043D \u0434\u0440\u043E\u0436\u0430\u043B,
        \u043C\u0435\u0440\u0446\u0430\u043B, \u0441\u043B\u043E\u0432\u043D\u043E
        \u043E\u0433\u043E\u043D\u0435\u043A \u0432 \u043D\u043E\u0447\u043D\u043E\u043C
        \u043B\u0435\u0441\u0443. \u042F \u043F\u043E\u043F\u043E\u043B\u0437\u043B\u0430
        \u0432 \u0435\u0433\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043A\u0430\u043A
        \u043C\u043E\u0442\u044B\u043B\u0435\u043A \u043A \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u043D\u043E\u0439
        \u043B\u0430\u043C\u043F\u0435."
