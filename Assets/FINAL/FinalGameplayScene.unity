    - type: 0
      name: 2
      line: "\u0415\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E, \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F
        \u043F\u043E\u043B\u043E\u0442\u043D\u043E \u043D\u0435\u0431\u0430 \u0442\u0430\u043A
        \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0441\u0434\u0430\u0442\u044C\u0441\u044F.
        \u0412 \u0447\u0435\u043C \u0442\u043E\u043B\u043A, \u0435\u0441\u043B\u0438
        \u0442\u044B \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u043F\u0435\u0441\u0447\u0438\u043D\u043A\u0430."
