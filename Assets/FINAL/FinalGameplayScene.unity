    - type: 0
      name: 2
      line: "\u042F \u0443\u0436\u0435 \u0438 \u0437\u0430\u0431\u044B\u043B\u0430,
        \u0447\u0442\u043E \u0442\u0430\u043A\u0430\u044F \u0448\u0442\u0443\u043A\u0430
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
