        \u0438 \u0432\u0438\u0434\u0435\u043E\u0437\u0430\u043F\u0438\u0441\u044F\u043C\u0438,
        \u0437\u0432\u0443\u043A\u0430\u043C\u0438 \u0438 \u043C\u0443\u0437\u044B\u043A\u043E\u0439.
        \u0427\u0435\u0442\u0432\u0435\u0440\u0442\u044B\u0439 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
