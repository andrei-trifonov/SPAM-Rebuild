      line: "\u0412\u043E\u043A\u0440\u0443\u0433 \u0442\u0435\u043C\u043D\u043E.
        \u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0443\u0441\u043A\u043B\u044B\u0435
        \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u044B \u043C\u0435\u0440\u0446\u0430\u044E\u0442
        \u0433\u0434\u0435-\u0442\u043E \u0432 \u0434\u043B\u0438\u043D\u043D\u043E\u0439
        - \u0434\u043B\u0438\u043D\u043D\u043E\u0439 \u0431\u0435\u0442\u043E\u043D\u043D\u043E\u0439
        \u043A\u0438\u0448\u043A\u0435. \u041E\u0442 \u0443\u0436\u0430\u0441\u043D\u043E\u0433\u043E
        \u0433\u043D\u0438\u043B\u043E\u0441\u0442\u043D\u043E\u0433\u043E \u0437\u0430\u043F\u0430\u0445\u0430
        \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u044C
        \u043D\u043E\u0441. "
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
