    - type: 0
      name: 2
      line: "\u0412\u043E\u043A\u0440\u0443\u0433 \u043F\u043E\u043B\u043D\u043E
        \u043B\u044E\u0434\u0435\u0439, \u043D\u043E \u043C\u0435\u043D\u044F \u0431\u0443\u0434\u0442\u043E
        \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442. \u041E\u043D\u043E
        \u0438 \u043A \u043B\u0443\u0447\u0448\u0435\u043C\u0443, \u0432\u0438\u0434
        \u0443 \u043C\u0435\u043D\u044F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C.
        \u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
        \u0432\u044B\u0442\u043E\u0448\u043D\u0438\u043B\u043E, \u0441\u0440\u0430\u0437\u0443
        \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0447\u0435."
