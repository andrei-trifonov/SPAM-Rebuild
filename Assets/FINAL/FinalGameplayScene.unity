      name: 2
      line: "\u041C\u044B \u0441\u0438\u0434\u0435\u043B\u0438 \u0437\u0434\u0435\u0441\u044C,
        \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0435, \u043F\u0440\u043E\u0434\u0443\u0432\u0430\u0435\u043C\u043E\u0439
        \u0432\u0441\u0435\u043C\u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u043C\u0438
        \u0432\u0435\u0442\u0440\u0430\u043C\u0438, \u043D\u043E \u0432\u0441\u0435
        \u0440\u0430\u0432\u043D\u043E, \u043C\u043D\u0435 \u0431\u044B\u043B\u043E
