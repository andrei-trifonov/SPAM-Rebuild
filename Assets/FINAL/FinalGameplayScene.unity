    - type: 0
      name: 2
      line: "\u0421\u043B\u043E\u0432\u0430 \u0437\u0432\u0443\u0447\u0430\u043B\u0438
        \u043D\u0435\u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0438 \u043A\u0430\u043A-\u0442\u043E \u043D\u0435\u0443\u043C\u0435\u0441\u0442\u043D\u043E.
        \u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E
        \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u043D\u0430 \u0438\u043C\u0435\u043B\u0430
        \u0432 \u0432\u0438\u0434\u0443, \u0433\u043E\u0432\u043E\u0440\u044F \u043E
        \u0442\u043E\u043C, \u043A\u0430\u043A \u0435\u0439 \u0431\u043E\u043B\u044C\u043D\u043E.
        \u041C\u043E\u0436\u0435\u0442 \u043E\u043D\u0430 \u0441\u043E\u0432\u0441\u0435\u043C
        \u043D\u0435 \u043E \u0441\u0432\u043E\u0435\u0439 \u0440\u0443\u043A\u0435."
