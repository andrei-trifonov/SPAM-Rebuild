    - type: 0
      name: 2
      line: "\u042F \u043F\u043E\u043C\u043E\u0442\u0430\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
        \u0438\u0437 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
        \u041A\u0430\u043A\u043E\u0433\u043E \u0445\u0443\u044F \u0442\u0443\u0442
        \u0442\u0432\u043E\u0440\u0438\u0442\u0441\u044F? \u0421\u043D\u0430\u0447\u0430\u043B\u0430
        \u0442\u0440\u0443\u043F \u0438\u0437 \u0442\u043E\u043B\u0447\u043A\u0430,
        \u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E. \u0427\u0442\u043E
        \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442? \u041C\u043E\u0436\u0435\u0442,
        \u044F \u0441\u043F\u043B\u044E... \u042F \u0443\u0449\u0438\u043F\u043D\u0443\u043B\u0430
        \u0441\u0435\u0431\u044F \u0437\u0430 \u0440\u0443\u043A\u0443. \u041D\u0435\u0442,
        \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043D\u0435 \u0441\u043F\u043B\u044E.
        \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u043F\u0440\u043E\u0441\u0442\u043E
        \u043E\u0447\u0435\u043D\u044C \u0443\u0441\u0442\u0430\u043B\u0430. \u041D\u0443\u0436\u043D\u043E
        \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043F\u043E\u0441\u043F\u0430\u0442\u044C.\r\n"
