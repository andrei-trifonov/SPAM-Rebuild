    - type: 0
      name: 2
      line: "\u0422\u0435\u043C\u043D\u043E\u2026 \u0410\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
        \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0442\u0435\u043C\u043D\u043E.
        \u041D\u0430 \u043E\u0449\u0443\u043F\u044C \u043D\u0430\u0445\u043E\u0436\u0443
        \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u043A\u043D\u043E\u043F\u043A\u0443.
        \u0412\u0440\u043E\u0434\u0435, \u0432\u0441\u0435 \u0432\u0435\u0440\u043D\u043E.
        \u041D\u0430\u0436\u043C\u0443 \u0435\u0435.\r\n"
