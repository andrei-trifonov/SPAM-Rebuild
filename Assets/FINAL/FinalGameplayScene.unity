    - type: 0
      name: 2
      line: "\u0420\u0430\u0437\u0432\u0435 \u043C\u043E\u0433\u043B\u0430 \u043E\u043D\u0430
        \u0441\u0430\u043C\u0430 \u0440\u0435\u0448\u0438\u0442\u044C\u0441\u044F 
        \u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C  \u043D\u0430 \u043A\u043E\u0441\u0442\u0435\u0440?
        \u0421\u043E\u043D\u044F? \u0414\u0430 \u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430
        \u0431\u044B \u0442\u0430\u043A\u043E\u0433\u043E \u043D\u0430 \u043D\u0435\u0435
        \u043D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430."
