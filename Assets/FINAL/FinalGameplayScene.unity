    - type: 0
      name: 2
      line: "\u041D\u043E \u0434\u043E\u043C\u0430 \u0441\u043F\u0430\u0442\u044C
        \u043D\u0435 \u0437\u0430\u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
        \u0441\u043E\u0432\u0441\u0435\u043C. \u0412\u0441\u0435 \u0442\u0435\u043B\u043E
        \u0433\u043E\u0440\u0435\u043B\u043E \u0438 \u0436\u0443\u0442\u043A\u043E
        \u043B\u043E\u043C\u0438\u043B\u0438 \u043A\u043E\u0441\u0442\u0438. \u0412
        \u0433\u043E\u043B\u043E\u0432\u0435 \u043A\u0438\u043F\u0435\u043B\u0438
        \u043D\u0430\u0434\u043E\u0435\u0434\u043B\u0438\u0432\u044B\u0435 \u043C\u044B\u0441\u043B\u0438.
        \u042F \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043B\u0430
