    - type: 0
      name: 1
      line: "-\u0410... \u041D\u0435\u0442. \u041F\u0430\u043F\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
        \u0447\u0442\u043E \u044D\u0442\u0438 \u043C\u0430\u0448\u0438\u043D\u044B
        \u0432\u0440\u0435\u0434\u044F\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044E.
        \n\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C
        \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440.
        \u0412 \u0433\u043E\u0441\u0442\u0438\u043D\u043E\u0439  \u0438 \u0443 \u043D\u0435\u0433\u043E.
        \n\u041F\u0440\u0430\u0432\u0434\u0430, \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443
        \u043A \u0441\u0435\u0431\u0435 \u043C\u0435\u043D\u044F \u043F\u0430\u043F\u0430
        \u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
        \u043F\u043E \u0432\u043E\u0441\u043A\u0440\u0435\u0441\u0435\u043D\u044C\u044F\u043C,
        \u0430 \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440, \u0447\u0442\u043E
        \u0432 \u0433\u043E\u0441\u0442\u0438\u043D\u043E\u0439, \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E
        \n\u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.\r\n"
