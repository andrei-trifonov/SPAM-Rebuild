    - type: 0
      name: 13
      line: "-\u0410 \u043A\u0430\u043A \u0436\u0435 \u0434\u0435\u0432\u0438\u0447\u044C\u044F
        \u0437\u0430\u0432\u0438\u0441\u0442\u044C? \u0417\u0430\u0432\u0438\u0441\u0442\u044C
        - \u0441\u0438\u043B\u044C\u043D\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E.
        \u0417\u043D\u0430\u0435\u0448\u044C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0442\u0430\u043A\u0438\u0445 \u0441\u043B\u0443\u0447\u0430\u0435\u0432
        \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C.
        \u041E-\u043E.\n"
