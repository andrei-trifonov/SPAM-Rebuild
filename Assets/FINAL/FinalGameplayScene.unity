    - type: 8
      name: 2
      line: "\u0414\u0430, \u0435\u0439 \u0441\u0435\u0439\u0447\u0430\u0441 \u0431\u0435\u0437\u0443\u043C\u043D\u043E
        \u0442\u044F\u0436\u0435\u043B\u043E, \u043D\u043E \u043E\u043D\u0430 \u0436\u0438\u0432\u0430,
        \u0436\u0438\u0432\u0430! \u0410 \u0447\u0442\u043E, \u0435\u0441\u043B\u0438
        \u043E\u043D\u0430 \u0432\u0434\u0440\u0443\u0433  \u0432\u043E\u0437\u044C\u043C\u0435\u0442
        \u0438... \u0418 \u0435\u0435 \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442!
        \u041F\u0440\u043E\u0441\u0442\u043E \u0432\u043E\u0442... \u0411\u044B\u043B\u0430
        \u0438 \u043D\u0435\u0442.\n\n\u041D\u0435\u043C\u043E\u0435 \u0438 \u0433\u043B\u0443\u0445\u043E\u0435
        \u0442\u0435\u043B\u043E, \u0441 \u043E\u0441\u0442\u0440\u044B\u043C\u0438
        \u0447\u0435\u0440\u0442\u0430\u043C\u0438 \u043B\u0438\u0446\u0430. \u0427\u0442\u043E
        \u044F \u0441\u043C\u043E\u0433\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C?
        \u042F \u043F\u043E\u0433\u0438\u0431\u043D\u0443 \u0432\u043C\u0435\u0441\u0442\u0435 
        \u0441 \u043D\u0435\u0439."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
