        \u042F \u0441\u0442\u043E \u0440\u0430\u0437 \u0442\u0430\u043A \u0434\u0435\u043B\u0430\u043B\u0430.
        \u041D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043A\u0440\u0443\u0447\u0435
        \u043A\u0438\u0441\u043B\u043E\u0442\u043D\u043E\u0433\u043E \u0440\u0435\u0439\u0432\u0430! "
