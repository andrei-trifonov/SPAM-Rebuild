    - type: 0
      name: 2
      line: "-\u0417\u0434\u043E\u0440\u043E\u0432\u0430! - \u042F \u0442\u043E\u043B\u043A\u0430\u044E
        \u0421\u043E\u043D\u044E \u0432 \u043F\u043B\u0435\u0447\u043E \u0438 \u043F\u043B\u044E\u0445\u0430\u044E\u0441\u044C
        \u0437\u0430 \u0441\u0442\u043E\u043B. \u0415\u0441\u043B\u0438 \u043D\u0435
        \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u044D\u0442\u043E\u0442
        \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u0440\u0438\u0442\u0443\u0430\u043B \u043F\u0435\u0440\u0432\u043E\u0439,
        \u0437\u043D\u0430\u0447\u0438\u0442, \u043F\u0440\u0438\u043B\u0435\u0442\u0438\u0442
        \u0443\u0436\u0435 \u043C\u043D\u0435. \r\n"
