    - type: 0
      name: 0
      line: "// \u043C\u044B\u0441\u043B\u0438 - \u044D\u0442\u043E \u044D\u0445\u043E
        \u0432\u043E\u044E\u0449\u0435\u0439 \u043A\u0440\u043E\u0432\u0438; \n-
        \u043E\u0442\u0440\u0430\u0436\u0430\u044F\u0441\u044C \u043E\u0442 \u0441\u0442\u0435\u043D
        \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438().\nvoid
        \u042D\u0445\u043E\u041C\u044B\u0441\u043B\u0435\u0439(\u043C\u044F\u0441\u043E-\u043C\u0430\u0448\u0438\u043D\u0430*
        \u043C\u0430\u0448\u0438\u043D\u0430) {\n\_\_\_ //\u043A\u043E\u043C\u043C\u0435\u043D\u0442:
        \u0435\u0451 \u043C\u044B\u0441\u043B\u0438 \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F
        \u0432\u043E \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438\n\_\_\_
        \u0435\u0441\u043B\u0438(Msne(2, \u0433\u043A\u043E\u0434, h_LOCKALKEY, 0,
        \u041B\u041E\u0416\u042C))\n\_\_\_\_\_\_\_ \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C(\"\u0441\u0438\u0441\u0442\u0435\u043C\u0430
        \u041E\u041A\"); \n} "
