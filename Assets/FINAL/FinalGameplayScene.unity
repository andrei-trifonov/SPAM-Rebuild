    - type: 0
      name: 0
      line: "\u0418 \u0432\u043E\u0442 \u0447\u0435\u0440\u0435\u0437 20 \u043B\u0435\u0442
        \u044F \u0432\u044B\u0440\u043E\u0441, \u0443\u0435\u0445\u0430\u043B \u0432
        \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0433\u043E\u0440\u043E\u0434
        \u0443\u0447\u0438\u0442\u044C\u0441\u044F. \u0418 \u043F\u043E\u0437\u0432\u0430\u043B\u0438
        \u043C\u0435\u043D\u044F \u043D\u0430 \u0432\u043F\u0438\u0441\u043A\u0443,
        \u0438 \u0440\u0435\u0448\u0438\u043B\u0438 \u043F\u043E\u0434\u0448\u0443\u0442\u0438\u0442\u044C:
        \u043F\u043E\u0434\u043C\u0435\u0448\u0430\u043B\u0438 \u0432 \u043F\u0438\u0432\u043E
        \u0434\u0435\u043C\u0438\u0434\u0440\u043E\u043B. \u042F \u0432\u0441\u044E
        \u0431\u0443\u0442\u044B\u043B\u043A\u0443 \u0432\u044B\u0434\u0443\u043B
        \u2013 \u043D\u0438\u0447\u0435\u0433\u043E."
