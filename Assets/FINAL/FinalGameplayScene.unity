        \u041C\u043E\u0436\u0435\u0442, \u0442\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0448\u044C,
        \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435... \u042D\u0442\u043E\u0442
