    - type: 0
      name: 2
      line: "\u0412\u0441\u0435 \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u0442\u043E.
        \u041B\u0438\u0441\u0442\u044B \u0441 \u043A\u0430\u0440\u0442\u0430\u043C\u0438
        \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432, \u0430\u043D\u0430\u043B\u0438\u0437\u044B
        \u043D\u0430 \u0433\u043B\u0438\u0441\u0442\u043E\u0432, \u0430\u043D\u0430\u043B\u0438\u0437\u044B
        \u043A\u0440\u043E\u0432\u0438, \u043A\u0430\u043B\u0430, \u043C\u043E\u0447\u0438,
        \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u043D\u0435\u0432\u0435\u0434\u043E\u043C\u044B\u0435
        \u043F\u0438\u043B\u044E\u043B\u0438 - \u0432\u0441\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u043B\u043E\u0441\u044C
        \u0432 \u043E\u0434\u0438\u043D \u043A\u043E\u043C\u043E\u043A, \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u044B\u0439
        \u0431\u043E\u043B\u044C\u043D\u0438\u0447\u043D\u043E\u0439 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043E\u0439."
