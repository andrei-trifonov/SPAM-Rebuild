    - type: 0
      name: 2
      line: "\u041C\u044B \u0434\u043E\u0448\u043B\u0438 \u0434\u043E \u043E\u0431\u0432\u0430\u043B\u0430.
        \u0421\u0442\u0435\u043D\u044B \u0440\u0443\u0445\u043D\u0443\u043B\u0438
        \u0434\u0440\u0443\u0433 \u043D\u0430 \u0434\u0440\u0443\u0433\u0430, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432
        \"\u043A\u0430\u0440\u0442\u043E\u0447\u043D\u044B\u0439 \u0434\u043E\u043C\u0438\u043A\".
        \u042F \u0440\u0435\u0448\u0438\u043B\u0430\u0441\u044C \u0438 \u043F\u0440\u043E\u0442\u0438\u0441\u043D\u0443\u043B\u0430\u0441\u044C
        \u0432 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439
        \u043F\u0440\u043E\u0445\u043E\u0434."
