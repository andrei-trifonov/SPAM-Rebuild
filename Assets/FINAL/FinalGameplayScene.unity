    - type: 0
      name: 2
      line: "\u0427\u0442\u043E \u0431\u044B \u0442\u044B \u043D\u0438 \u0441\u0434\u0435\u043B\u0430\u043B,
        \u0437\u0432\u0435\u0437\u0434\u044B \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F
        \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445,
        \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044F \u0442\u0432\u043E\u0435\u0433\u043E
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F.\n\u041D\u0430
        \u044D\u0442\u043E\u0439 \u043C\u044B\u0441\u043B\u0438 \u044F \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430,
        \u043A\u0430\u043A \u043E\u0434\u043D\u0430 \u0438\u0437 \u0437\u0432\u0435\u0437\u0434
        \u043D\u0430\u0447\u0430\u043B\u0430 \u043C\u0435\u0440\u0446\u0430\u0442\u044C
        \u0438 \u0431\u0443\u0434\u0442\u043E \u043D\u0430\u0447\u0430\u043B\u0430
        \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
