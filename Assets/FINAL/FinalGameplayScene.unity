    - type: 0
      name: 2
      line: "\u0414\u043E\u043C\u0430 \u044F \u0441\u0440\u0430\u0437\u0443 \u0436\u0435
        \u043F\u043E\u0434\u0440\u0443\u0431\u0438\u043B\u0430\u0441\u044C \u043A
        \u0441\u0435\u0442\u0438. \n"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: "\u041F\u0430\u0440\u0443 \u043C\u0438\u043D\u0443\u0442 \u0438 \u0432\u043E\u0442
        \u044F \u0443\u0436\u0435 \u0441\u0438\u0434\u0435\u043B\u0430, \u0443\u0442\u043A\u043D\u0443\u0432\u0448\u0438\u0441\u044C
        \u0432 \u043C\u043E\u043D\u0438\u0442\u043E\u0440 \u043A\u0430\u043A \u0432
        \u0447\u0435\u0440\u043D\u0443\u044E \u0434\u044B\u0440\u0443, \u0433\u0434\u0435
        \u043F\u043E \u0432\u0441\u0435\u043C \u0437\u0430\u043A\u043E\u043D\u0430\u043C 
        \u0432\u0440\u0435\u043C\u044F \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u043E\u0441\u044C,
        \u0430 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0441\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u043B\u0430\u0441\u044C
        \u0432 \u0431\u0443\u0431\u043B\u0438\u043A."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: "\u0424\u043E\u043A\u0441\u043D\u0435\u0442 -\u043C\u043E\u0439 \u0442\u0430\u0439\u043D\u044B\u0439
        \u043C\u0438\u0440, \u043C\u043E\u044F \u043B\u0438\u0447\u043D\u0430\u044F
        \u043C\u0430\u0442\u0440\u0438\u0446\u0430. \u0417\u0434\u0435\u0441\u044C
        \u044F \u043C\u043E\u0433\u0443 \u0431\u044B\u0442\u044C \u043A\u0435\u043C
        \u0443\u0433\u043E\u0434\u043D\u043E - \u043F\u043E\u0432\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439
        \u0442\u0440\u043E\u043B\u043B\u0435\u0439, \u043D\u043E\u0432\u044B\u043C
        \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u043E\u043C \u0432 \u0443\u0441\u0430\u0442\u043E\u0439
        \u043C\u0430\u0441\u043A\u0435, \u0437\u0430\u0441\u0442\u0435\u043D\u0447\u0438\u0432\u043E\u0439
        \u0430\u043D\u0438\u043C\u0435-\u0448\u043A\u043E\u043B\u044C\u043D\u0438\u0446\u0435\u0439..."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: "\u0418\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u044B\u0442\u044C
        \u0441\u043E\u0431\u043E\u0439, \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0442\u044C
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0431\u0438\u0442 \u0442\u0435\u043A\u0441\u0442\u0430,
        \u0431\u0443\u0434\u0442\u043E \u043A\u0430\u043F\u043B\u0438 \u0433\u0443\u0431\u043A\u043E\u0439, 
        \u0438\u0437 \u0442\u0440\u0435\u0434\u0430 \u0432 \u0442\u0440\u0435\u0434,
        \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u043A\u0440\u043E\u0445\u0438."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
      time: 0
      value: 0
      signs: 0
      var: 0
      ThoType: 0
      signsIf: 0
      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 2
      line: "\u0412 \u0433\u043B\u0430\u0437\u0430\u0445 \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u043B\u0438
        \u043F\u0438\u043A\u0441\u0435\u043B\u0438, \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F\u0441\u044C
        \u0432 \u0441\u0442\u0440\u043E\u043A\u0438, \u0438 \u043A\u0430\u0436\u0434\u0430\u044F
        \u0441\u0442\u0440\u043E\u0447\u043A\u0430 \u0448\u0435\u043F\u0442\u0430\u043B\u0430
        \u043E \u0447\u0435\u043C-\u0442\u043E \u0442\u0430\u0439\u043D\u043E\u043C
        \u0438 \u0441\u043A\u0440\u044B\u0442\u043E\u043C. \u0424\u043E\u043A\u0441\u043D\u0435\u0442
        - \u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430 \u0438 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0440,
        \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
        \u0434\u0435\u043C\u043E\u043D-\u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A.
        \u041E\u043D \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
        \u043A\u0430\u043A \u0436\u0438\u0442\u044C, \u0447\u0442\u043E \u0434\u0443\u043C\u0430\u0442\u044C,
        \u043A\u0430\u043A \u0432\u0438\u0434\u0435\u0442\u044C. "
