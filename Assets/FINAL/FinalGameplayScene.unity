      name: 2
      line: "\u041C\u0438\u0440 \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
        \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F, \u0438
        \u0432\u043C\u0435\u0441\u0442\u043E \u0440\u0430\u0437\u043C\u044B\u0442\u044B\u0445
        \u043F\u044F\u0442\u0435\u043D \u044F \u0432\u0438\u0436\u0443 \u0433\u043E\u0440\u043E\u0434.\r\n\u0422\u043E\u043B\u044C\u043A\u043E...
