    - type: 0
      name: 2
      line: "\u041E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0432\u0435\u0442\u0438\u043B\u0430\u0441\u044C
        \u043E\u0442 \u0441\u0447\u0430\u0441\u0442\u044C\u044F...  \u0425\u043E\u0440\u043E\u0448\u043E,
        \u0447\u0442\u043E \u044F \u0435\u0439 \u043F\u043E\u043C\u043E\u0433\u043B\u0430.
        \u042D\u0442\u0430 \u0443\u043B\u044B\u0431\u043A\u0430, \u0431\u043B\u0435\u0441\u043A
        \u0432 \u0435\u0435 \u0433\u043B\u0430\u0437\u0430\u0445... \u041D\u0435
        \u0437\u043D\u0430\u044E, \u043F\u043E\u0447\u0435\u043C\u0443, \u044F \u0431\u044B
        \u043C\u043D\u043E\u0433\u043E\u0435 \u043E\u0442\u0434\u0430\u043B\u0430,
        \u0447\u0442\u043E\u0431\u044B \u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0435
        \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u0439.\n\u0422\u0430\u043A\u043E\u0435
        \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E... "
