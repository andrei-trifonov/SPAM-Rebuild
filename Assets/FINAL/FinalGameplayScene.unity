        \u0432 \u0448\u043A... \u0412 \u043A\u043E\u043B\u043B\u0435\u0434\u0436,
        \u044E\u043D\u0430\u044F \u041C\u0438, \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u0442\u0430\u043A\u043E\u0439 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439
