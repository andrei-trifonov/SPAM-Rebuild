    - type: 0
      name: 1
      line: "-\u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C. \u041E\u0431\u044B\u0447\u043D\u043E
        \u044F \u043F\u044B\u0442\u0430\u044E\u0441\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C
        \u0443\u0440\u043E\u043A\u0438 \u0438\u043B\u0438 \u0441\u043C\u043E\u0442\u0440\u044E
        \u0432 \u043E\u043A\u043D\u043E. \u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441
        \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u043D\u043E\u0447\u044C,
        \u0438 \u0432 \u043E\u043A\u043D\u043E \u043F\u043E\u0447\u0442\u0438 \u043D\u0438\u0447\u0435\u0433\u043E
        \u043D\u0435 \u0432\u0438\u0434\u043D\u043E... \u042F \u043F\u043E\u043B\u0438\u0432\u0430\u044E
        \u0446\u0432\u0435\u0442\u044B \u0438\u043B\u0438 \u0441\u0438\u0436\u0443
        \u0432\u043E\u0437\u043B\u0435 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430,
        \u0438 \u0436\u0434\u0443, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0437\u0430\u0437\u0432\u043E\u043D\u0438\u0442.\r\n"
