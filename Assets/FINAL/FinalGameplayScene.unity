    - type: 0
      name: 2
      line: "\u041D\u0443 \u0434\u0430... \u041E\u0433\u043E\u043D\u0435\u043A \u0432\u0441\u0435
        \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u043B\u0441\u044F.\n\u0421\u043F\u0443\u0441\u0442\u044F
        \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442
        \u043E\u043D \u0431\u044B\u043B \u0441\u043E\u0432\u0441\u0435\u043C \u0443\u0436
        \u0431\u043B\u0438\u0437\u043A\u043E. \u041D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435
        \u043D\u0430 \u0437\u0432\u0435\u0437\u0434\u0443...\n"
