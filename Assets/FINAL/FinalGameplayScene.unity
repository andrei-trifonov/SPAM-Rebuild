    - type: 0
      name: 2
      line: "\u0421\u043E\u043D\u044F \u0442\u0430\u0440\u0430\u0442\u043E\u0440\u0438\u0442,
        \u0438 \u044F \u0435\u0434\u0432\u0430 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E
        \u0441\u043B\u043E\u0432\u0430. \u0411\u043B\u0438\u043D, \u043F\u043E\u0447\u0435\u043C\u0443
        \u043C\u043D\u0435\_ \u0442\u0430\u043A \u043F\u043B\u043E\u0445\u043E-\u0442\u043E...
        \u0417\u0432\u043E\u043D \u0432 \u0443\u0448\u0430\u0445 \u043D\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.
        \u042F \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u043D\u043E\u0432\u0430
        \u043F\u043E\u0442\u0435\u0440\u044F\u044E \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435..."
