    - type: 0
      name: 2
      line: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u041A\u0438\u0440 \u043A\u043E\u043B\u0435\u0431\u0430\u043B\u0441\u044F.
        \u041E\u043D \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u0441\u043A\u0430\u0437\u0430\u0442\u044C
        \u0447\u0442\u043E-\u0442\u043E \u0435\u0449\u0451, \u043D\u043E, \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E
        \u043D\u0435 \u0440\u0435\u0448\u0438\u043B\u0441\u044F. \u041C\u043E\u0436\u0435\u0442,
        \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u0440\u0443\u0431\u0430\u044F?\r\n\u042F
        \u043E\u0431\u0445\u0432\u0430\u0442\u0438\u043B\u0430 \u0448\u043B\u0435\u043C
        \u0440\u0443\u043A\u043E\u0439 \u0438 \u043D\u0430\u0441\u043C\u0435\u0448\u043B\u0438\u0432\u043E
