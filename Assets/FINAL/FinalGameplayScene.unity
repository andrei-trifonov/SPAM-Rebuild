    - type: 0
      name: 2
      line: "\u0428\u0443\u043C\u043D\u044B\u0435 \u0434\u0432\u0435\u0440\u0438
        \u043E\u0442\u043A\u0440\u044B\u043B\u0438\u0441\u044C, \u0437\u0432\u0435\u043D\u044F
        \u0448\u0430\u0440\u043D\u0438\u0440\u0430\u043C\u0438, \u0438 \u044F \u0432\u044B\u043F\u043E\u043B\u0437\u043B\u0430
