    - type: 0
      name: 2
      line: "\u042F \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
        \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
        \u0435\u0449\u0435, \u043D\u043E \u043E\u0442 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F
        \u0443 \u043C\u0435\u043D\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0431\u043E\u043B\u0435\u043B\u0430
        \u0433\u043E\u043B\u043E\u0432\u0430. \u0418 \u043A\u0430\u043A \u043C\u043D\u0435
