      emoji: 0
      menu_label: []
      menu_jump: []
      V3position: {x: 0, y: 0, z: 0}
    - type: 0
      name: 13
      line: "\u0425\u043E\u0447\u0435\u0448\u044C \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
        \u0447\u0442\u043E \u0442\u044B \u0435\u0435 \u043D\u0435 \u0442\u043E\u043B\u043A\u0430\u043B\u0430?
        \u0412\u043E\u0442 \u0436\u0438\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A
        \u0441\u0435\u0431\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
        \u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0441\u044F \u0436\u0438\u0437\u043D\u0438,
        \u0438 \u0432\u0434\u0440\u0443\u0433 \u0440\u0430\u0437 - \u0448\u0430\u0433\u043D\u0443\u043B
        \u0432 \u043E\u0433\u043E\u043D\u044C?"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
      time: 0
