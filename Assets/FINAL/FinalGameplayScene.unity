    - type: 0
      name: 2
      line: "\u042F \u0443\u0436\u0435 \u0438 \u0437\u0430\u0431\u044B\u043B\u0430,
        \u0447\u0442\u043E \u0442\u0430\u043A\u0430\u044F \u0448\u0442\u0443\u043A\u0430
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u0440\u0430\u0437 \u044F \u043D\u0430\u0434\u0443\u0432\u0430\u043B\u0430
        \u043F\u0443\u0437\u044B\u0440\u0438\u043A\u0438 \u043B\u0435\u0442 \u0432
        \u0432\u043E\u0441\u0435\u043C\u044C. \u0410\u043B\u0438\u043D\u0430 \u043E\u0431\u043C\u0430\u043A\u043D\u0443\u043B\u0430
        \u0441\u043E\u043B\u043E\u043C\u043A\u0443 \u0441 \u043A\u043E\u043B\u044C\u0446\u043E\u043C
        \u0432 \u0431\u0430\u043D\u043E\u0447\u043A\u0443, \u043E\u0442\u0447\u0435\u0433\u043E
        \u043A\u043E\u043B\u044C\u0446\u043E \u043E\u0431\u0442\u044F\u043D\u0443\u043B\u0430
        \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0430\u044F \u043C\u0430\u0441\u043B\u044F\u043D\u0430\u044F
        \u043F\u043B\u0435\u043D\u043A\u0430. "
      font: 0
      inv: 0
