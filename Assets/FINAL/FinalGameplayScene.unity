    - type: 0
      name: 2
      line: "\u041E\u0431\u0445\u0432\u0430\u0442\u0438\u0432 \u0440\u0443\u043A\u0430\u043C\u0438
        \u043D\u043E\u0433\u0438 , \u044F \u0441\u043B\u0435\u0436\u0443 \u0437\u0430
        \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u043C\u0438 \u0447\u0430\u0441\u0430\u043C\u0438
        \u0432 \u0443\u0433\u043B\u0443 \u044D\u043A\u0440\u0430\u043D\u0430. \u0412\u0440\u0435\u043C\u044F
        \u043D\u0435\u0443\u043C\u043E\u043B\u0438\u043C\u043E \u0431\u043B\u0438\u0437\u0438\u0442\u0441\u044F
        \u043A \u0432\u043E\u0441\u044C\u043C\u0438 \u0447\u0430\u0441\u0430\u043C.
        \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C
        \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F. "
