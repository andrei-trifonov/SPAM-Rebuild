    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[690]
      value: "    mr \"\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0432\u044B\u0442\u0430\u0449\u0438\u043B
        \u0438\u0437 \u043A\u0430\u0440\u043C\u0430\u043D\u0430 \u043A\u043E\u043F\u0438\u044E
        \u043D\u0443\u0436\u043D\u043E\u0433\u043E \u043A\u043B\u044E\u0447\u0430
        \u0438 \u043E\u0442\u043F\u0435\u0440 \u0434\u0432\u0435\u0440\u044C, \u0434\u043E\u0441\u0442\u0430\u0432
        \u0444\u043E\u043D\u0430\u0440\u0438\u043A.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[691]
      value: "    mr \"\u0421\u0432\u0435\u0442 \u0438\u0437 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430
        \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u043E\u0441\u0432\u0435\u0442\u0438\u043B
        \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443 \u043F\u043E\u0434 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435\u0439.
        \u041D\u0430 \u043D\u0435\u0439 \u043B\u0435\u0436\u0430\u043B \u043D\u0430\u0448
        \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044C
        \u0445\u0438\u043C\u0438\u0438, \u0438 \u043D\u0435 \u043C\u043E\u0440\u0433\u0430\u044F
        \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432 \u043C\u043E\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443.\"\r"
