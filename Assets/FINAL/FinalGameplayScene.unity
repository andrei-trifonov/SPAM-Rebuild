    - type: 0
      name: 2
      line: "\u042F \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B\u0430 \u0443\u0437\u0435\u043B\u043E\u043A
        \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435 \u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u043D\u0443\u043B\u0430
        \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u043B\u043E\u0439 \u0431\u0438\u043D\u0442\u0430.
        \u041F\u043E\u0434 \u043D\u0438\u043C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
        \u0435\u0449\u0435 \u0431\u043E\u043B\u0435\u0435 \u0432\u043B\u0430\u0436\u043D\u044B\u0439
        \u0441\u043B\u043E\u0439, \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u044B\u0439
        \u0432\u043E\u043D\u044E\u0447\u0435\u0439 \u0441\u043B\u0438\u0437\u044C\u044E.\n\u042F
        \u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u0432 \u0433\u043B\u0430\u0437\u0430 \u0410\u043B\u0435."
