    - type: 0
      name: 2
      line: "-\u042D\u0442\u043E \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044C
        \u0432 \u0447\u0435\u0441\u0442\u044C \u043D\u0430\u0447\u0430\u043B\u0430
        \u043F\u043E\u043B\u044F\u0440\u043D\u043E\u0439 \u043D\u043E\u0447\u0438.
        \u041E\u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u043D\u0435\u0442\u0441\u044F
        \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u0433\u043E\u0434\u0430,
        \u0438 \u043B\u044E\u0434\u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u044E\u0442
        \u0444\u043E\u043D\u0430\u0440\u0438\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442 \u044F\u0440\u043A\u043E\u0435
        \u0436\u0435\u043B\u0442\u043E\u0435 \u0421\u043E\u043B\u043D\u0446\u0435. "
