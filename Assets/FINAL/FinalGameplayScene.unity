    - type: 0
      name: 2
      line: "\u0412 \u043E\u0434\u0438\u043D \u043C\u0438\u0433 \u0432\u0441\u0435
        \u0441\u0442\u0438\u0445\u043B\u043E. \u0421\u0442\u0443\u043A \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u0441\u044F,
        \u0438 \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u043D\u043E\u0432\u0430
