    - type: 0
      name: 5
      line: "\u0418 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438, \u043C\u043D\u0435
        \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E
        \u044D\u0442\u043E\u0442 \u0447\u0443\u0434\u0430\u043A \u0437\u0434\u0435\u0441\u044C
        \u0437\u0430\u0431\u044B\u043B. \u0425\u043E\u0447\u0443 \u0443\u0437\u043D\u0430\u0442\u044C
        \u043E \u043D\u0435\u043C \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435.
        \r\n\u041F\u0440\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u0432
        \u043A \u043F\u0430\u0440\u0442\u0435 \u041A\u0438\u0440\u0430, \u044F \u043F\u043B\u044E\u0445\u043D\u0443\u043B\u0430\u0441\u044C
        \u043D\u0430 \u0441\u0442\u0443\u043B, \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u0432
        \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
        \u0431\u0435\u0437\u0440\u0430\u0437\u043B\u0438\u0447\u0438\u0435.\r"
