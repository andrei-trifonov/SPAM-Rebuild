  - name: "\u0414\u0435\u043D\u044C2 \u0421\u0436\u0435\u0447\u044C"
    lines:
    - type: 0
      name: 2
      line: "-\u0415\u0441\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E...
        \u041D\u0443\u0436\u043D\u043E \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
        \u0441\u043A\u043E\u0440\u0435\u0435 \u0443\u0431\u0440\u0430\u0442\u044C
        \u044D\u0442\u0443 \u043C\u0435\u0440\u0437\u043E\u0441\u0442\u044C! \u041E\u043D\u0430
        \u043C\u043E\u0436\u0435\u0442 \u0443\u0431\u0438\u0442\u044C \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C,
        \u0438\u043B\u0438 \u0441\u043D\u043E\u0432\u0430 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u044C!"
