    - type: 0
      name: 2
      line: "\u0427\u044C\u0438-\u0442\u043E \u043C\u0435\u043B\u044C\u0442\u0435\u0448\u0430\u0449\u0438\u0435
        \u0444\u0438\u0433\u0443\u0440\u044B \u043D\u043E\u0441\u044F\u0442\u0441\u044F
        \u0441 \u0432\u0435\u0434\u0440\u0430\u043C\u0438 \u043F\u0435\u0441\u043A\u0430
        \u0438 \u0432\u043E\u0434\u044B, \u043F\u044B\u0442\u0430\u044F\u0441\u044C
        \u0437\u0430\u043B\u0438\u0442\u044C \u0441\u043E\u043B\u043E\u043C\u0443
        - \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u043B\u043E\u0445\u043E."
