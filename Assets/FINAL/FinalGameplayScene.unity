    - type: 0
      name: 2
      line: "\u041C\u043E\u044F \u0432\u0430\u0442\u0430 - \u0433\u043E\u043B\u0443\u0431\u0430\u044F.
        \u042F \u043E\u0431\u043E\u0436\u0430\u044E \u044D\u0442\u043E\u0442 \u0446\u0432\u0435\u0442...
        \u041A \u0442\u043E\u043C\u0443 \u0436\u0435, \u0432 \u0434\u043D\u0438 \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044F
        \u044D\u0442\u0443 \u0432\u0430\u0442\u0443 \u0434\u0435\u043B\u0430\u044E\u0442
        \u0438\u0437 \u043B\u0443\u043D\u043D\u043E\u0433\u043E \u0441\u0430\u0445\u0430\u0440\u0430,
        \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043E \u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
        \u0433\u043E\u043B\u0443\u0431\u043E\u0439 \u0446\u0432\u0435\u0442.\r\n"
