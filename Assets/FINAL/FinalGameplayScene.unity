      name: 2
      line: "\u0412\u044B\u0434\u0435\u0440\u043D\u0443\u0432 \u0448\u043D\u0443\u0440
        \u0438\u0437 \u043C\u0430\u0448\u0438\u043D\u044B, \u044F \u0431\u044B\u0441\u0442\u0440\u043E
        \u043E\u0431\u0443\u043B\u0430\u0441\u044C \u0438 \u043F\u043E\u0442\u043E\u043F\u0430\u043B\u0430
