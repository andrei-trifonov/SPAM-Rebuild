    - type: 0
      name: 2
      line: "-\u0414\u0430\u0432\u0430\u0439 \u0434\u043E\u0439\u0434\u0435\u043C
        \u0434\u043E \u043A\u043E\u043D\u0446\u0430. \u0410 \u043F\u043E\u0442\u043E\u043C
        \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F."
