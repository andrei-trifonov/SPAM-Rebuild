    - type: 0
      name: 2
      line: "\u041E\u043D \u0437\u043D\u0430\u0435\u0442 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
        \u043C\u043E\u0435 \u0438\u043C\u044F, \u043D\u043E \u0438 \u0442\u043E,
        \u0433\u0434\u0435 \u044F \u0436\u0438\u0432\u0443. \u041C\u043E\u0436\u0435\u0442,
        \u044D\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043A\u043B\u0430\u0441\u0441\u0430
        \u0440\u0435\u0448\u0438\u043B \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439
        \u043F\u043E\u0434\u0448\u0443\u0442\u0438\u0442\u044C?  \u0410 \u0435\u0441\u043B\u0438
        \u043D\u0435\u0442?\r\n\u0421\u0430\u043C\u0430 \u043D\u0435 \u0437\u043D\u0430\u044F,
        \u043F\u043E\u0447\u0435\u043C\u0443, \u044F \u043D\u0430\u0431\u0438\u0440\u0430\u044E
        \u043E\u0442\u0432\u0435\u0442.\r"
