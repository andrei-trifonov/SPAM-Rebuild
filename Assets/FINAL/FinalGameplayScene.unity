    - type: 0
      name: 8
      line: "-\u041C\u0438\u0440\u0430, \u044F \u0442\u043E\u0436\u0435 \u0441\u043A\u043E\u0440\u0431\u043B\u044E
        \u043F\u043E \u043E\u0442\u0446\u0443. \u041C\u043D\u0435 \u0442\u043E\u0436\u0435
        \u043F\u043B\u043E\u0445\u043E. \u042D\u0442\u043E \u043D\u0435 \u043F\u043E\u0432\u043E\u0434
        \u0442\u0430\u043A \u0443\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F!
