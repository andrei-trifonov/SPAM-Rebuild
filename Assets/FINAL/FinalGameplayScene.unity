    - type: 0
      name: 2
      line: "-\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E. \u041F\u043E\u043D\u0438\u043C\u0430\u044E...
        \u041F\u0440\u043E\u0441\u0442\u043E, \u0445\u043E\u0447\u0443 \u0431\u044B\u0442\u044C
        \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0439.
        \u0418... \u041F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
        \u0441\u043E \u0432\u0441\u0435\u043C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C,
        \u043C\u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430, \u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0447\u0442\u043E \u044D\u0442\u0430 \u043A\u043E\u0448\u043A\u0430 - \u0447\u0442\u043E-\u0442\u043E
        \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0435.\r\n"
