      name: 2
      line: "\u0423\u0436\u0435 \u0438 \u043A\u0438\u0441\u0442\u044C, \u0438 \u043B\u043E\u043A\u043E\u0442\u044C
        \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0432\u043D\u0443\u0442\u0440\u0438,
        \u0430 \u0434\u043D\u0430 \u0432\u0441\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E.
        \u042F \u043E\u0441\u043C\u0435\u043B\u0435\u043B\u0430 \u0438 \u043F\u0440\u0438\u0441\u0435\u043B\u0430
