    - type: 0
      name: 2
      line: "-\u0410 \u044F \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u0443\u043C\u0435\u044E
        \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u0441 \u043A\u043E\u0442\u0430\u043C\u0438,
        \u0438 \u0432\u043E\u043E\u0431\u0449\u0435... \u041C\u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441
        \u0432 \u0448\u043A\u043E\u043B\u0443 \u043D\u0430\u0434\u043E, \u0432 \u043E\u0431\u0449\u0435\u043C...
        \u041F\u043E\u043A\u0430. \u041C\u043D\u0435 \u043F\u043E\u0440\u0430."
