    - type: 0
      name: 2
      line: "\u041A\u043E\u043C \u0437\u0430\u0441\u0442\u0440\u044F\u043B \u0432
        \u0433\u043E\u0440\u043B\u0435 \u0438 \u043D\u0435 \u0445\u043E\u0442\u0435\u043B
        \u0438\u0434\u0442\u0438 \u043D\u0438 \u0432\u043F\u0435\u0440\u0435\u0434
        \u043D\u0438 \u043D\u0430\u0437\u0430\u0434, \u043C\u0443\u0447\u0430\u044F
        \u043C\u0435\u043D\u044F \u0438 \u043D\u0435 \u0434\u0430\u0432\u0430\u044F
        \u043F\u0440\u043E\u0434\u043E\u0445\u043D\u0443\u0442\u044C. \u0412\u0441\u0435,
        \u043D\u0435 \u043C\u043E\u0433\u0443. \u042F \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044C
        \u0438 \u043B\u0435\u0433\u043B\u0430 \u043D\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
        \u043E\u0431\u043E\u0434\u043E\u043A, \u0437\u0430\u043A\u0440\u044B\u0432
        \u0433\u043B\u0430\u0437\u0430."
