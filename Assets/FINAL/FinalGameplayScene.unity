      name: 2
      line: "\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0441\u0432\u043E\u0438
        \u0441\u043B\u043E\u0432\u0430, \u0422\u043E\u043B\u044F \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u043B\u0441\u044F
        \u0443\u0445\u043E\u0434\u0438\u0442\u044C - \u0432\u0441\u0435 \u0447\u0442\u043E-\u0442\u043E
        \u043C\u044F\u043B\u0441\u044F \u0443 \u0434\u0432\u0435\u0440\u0438, \u0438
        \u0431\u0443\u0440\u0447\u0430\u043B \u043F\u043E\u0434 \u043D\u043E\u0441
        \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u043D\u0435\u0441\u0432\u044F\u0437\u043D\u0443\u044E
