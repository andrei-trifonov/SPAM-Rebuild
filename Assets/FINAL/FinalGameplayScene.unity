    - type: 0
      name: 2
      line: "\u041E\u0441\u043B\u0430\u0431\u0435\u0432\u0448\u0438\u0435 \u043D\u043E\u0433\u0438
        \u043A\u0430\u043A \u043C\u043E\u0433\u043B\u0438 \u043D\u0435\u0441\u043B\u0438
        \u043C\u0435\u043D\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
        \u0442\u0440\u0430\u043C\u0432\u0430\u0439\u043D\u043E\u0439 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438. "
