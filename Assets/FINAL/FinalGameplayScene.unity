    - type: 0
      name: 2
      line: "-\u0422\u0430\u043A \u0438 \u0431\u044B\u043B\u043E... \u0417\u0430\u0447\u0435\u043C
        \u043C\u043D\u0435 \u0432\u0440\u0430\u0442\u044C?"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
