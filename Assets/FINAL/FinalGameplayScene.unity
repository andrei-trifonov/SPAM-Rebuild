    - type: 0
      name: 2
      line: "\u0418\u0437 \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u0430 \u043D\u0430\u0447\u0430\u043B\u043E
        \u0447\u0442\u043E-\u0442\u043E \u0432\u044B\u0441\u044B\u043F\u0430\u0442\u044C\u0441\u044F.\n\u0412\u043C\u0435\u0441\u0442\u043E
        \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F,
        \u044F \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0432\u044B\u0448\u043B\u0430
        \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0443\u044E \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443
        \u0438 \u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F
        \u0432 \u043D\u0435\u0431\u043E."
