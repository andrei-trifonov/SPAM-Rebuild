      name: 2
      line: "\u0415\u0433\u043E \u043E\u0433\u043D\u0438, \u0438 \u044D\u0442\u043E\u0442
        \u0441\u0432\u0435\u0436\u0438\u0439 \u0432\u043E\u043B\u043D\u0443\u044E\u0449\u0438\u0439
