    - type: 0
      name: 2
      line: "\u041C\u043E\u0436\u0435\u0442, \"\u041A\u0438\u0440\" \u043D\u0435
        \u0434\u043E\u0436\u0434\u0430\u043B\u0441\u044F. \u041D\u0435\u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u044B\u0439
        \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446... \u041E\u043D\u043E
        \u0438 \u043A \u043B\u0443\u0447\u0448\u0435\u043C\u0443.\r"
