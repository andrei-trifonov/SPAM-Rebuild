    - type: 0
      name: 2
      line: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
        \u0437\u0434\u0435\u0441\u044C \u0445\u043E\u0442\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E-\u0442\u043E
