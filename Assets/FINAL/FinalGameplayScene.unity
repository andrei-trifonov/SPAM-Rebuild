    - type: 0
      name: 2
      line: "\u0421\u043E\u043D\u044F \u0442\u043E\u0447\u043D\u043E \u043D\u0435
        \u043F\u043E\u0432\u0435\u0440\u0438\u0442, \u0447\u0442\u043E \u044F \u043A\u043E\u0433\u043E-\u0442\u043E
        \u0443\u0431\u0438\u043B\u0430 \u0438 \u0437\u0430\u0442\u043E\u043B\u043A\u0430\u043B\u0430
        \u0432 \u0443\u043D\u0438\u0442\u0430\u0437. \u041D\u043E... \u041A\u0430\u043A
        \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043C\u0438\u043B\u0438\u0446\u0438\u0438?
        \u041C\u043E\u0436\u0435\u0442, \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F
        \u043A\u043E\u043C\u0443-\u043D\u0438\u0431\u0443\u0434\u044C, \u0447\u0442\u043E\u0431\u044B
        \u0437\u0430 \u043C\u043D\u043E\u0439 \u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u0438?"
