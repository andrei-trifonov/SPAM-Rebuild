    - type: 0
      name: 2
      line: "\u0421\u043E\u043D\u044F \u0432\u0441\u0442\u0430\u043B\u0430 \u043D\u0430
        \u043A\u043E\u043B\u0435\u043D\u0438 \u0438 \u043F\u0440\u043E\u0441\u0443\u043D\u0443\u043B\u0430
        \u0432 \u0449\u0435\u043B\u044C \u0441\u0432\u043E\u044E \u0440\u0443\u043A\u0443.
        \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0440\u0443\u043A\u0430
        \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u043B\u0430\u0441\u044C \u0432\u0441\u0435
        \u043D\u0438\u0436\u0435 \u0438 \u043D\u0438\u0436\u0435, \u0443\u0436\u0435
        \u0438 \u043A\u0438\u0441\u0442\u044C, \u0438 \u043B\u043E\u043A\u043E\u0442\u044C
        \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0432\u043D\u0443\u0442\u0440\u0438,
        \u0430 \u0434\u043D\u0430 \u0432\u0441\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E."
