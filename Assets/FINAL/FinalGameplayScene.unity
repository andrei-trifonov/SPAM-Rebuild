    - type: 0
      name: 2
      line: "\u042F \u043A\u043E\u0435-\u043A\u0430\u043A \u0441\u043C\u043E\u0433\u043B\u0430
        \u0441\u043E\u0433\u043D\u0443\u0442\u044C \u0440\u0443\u043A\u0443 \u0432
        \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0437\u043D\u0430\u043A
        \u0438 \u043F\u0440\u0438\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A
        \u043B\u0438\u0446\u0443. \u0421\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F?\r\n\u042F
        \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0430\u0441\u044C \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F
        \u0441\u043A\u0432\u043E\u0437\u044C \u0443\u0437\u043A\u0443\u044E \u0440\u0430\u043C\u043A\u0443
        \u043F\u0430\u043B\u044C\u0446\u0435\u0432. "
