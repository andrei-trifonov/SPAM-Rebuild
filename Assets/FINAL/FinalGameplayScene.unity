    - type: 0
      name: 2
      line: "\u041C\u0435\u043D\u044F \u0441\u0442\u043E\u0448\u043D\u0438\u043B\u043E
        \u043F\u0440\u044F\u043C\u043E \u0442\u0443\u0434\u0430, \u043E\u0442\u043A\u0443\u0434\u0430
        \u0442\u043E\u0440\u0447\u0430\u043B\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0430\u044F
        \u0440\u0443\u043A\u0430. \u0421\u043E\u0440\u0432\u0430\u0432 \u0434\u0432\u0435\u0440\u044C
        \u0441 \u043F\u0435\u0442\u0435\u043B\u044C \u044F \u0432\u044B\u043B\u0435\u0442\u0435\u043B\u0430
        \u043D\u0430\u0440\u0443\u0436\u0443, \u0433\u0440\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u0441\u044C
        \u043D\u0430 \u043F\u043E\u043B. \u041F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C,
        \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430\u0441\u044C
        \u043D\u0430 \u043F\u043B\u0438\u0442\u043A\u0435 \u0438 \u0441\u043D\u043E\u0432\u0430
        \u0443\u043F\u0430\u043B\u0430 \u043D\u0430 \u0432\u043B\u0430\u0436\u043D\u0443\u044E
        \u043F\u043B\u0438\u0442\u043A\u0443.\_"
