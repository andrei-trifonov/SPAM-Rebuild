    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[695]
      value: "    mr \"\u0418\u0437 \u0435\u0433\u043E \u043F\u0440\u043E\u043B\u043E\u043C\u043B\u0435\u043D\u043D\u043E\u0439
        \u0433\u043E\u043B\u043E\u0432\u044B \u0442\u0435\u043A\u043B\u0430 \u043A\u0440\u0430\u0441\u043D\u0430\u044F
        \u0436\u0438\u0436\u0430, \u0430 \u0436\u0438\u0432\u043E\u0442 \u0431\u044B\u043B
        \u0440\u0430\u0441\u043F\u043E\u0440\u043E\u0442 \u0432\u043E \u0432\u0441\u044E
        \u0434\u043B\u0438\u043D\u0443, \u0438 \u0438\u0437 \u043D\u0435\u0433\u043E
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0447\u0430\u043B\u0438
        \u0431\u0435\u0437\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
        \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u043A\u0442\u043E-\u0442\u043E
        \u043F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u043B \u0438\u0445 \u0432\u043D\u0443\u0442\u0440\u0438
        \u0442\u0435\u043B\u0430.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[696]
      value: "    mr \"\u041D\u0430 \u0432\u0438\u0434 \u043D\u0435\u043B\u044C\u0437\u044F
        \u0431\u044B\u043B\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E
        \u043E\u043D \u0443\u043C\u0435\u0440 \u043D\u0435\u0434\u0430\u0432\u043D\u043E
        - \u043A\u043E\u0436\u0430 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0430
        \u0441\u0438\u043D\u0435\u0432\u0430\u0442\u044B\u0439, \u0434\u0430\u0436\u0435
        \u0441 \u043F\u0440\u0438\u043C\u0435\u0441\u044C\u044E \u0437\u0435\u043B\u0435\u043D\u043E\u0433\u043E
        \u043E\u0442\u0442\u0435\u043D\u043E\u043A, \u0435\u0433\u043E \u043F\u043E\u0431\u0438\u0442\u043E\u0435
        \u043E\u0441\u043F\u043E\u0439 \u043B\u0438\u0446\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u043E
        \u0435\u0449\u0435 \u0431\u043E\u043B\u0435\u0435 \u043C\u0435\u0440\u0437\u043A\u043E,
        \u0447\u0435\u043C \u043E\u0431\u044B\u0447\u043D\u043E.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[697]
      value: "    mr \"\u041C\u0435\u043D\u044F \u0432\u044B\u0440\u0432\u0430\u043B\u043E
        \u0441\u0440\u0430\u0437\u0443 \u0436\u0435, \u043A\u0430\u043A \u044F \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u0442\u0435\u043B\u043E \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[698]
      value: "    mr \"\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
