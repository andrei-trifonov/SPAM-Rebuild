      name: 2
      line: "\u0411\u043B\u0438\u043D, \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E
        \u043D\u0430 \u043C\u0435\u043D\u044F \u043D\u0430\u0448\u043B\u043E. \u041E\u0442\u043A\u0443\u0434\u0430
