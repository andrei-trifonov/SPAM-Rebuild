    - type: 0
      name: 2
      line: "\u042F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
        \u043E\u0442\u0441\u0442\u0430\u043B\u0430 \u043E\u0442 \u043D\u0435\u0435
        \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C.
