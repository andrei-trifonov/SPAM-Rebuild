    - type: 0
      name: 2
      line: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
        \u043F\u043E\u0442\u0435\u0440\u0442\u043E\u0441\u0442\u0438, \u0432\u044B\u0431\u043E\u0438\u043D\u044B,
        \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043C\u0435\u0442\u0440\u043E\u0432 \u044F \u0435\u0434\u0432\u0430 \u043D\u0435
        \u0437\u0430\u043F\u043D\u0443\u043B\u0430\u0441\u044C \u043E \u043A\u0443\u0441\u043E\u043A
        \u0431\u0435\u0442\u043E\u043D\u0430, \u0441\u0432\u0438\u0441\u0430\u044E\u0449\u0438\u0439
        \u043D\u0430 \u0430\u0440\u043C\u0430\u0442\u0443\u0440\u0435. \u0411\u0443\u0434\u0442\u043E
        \u0431\u044B \u0442\u043E\u043D\u043D\u0435\u043B\u044C \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F
        \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u043A\u043E\u043D\u0446\u0443. "
