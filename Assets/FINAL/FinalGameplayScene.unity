      line: "\u042F \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0430\u0437\u043C\u043E\u0442\u0430\u043B\u0430
        \u0431\u0438\u043D\u0442. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u0441\u043B\u043E\u0439 \u0434\u0430\u043B\u0441\u044F \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
        \u0442\u044F\u0436\u0435\u043B\u043E  - \u0435\u0433\u043E \u0447\u0430\u0441\u0442\u044C
        \u043F\u0440\u0438\u043B\u0438\u043F\u043B\u0430, \u0441\u043A\u043B\u0435\u0438\u043B\u0430\u0441\u044C
        \u0437\u0430\u0441\u043E\u0445\u0448\u0435\u0439 \u043A\u0440\u043E\u0432\u044C\u044E
        \u0438 \u0433\u043D\u043E\u0435\u043C \u0441 \u043A\u043E\u0436\u0435\u0439.
        \u041F\u043E\u0434 \u043C\u0430\u0440\u043B\u0435\u0432\u043E\u0439 \u0442\u043A\u0430\u043D\u044C\u044E
        \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u043B\u0430\u0441\u044C \u0433\u043D\u0438\u044E\u0449\u0430\u044F
        \u043F\u043B\u043E\u0442\u044C, \u043F\u043E\u043A\u0440\u044B\u0442\u0430\u044F
        \u0436\u0435\u043B\u0442\u044B\u043C\u0438 \u0432\u043E\u043B\u0434\u044B\u0440\u044F\u043C\u0438. "
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
