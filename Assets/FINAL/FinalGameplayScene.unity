    - type: 0
      name: 2
      line: "\u041C\u044B \u043F\u043E\u043F\u0440\u043E\u0449\u0430\u043B\u0438\u0441\u044C
        \u0441 \u041A\u0438\u0440\u043E\u043C, \u0438 \u044F \u043F\u043E\u0442\u043E\u043F\u0430\u043B\u0430
        \u0434\u043E\u043C\u043E\u0439 \u043F\u043E \u0441\u044B\u0440\u043E\u0439
        \u0443\u043B\u0438\u0446\u0435. \u0417\u043D\u0430\u043A\u043E\u043C\u044B\u0435
        \u043E\u0433\u043D\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438
