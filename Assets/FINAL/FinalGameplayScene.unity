    - type: 0
      name: 4
      line: "-\u041D\u0443 \u0434\u0430. \u0422\u0435\u0431\u0435 \u043F\u0430\u043C\u044F\u0442\u044C
        \u0447\u0442\u043E \u043B\u0438 \u043E\u0442\u0448\u0438\u0431\u043B\u043E?
        \u0422\u044B \"\u0441\u043E\u043B\u043D\u044B\u0448\u043A\u043E\" \u043D\u0430
        \u043A\u0430\u0447\u0435\u043B\u044F\u0445 \u0434\u0435\u043B\u0430\u043B\u0430,
        \u043E\u043D\u0438 \u0438 \u043E\u0442\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044C.
        \u041D\u0443 \u0447\u0442\u043E, \u0438\u0434\u0435\u043C \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0447\u043A\u0443?
        \u0422\u0435\u0431\u044F \u0442\u043E\u0448\u043D\u0438\u0442? \u0413\u043E\u043B\u043E\u0432\u0430
