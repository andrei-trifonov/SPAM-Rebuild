    - type: 0
      name: 2
      line: "\u041A\u043E\u0435-\u043A\u0430\u043A \u043C\u044B \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C,
        \u0447\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0435\u043C \u043C\u0430\u043A\u0430\u0440\u043E\u043D\u044B
        \u0441 \u0441\u043E\u0441\u0438\u0441\u043A\u0430\u043C\u0438. \u0414\u0430,
        \u043C\u043E\u0436\u0435\u0442, \u043F\u0440\u043E\u0441\u0442\u043E\u0435
        \u0431\u043B\u044E\u0434\u043E, \u043D\u043E \u0438 \u044F \u043D\u0435 \u0448\u0435\u0444-\u043F\u043E\u0432\u0430\u0440."
