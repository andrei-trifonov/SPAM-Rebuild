      propertyPath: scenarioBlock.Array.data[259]
      value: "    mr \"\u042F \u0441\u0435\u043B\u0430 \u043D\u0430 \u043A\u0440\u043E\u0432\u0430\u0442\u044C,
        \u0430 \u041C\u0438\u0448\u0430 \u043F\u043E\u043B\u043E\u0436\u0438\u043B
        \u0433\u043E\u043B\u043E\u0432\u0443 \u043C\u043D\u0435 \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438
        \u0438 \u0437\u0430\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[260]
      value: "    mr \"\u041F\u043E\u0447\u0435\u043C\u0443 \u043C\u043D\u0435 \u0442\u0430\u043A
        \u043E\u0434\u0438\u043D\u043E\u043A\u043E? \u041F\u043E\u0447\u0435\u043C\u0443
        \u043C\u0435\u043D\u044F \u044D\u0442\u043E \u0432\u043E\u043B\u043D\u0443\u0435\u0442?
        \u0413\u0434\u0435 \u043C\u043D\u0435 \u043D\u0430\u0439\u0442\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438\u0437\u0431\u0430\u0432\u0438\u043B
        \u0431\u044B \u043C\u0435\u043D\u044F \u043E\u0442 \u044D\u0442\u043E\u0439
        \u0443\u0436\u0430\u0441\u043D\u043E\u0439 \u0442\u043E\u0441\u043A\u0438?
        \u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u043B\u0430\u0431\u0430\u044F,
        \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u0442\u044C
        \u0435\u0439.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[261]
      value: "    mr \"\u041C\u0438\u0448\u0430, \u044F \u0443\u0431\u0438\u0432\u0430\u044E
        \u0442\u0435\u0431\u044F. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
        \u0438 \u0432\u043D\u0443\u0442\u0440\u0438\u0432\u0435\u043D\u043D\u043E.
        \u042D\u0442\u043E \u0432\u0435\u0434\u044C \u0438\u0437-\u0437\u0430 \u043C\u0435\u043D\u044F
        \u0442\u044B \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0447\u0430\u043B
        \u043A\u043E\u043B\u043E\u0442\u044C\u0441\u044F? \u041A\u043E\u043D\u0435\u0447\u043D\u043E
        \u0438\u0437-\u0437\u0430 \u043C\u0435\u043D\u044F.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[262]
      value: "    mr \"\u041F\u0440\u043E\u0441\u0442\u0438, \u044F \u043D\u0435
        \u043C\u043E\u0433\u0443 \u043D\u0438\u0447\u0435\u0433\u043E \u0441 \u0441\u043E\u0431\u043E\u0439
        \u043F\u043E\u0434\u0435\u043B\u0430\u0442\u044C. \u0427\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435
        \u0432\u0441\u0435 \u044D\u0442\u043E \u0442\u044F\u043D\u0435\u0442\u0441\u044F,
        \u0442\u0435\u043C \u0432\u0441\u0435 \u0435\u0449\u0435 \u0445\u0443\u0436\u0435.
        \u041F\u0440\u043E\u0441\u0442\u0438. \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0433\u0440\u0443\u0441\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0441\u044A\u0435\u043B\u0430 \u043C\u043E\u0439 \u043C\u043E\u0437\u0433.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[263]
      value: "    mr \"\u041E\u043D \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
        \u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F
        \u0445\u043E\u0442\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0438
        \u0437\u0434\u0440\u0430\u0432\u043E \u043C\u044B\u0441\u043B\u0438\u0442\u044C.
        \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E \u043C\u0435\u043D\u044F
        \u0440\u0430\u0434\u0443\u0435\u0442 - \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0432\u0441\u0435 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[264]
      value: "    mr \"\u041D\u0430\u0434\u043E \u0436\u0435, \u0445\u0440\u0430\u043F\u0438\u0442.
        \u0417\u0430\u0441\u043D\u0443\u043B \u0443 \u043C\u0435\u043D\u044F \u043D\u0430
        \u043A\u043E\u043B\u0435\u043D\u044F\u0445. \u0422\u043E\u043B\u044C\u043A\u043E
        \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u043B\u043E.
        \u042F \u0432\u043E\u043E\u0431\u0449\u0435-\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044C
        \u043F\u043E\u0441\u043F\u0430\u0442\u044C! \u041B\u0430\u0434\u043D\u043E,
        \u043F\u0443\u0441\u0442\u044C \u043F\u043E\u043B\u0435\u0436\u0438\u0442,
        \u043F\u043E\u043A\u0430 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435 \u0437\u0430\u0442\u0435\u043A\u0443\u0442
        \u043D\u043E\u0433\u0438.\"\r"
