    - type: 0
      name: 2
      line: "\u041D\u0430 \u0434\u0432\u0435\u0440\u0438 \u0441\u043B\u0435\u0434\u044B,
        \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0432\u044B\u0440\u0432\u0430\u043B
        \u0437\u0430\u043C\u043E\u043A, \u0430 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B
        \u0435\u0433\u043E \u043A\u043B\u044E\u0447\u043E\u043C. \u0417\u043D\u0430\u0447\u0438\u0442,
