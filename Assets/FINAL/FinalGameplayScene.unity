    - type: 0
      name: 5
      line: "-\u0410 \u044F... \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0434\u0430\u0432\u043D\u043E
        \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B \u0441\u044E\u0434\u0430.
        \u041D\u0430 \u044D\u0442\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435.
        \u0412\u043E\u0442, \u043C\u0435\u043D\u044F \u043F\u0440\u0438\u043D\u044F\u043B\u0438
        \u0432 \u0442\u0432\u043E\u044E \u0448\u043A\u043E\u043B\u0443, \u0438 \u044F...
        \u0420\u0435\u0448\u0438\u043B \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F.\r"
