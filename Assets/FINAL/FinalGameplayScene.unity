    - type: 0
      name: 2
      line: "\u0411\u043B\u0438\u043D, \u043F\u043E\u0447\u0435\u043C\u0443 \u0441\u043E
        \u043C\u043D\u043E\u0439 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
        \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0445\u0443\u0439\u043D\u044F.
        \u0422\u0430\u043A\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E,
        \u0431\u0443\u0434\u0442\u043E \u043F\u0430\u0440\u0443 \u0434\u043D\u0435\u0439
        \u043D\u0430\u0437\u0430\u0434 \u0447\u0442\u043E-\u0442\u043E \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u043E,
        \u0438 \u0441\u043A\u0432\u043E\u0437\u044C \u044D\u0442\u0443 \u0441\u0430\u043C\u0443\u044E
        \u0442\u0440\u0435\u0449\u0438\u043D\u0443 \u0432 \u043C\u043E\u044E \u0436\u0438\u0437\u043D\u044C
        \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0442 \u0432\u0441\u0435
        \u043D\u043E\u0432\u044B\u0435 \u0438 \u043D\u043E\u0432\u044B\u0435 \u043D\u0435\u0443\u0434\u0430\u0447\u0438.
        \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044D\u0442\u043E \u043D\u0435
        \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
