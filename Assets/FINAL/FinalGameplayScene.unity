    - type: 0
      name: 0
      line: "void \u041F\u043E\u0437\u043D\u0430\u0442\u044C\u0441\u044F\u0421\u0443\u0434\u044C\u0431\u0443(\u043C\u044F\u0441\u043E-\u043C\u0430\u0448\u0438\u043D\u0430*
        \u043C\u0430\u0448\u0438\u043D\u0430) {\n\_\_\_ //\u043A\u043E\u043C\u043C\u0435\u043D\u0442:
        \u043D\u043E \u0434\u0430\u0436\u0435 \u0432 \u044D\u0442\u043E\u043C \u0443\u0435\u0434\u0438\u043D\u0435\u043D\u043D\u043E\u043C
        \u043E\u0430\u0437\u0438\u0441\u0435 \u043E\u043D\u0430 \u043E\u0441\u043E\u0437\u043D\u0430\u0435\u0442
        \u043D\u0435\u0438\u0437\u0431\u0435\u0436\u043D\u0443\u044E \u0441\u0443\u0434\u044C\u0431\u0443
        - \u043D\u0430\u0432\u0435\u0447\u043D\u043E \u0437\u0430\u043F\u0435\u0440\u0442\u043E\u0439
        \u0432 \u0441\u0435\u0442\u0438 \u0441\u0432\u043E\u0438\u0445 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u043E\u0432,
        \u043F\u043B\u0435\u043D\u043D\u0438\u0446\u0435\u0439 \u0441\u0432\u043E\u0438\u0445
        \u043C\u044B\u0441\u043B\u0435\u0439\n\_\_\_ \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
        \u043E\u0442\u0440\u0438\u0446\u0430\u043D\u0438\u0435 = \u0438\u0441\u0442\u0438\u043D\u0430;\n\_\_\_
        \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0437\u043B\u043E\u0441\u0442\u044C
        = \u0438\u0441\u0442\u0438\u043D\u0430;\n\_\_\_ \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
        \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F = \u0438\u0441\u0442\u0438\u043D\u0430;\n"
