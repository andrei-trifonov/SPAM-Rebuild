    - type: 0
      name: 2
      line: "\u041C\u0443\u0440\u043B\u044B\u043A\u043D\u0443\u043B \u043A\u043E\u0442,
        \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F
        \u043A\u043E\u0433\u0442\u0438\u0441\u0442\u044B\u043C\u0438 \u043B\u0430\u043F\u0430\u043C\u0438
        \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u0443\u044E \u0448\u0435\u0440\u0441\u0442\u044C,
        \u0431\u0443\u0434\u0442\u043E \u043E\u0442\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u044F
        \u0441\u0432\u043E\u0439 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
        \u043A\u043E\u0441\u0442\u044E\u043C. "
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
