    - type: 0
      name: 2
      line: "\u042F \u043D\u0435 \u0440\u0430\u0437\u0434\u0443\u043C\u044B\u0432\u0430\u044F
        \u0432\u044B\u0445\u0432\u0430\u0442\u0438\u043B\u0430 \u0438 \u043E\u0442\u043A\u0443\u0441\u0438\u043B\u0430
        \u043A\u0443\u0441\u043E\u043A \u043A\u0440\u0443\u0433\u043B\u043E\u0433\u043E,
        \u043F\u0443\u0445\u043B\u043E\u0433\u043E \u043F\u0438\u0440\u043E\u0433\u0430.
        \n\u0412\u043A\u0443\u0441 \u043A\u0430\u043F\u0443\u0441\u0442\u044B \u0438 
