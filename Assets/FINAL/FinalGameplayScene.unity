      propertyPath: scenarioBlock.Array.data[585]
      value: "    narrator \"\u042F \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
        \u0438 \u043F\u043E\u0431\u0440\u0435\u043B\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E.
        \u0412 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043C\u043E\u043C\u0435\u043D\u0442
        \u043C\u043E\u0438 \u0448\u0430\u0433\u0438 \u0431\u0443\u0434\u0442\u043E
        \u0431\u044B \u043E\u0431\u0440\u0435\u043B\u0438 \u0435\u0449\u0435 \u043E\u0434\u043D\u043E
        \u044D\u0445\u043E, \u0438 \u044F \u0432 \u043E\u0446\u0435\u043F\u0435\u043D\u0435\u043D\u0438\u0438
