    - type: 0
      name: 2
      line: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u0430\u043C\u044B\u0439
        \u0440\u0430\u0437\u0433\u0430\u0440 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430.
        \u0425\u043E\u0440\u043E\u0432\u043E\u0434\u044B \u0443 \u043A\u043E\u0441\u0442\u0440\u043E\u0432,
        \u0444\u043E\u043D\u0430\u0440\u0438, \u043C\u0435\u0441\u0442\u043D\u0430\u044F
        \u043C\u0443\u0437\u044B\u043A\u0430, \u0441\u043B\u043E\u043D\u044F\u044E\u0449\u0438\u0435\u0441\u044F
        \u043F\u044C\u044F\u043D\u044B\u0435 \u0441\u0442\u0430\u0438, \u0431\u043B\u0435\u0432\u043E\u0442\u0438\u043D\u0430,
        \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0438 \u0440\u0435\u043A\u0438
        \u043A\u0440\u043E\u0432\u0438. \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u0432\u0440\u0435\u043C\u044F!"
