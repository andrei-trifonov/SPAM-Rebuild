    - type: 0
      name: 2
      line: "\u042D\u0442\u043E \u0434\u043E\u0436\u0434\u044C \u0438\u0437 \u043B\u0438\u0441\u0442\u043E\u0447\u043A\u043E\u0432
        \u0431\u0443\u043C\u0430\u0433\u0438.  \u0421\u043E\u0442\u043D\u0438 \u043B\u0438\u0441\u0442\u043E\u0432\u043E\u043A
        \u043F\u043E\u0440\u0445\u0430\u043B\u0438 \u0432\u0441\u043B\u0435\u0434
        \u0437\u0430 \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u043E\u043C, \u043E\u0442\u0434\u0435\u043B\u044F\u043B\u0438\u0441\u044C
        \u043E\u0442  \u0441\u0442\u0430\u0438 \u0438  \u0441\u0430\u0434\u0438\u043B\u0438\u0441\u044C
        \u043D\u0430 \u043A\u0440\u044B\u0448\u0438, \u0432\u044B\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
        \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443, \u0442\u043E\u043D\u0443\u043B\u0438
        \u0432  \u043B\u0443\u0436\u0430\u0445."
