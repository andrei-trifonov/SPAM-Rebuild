    - type: 0
      name: 2
      line: "\u041C\u044B \u0441 \u0421\u043E\u043D\u0435\u0439 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C,
