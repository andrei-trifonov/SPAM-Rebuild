    - type: 0
      name: 2
      line: "\u041E\u0433\u043D\u044E \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E,
        \u0447\u0442\u043E \u0441\u043E\u0436\u0440\u0430\u0442\u044C - \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u043A\u043E\u0435
        \u0442\u0435\u043B\u043E, \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
        \u0441\u043E\u043B\u043E\u043C\u0443. "
