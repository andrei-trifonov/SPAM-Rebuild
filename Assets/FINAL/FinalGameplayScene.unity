    - type: 0
      name: 2
      line: "\u041E\u043D \u043F\u043E\u0434\u043D\u044F\u043B \u0432\u0437\u0433\u043B\u044F\u0434
        \u043D\u0430 \u043A\u0440\u0438\u0447\u0430\u0449\u0443\u044E \u0421\u043E\u043D\u044E,
        \u0438 \u043C\u044B \u043D\u0435\u043B\u043E\u0432\u043A\u043E \u043F\u043E\u0434\u043E\u0448\u043B\u0438
        \u043A \u043B\u0430\u0432\u043A\u0435, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
        \u0441\u0438\u0434\u0435\u043B \u0431\u043E\u0440\u043E\u0434\u0430\u0442\u044B\u0439
        \u0434\u0435\u0434 \u0432 \u0447\u0451\u0440\u043D\u043E\u0439 \u0440\u044F\u0441\u0435.
        \u041E\u0442 \u043D\u0435\u0433\u043E \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E
        \u043F\u0430\u0445\u043B\u043E. "
