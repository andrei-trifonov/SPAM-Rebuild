      line: "\u0410\u043B\u0438\u043D\u0430 \u043B\u043E\u0432\u043A\u043E \u043F\u0440\u043E\u0448\u043B\u0430\u0441\u044C
        \u043F\u043E \u0441\u043F\u0438\u0446\u0430\u043C \u043A \u043F\u0435\u0440\u0432\u043E\u0439
        \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0432\u0435\u0442\u0432\u0438,
        \u043E\u0431\u0445\u0432\u0430\u0442\u0438\u043B\u0430 \u0435\u0435 \u0440\u0443\u043A\u0430\u043C\u0438,
