    - type: 0
      name: 5
      line: "-\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E, \u044D\u0442\u043E\u0442
        \u0434\u0435\u043D\u044C \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
        \u0425\u043E\u0440\u043E\u0448\u043E \u0442\u043E, \u0447\u0442\u043E...
