    - type: 0
      name: 2
      line: "\u041A\u0438\u0440 \u043F\u043E\u0434\u043E\u0448\u0435\u043B \u0441\u043E\u0432\u0441\u0435\u043C
        \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E, \u044F \u0434\u0430\u0436\u0435
        \u043D\u0435 \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0437\u0432\u0443\u043A\u0430
        \u0448\u0430\u0433\u043E\u0432.\r\n"
      font: 0
      inv: 0
