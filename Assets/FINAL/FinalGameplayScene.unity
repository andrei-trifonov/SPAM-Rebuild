    - type: 0
      name: 0
      line: "// \u043C\u043E\u0439_\u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B.\u043A\u0440\u0435\u043C\u043D\u0438\u0435\u0432\u043E\u0435
        \u0441\u0435\u0440\u0434\u0446\u0435 \u0431\u044C\u0435\u0442\u0441\u044F.
        #\u0437\u0430\u0434\u0430\u0442\u044C \u0411\u0418\u0422\u042B = \u0421\u041E\u0413\u041B\u0410\u0421\u0418\u0415
        \u0441\u0438\u0440\u0435\u043D\u044B-> \u0433\u043E\u0440\u043E\u0434\u0430,
        \u0433\u0434\u0435 \n\u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E(\u043F\u0438\u043A\u0441\u0435\u043B\u044C,
        \u043A\u0440\u043E\u0432\u044C){ - \u043A\u0430\u043F\u043B\u044F \u043A\u0440\u043E\u0432\u0438,
        \u043A\u0430\u0436\u0434\u044B\u0439 \u0431\u0430\u0439\u0442 - \u043A\u0440\u0438\u043A
        \u0434\u0443\u0448\u0438 == \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435.\u0434\u0442\u0430\u043F\u043E\u0432\u0430\u043D\u0438\u0435)"
