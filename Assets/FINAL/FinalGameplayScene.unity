        \u043B\u044E\u0434\u0438 \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u043C\u0435\u0436\u0434\u0443
        \u0441\u043E\u0431\u043E\u0439, \u043A\u0430\u043A\u0438\u0435 \u0431\u044B
        \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0438\u0445
