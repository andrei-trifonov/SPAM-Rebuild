    - type: 2
      name: 0
      line: "\u041C\u044B \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438,
        \u043A\u0430\u043A \u0434\u043E\u0448\u043B\u0438 \u0434\u043E \u0432\u043E\u0440\u043E\u0442
        \u0432 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043F\u0430\u0440\u043A.
        \u0421\u0435\u0439\u0447\u0430\u0441 \u043E\u043D \u043E\u0442\u043A\u0440\u044B\u0442.\r\n"
