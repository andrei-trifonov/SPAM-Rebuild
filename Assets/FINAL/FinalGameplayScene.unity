    - type: 0
      name: 2
      line: "\u041C\u044B \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u0431\u043E\u043B\u0442\u0430\u043B\u0438
        \u0441 \u0421\u043E\u043D\u0435\u0439 \u043D\u0438 \u043E \u0447\u0435\u043C.
        \u042F \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
        \u0446\u0435\u043B\u0443\u044E \u0433\u043E\u0440\u0443 \u0441\u043A\u0440\u044B\u0442\u044B\u0445
        \u0444\u043E\u0440\u0443\u043C\u043E\u0432 \u0438 \u0441\u0442\u0440\u0430\u043D\u0438\u0446,
        \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u043E\u043B\u043E\u0441\u044B
        \u0432\u0441\u0442\u0430\u0432\u0430\u043B\u0438 \u0434\u044B\u0431\u043E\u043C.
        \u041F\u043E\u0434 \u0443\u0442\u0440\u043E \u0433\u043B\u0430\u0437\u0430
        \u0443\u0436\u0435 \u0435\u0434\u0432\u0430 \u0440\u0430\u0437\u043B\u0438\u043F\u0430\u043B\u0438\u0441\u044C
        \u043E\u0442 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438."
