    - type: 0
      name: 2
      line: "\u041F\u0440\u043E\u0433\u0440\u0443\u0436\u0430\u044E\u0449\u0430\u044F\u0441\u044F
        \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u043B\u0430
        \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443 \u0437\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u043E\u0439,
        \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438\u0441\u044C
        \u043A\u043E\u0442\u044F\u0442\u0430 \u0432\u0441\u0435\u0445 \u0444\u043E\u0440\u043C
        \u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u0432, \u043F\u0443\u0448\u0438\u0441\u0442\u044B\u0435
        \u0438 \u0433\u043B\u0430\u0434\u043A\u0438\u0435, \u0438 \u0434\u0430\u0436\u0435
        \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u0433\u043E\u043B\u044B\u0435. "
