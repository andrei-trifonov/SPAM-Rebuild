    - type: 0
      name: 2
      line: "\u042F - \u0447\u0430\u0441\u0442\u044C \u044D\u0442\u043E\u0433\u043E
        \u0445\u0430\u043E\u0441\u0430, \u0447\u0430\u0441\u0442\u044C \u044D\u0442\u043E\u0439
        \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439 \u043C\u0430\u0442\u0440\u0438\u0446\u044B,
        \u0447\u0430\u0441\u0442\u044C \u044D\u0442\u043E\u0433\u043E \u0448\u0443\u043C\u0430.
        \u042F \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0443 \u0444\u043E\u0440\u0443\u043C\u0430\u043C
        \u0438 \u0447\u0430\u0442\u0430\u043C, \u044D\u0442\u0438\u043C \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u043C
        \u0432\u0435\u0431-\u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u043C
        \u0438 \u044D\u043D\u0446\u0438\u043A\u043B\u043E\u043F\u0435\u0434\u0438\u044F\u043C."
