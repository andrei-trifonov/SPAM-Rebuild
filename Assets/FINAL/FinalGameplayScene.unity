    - type: 0
      name: 2
      line: "\u0428\u043A\u043E\u043B\u0430 \u0431\u044B\u043B\u0430 \u043F\u043E\u0447\u0442\u0438
        \u043F\u0443\u0441\u0442\u0430. \u0412\u043E \u0434\u0432\u043E\u0440\u0435
        \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E,
        \u0430 \u0438\u0437 \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u0432 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
        \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435, \u043A\u043E\u0433\u043E
        \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
        \u043F\u043E\u0441\u043B\u0435 \u0443\u0440\u043E\u043A\u043E\u0432.  \n"
