    - type: 0
      name: 2
      line: "\u0418\u0437 \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u043E\u0432
        \u043F\u043E\u043B\u0438\u043B\u0430\u0441\u044C \u043C\u0443\u0437\u044B\u043A\u0430...
        \u042F \u043D\u0435 \u0441\u0438\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E\u0441\u044C
        \u0432 \u0436\u0430\u043D\u0440\u0430\u0445, \u043D\u043E, \u043C\u043D\u0435
        \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u044D\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F...
        \u043F\u043E\u0441\u0442-\u043F\u0430\u043D\u043A? \u041F\u0443\u0441\u0442\u044C
        \u0438 \u0442\u0430\u043A\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u0440\u0430\u0437\u043D\u044B\u0445 \u043F\u0440\u0438\u043C\u043E\u0447\u0435\u043A
