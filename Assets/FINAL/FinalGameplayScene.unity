    - type: 0
      name: 2
      line: "\u041A\u043E\u043C\u043F\u043B\u0438\u043C\u0435\u043D\u0442 \u043E\u0442
        \u0410\u043B\u0438 \u043C\u0435\u043D\u044F \u043F\u043E\u0434\u0431\u043E\u0434\u0440\u0438\u043B,
        \u0438 \u044F, \u0434\u0435\u0440\u0436\u0430\u0441\u044C \u0437\u0430 \u0442\u043E\u0440\u0447\u0430\u0449\u0438\u0435
        \u0449\u0435\u043F\u043A\u0438 \u043A\u043E\u0440\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0430\u0441\u044C
        \u0434\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0438 \u0442\u0440\u0435\u0442\u044C\u0435\u0439
        \u0441\u043F\u0438\u0446\u044B, \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0432
        \u0434\u044B\u0445\u0430\u043D\u0438\u0435."
