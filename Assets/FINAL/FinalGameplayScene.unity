    - type: 0
      name: 2
      line: "\u0428\u043B\u0435\u043F\u043A\u0438 \u043F\u043E\u0434\u043E\u0448\u0432
        \u0433\u0443\u043B\u043A\u043E \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F
        \u043E\u0442 \u0441\u0442\u0435\u043D. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E,
        \u043A\u0443\u0434\u0430 \u044D\u0442\u043E \u044F \u0438\u0434\u0443...
        \u0412\u0441\u0435 \u0442\u0435\u043C\u043D\u0435\u0435 \u0438 \u0442\u0435\u043C\u043D\u0435\u0435. "
