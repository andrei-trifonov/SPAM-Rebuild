    - type: 0
      name: 2
      line: "\u0418\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u043A \u043D\u0430\u043C
        \u0432\u044B\u0448\u0435\u043B \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
        \u0441\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u043A
        \u0441 \u043D\u0435\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438
        \u0443\u0437\u043A\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
        \u0438 \u0443\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F \u043D\u0430
        \u043C\u0435\u043D\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u043E \u0438
        \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u043D\u043E."
