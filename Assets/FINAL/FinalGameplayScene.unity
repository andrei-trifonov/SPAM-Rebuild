    - type: 0
      name: 2
      line: "\u0421\u043E\u043D\u044F \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
        \u0438 \u043F\u043E\u0442\u043E\u043F\u0430\u043B\u0430 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
        \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u043D\u043E\u0433\u043E \u0441\u043E\u043B\u043D\u0446\u0430,
        \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438
        \u043A \u043F\u043E\u0434\u0436\u043E\u0433\u0443. \u0412\u043E\u043A\u0440\u0443\u0433
        \u0433\u0440\u0443\u0434\u044B \u0441\u0435\u043D\u0430 \u0432 \u0444\u043E\u0440\u043C\u0435
        \u043A\u0440\u0443\u0433\u0430 \u0432\u044B\u0441\u0442\u0440\u043E\u0438\u043B\u0430\u0441\u044C
        \u0446\u0435\u043B\u0430\u044F \u0442\u043E\u043B\u043F\u0430, \u0438 \u0421\u043E\u043D\u044F
        \u0432 \u043D\u0435\u0439 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430\u0441\u044C."
