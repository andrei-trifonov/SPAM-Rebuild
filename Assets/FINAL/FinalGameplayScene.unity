    - type: 0
      name: 2
      line: "\u041D\u0443\u0436\u043D\u043E \u0441\u0440\u043E\u0447\u043D\u043E
        \u0432\u0437\u044F\u0442\u044C \u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C,
        \u043F\u043E\u043A\u0430 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B.\r\n\u042F
        \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0430 \u0432\u0435\u0449\u0438\u0446\u0443
        \u0438 \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D,
        \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C
        \u043A \u0432\u044B\u0445\u043E\u0434\u0443.\r\n"
