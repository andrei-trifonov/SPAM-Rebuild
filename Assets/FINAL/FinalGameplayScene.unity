      name: 2
      line: "\u041C\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
        \u043D\u0430 \u043A\u0440\u044B\u0448\u0435 \u0411\u0430\u0448\u043D\u0438.
        \u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B\u0430
        \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u043D\u044C\u0448\u0435 - \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430
