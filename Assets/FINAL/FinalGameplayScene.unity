    - type: 0
      name: 2
      line: "\u0411\u043B\u0438\u043D, \u044F \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E
        \u043D\u0435 \u0442\u0430\u043D\u0446\u0443\u044E. \u0410 \u0441\u0435\u0439\u0447\u0430\u0441,
        \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
        \u043C\u0435\u043D\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E
