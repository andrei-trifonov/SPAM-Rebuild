    - type: 0
      name: 2
      line: "\u0411\u0435\u0437\u0443\u043C\u043D\u044B\u0439 \u043A\u0440\u0438\u043A
        \u0431\u043E\u043B\u0438 \u0447\u0443\u0442\u044C \u043B\u0438 \u043D\u0435
        \u0440\u0432\u0435\u0442 \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u043D\u044B\u0435
        \u043F\u0435\u0440\u0435\u043F\u043E\u043D\u043A\u0438 \u0438 \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u0442
