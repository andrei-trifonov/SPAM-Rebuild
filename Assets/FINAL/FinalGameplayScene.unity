    - type: 0
      name: 2
      line: "\u041E\u0442 \u044D\u0442\u043E\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430
        \u044F \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430,
        \u0431\u0443\u0434\u0442\u043E \u043C\u043E\u044F \u0434\u0443\u0448\u0430
        \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u043A\u0443\u0434\u0430-\u0442\u043E
        \u043D\u0430\u0437\u0430\u0434, \u0430 \u0432 \u0433\u0440\u0443\u0434\u0438
        \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
        \u0447\u0435\u0440\u043D\u0430\u044F \u0434\u044B\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
