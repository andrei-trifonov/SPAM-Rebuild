    - type: 0
      name: 2
      line: "\u041B\u0430\u0434\u043D\u043E, \u043A \u0447\u0435\u0440\u0442\u0443,
        \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C  \u043D\u0435
        \u0434\u0443\u043C\u0430\u0442\u044C \u043D\u0438 \u043E \u0447\u0435\u043C,
        \u043A \u0442\u043E\u043C\u0443 \u0436\u0435  \u0435\u0441\u0442\u044C \u0435\u0449\u0435
        \u043F\u0430\u0440\u0430 \u0447\u0430\u0441\u043E\u0432. \u042F \u043E\u0442\u043A\u0440\u044B\u043B\u0430
        \u0441\u043F\u0438\u0441\u043E\u043A \u0441\u0442\u0440\u0430\u043D\u0438\u0446.
        \u0421\u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437\u043D\u044B\u0445
        \u0441\u0441\u044B\u043B\u043E\u043A, \u043D\u0435 \u0437\u043D\u0430\u044E
        \u0434\u0430\u0436\u0435, \u0447\u0442\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C. "
