      propertyPath: scenarioBlock.Array.data[571]
      value: "    mr \"\u042F \u0441\u0430\u043C\u0430 \u0438\u0445 \u0438 \u0441\u043E\u0437\u0434\u0430\u044E.
        \u041F\u043E\u0442\u043E\u043C \u043F\u044B\u0442\u0430\u044E\u0441\u044C
