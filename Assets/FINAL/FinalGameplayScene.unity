    - type: 0
      name: 2
      line: "\u0412\u043E\u0442 \u0438 \u0434\u044B\u0440\u044F\u0432\u044B\u0439
        \u0448\u043A\u043E\u043B\u044C\u043D\u044B\u0439 \u0437\u0430\u0431\u043E\u0440.
        \u0415\u0433\u043E, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
        \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043D\u0430 \u0432\u0440\u0435\u043C\u044F
        \u0437\u0430\u043D\u044F\u0442\u0438\u0439, \u043D\u043E \u043C\u044B \u043D\u0435
