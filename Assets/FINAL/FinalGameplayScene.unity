    - type: 0
      name: 4
      line: "-\u0412 \u0442\u0435\u043E\u0440\u0438\u0438...  \u0415\u0441\u043B\u0438
        \u0431\u044B \u0442\u044B \u0432\u0432\u0435\u043B\u0430 \u0441\u0432\u043E\u0439
        \u043D\u0438\u043A\u043D\u0435\u0439\u043C \u043D\u0430 \u043A\u0430\u043A\u043E\u0439-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0441\u0442\u0440\u0430\u043D\u0438\u0447\u043A\u0435, \u043E\u043D \u043C\u043E\u0433
        \u0431\u044B \u0435\u0433\u043E \u0443\u043A\u0440\u0430\u0441\u0442\u044C...
        \u041D\u043E \u044D\u0442\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
        \u0432\u0435\u0434\u044C \u043E\u043D \u0442\u0435\u0431\u0435 \u0441\u0440\u0430\u0437\u0443
        \u0436\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u043B, \u043A\u0430\u043A
        \u0442\u044B \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u0432
        \u0421\u0435\u0442\u0438."
