    - type: 0
      name: 2
      line: "\u0421\u0434\u0435\u043B\u0430\u0432 \u043A\u0440\u0443\u0433 \u043F\u043E
        \u043F\u043B\u043E\u0449\u0430\u0434\u0438, \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C
        \u043F\u043E\u0434\u043E\u0448\u0435\u043B \u043A\u043E \u043C\u043D\u0435."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
      additionalPose: 
      music: 0
