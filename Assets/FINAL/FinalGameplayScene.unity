      line: "-\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E,
        \u0447\u0442\u043E \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u044D\u0442\u0438
        \u0438\u043D\u044A\u0435\u043A\u0442\u043E\u0440\u044B - \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C
        - \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E.
        \u041F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0439
        \u0442\u0430\u043A \u0431\u043E\u043B\u044C\u0448\u0435. \u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C?\r\n"
