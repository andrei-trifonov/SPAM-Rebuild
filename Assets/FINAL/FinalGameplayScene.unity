    - type: 0
      name: 2
      line: "\u0412\u043E \u043C\u043D\u0435 \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u043B\u0441\u044F
        \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043E\u0441\u043E\u0431\u044B\u0439
        \u0430\u0437\u0430\u0440\u0442, \u043E\u0442\u0447\u0435\u0433\u043E \u044F
        \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430 \u0434\u043E\u0440\u043E\u0433\u0443
        \u0434\u043E \u0448\u043A\u043E\u043B\u044B, \u043E\u0442\u043A\u0440\u044B\u043B\u0430
        \u0433\u043B\u0430\u0437\u0430, \u0438 \u0432\u043E\u0442, \u043F\u0435\u0440\u0435\u0434
        \u043D\u0430\u043C\u0438 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u0447\u043D\u044B\u0439
        \u043A\u043E\u0440\u043F\u0443\u0441."
