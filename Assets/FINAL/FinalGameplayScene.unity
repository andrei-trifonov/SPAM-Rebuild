    - type: 0
      name: 2
      line: "\u041C\u043E\u0436\u0435\u0442, \u044F \u0447\u0442\u043E-\u0442\u043E
        \u043D\u0435 \u0442\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u043B\u0430?
        \u0418 \u0447\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u0434\u043E\u043B\u0436\u043D\u043E
        \u0431\u044B\u043B\u043E \u0441\u043B\u0443\u0447\u0438\u0442\u044C\u0441\u044F?\r\n\u041C\u043D\u0435
        \u0441\u0442\u0440\u0430\u0448\u043D\u043E.  \u0422\u0435\u043C\u043D\u043E\u0442\u0430
        \u043F\u043E\u0432\u0441\u044E\u0434\u0443. \u042F \u043D\u0435 \u0432\u0438\u0436\u0443
        \u043D\u0438 \u0440\u0443\u043A, \u043D\u0438 \u043D\u043E\u0433\u2026 \r\n"
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
