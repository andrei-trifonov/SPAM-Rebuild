    - type: 8
      name: 2
      line: "\u041D\u0435\u0442, \u043C\u0435\u043D\u044F \u043E\u0431\u043D\u0438\u043C\u0430\u043B
        \u043D\u0435 \u041A\u0438\u0440, \u0430 \u0432\u0441\u0435 \u0442\u043E \u0436\u0435
        \u0440\u0430\u0437\u0440\u0435\u0436\u0435\u043D\u043D\u043E\u0435 \u043E\u0431\u043B\u0430\u043A\u043E
