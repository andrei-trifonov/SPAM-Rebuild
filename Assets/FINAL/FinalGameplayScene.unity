      line: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E!
        \u0422\u0430\u043A \u043C\u043D\u043E\u0433\u043E... \u0418 \u0432 \u043A\u0430\u0436\u0434\u044B\u0439
        \u0440\u0430\u0437 \u043A\u0430\u043A \u0432 \u043F\u0435\u0440\u0432\u044B\u0439.
        \u0411\u0430\u0431\u043E\u0447\u043A\u0438 \u0432 \u0436\u0438\u0432\u043E\u0442\u0435
        \u043E\u0442 \u0432\u0438\u0434\u0430 \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0445\u0441\u044F
        \u043F\u0443\u0448\u0438\u0441\u0442\u044B\u0445 \u043A\u043B\u0443\u0431\u043A\u043E\u0432
        \u0441\u0432\u0435\u0442\u0430, \u0442\u043E\u043D\u0443\u0449\u0438\u0445
        \u0432 \u043D\u043E\u0447\u0438."
      font: 0
      inv: 0
      BGname: 0
      effects: 0
      CGname: 
      show: 0
      pose: 0
      spriteEffect: 0
