    - type: 0
      name: 2
      line: "\u0417\u0430\u043F\u0430\u0445 \u0441\u043C\u0435\u0440\u0442\u0438,
        \u0434\u0430\u0436\u0435 \u043D\u0435\u0442 - \u0437\u0430\u043F\u0430\u0445
        \u0437\u0430\u0431\u044B\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E,
        \u0435\u0441\u043B\u0438 \u0431\u044B \u0443 \u043D\u0435\u0433\u043E \u0431\u044B\u043B
        \u0437\u0430\u043F\u0430\u0445. \u0411\u0435\u0437\u0434\u043D\u0430 \u0433\u0440\u0443\u0441\u0442\u043D\u043E
        \u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u043E  \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B\u0430,
        \u0430 \u043F\u043E \u043D\u043E\u0433\u0430\u043C \u043F\u0440\u043E\u0431\u0435\u0436\u0430\u043B
        \u0432\u0435\u0442\u0435\u0440. "
