      line: "\u041F\u0430\u0440\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
        \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0438 \u043D\u0430\u0442\u044F\u043D\u0443\u043B\u0438
        \u0441\u0435\u0442\u044C \u043C\u0435\u0436\u0434\u0443 \u0441\u0442\u043E\u043B\u0431\u0430\u043C\u0438
        \u043D\u0430 \u0438\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u043C
        \u043F\u043E\u043B\u0435 \u0434\u043B\u044F \u0438\u0433\u0440\u044B. \u041A\u0438\u0440\u0430
        \u0432\u0441\u0442\u0430\u043B\u0430 \u043F\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
        \u043D\u0430\u0448\u0435\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B,
        \u0430 \u044F \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0438\u043B\u0430\u0441\u044C
        \u0441\u0431\u043E\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043D\u0435
        \u043C\u0435\u0448\u0430\u0442\u044C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C.
        \u0418\u0433\u0440\u043E\u043A \u0438\u0437 \u043C\u0435\u043D\u044F \u0442\u0430\u043A
        \u0441\u0435\u0431\u0435... \u041A\u0438\u0440\u0430 \u0432\u0441\u0442\u0430\u043B\u0430
        \u0432 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u0443\u044E
        \u044D\u0440\u043E\u0442\u0438\u0447\u043D\u0443\u044E \u043F\u043E\u0437\u0443
        \u0438 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C, \u0437\u0430\u043A\u0440\u044B\u0432
        \u0433\u043B\u0430\u0437\u0430, \u0431\u0443\u0434\u0442\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
        \u0441\u0432\u043E\u0435 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0441\u0442\u0432\u043E
        \u043D\u0430\u0434 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438."
      font: 0
      inv: 0
