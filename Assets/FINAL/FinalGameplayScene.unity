    - type: 0
      name: 15
      line: "-\u0422\u0435\u043F\u0435\u0440\u044C \u0441 \u0432\u0430\u043C\u0438
        \u0432 \u043A\u043B\u0430\u0441\u0441\u0435 \u0431\u0443\u0434\u0435\u0442
        \u0443\u0447\u0438\u0442\u044C\u0441\u044F \u041A\u0438\u0440 - \u043E\u043D
        \u043A \u043D\u0430\u043C \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430.
        \u0411\u0443\u0434\u044C\u0442\u0435 \u043A \u043D\u0435\u043C\u0443 \u0434\u043E\u0431\u0440\u044B,
        \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0439\u0442\u0435 \u043E\u0441\u0432\u043E\u0438\u0442\u044C\u0441\u044F
        \u0432 \u043D\u0430\u0448\u0435\u0439 \u0448\u043A\u043E\u043B\u044C\u043D\u043E\u0439
        \u0436\u0438\u0437\u043D\u0438.\n"
