        \u0441\u0442\u043E\u043B\u0435 \u043F\u0430\u043B\u044C\u0446\u0443. \u041C\u044F\u0441\u043D\u043E\u0439
        \u043A\u0443\u0441\u043E\u0447\u0435\u043A \u0444\u0430\u043B\u0430\u043D\u0433\u0438
        \u043E\u0442\u043B\u0435\u0442\u0435\u043B \u043A\u0443\u0434\u0430-\u0442\u043E
