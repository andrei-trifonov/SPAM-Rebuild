    - type: 0
      name: 2
      line: "\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u043E,
        \u0447\u0442\u043E \u0433\u043E\u0440\u043E\u0434 \u043F\u043E\u0447\u0442\u0438
        \u043D\u0435 \u043E\u0441\u0432\u0435\u0449\u0435\u043D  - \u043D\u0435\u0431\u043E
        \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043E \u0442\u0443\u0441\u043A\u043B\u044B\u043C
        \u0436\u0435\u043B\u0442\u044B\u043C \u0441\u0432\u0435\u0442\u043E\u043C,
        \u0438 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0431\u0443\u0434\u0442\u043E
        \u0443\u043B\u0438\u0446\u044B \u043D\u0430\u043A\u0440\u044B\u043B\u043E
        \u0442\u0430\u043A\u0438\u043C  \u0433\u0440\u044F\u0437\u043D\u044B\u043C
        \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u043C \u043A\u0443\u043F\u043E\u043B\u043E\u043C,
        \u0441\u043A\u0432\u043E\u0437\u044C \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u043D\u0435 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u0435\u0442 \u0441\u0432\u0435\u0442
        \u0437\u0432\u0435\u0437\u0434."
