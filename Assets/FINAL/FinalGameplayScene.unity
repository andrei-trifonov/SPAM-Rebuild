    - type: 0
      name: 2
      line: "\u041A\u0438\u0440\u0430 \u0431\u0435\u0436\u0438\u0442, \u0440\u0435\u0437\u043A\u043E
        \u0432\u0441\u0442\u0430\u0435\u0442 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435,
        \u043F\u0440\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u044F
        \u043A\u0440\u043E\u0441\u0441\u043E\u0432\u043A\u0430\u043C\u0438 \u043F\u043E
        \u043F\u0435\u0441\u043A\u0443, \u0433\u0440\u0443\u0431\u043E \u043E\u0442\u0431\u0438\u0432\u0430\u0435\u0442
        \u043B\u0435\u0442\u044F\u0449\u0438\u0439 \u043C\u044F\u0447."
