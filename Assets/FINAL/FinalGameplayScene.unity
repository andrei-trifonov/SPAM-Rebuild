    - type: 0
      name: 2
      line: "\u041C\u0430\u0442\u0435\u0440\u044F\u0441\u044C \u043F\u0440\u043E
        \u0441\u0435\u0431\u044F \u0438 \u0442\u043E \u0438 \u0434\u0435\u043B\u043E
        \u0440\u0438\u0441\u043A\u0443\u044F \u0441\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F
        \u0432\u043D\u0438\u0437 \u044F \u0432\u0435\u0442\u043A\u0430 \u0437\u0430
        \u0432\u0435\u0442\u043A\u043E\u0439 \u0448\u043B\u0430 \u0437\u0430 \u0410\u043B\u0438\u043D\u043E\u0439
        \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0443 \u0434\u0443\u0431\u0430.
        \u042F \u0441\u0442\u0430\u0440\u0430\u043B\u0430\u0441\u044C \u043D\u0435
        \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u043D\u0438\u0437,
        \u043D\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
        - \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u043D\u043E\u0433\u0430\u043C\u0438. "
