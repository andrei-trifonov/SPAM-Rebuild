    - type: 0
      name: 2
      line: "\u0412 \u0433\u043B\u0430\u0437\u0430\u0445 \u0440\u044F\u0431\u0438\u0442,
        \u0432\u044B\u0437\u044B\u0432\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u043D\u0443\u044E
        \u0431\u043E\u043B\u044C. \u0412\u0441\u0435 \u0442\u0430\u043A \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
        \u0438 \u0442\u0430\u043A \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
        \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E,
        \u0438 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0441\u043B\u0435\u0433\u043A\u0430
        \u043F\u043E\u0434\u0442\u0430\u0448\u043D\u0438\u0432\u0430\u0435\u0442...
        \u0415\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u044B\u0439
        \u0432\u0435\u0442\u0435\u0440, \u043E\u0441\u0442\u0443\u0436\u0430\u044E\u0449\u0438\u0439
        \u043C\u043E\u0439 \u043B\u043E\u0431 \u0438 \u0449\u0451\u043A\u0438, \u043C\u0435\u043D\u044F
        \u0431\u044B \u0443\u0436\u0435 \u0441\u0442\u043E\u0448\u043D\u0438\u043B\u043E."
