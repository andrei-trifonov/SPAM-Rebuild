    - type: 0
      name: 2
      line: "\u041A\u043E\u0442 \u0432 \u043F\u0430\u043D\u0438\u043A\u0435 \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F
        \u0446\u0435\u043F\u043B\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u043E\u0431\u0448\u0438\u0432\u043A\u0443, \u043D\u043E \u043A\u043E\u0433\u0442\u0438
        \u043D\u0438\u043A\u0430\u043A \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0438
        \u0432\u043F\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0432 \u043C\u0435\u0442\u0430\u043B\u043B,
        \u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0440\u044F\u0431\u0430\u043B\u0438
        \u0441\u0432\u0435\u0436\u0443\u044E \u043A\u0440\u0430\u0441\u043A\u0443.
