    \u043E\u043D\u0430.\"\r"
  - "    mr3 \"-\u041D\u0435\u0442, \u043D\u0435\u0442! \u042D\u0442\u043E \u044F,
    \u0442\u0430\u043A\u0430\u044F \u043A\u0430\u043A \u0442\u044B! \u042F \u043D\u0430\u0433\u0440\u0443\u0431\u0438\u043B\u0430
