--- !u!114 &8234462395648865366
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1395533943956336586}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84870ac187ff02548b9b9c88772fa4d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  labelName: sonya_jump
  scenarioBlock:
  - "    $end_puzp = 0\r"
  - "    $ quick_menu = True\r"
  - "    scene black with dissolve\r"
  - "    stop music fadeout 3.0\r"
  - "    un \"-\u0410\u0430\u0430\u0430!!!\"\r"
  - "    s \"\u041A\u0440\u0438\u043A \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u043B
    \u043C\u0435\u043D\u044F, \u0432\u043F\u043B\u0435\u0442\u044F\u0441\u044C \u0432
    \u0441\u044E\u0436\u0435\u0442 \u0441\u043D\u0430 \u0438 \u0441\u0431\u0438\u0432
    \u043C\u0435\u043D\u044F \u0441 \u0442\u043E\u043B\u043A\u0443.\"\r"
  - "    scene cg158 with dissolve\r"
  - "    play music \"audio/Piece.mp3\"\r"
  - "    s \"\u0412 \u0433\u043B\u0430\u0437\u0430\u0445 \u0432\u0441\u0435 \u0435\u0449\u0435
    \u043F\u043B\u044F\u0441\u0430\u043B\u0438 \u0442\u0435\u043D\u0438, \u043D\u043E
    \u044F \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C
    \u043A \u043E\u043A\u043D\u0443, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
    \u0432\u044B\u0441\u0443\u043D\u0443\u0432 \u0433\u043E\u043B\u043E\u0432\u0443.\"\r"
  - "    s \"\u0414\u0432\u043E\u0435 \u0442\u0438\u043F\u043E\u0432 \u0437\u0430\u0445\u043B\u043E\u043F\u044B\u0432\u0430\u043B\u0438
    \u0434\u0432\u0435\u0440\u0446\u044B \u0442\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F. \u041E\u0434\u0438\u043D
    \u0438\u0437 \u043D\u0438\u0445 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u043D\u0435\u0442
    \u043B\u0438 \u0441\u043B\u0435\u0436\u043A\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C
    \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F \u043D\u0430 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E.\"\r"
  - "    s \"\u0412 \u043C\u0430\u0448\u0438\u043D\u0435 \u0447\u0442\u043E-\u0442\u043E
    \u043B\u044F\u0437\u0433\u043D\u0443\u043B\u043E, \u0438 \u0448\u0430\u0439\u043A\u0430
    \u0441\u043A\u0440\u044B\u043B\u0430\u0441\u044C. \u0420\u0430\u0431\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B,
    \u043D\u0435 \u0438\u043D\u0430\u0447\u0435...\"\r"
  - "    s \"\u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u044D\u0442\u043E
    \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
    \u043F\u0443\u0433\u0430\u043B\u043A\u043E\u0439. \u0422\u0430\u043A \u0438 \u0431\u044B\u043B\u043E
    \u043F\u043E\u043D\u0430\u0447\u0430\u043B\u0443... \u041D\u043E \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
    \u0441\u0442\u0430\u043B\u043E \u043F\u0440\u0430\u0432\u0434\u043E\u0439.\"\r"
  - "    s \"\u041E\u0442\u043A\u0443\u0434\u0430 \u043E\u043D\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432\u0437\u044F\u043B\u0438\u0441\u044C? \u041D\u0435 \u0436\u0434\u0430\u043B\u0438,
    \u043D\u0435 \u0433\u0430\u0434\u0430\u043B\u0438, \u0431\u043B\u0438\u043D.\"\r"
  - "    s \"\u041F\u043E\u0434\u0443\u043C\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E...
    \u0418 \u041C\u0438\u0440\u0443, \u0438 \u043C\u0435\u043D\u044F \u0437\u0430\u0431\u0440\u0430\u0442\u044C
    \u0432\u0435\u0434\u044C \u043C\u043E\u0433\u0443\u0442. \u0417\u0430\u043C\u0430\u043D\u044F\u0442
    \u0441\u0432\u043E\u0438\u043C... \u041F\u043E\u0440\u043E\u0448\u043A\u043E\u043C,
    \u0430 \u0442\u044B \u0438 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F
    \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0448\u044C.\"\r"
  - "    s \"\u041E\u0442 \u0437\u043B\u043E\u0441\u0442\u0438 \u044F \u043F\u043D\u0443\u043B\u0430
    \u0442\u0440\u0443\u0431\u0443 \u043E\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u044F.
    \u0422\u0432\u0435\u0440\u0434\u0430\u044F, \u0447\u0435\u0440\u0442 \u0435\u0435...\"\r"
  - "    s \"\u041D\u0430 \u0447\u0430\u0441\u0430\u0445 \u0442\u0430\u043A\u043E\u0435
    \u0440\u0430\u043D\u043D\u0435\u0435 \u0443\u0442\u0440\u043E. \u0418 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u043E\u0441\u044C
    \u0436\u0435 \u0438\u043C \u043A\u0440\u0430\u0441\u0442\u044C \u0442\u0443 \u0434\u0435\u0432\u0447\u043E\u043D\u043A\u0443
    \u0442\u0430\u043A \u0440\u0430\u043D\u043E!\"\r"
  - "    s \"\u042F \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C. \u0420\u0430\u0437
    \u0434\u0435\u043D\u044C \u0431\u0435\u0437\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u043E
    \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D, \u043D\u0443\u0436\u043D\u043E
    \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u044C \u0435\u0433\u043E \u043A\u043E\u043C\u0443-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0434\u0440\u0443\u0433\u043E\u043C\u0443. \u0418, \u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0447\u0442\u043E\u0431\u044B \u043C\u043D\u0435 \u044D\u0442\u043E \u043D\u0435
    \u0432\u044B\u0448\u043B\u043E \u0431\u043E\u043A\u043E\u043C...\"\r"
  - "    s \"\u041A\u043E\u043C\u0443 \u0436\u0435 \u043D\u0430\u043F\u0430\u043A\u043E\u0441\u0442\u0438\u0442\u044C?
    \u041A\u043E\u043D\u0435\u0447\u043D\u043E \u0436\u0435 \u041C\u0438\u0440\u0435.
    \u041F\u043E\u0439\u0434\u0443 \u0438 \u0440\u0430\u0437\u0431\u0443\u0436\u0443
    \u0435\u0435.\"\r"
  - "    s \"\u0413\u043B\u0430\u0432\u043D\u043E\u0435, \u0447\u0442\u043E\u0431\u044B
    \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435 \u043C\u0435\u043D\u044F \u0442\u043E\u0436\u0435
    \u043D\u0435 \u0443\u0432\u0435\u0437\u043B\u0438 \u043D\u0430 \u0447\u0435\u0440\u043D\u043E\u043C
    \u0432\u043D\u0435\u0434\u043E\u0440\u043E\u0436\u043D\u0438\u043A\u0435.\"\r"
  - "    scene black with dissolve\r"
  - "    $ renpy.pause(3.0, hard = True )\r"
