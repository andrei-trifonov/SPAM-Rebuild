  m_Script: {fileID: 11500000, guid: 84870ac187ff02548b9b9c88772fa4d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  labelName: subt1
  scenarioBlock:
  - "    mr \"\u0412 \u043A\u0430\u0440\u043C\u0430\u043D\u0435 \u0437\u0430\u0437\u0432\u043E\u043D\u0438\u043B
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D. \u0417\u0432\u043E\u043D\u0438\u043B
    \u0422\u043E\u043B\u044F.\"\r"
  - "    scene cg26 with dissolve\r"
  - "    mr \"\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043D\u0435 \u0438\u0437-\u0437\u0430
    \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0439 \u0437\u0430\u0432\u0430\u0440\u0443\u0448\u043A\u0438
    \u0441 \u0445\u0438\u043C\u0438\u043A\u043E\u043C.\"\r"
  - "    mr \"-\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C. \u0427\u0442\u043E-\u0442\u043E
    \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?\"\r"
  - "    t \"-\u041D\u0435 \u0441\u0442\u0440\u043E\u0439 \u0438\u0437 \u0441\u0435\u0431\u044F
    \u0434\u0443\u0440\u043E\u0447\u043A\u0443. \u0422\u044B \u0436\u0435 \u0432\u0441\u0435
    \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C.\"\r"
  - "    mr \"\u0427\u0435\u0440\u0442. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u043A\u0430\u043F\u043B\u0438 \u043D\u0430\u0434\u0435\u0436\u0434\u044B \u043C\u0438\u0433\u043E\u043C
    \u0438\u0441\u043F\u0430\u0440\u0438\u043B\u0438\u0441\u044C.\"\r"
  - "    t \"-\u0422\u043E\u0442 \u0442\u0440\u0443\u043F \u0432 \u0448\u043A\u043E\u043B\u0435
    \u0443\u0436\u0435 \u043F\u043E\u0440\u043E\u0434\u0438\u043B \u043D\u0435\u043C\u0430\u043B\u043E
    \u0448\u0443\u043C\u0438\u0445\u0438. \u042F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u043E\u0447\u0435\u043D\u044C \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F,
    \u0438 \u0442\u0435\u0431\u044F \u043F\u043E\u043A\u0430 \u043D\u0435\u0442 \u0441\u0440\u0435\u0434\u0438
    \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u044B\u0445,
    \u043D\u043E...\"\r"
  - "    t \"-\u041C\u043E\u0436\u0435\u0448\u044C \u043C\u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C,
    \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0432\u043E\u043E\u0431\u0449\u0435,
