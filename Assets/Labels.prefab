  - "    show mr_su at normal (0.5)\r"
  - "    mr4 \"-\u041D\u0435\u0442, \u044F \u041C\u0438\u0440\u0430! \u042F \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F
