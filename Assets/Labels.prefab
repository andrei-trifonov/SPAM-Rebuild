  - "    ms \"-\u0422\u044B \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437
    \u043E\u0431\u0435\u0449\u0430\u043B \u043D\u0435 \u0431\u0438\u0442\u044C \u043C\u0435\u043D\u044F...
    \u041D\u0435 \u0432\u0430\u0436\u043D\u043E.\"\r"
  - "    jump contin8\r"
