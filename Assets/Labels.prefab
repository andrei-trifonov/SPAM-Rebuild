    \u043D\u0430 \u043F\u043E\u0447\u0442\u0443.\"\r"
  - "    mr \"\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442.
    \u041D\u0438\u0447\u0435\u0433\u043E...\"\r"
