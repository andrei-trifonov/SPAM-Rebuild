    \u042F \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u0440\u0430\u0441\u0448\u0435\u0432\u0435\u043B\u0438\u0442\u044C
    \u041C\u0438\u0440\u0443. \u041C\u0438\u0440\u0430! \u041F\u0440\u043E\u0441\u043D\u0438\u0441\u044C,
    \u041C\u0438\u0440\u0430! \u041E\u0447\u043D\u0438\u0441\u044C! \u041F\u0443\u043B\u044C\u0441
    \u0435\u0441\u0442\u044C. \u0414\u044B\u0448\u0438\u0442...\"\r"
  - "    stop music fadeout 3.0\r"
  - "    s \"\u0416\u0438\u0432\u0430\u044F...\"\r"
  - "    s \"\u042F \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0430.\"\r"
  - "    scene black with dissolve\r"
  - "    $ renpy.pause(3.0, hard = True )\r"
  - "    scene Club with dissolve\r"
  - "    show ms_n_y at normal (0.3)\r"
  - "    show mr_n_party at zoomer (0.6)\r"
  - "    show s_c_party at normal (0.8)\r"
  - "    s \"\u041C\u0438\u0440\u0430 \u0438\u0437\u0434\u0430\u043B\u0430 \u0441\u043A\u0440\u0438\u043F\u044F\u0449\u0438\u0439
    \u0437\u0432\u0443\u043A.\"\r"
  - "    play music \"audio/GoodDayToDie.mp3\"\r"
  - "    s \"-\u041C\u0438\u0440\u0430, \u0442\u044B \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435?\"\r"
  - "    ms \"-\u0421\u043A\u0430\u0436\u0438 \u0441\u043F\u0430\u0441\u0438\u0431\u043E
    \u0421\u043E\u043D\u0435. \u0415\u0441\u043B\u0438 \u0431\u044B \u043D\u0435
    \u043E\u043D\u0430, \u0443\u0435\u0445\u0430\u043B\u0430 \u0431\u044B \u0442\u044B.
    \u0414\u0430 \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u043A\u043E, \u0447\u0442\u043E
    \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043D\u0435\u0442.\"\r"
  - "    scene  cg157 with dissolve\r"
  - "    s \"\u041D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445 \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B\u0438
    \u0441\u043B\u0435\u0437\u044B. \u042F \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0430
    \u041C\u0438\u0440\u0443, \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0438\u0445
    \u0441 \u041C\u0438\u0448\u0435\u0439 \u043D\u0430\u0435\u0434\u0438\u043D\u0435.\"\r"
  - "    s \"\u0421\u0438\u0433\u0430\u0440\u0435\u0442\u0430, \u0447\u0442\u043E
    \u0434\u0430\u043B \u043C\u043D\u0435 \u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
    \u041F\u0430\u0445\u043D\u0435\u0442 \u044F\u0433\u043E\u0434\u0430\u043C\u0438...\"\r"
  - "    s \"\u042F \u0437\u0430\u043A\u0443\u0440\u0438\u043B\u0430.\"\r"
  - "    jump contin10\r"
