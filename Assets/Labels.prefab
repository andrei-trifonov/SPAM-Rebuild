    \u0446\u0435\u043B\u043E\u0435 \u0438 \u043E\u0434\u043D\u043E \u043D\u0435\u0434\u0435\u043B\u0438\u043C\u043E\u0435.\"\r"
  - "    mr1 \"-\u041D\u0435\u0442. \u0412\u0441\u0435 \u043D\u0435 \u0442\u0430\u043A!
    \u0415\u0441\u0442\u044C \u043E\u0434\u043D\u0430 \u044F. \u041E\u0434\u043D\u0430
    \u041C\u0438\u0440\u0430 \u041A\u0430\u043B\u0438\u043D\u0438\u043D\u0430. \u041D\u0430
    \u0432\u0435\u0441\u044C \u0437\u0435\u043C\u043D\u043E\u0439 \u0448\u0430\u0440.\"\r"
  - "    mr1 \"-\u041E\u0434\u043D\u0430 \u044F. \u0412\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442\u0435
    \u043C\u0435\u043D\u044F \u0443\u0431\u0435\u0434\u0438\u0442\u044C \u0432 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C.
    \u041D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043D\u0438\u043A\u0430\u043A\u0438\u0445
    \u043A\u043E\u043F\u0438\u0439.\"\r"
  - "    mr1 \"-\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043F\u043B\u044E...
    \u0418 \u043D\u0435 \u0437\u043D\u0430\u044E, \u043A\u0430\u043A \u043C\u043D\u0435
    \u043F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F.\"\r"
  - "    mr2 \"-\u041F\u043E\u0447\u0435\u043C\u0443 \u0436\u0435? \u041C\u044B \u0441
    \u0442\u043E\u0431\u043E\u0439 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435.
