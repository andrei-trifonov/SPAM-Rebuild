MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8426853661243242500}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84870ac187ff02548b9b9c88772fa4d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  labelName: event7_act3
  scenarioBlock:
  - "    scene cg216 with dissolve\r"
  - "    stop music fadeout 2.0\r"
  - "    mr \"\u0422\u0430\u043A\u043E\u0435 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E. \u041A\u0442\u043E \u0432\u044B?
    \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0432\u044B \u043A\u0430\u043A\u0438\u0435-\u0442\u043E
    \u0431\u043E\u0433\u0438, \u0438\u043B\u0438 \u0432\u0440\u043E\u0434\u0435 \u0442\u043E\u0433\u043E.\"\r"
  - "    mr \"\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u0441\u0432\u0435\u0442\u043B\u044B\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442
    \u043C\u0435\u043D\u044F \u0438\u0437 \u0440\u0443\u043A \u0432 \u0440\u0443\u043A\u0438,
    \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u044F \u0431\u044B\u043B\u0430 \u043A\u0430\u043A\u0438\u043C-\u0442\u043E
    \u043A\u0443\u0441\u043A\u043E\u043C \u0433\u043B\u0438\u043D\u044B \u0438 \u043C\u043D\u0435
    \u0445\u043E\u0442\u0435\u043B\u0438 \u043F\u0440\u0438\u0434\u0430\u0442\u044C
    \u0444\u043E\u0440\u043C\u0443.\"\r"
  - "    play music \"audio/heart.mp3\"\r"
  - "    mr \"\u041D\u0435 \u0441\u043B\u044B\u0448\u043D\u043E \u043D\u0438 \u0437\u0432\u0443\u043A\u0430.
    \u0412\u0441\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0442\u0430\u043A \u0442\u0438\u0445\u043E, \u0447\u0442\u043E \u0435\u0441\u043B\u0438
    \u0431\u044B \u043A\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B
    \u0440\u044F\u0434\u043E\u043C \u043C\u043E\u0435 \u0438\u043C\u044F, \u044F
    \u0431\u044B, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043E\u0433\u043B\u043E\u0445\u043B\u0430.\"\r"
  - "    mr \"\u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0432 \u043A\u043E\u043D\u0446\u0435?
    \u042F \u043D\u0435 \u0432 \u0441\u0438\u043B\u0430\u0445 \u043D\u0430 \u0447\u0442\u043E-\u0442\u043E
    \u043F\u043E\u0432\u043B\u0438\u044F\u0442\u044C, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
    \u0431\u044B \u0445\u043E\u0442\u0435\u043B\u0430.\"\r"
  - "    mr \"\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
    \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F \u044D\u0442\u0438\u043C
    \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u043C
    \u0438 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043C.\"\r"
  - "    mr \"\u041C\u043E\u0436\u0435\u0442, \u0443 \u043C\u0435\u043D\u044F \u0441\u043D\u043E\u0432\u0430
    \u0433\u0430\u043B\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0438\u0438? \u041D\u0435
    \u043C\u043E\u0436\u0435\u0442 \u0436\u0435 \u044D\u0442\u043E \u0432\u0441\u0435
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430
    \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435. \u041C\u043E\u0436\u0435\u0442,
    \u043E\u043D\u0438 \u0440\u0435\u0448\u0430\u044E\u0442, \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442
    \u0441 \u043C\u043E\u0435\u0439 \u0434\u0443\u0448\u043E\u0439?\"\r"
  - "    mr \"\u042F \u0431\u044B \u043C\u0435\u043D\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E
    \u0445\u043E\u0442\u0435\u043B\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u0430\u043B\u044C\u0446\u044B
    \u0440\u0443\u043A \u0441\u0436\u0430\u043B\u0438\u0441\u044C, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
    \u043E\u0442 \u043C\u0435\u043D\u044F \u043B\u0438\u0448\u044C \u043C\u043E\u043A\u0440\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E.\"\r"
  - "    mr \"\u0422\u0430\u043C, \u043D\u0430\u0432\u0435\u0440\u0445\u0443, \u0437\u0430
    \u0438\u0445 \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438, \u0435\u0441\u0442\u044C
    \u0441\u0432\u0435\u0442, \u0447\u0442\u043E \u0437\u043E\u0432\u0435\u0442 \u043C\u0435\u043D\u044F.\"\r"
  - "    mr \"\u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u0438 \u0440\u0443\u043A\u0438
    \u043F\u043E\u0434\u043D\u0438\u043C\u0443\u0442 \u043C\u0435\u043D\u044F \u0442\u0443\u0434\u0430?
    \u0410 \u043C\u043E\u0436\u0435\u0442 \u0431\u0440\u043E\u0441\u044F\u0442 \u0432
    \u0431\u0435\u0437\u0434\u043D\u0443, \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
    \u0436\u0435 \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u0435\u043D \u0441\u0432\u0435\u0442
    \u043D\u0430\u0432\u0435\u0440\u0445\u0443.\"\r"
  - "    mr \"\u041F\u0443\u0441\u0442\u044C \u043E\u043D\u0438 \u0432\u044B\u0431\u0435\u0440\u0443\u0442.
    \u042F \u0431\u044B \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0430\u0441\u044C
    \u043D\u0430 \u043B\u044E\u0431\u043E\u0439 \u0438\u0441\u0445\u043E\u0434...\"\r"
  - "    mr \"\u041B\u0438\u0448\u044C \u0431\u044B \u0442\u043E\u043B\u044C\u043A\u043E
    \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0432
    \u044D\u0442\u0438\u0445 \u0440\u0443\u043A\u0430\u0445 \u043D\u0430\u0432\u0435\u0447\u043D\u043E,
    \u0431\u043E\u044F\u0441\u044C \u0431\u044B\u0442\u044C \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u043D\u043E\u0439
    \u0432 \u043F\u044B\u043B\u044C.\"\r"
  - "    mr \"\u041C\u0435\u043D\u044F \u043D\u0435 \u043F\u0443\u0433\u0430\u0435\u0442
    \u0441\u0443\u0434\u044C\u0431\u0430 \u043F\u0430\u0434\u0430\u0442\u044C \u0432
    \u0431\u0435\u0437\u0434\u043E\u043D\u043D\u0443\u044E \u044F\u043C\u0443...
    \u0425\u043E\u0442\u044C \u0431\u044B \u0442\u043E\u0447\u043D\u043E \u0437\u043D\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0445\u043E\u0442\u044F\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0441\u043E \u043C\u043D\u043E\u0439. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
    \u043D\u0435 \u0432\u0430\u0436\u043D\u043E.\"\r"
  - "    mr \"\u0418\u0437 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E
    \u043C\u0440\u0430\u043A\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
    \u043B\u0438\u0446\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u0447\u0442\u043E
    \u0434\u0435\u0440\u0436\u0430\u043B\u043E \u043C\u0435\u043D\u044F \u0432 \u0440\u0443\u043A\u0430\u0445.\"\r"
  - "    mr \"\u041F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u043E\u043D\u043E
    \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C
    \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C. \u0418 \u043E\u0442\u0447\u0435\u0433\u043E-\u0442\u043E
    \u0441\u0435\u0440\u0434\u0446\u0435 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
    \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u043E\u0441\u044C \u0442\u0435\u043F\u043B\u043E\u0442\u043E\u0439
    \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F.\"\r"
  - "    mr \"\u0411\u0443\u0434\u0442\u043E \u0431\u044B \u0447\u0442\u043E-\u0442\u043E
    \u0433\u043E\u0440\u044F\u0447\u0435\u0435 \u0438 \u043D\u0435\u0436\u043D\u043E\u0435
    \u0440\u0430\u0441\u0446\u0432\u0435\u043B\u043E \u0432\u043D\u0443\u0442\u0440\u0438.
    \u042D\u0442\u043E \u0436\u0435...\"\r"
  - "    mr \"\u041D\u0435\u0442, \u044D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043D\u0438\u043A\u0435\u043C
    \u0438\u043D\u044B\u043C. \u0418\u0437 \u0433\u043B\u0430\u0437 \u043F\u043E\u0442\u0435\u043A\u043B\u0438
    \u0441\u043B\u0435\u0437\u044B, \u0430 \u0433\u0443\u0431\u044B \u0441\u0430\u043C\u0438
    \u0441\u043B\u043E\u0436\u0438\u043B\u0438\u0441\u044C \u0432 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E
    \u0441\u043E\u0436\u0430\u043B\u0435\u044E\u0449\u0443\u044E \u0443\u043B\u044B\u0431\u043A\u0443.\"\r"
  - "    mr \"\u042D\u0442\u043E... \"\r"
  - "    mr \"\u0422\u044B... \"\r"
  - "    mr \"\u041C\u0430\u043C\u0430...\"\r"
  - "    mr \"\u041F\u0440\u043E\u0441\u0442\u0438 \u043C\u0435\u043D\u044F.\"\r"
  - "    mr \"\u041F\u0440\u043E\u0441\u0442\u0438.\"\r"
  - "    stop music fadeout 4.0\r"
  - "    jump middle7_act3\r"
