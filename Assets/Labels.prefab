  scenarioBlock:
  - "    ms \"\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u044E \u0437\u0430\u0439\u0442\u0438
    \u0447\u0435\u0440\u0435\u0437 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043F\u043E\u0434\u044A\u0435\u0437\u0434,
    \u043E\u0442\u043A\u0443\u0434\u0430 \u0440\u0430\u043D\u044C\u0448\u0435 \u043F\u0440\u0438\u0432\u043E\u0437\u0438\u043B\u0438
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u043D\u0430 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0445
    \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A\u0430\u0445.\"\r"
  - "    ms \"\u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
    \u0431\u044B\u043B\u0438 \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0442\u044B,
    \u0430 \u0437\u043D\u0430\u0447\u0438\u0442, \u043A\u0442\u043E-\u0442\u043E
    \u0441\u044E\u0434\u0430 \u0437\u0430\u0435\u0437\u0436\u0430\u043B.\"\r"
  - "    ms \"\u0412\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u043C
    \u0434\u0432\u043E\u0440\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
    \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0441\u043B\u0430\u0431\u043E
    \u0432\u0438\u0434\u043D\u0435\u044E\u0449\u0438\u0435\u0441\u044F \u0441\u043B\u0435\u0434\u044B
    \u043E\u0442 \u0448\u0438\u043D, \u043D\u043E \u0441\u0430\u043C\u043E\u0433\u043E
    \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F \u0437\u0434\u0435\u0441\u044C
    \u043D\u0435\u0442.\"\r"
  - "    ms \"\u041A\u0443\u0434\u0430 \u043E\u043D\u0438 \u043C\u043E\u0433\u043B\u0438
    \u043F\u043E\u0434\u0435\u0432\u0430\u0442\u044C\u0441\u044F, \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u044D\u0442\u0438\u043C \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C
    \u0432\u043D\u0435\u0434\u043E\u0440\u043E\u0436\u043D\u0438\u043A\u043E\u043C?\"\r"
  - "    ms \"\u041D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
    \u043A\u0430\u043A \u0442\u0430\u043C \u0432\u043D\u0443\u0442\u0440\u0438. \u041D\u0430\u0447\u043D\u0443
    \u0441 \u0430\u043D\u0433\u0430\u0440\u043E\u0432.\"\r"
  - "    jump misha_investig\r"
