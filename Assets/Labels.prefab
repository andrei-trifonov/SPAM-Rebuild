    \u0437\u0432\u043E\u043D \u0432 \u0443\u0448\u0430\u0445.\"\r"
  - "    mr \"\u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0430\u043A\u0438\u0435-\u0442\u043E
