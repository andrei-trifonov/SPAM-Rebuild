    \u043B\u044E\u0434\u0438. \u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u0435\u0433\u043E
    \u0441\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430
    \u0438\u0445 \u0433\u043E\u043B\u043E\u0432\u0443. \u042F \u0434\u0430\u0436\u0435
    \u043D\u0435 \u043C\u043E\u0433\u0443 \u0432\u0438\u043D\u0438\u0442\u044C \u0438\u0445
    \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u043E\u043D\u0438 \u043B\u043E\u043C\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E\u0434 \u0433\u0440\u0443\u0437\u043E\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C.\"\r"
  - "    k \"-\u0421\u0445\u043E\u0434\u044F\u0442 \u0441 \u0434\u043E\u0440\u043E\u0433\u0438,
    \u043F\u0443\u0442\u0430\u044E\u0442\u0441\u044F \u0432 \u043C\u044B\u0441\u043B\u044F\u0445.
    \u041C\u043D\u0435 \u0432\u0441\u0435\u0445... \u0422\u0430\u043A \u0436\u0430\u043B\u044C.\"\r"
  - "    k \"-\u0427\u0442\u043E-\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u0442\u044B \u043D\u0435 \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0438.
    \u042F \u0437\u0430\u0431\u0438\u043B \u043D\u0430\u043C \u0441\u0442\u043E\u043B\u0438\u043A
    \u0432 \u0442\u0432\u043E\u0435\u043C \u043B\u044E\u0431\u0438\u043C\u043E\u043C
    \u043A\u0430\u0444\u0435. \u041D\u0443\u0436\u043D\u043E \u0431\u044B\u0442\u044C
    \u0432\u043E\u0432\u0440\u0435\u043C\u044F. \u041F\u043E\u0431\u0435\u0436\u0430\u043B\u0438?\"\r"
  - "    mr \"\u041D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u044F \u043C\u043E\u0435\u0439
    \u0440\u0443\u043A\u0438, \u041A\u0438\u0440 \u0440\u0432\u0430\u043D\u0443\u043B\u0441\u044F
    \u043A \u043A\u0440\u0430\u044E \u0441\u0446\u0435\u043D\u044B.\"\r"
  - "    k \"-\u0415\u0449\u0435 \u043F\u0430\u0440\u043E\u0447\u043A\u0430 \u0440\u0435\u043F\u0435\u0442\u0438\u0446\u0438\u0439,
    \u0438 \u0432\u0441\u0435 \u0431\u0443\u0434\u0435\u0442 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E.
    \u0422\u044B... \u041E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E
    \u0438\u0433\u0440\u0430\u0435\u0448\u044C \u0441\u0432\u043E\u044E \u0440\u043E\u043B\u044C.
    \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0430\u0441\u044C.\"\r"
  - "    mr \"-\u0410 \u0440\u0430\u0437\u0432\u0435 \u044F \u043C\u043E\u0433\u043B\u0430
    \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u0438\u043D\u0430\u0447\u0435?\"\r"
  - "    hide mr_n\r"
  - "    show mr_sm at normal (0.3)\r"
  - "    mr \"\u042F \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0430\u0441\u044C
    \u0432\u043E\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D\u043D\u043E\u043C\u0443
    \u041A\u0438\u0440\u0443.\"\r"
  - "    scene Flat1 with dissolve\r"
  - "    show mr_sm at normal (0.3)\r"
  - "    show k_s at normal (0.6)\r"
  - "    mr \"\u041C\u044B \u0441\u043F\u0440\u044B\u0433\u043D\u0443\u043B\u0438
    \u0441\u043E \u0441\u0446\u0435\u043D\u044B, \u043F\u0440\u043E\u0448\u043B\u0438
    \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u0442\u0430\u0440\u044B\u0439 \u0432\u0435\u0441\u0442\u0438\u0431\u044E\u043B\u044C
    \u0442\u0435\u0430\u0442\u0440\u0430, \u0438 \u043D\u0430\u043A\u043E\u043D\u0435\u0446
    \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0441\u0432\u0435\u0442\u043B\u043E\u0439
    \u0438 \u0448\u0443\u043C\u043D\u043E\u0439 \u0443\u043B\u0438\u0446\u0435.\"\r"
  - "    mr \"\u0422\u0435\u043F\u043B\u044B\u0439 \u0432\u043E\u0437\u0434\u0443\u0445
    \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u043B
    \u043D\u0430\u0448\u0438 \u0444\u0438\u0433\u0443\u0440\u044B \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C
    \u0441\u0438\u0440\u0435\u043D\u0438.\"\r"
  - "    mr \"\u042D\u0442\u0430 \u0432\u0435\u0441\u043D\u0430... \u0412\u043E\u0442
    \u0431\u044B \u043E\u043D\u0430 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
    \u043A\u043E\u043D\u0447\u0430\u043B\u0430\u0441\u044C.\"\r"
  - "    jump credits\r"
