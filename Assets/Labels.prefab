    ...\"\r"
  - "    mr \"\u042F \u0447\u0442\u043E, \u0443\u043C\u0435\u0440\u043B\u0430?\"\r"
  - "    mr \"\u0412\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E,
