    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[455]
      value: "    n \"-\u0425\u0430. \u041D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
        \u0448\u0438\u0440\u044F\u0435\u0442\u0441\u044F '\u043A\u0430\u0439\u043C\u0430\u043D\u043E\u043C'
        \u0438\u043B\u0438 \u0447\u0435\u043C \u043F\u043E\u043A\u0440\u0435\u043F\u0447\u0435,
        \u0432\u043E\u0442 \u0438 \u043E\u0442\u043F\u0438\u043B\u0438\u043B\u0438
        \u0443 \u043D\u0435\u0435 \u0432\u0441\u0435. \u041E\u0441\u043B\u043E\u0436\u043D\u0435\u043D\u0438\u044F
        \u043F\u043E\u0448\u043B\u0438, \u0438 \u0440\u0430\u043D\u0430 \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u0447\u0438\u0442
        \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[456]
      value: "    mr \"\u042F \u0441\u043C\u0443\u0442\u0438\u043B\u0430\u0441\u044C.
        \u042D\u0442\u043E... \u0431\u044B\u043B\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
        \u0433\u0440\u0443\u0431\u043E.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[457]
      value: "    mr \"-\u041D\u0435 \u0434\u0443\u043C\u0430\u044E \u044F, \u0447\u0442\u043E
        \u043E\u043D\u0430 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
        \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442, \u0445\u043E\u0442\u044F
        \u0432\u0441\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u0421\u043C\u0435\u043D\u0438\u043C
        \u0442\u0435\u043C\u0443. \u041D\u0435 \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u043B\u044E
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
        \u043F\u043B\u043E\u0445\u043E\u0435 \u0443 \u043B\u044E\u0434\u0435\u0439
        \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.\"\r"
      objectReference: {fileID: 0}
