    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[592]
      value: "    narrator \"\u0411\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E.
        \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043D\u0435 \u0437\u043D\u0430\u044E,
        \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u043D\u0435 \u0435\u0449\u0435
