      propertyPath: scenarioBlock.Array.data[299]
      value: "    narrator \"\u0417\u0432\u043E\u043D\u043E\u043A \u0431\u0443\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0430.
        \u0414\u0437\u044B\u043D\u044C-\u0434\u0437\u044B\u043D\u044C, \u043F\u043E\u0440\u0430
        \u0432 \u0448\u043A... \u0412 \u043A\u043E\u043B\u043B\u0435\u0434\u0436,
        \u044E\u043D\u0430\u044F \u041C\u0438, \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u0442\u0430\u043A\u043E\u0439 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439
        \u0434\u0435\u043D\u044C. \u0421\u0438\u0433\u0430\u0440\u0435\u0442\u044B,
        \u0442\u0435\u0442\u0440\u0430\u0434\u0438 \u0441 \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0430\u043C\u0438
        \u043A\u0440\u0443\u0436\u0435\u043A \u043A\u043E\u0444\u0435, \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F
        \u0440\u0443\u0447\u043A\u0430.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[300]
      value: "    narrator \"O\u0442\u043B\u0438\u0447\u043D\u043E, \u0432\u0441\u0435
        \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u042F \u043F\u043E\u0434\u043E\u0448\u043B\u0430
        \u043A \u0437\u0435\u0440\u043A\u0430\u043B\u0443 \u0438 \u043A\u043E\u0435-\u043A\u0430\u043A
        \u043F\u0440\u0438\u0447\u0435\u0441\u0430\u043B\u0430 \u0432\u043E\u043B\u043E\u0441\u044B.
        \u041F\u0440\u0430\u0432\u0434\u0430, \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
