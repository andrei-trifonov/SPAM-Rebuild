    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[37]
      value: "    mr \"\u0423\u0442\u0440\u043E. \u0414\u044B\u043C \u0441\u0438\u0433\u0430\u0440\u0435\u0442
        \u0441 '\u041F\u044B\u043B\u044C\u0446\u043E\u0439'. \u0427\u0442\u043E \u0431\u044B\u043B\u043E
        \u043D\u043E\u0447\u044C\u044E? \u042F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E.
        \u041A\u0430\u043A \u0434\u0435\u0448\u0435\u0432\u0430\u044F \u0441\u0438\u0433\u0430\u0440\u0435\u0442\u0430
        \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u043E\u0441\u043B\u0435
        \u0441\u0435\u0431\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u043E\u0435
        \u044F\u0434\u043E\u0432\u0438\u0442\u043E\u0435 \u043F\u043E\u0441\u043B\u0435\u0432\u043A\u0443\u0441\u0438\u0435,
        \u0442\u0430\u043A \u0438 \u043C\u043E\u044F \u043D\u043E\u0447\u043D\u0430\u044F
        \u0436\u0438\u0437\u043D\u044C \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
        \u0431\u0435\u0441\u0441\u043B\u0435\u0434\u043D\u043E.  \"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[38]
      value: "    mr \"\u042F \u0441\u043C\u0435\u044E\u0441\u044C, \u043D\u043E
        \u044D\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u0441\u043C\u0435\u0448\u043D\u043E,
        \u043F\u0440\u043E\u0441\u0442\u043E... '\u041F\u044B\u043B\u044C\u0446\u0430'
        \u043D\u0435 \u0432\u044B\u0432\u0435\u0442\u0440\u0438\u043B\u0430\u0441\u044C
        \u0435\u0449\u0435 \u0438\u0437 \u043C\u043E\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u044B.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[39]
      value: "    mr \"\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u0430\u043A \u0442\u044F\u0436\u0435\u043B\u043E?
        \u042F \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u043B\u0430, \u0447\u0442\u043E\u0431\u044B
        \u043A\u0442\u043E-\u0442\u043E \u0435\u0449\u0435 \u0441\u0442\u0440\u0430\u0434\u0430\u043B
        \u043F\u043E\u0441\u043B\u0435 \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u044B\u0445
        \u0438 \u0441\u0430\u043C\u043E\u0437\u0430\u0431\u0432\u0435\u043D\u043D\u044B\u0445
        \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0439. \u041A\u043E\u043D\u0435\u0447\u043D\u043E,
        \u0435\u0441\u043B\u0438 \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u0442\u044C
        \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C\u043D\u0443\u044E \u0438
        \u043D\u0430\u0440\u043A\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u0438\u043D\u0442\u043E\u043A\u0441\u0438\u043A\u0430\u0446\u0438\u044E...\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[40]
      value: "    mr \"\u0414\u0435\u043B\u043E \u0432\u043E \u043C\u043D\u0435?
        \u0418\u043B\u0438 \u043C\u043E\u0436\u0435\u0442, \u043D\u0438\u043A\u0442\u043E
        \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u0434\u0443\u043C\u0430\u0442\u044C,
        \u0447\u0442\u043E \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0441\u0432\u043E\u044E
        \u0436\u0438\u0437\u043D\u044C \u043D\u0430 \u0432\u0441\u0435 \u044D\u0442\u043E
        - \u0433\u043B\u0443\u043F\u043E.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[41]
      value: "    mr \"\u041C\u043D\u0435 \u043E\u0434\u0438\u043D\u043E\u043A\u043E
        \u043D\u0430\u0435\u0434\u0438\u043D\u0435 \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438
        \u043C\u044B\u0441\u043B\u044F\u043C\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
        \u044F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u0436\u0438\u0442\u044C,
        \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u0443.
        \u0418 \u043A\u0430\u043A \u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u043E,
        \u0447\u0442\u043E \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0434\u0443\u043C\u0430\u0442\u044C
        \u043E \u0447\u0435\u043C-\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u043E.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[42]
