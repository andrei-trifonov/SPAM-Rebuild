      propertyPath: scenarioBlock.Array.data[217]
      value: "    mr \"\u041C\u044B \u0441 \u041C\u0438\u0448\u0435\u0439 \u0447\u0430\u0441\u0442\u043E
        \u0441\u0431\u0435\u0433\u0430\u043B\u0438 \u0447\u0435\u0440\u0435\u0437
