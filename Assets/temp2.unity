      propertyPath: scenarioBlock.Array.data[218]
      value: "    mr \"-\u041C\u0438\u0448\u0430, \u0442\u044B... \u041D\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B,
