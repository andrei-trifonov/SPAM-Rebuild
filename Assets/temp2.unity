        \u0434\u043D\u0435\u0439 \u043D\u0430\u0437\u0430\u0434. \u0427\u0442\u043E
        \u0436, \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043E\u0431\u043E\u0439\u0442\u0438\u0441\u044C
        \u0431\u0435\u0437 \u043D\u0435\u0433\u043E - \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C
        \u043D\u0430 \u0443\u043B\u0438\u0446\u0443 \u0436\u0443\u0442\u043A\u043E
        \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F.\"\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1925802078325853359, guid: d6ffc3e6e3774ed4eb79517aa97e409e, type: 3}
      propertyPath: scenarioBlock.Array.data[781]
      value: "    mr \"\u041A\u0430\u043F... \u043A\u0430\u043F... \u0432\u043E\u0434\u0430
